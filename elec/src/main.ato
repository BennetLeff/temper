# main.ato
# Temper Induction Cooker - Top Level Design
# Reference: pcb/temper.kicad_sch
#
# System Overview:
# - AC Input (120V) -> Voltage Doubler -> DC Bus (340V)
# - DC Bus -> Half-Bridge -> Resonant Tank -> Coil
# - ESP32-S3 controls PWM, monitors sensors, kicks watchdog
# - Hardware safety interlock: OCP, OVP, Thermal, Watchdog -> SHUTDOWN_N
#
# Power Rails:
# - DC_BUS: 340V nominal (rectified mains)
# - +15V: Gate driver, safety logic (from auxiliary supply)
# - +3.3V: MCU, digital logic (from LDO)

# Module imports
import HalfBridge from "modules.ato"
import ResonantTank from "modules.ato"
import PowerInput from "modules.ato"
import BusDischarge from "modules.ato"
import PowerManagement from "modules.ato"
import AuxSupply from "modules.ato"
import CurrentSensing from "modules.ato"
import RTDSensing from "modules.ato"
import SafetyInterlock from "modules.ato"
import ThermalSystem from "modules.ato"
import MCU from "modules.ato"
import HighVoltageConstraints from "constraints.ato"
import ACMainsConstraints from "constraints.ato"
import ThermalZonesConstraints from "constraints.ato"

# Footprint imports for FAC
import IGBT_TO247 from "footprints.ato"
import SOIC16W_Isolated from "footprints.ato"
import LitzPad_15A from "footprints.ato"
import CST1005_Footprint from "footprints.ato"

# ==============================================================================
# TOP-LEVEL MODULE: Complete Induction Cooker System
# ==============================================================================

module Top:
    """Top-level Temper induction cooker assembly."""

    constraints = new HighVoltageConstraints
    thermal_constraints = new ThermalZonesConstraints
    # The branch circuit this product plugs into. Instantiated here
    # 2026-08-20 so the top-level power budget can be derived from the
    # branch's own volt-ampere capacity instead of restating 1800 as a
    # literal -- see the p_output_max block below. Same module PowerInput
    # already instantiates for its own series-element ratings.
    ac_constraints = new ACMainsConstraints

    
    # --- System Operating Conditions ---
    v_bus_max = 340V
    v_bus_abs_max = 400V
    v_ac_nominal = 120V
    # DEAD DECLARATION, FLAGGED 2026-08-20, NOT DELETED HERE. Nothing in
    # this repo reads `power_max` -- not the firmware, not the placer, not
    # any gate; it is a second, independent copy of the same 1800 figure
    # that `p_output_max` further down carries, and it carries the same
    # units error (1800 is the branch circuit's VOLT-AMPERES, not
    # deliverable output watts -- see the block at p_output_max). It is
    # left in place because docs/evidence/2026-07-26-ovp-crossing-
    # resolution.md and 2026-07-26-bom-blocker-resolution.md both cite
    # this line by name, and silently removing a figure two evidence
    # documents point at is worse than recording that it is wrong.
    power_max = 1800W

    # `i_peak_max = 25A` USED TO BE DECLARED HERE, and asserted immediately
    # below as `assert i_peak_max <= constraints.i_max`. Both sides were
    # 25A -- HighVoltageConstraints.i_max is the same number -- so the
    # check passed by an exact tie with zero derating and no component in
    # the design could move either side of it. Meanwhile modules.ato's
    # ResonantTank comment has recorded, since 2026-07-29, that the real
    # tank peak is 28.7-31.9A, i.e. ABOVE this "limit", marked
    # "UNRESOLVED AND RECORDED, NOT FIXED HERE".
    #
    # The declaration is gone and the check has MOVED, not been dropped:
    # `i_tank_peak_sq` in the SAFETY ASSERTIONS section below derives the
    # peak from the tank's own L and C and asserts it against
    # constraints.i_max there. It has to live there because it reads
    # f_switching, l_pan_loaded_ratio and the `tank` instance, all
    # declared later in this file.

    # --- Operating Envelope Assertions (temper-ofq.4) ---
    assert v_ac_nominal within 100V to 130V  # NEMA 5-15 tolerance

    # Verify against constraints (temper-ofq.6)
    assert v_bus_max <= constraints.v_max

    f_line: frequency = 60Hz
    assert f_line within 59Hz to 61Hz  # US grid tolerance
    
    v_bus_nominal: voltage = 340V
    assert v_bus_nominal within 280V to 380V  # Doubler output range
    
    v_bus_ripple_max: voltage = 20V
    assert v_bus_ripple_max < v_bus_nominal * 0.1  # <10% ripple
    
    # CORRECTED 2026-07-27 (docs/evidence/2026-07-27-zvs-operating-point.md,
    # docs/evidence/2026-07-27-pan-preset-correction.md): the previous value
    # here, 35kHz, was found to lose ZVS COMPLETELY for ferromagnetic pans
    # (cast_iron/stainless) once the pan-coupling model was corrected to
    # Infineon AN235020's measured K=0.79 -- 100.7% margin lost, i.e. full
    # hard switching of a 1200V IGBT half-bridge, not a tuning shortfall.
    # aluminum/no_pan were unaffected (their K was not raised).
    #
    # 47kHz is the best-evidenced replacement: at ratio~=1.25 over the
    # LOADED resonance (37.56kHz) it delivers ~1804W, holds ZVS (0.8%
    # margin, re-verified 2026-07-27 for ALL FOUR pan presets, not just
    # cast_iron), and clears OCP-01's 50.1A peak trip by 43% (28.76A vs.
    # 48.18A at the old 35kHz/same-L point).
    #
    # WHAT THIS NUMBER IS CONTINGENT ON, RESTATED 2026-07-29
    # (docs/evidence/2026-07-29-tank-coil-specification.md). It used to
    # read "CONTINGENT on L=150uH", with 150uH an assumption and
    # inductor_conn a Resistor placeholder carrying no inductance at all.
    # The coil is now declared -- modules.ato ResonantTank.inductor_conn
    # is an `Inductor`, 88uH +/-10%, and docs/hardware/TANK_COIL_
    # SPECIFICATION.md is a supplier-issuable spec with an acceptance
    # test. 47kHz DID NOT MOVE, and that is the point:
    #
    #   only the LOADED inductance resonates with c_tank_total, and
    #     150uH x 0.399 = 59.850uH -> f_res = 37560.2Hz   (declared until
    #                                                      2026-07-29)
    #      88uH x 0.68  = 59.840uH -> f_res = 37563.3Hz   (declared now)
    #
    # a 0.008% move. The old pair was a geometry-estimated coil times a
    # coupling ratio measured at 90-150kHz; the new pair is one 2kW
    # cooking coil measured by one manufacturer across 15-50kHz, i.e.
    # THIS design's band. The two errors in the old pair cancelled --
    # 1.7x high on the coil, 1.7x low on the coupling -- which is exactly
    # why neither factor may be "corrected" alone. See docs/solutions/
    # design-patterns/resonant-tank-only-loaded-inductance-resonates-
    # 2026-07-28.md.
    #
    # So f_switching is now contingent on L_LOADED ~= 59.8uH rather than
    # on any one coil value, and the incoming acceptance test in the
    # specification doc (L_loaded >= 0.60 x L_unloaded at 40kHz) is what
    # keeps a delivered coil inside that. A coil that passes on unloaded
    # inductance and fails that ratio invalidates this line.
    #
    # LOWER BOUND ON THIS VALUE IS NOW MACHINE-DERIVED (2026-07-29,
    # docs/evidence/2026-07-29-pll-floor-above-resonance.md, corrected the
    # same day by docs/evidence/2026-07-29-pll-floor-cap-tolerance.md to
    # also worst-case the capacitor): f_switching must stay above
    # f_pll_tracking_min, which scripts/check_pll_range_consistency.py
    # derives from l_tank_assumed / l_pan_loaded_ratio / c_tank_total /
    # l_tank_tolerance / c_tank_tolerance below as 1.05 x the WORST-CASE
    # (minimum-L, minimum-C) loaded resonance. Below the loaded resonance
    # the series tank is CAPACITIVE and the bridge hard-switches; 47kHz
    # sits at ratio 1.2512 over the nominal loaded resonance (37563Hz)
    # and at 1.1261 over the -10%-L/-10%-C worst case (41737Hz). Do not
    # lower f_switching without re-running that gate.
    # (Before c_tank_tolerance rose to 0.10 (PR #410, CDE 942C16P1K-F
    # re-source, 2026-07-29), the worst-case figure was 1.1570 / 40624Hz
    # at c_tank_tolerance=0.05 (WIMA FKP 1). Before c_tank_tolerance was
    # declared at all, it was 1.1870 / 39595Hz -- nominal C only. Before
    # the 2026-07-29 coil respecification, all three were
    # 1.2513 / 37560Hz / 39592Hz under the pre-2026-07-29 150uH x 0.399
    # pair -- see the block above for why respecifying the coil moved the
    # nominal figure by 0.008%.)
    f_switching: frequency = 47kHz
    # NOTE (2026-07-28, docs/evidence/2026-07-28-pll-defaults-and-range-
    # gate.md): this 20-100kHz window is an LC-TANK THEORETICAL bound, not
    # the firmware's actual capability -- it overstates what the PLL can
    # deliver by 5x at the top end. See f_pll_tracking_min/max immediately
    # below for the real, firmware-matched range and the gate that
    # cross-checks both.
    assert f_switching within 20kHz to 100kHz  # LC tank theoretical bound (NOT firmware capability)

    # --- PLL frequency tracking range: the firmware's ACTUAL capability ---
    # DECLARED 2026-07-28 (docs/evidence/2026-07-28-pll-defaults-and-range-
    # gate.md, docs/evidence/2026-07-28-pll-ratio-tracking-check.md). This
    # mirrors firmware/components/control/pll_control.h's PLL_MIN_FREQ_HZ /
    # PLL_MAX_FREQ_HZ exactly -- NOT the 20-100kHz "LC tank theoretical
    # bound" above, which the firmware cannot reach.
    # scripts/check_pll_range_consistency.py enforces that these two stay
    # equal and that f_switching falls inside them; it fails the build if
    # this file and pll_control.h ever disagree again.
    #
    # FLOOR RAISED 30kHz -> 42kHz -> 43kHz -> 44kHz. 30->42kHz on
    # 2026-07-29 (docs/evidence/2026-07-29-pll-floor-above-resonance.md);
    # 42->43kHz later the same day (docs/evidence/2026-07-29-pll-floor-cap-
    # tolerance.md, see below); 43->44kHz later still the same day, when
    # PR #410 re-sourced c_tank1/c_tank2 to CDE 942C16P1K-F and added
    # c_tank3, raising c_tank_tolerance 0.05 -> 0.10. The original 30kHz floor sat 7.6kHz BELOW
    # the loaded resonance (37.56kHz at the declared L/ratio/C below;
    # 37.58kHz under the 150uH x 0.399 pair declared until 2026-07-29).
    # This is a SERIES-resonant inverter: above resonance the tank is
    # inductive and the bridge switches at zero voltage; below resonance
    # the tank is CAPACITIVE and the bridge hard-switches -- turn-on loss
    # plus diode reverse recovery on a 1200V IGBT half-bridge at full bus.
    # The old range therefore declared a device-destroying regime legal.
    # Worse, 30kHz delivers ~1783W under this repo's own committed
    # T-model, i.e. essentially the rated 1800W: a power-seeking control
    # loop could settle there and read as nominal while hard-switching.
    #
    # 44kHz IS NOT HAND-PICKED. scripts/check_pll_range_consistency.py
    # DERIVES the required floor from l_tank_assumed, l_pan_loaded_ratio,
    # c_tank_total, l_tank_tolerance AND c_tank_tolerance (all declared
    # below/above) as
    #     1.05 x 1/(2*pi*sqrt(l_tank_assumed*(1-l_tank_tolerance)
    #                         * l_pan_loaded_ratio
    #                         * c_tank_total*(1-c_tank_tolerance)))
    # = 1.05 x 41737Hz = 43824Hz, and FAILS if PLL_MIN_FREQ_HZ is below
    # it. (This is a SECOND worst-casing, added 2026-07-29 alongside the
    # first: f_res ~ 1/sqrt(C) too, so a capacitor at the bottom of its
    # OWN tolerance also raises resonance. At the previously-committed
    # nominal-C derivation the floor was only 41575Hz. c_tank_tolerance
    # was 0.05 -- WIMA FKP 1's ordering-table tolerance letter -- until PR
    # #410 re-sourced c_tank1/c_tank2 to CDE 942C16P1K-F and added c_tank3,
    # at which point the MPN's own tolerance letter (`K`, confirmed +/-10%
    # from BOTH CDE's own 942C.pdf catalog and DigiKey's distributor
    # listing -- see c_tank_tolerance's comment below) raised this to 0.10.
    # 44000Hz is the smallest round kHz value at or above the corrected
    # 43824Hz floor; margin at PLL_MIN_FREQ_HZ = 44000Hz: 176Hz.) The 1.05
    # is the ZVS cliff from docs/hardware/TANK_COIL_SPECIFICATION.md,
    # confirmed a threshold (not a gradient) in docs/evidence/2026-07-27-
    # inductance-range-sweep.md Sec 2.3. The gate keys off the WORST-CASE
    # (minimum) coil inductance AND the WORST-CASE (minimum) tank
    # capacitance, not nominal, because f_res scales as 1/sqrt(L*C): a
    # low-tolerance part on EITHER side raises resonance, so nominal would
    # under-protect exactly the unit that needs protecting most.
    #
    # WHAT THE RAISED FLOOR COSTS: for a series-resonant inverter lower
    # f_sw means MORE power, so the floor caps maximum deliverable power.
    # It does not threaten 1800W -- that point is at 47.1kHz nominal, and
    # the ZVS margin there (1.126x the worst-case loaded resonance,
    # including the capacitor tolerance) is comfortably above the 1.05
    # cliff. The 43-44kHz band newly excluded by this change was already
    # inside the "admits several kW, not the safety-relevant regime"
    # territory the 2026-07-29 evidence doc characterized for 30-42kHz;
    # re-simulating the exact deliverable power at 43-44kHz was not done
    # for this change (T-model re-run is out of scope; see
    # docs/evidence/2026-07-29-pll-floor-cap-tolerance.md) but the
    # direction (a 1kHz-higher floor delivers marginally LESS turndown
    # power, not more, and does not touch the 1800W point) is unaffected.
    #
    # WHAT THIS FLOOR REQUIRES OF A DELIVERED COIL (2026-07-29, corrected
    # same day for the CDE 942C16P1K-F capacitor re-source). Inverting the
    # derivation gives the acceptance criterion, now also worst-casing C,
    # and it is tighter than a ratio screen:
    #     44000Hz / 1.05 = 41904.8Hz  (highest loaded resonance still
    #                                  guarded, worst-case C)
    #     C_worst = 300nF * (1 - 0.10) = 270nF
    #     L_loaded_min = 1/((2*pi*41904.8)^2 * 270nF) = 53.43uH
    # scripts/check_pll_range_consistency.py check 8 computes this value
    # and fails the build if docs/hardware/TANK_COIL_SPECIFICATION.md's
    # written acceptance threshold ever disagrees with it -- the number is
    # emitted by the gate, not hand-copied, so it moves automatically
    # whenever L, C, either tolerance, or PLL_MIN_FREQ_HZ moves. A coil at
    # -10% inductance (79.2uH) whose loaded/unloaded ratio is only 0.60 --
    # both individually inside spec -- gives L_loaded = 47.5uH, resonating
    # at 42.15kHz, i.e. ABOVE this floor: the firmware would again declare
    # a hard-switching regime legal. The gate CANNOT see that, because it
    # applies l_tank_tolerance (and now c_tank_tolerance) to L and C and
    # treats l_pan_loaded_ratio as exact. Incoming inspection carries it
    # instead: docs/hardware/TANK_COIL_SPECIFICATION.md Sec 2 accepts on
    # the gate-derived L_loaded_min measured, not on the ratio.
    #
    # OPEN HARDWARE QUESTION -- NOT RESOLVED BY THIS DECLARATION:
    # docs/evidence/2026-07-27-inductance-range-sweep.md Sec 3 finds that
    # the ratio-tracking ZVS mitigation (retuning f_sw in real time to hold
    # f_sw/f_res_loaded ~= 1.25 as L varies) needs 35.7-83.0kHz agility to
    # hold ZVS across the plausible L in [50, 250]uH range. That sweep
    # cited "every comparable real coil ... (Infineon AN235020, Wurth
    # 760308101303, APHO2025) measures 47-50uH" -- CORRECTED 2026-07-28 by
    # docs/evidence/2026-07-28-coil-selection-research.md Sec 2.4: the
    # Wurth part is a 26mm/1.5A/20W Qi wireless-power receiver coil and
    # APHO2025's bench coil was validated against it, so that "cluster of
    # three independent sources" is ONE comparable coil, measured only at
    # 90-150kHz for a 100-140kHz inverter. At this design's 20-50kHz band
    # the same manufacturer publishes ~88uH unloaded / ~60uH loaded for a
    # 2kW cooking coil -- which lands on the SAME L_loaded ~= 60uH this
    # file assumed via 150uH x 0.399, and which this file now declares
    # directly (88uH x 0.68, 2026-07-29). The capability gap above is
    # therefore weaker evidenced than when written, but it is deliberately
    # NOT declared closed here: the [50, 250]uH agility requirement was
    # computed over "which coil might we get", and specifying one coil
    # narrows that question without answering whether the bridge can
    # track it.
    #
    # Raising PLL_MAX_FREQ_HZ toward 83-100kHz is explicitly NOT done here
    # and must not be done by silently editing a constant: whether the
    # bridge, gate drive and snubber network tolerate that frequency is a
    # switching-loss / hardware question a human must decide, informed by
    # bench data this project does not yet have. Widening the firmware to
    # an unvalidated range just to make f_switching's assertion agree with
    # the mitigation's requirement would recreate the exact failure mode
    # (a declared value later readers trust) this gate exists to prevent.
    # The 2026-07-29 floor change did NOT widen the top of the window to
    # compensate: f_pll_tracking_max is unchanged at 50kHz. One consequence
    # is recorded rather than fixed -- at -10% coil the 1800W point moves
    # to 50.05kHz, i.e. marginally ABOVE the ceiling, so a low-tolerance
    # coil trades full power, not ZVS. That is the correct direction to
    # fail, and widening the ceiling to recover it is a separate decision.
    #
    # THESE ARE LEFT DECLARATIVE ON PURPOSE, AND THE REASON IS MECHANICAL,
    # NOT ELECTRICAL (2026-08-20, .ato-assertion-vacuity paydown review).
    # `f_switching`, `f_pll_tracking_min` and `f_pll_tracking_max` -- and
    # `l_tank_assumed`, `c_tank_total`, `l_pan_loaded_ratio`,
    # `l_tank_tolerance`, `c_tank_tolerance` further down -- are the eight
    # names scripts/check_pll_range_consistency.py REGEX-PARSES out of this
    # file, matched as `<name>: <type> = <number><unit>` and failing closed
    # if any is missing or unparseable (ATO_DECLARATION_NAMES and
    # ATO_PHYSICS_NAMES there). Rewriting any of them as a derived
    # expression makes that gate error out -- and that gate is what
    # cross-checks these three against the firmware's own PLL_MIN_FREQ_HZ /
    # PLL_MAX_FREQ_HZ / PLL_DEFAULT_FREQ_HZ, and the other five against
    # modules.ato's coil and capacitor bank and against the coil acceptance
    # threshold in docs/hardware/TANK_COIL_SPECIFICATION.md. Eight checks,
    # none of which the .ato assertion grammar can express.
    #
    # So these eight ARE tied to the circuit; the coupling lives in Python
    # rather than in an `assert` the vacuity gate can see. Trading eight
    # working cross-file checks for eight in-language ones would be a net
    # loss of coverage. Recorded so the next reader does not "fix" it.
    f_pll_tracking_min: frequency = 44kHz
    f_pll_tracking_max: frequency = 50kHz
    assert f_pll_tracking_min < f_pll_tracking_max
    assert f_switching >= f_pll_tracking_min
    assert f_switching <= f_pll_tracking_max

    # THIS IS THE UNLOADED RESONANCE (L_unloaded with c_tank_total, no pan
    # on the coil). It is NOT the loaded resonance the ZVS ratio must be
    # referenced against -- loaded and unloaded differ by ~1.2x here, and
    # confusing the two already caused a real bug: run_tank_coil_sweep.py
    # referenced its ratio against the UNLOADED resonance and silently
    # reintroduced the under-loading error the moment K was corrected. It
    # needed a self-consistent f_res_loaded_hz() fixed-point solver to fix.
    #
    # 25kHz -> 31kHz, 2026-07-29 (docs/evidence/2026-07-29-tank-coil-
    # specification.md). THIS VALUE IS NOW DERIVED, NOT ASSERTED. It is
    # exactly what l_tank_assumed and c_tank_total below say it is:
    #     1/(2*pi*sqrt(88uH * 300nF)) = 30 975 Hz
    # declared as 31kHz nominal (a 0.08% rounding). Over the coil's
    # +/-10% acceptance tolerance it spans 29.5-32.7kHz, inside the
    # assertion band below.
    #
    # WHY IT WAS 25kHz, AND WHY THAT WAS RIGHT UNTIL NOW. 25kHz at 300nF
    # algebraically implies L=135.1uH -- a THIRD coil inductance, agreeing
    # with neither the simulation harness's 80uH PANLOAD_TRANSFORMER
    # default (32.5kHz unloaded) nor the 150uH behind f_switching (23.7kHz
    # unloaded). The 2026-07-27 pass deliberately refused to change it,
    # reasoning that "doing so would just be inventing the same
    # unspecified L via a different variable" -- correct at the time,
    # because no coil was specified and every candidate value was a guess.
    # That reason is now gone: modules.ato ResonantTank.inductor_conn is a
    # declared 88uH +/-10% Inductor, so the unloaded resonance is
    # arithmetic over two declared quantities rather than a fourth guess.
    # Leaving 25kHz would have made this file assert 88uH in one place and
    # imply 135.1uH in another.
    #
    # NOT GATED. scripts/check_pll_range_consistency.py does not read this
    # line -- it derives the LOADED resonance, which is the safety-bearing
    # one. This mirror can therefore drift if l_tank_assumed or
    # c_tank_total change without it. Recorded as a known gap rather than
    # closed here (evidence doc Sec 7); the honest fix is a seventh check,
    # not a comment.
    #
    # THE ASSERTION ON THIS LINE HAS MOVED AND IS NOW DERIVED (2026-08-20,
    # .ato-assertion-vacuity paydown), which closes the "known gap"
    # recorded three paragraphs up. `assert f_resonant_nominal within
    # 20kHz to 35kHz` compared one hand-typed 31kHz against two hand-typed
    # band edges: no coil and no capacitor on this board could falsify it,
    # which is exactly the drift this comment predicted ("This mirror can
    # therefore drift if l_tank_assumed or c_tank_total change without
    # it"). The honest fix the comment asked for was "a seventh check";
    # what it gets instead is the band asserted on the resonance COMPUTED
    # from tank.inductor_conn.value and the c_tank1/2/3 bank, plus a
    # consistency assertion pinning this declared mirror to that
    # computation. Both live in the tank-derivation block further down --
    # search "UNLOADED RESONANCE, DERIVED FROM THE TANK" -- because they
    # need the `tank` instance, which is declared after this line.
    #
    # The declaration itself STAYS: simulation/harness/run_zvs_sweep.py
    # mirrors it as F_RESONANT_DECLARED_HZ and cites this line, and
    # firmware/components/control/pll_control.c names it in prose.
    # Deleting it would strand both; asserting it against the derived
    # value is what stops it drifting from them.
    f_resonant_nominal: frequency = 31kHz

    # THE COIL'S UNLOADED INDUCTANCE. 150uH -> 88uH, 2026-07-29
    # (docs/evidence/2026-07-29-tank-coil-specification.md). The variable
    # keeps the name `l_tank_assumed` because it is still not a
    # measurement of THIS project's coil -- but it is no longer an
    # assumption pulled from a formula either, and it is no longer
    # invisible: modules.ato ResonantTank.inductor_conn is now a declared
    # `Inductor`, `value = 88uH +/- 10%`, and scripts/check_pll_range_
    # consistency.py check 7 fails the build if that declaration and this
    # one ever disagree. Until 2026-07-29 the coil was `new Resistor` with
    # no value at all, so this line had nothing to be checked against.
    #
    # PROVENANCE OF 88uH: Infineon EVAL-IHW25N140R5L user guide rev 1.0
    # (2023-08-04), Fig. 16, the 2kW cooking coil shipped with that kit --
    # ~87uH flat across 15-50kHz, i.e. MEASURED IN THIS DESIGN'S BAND.
    # It is a CHART READING (+/-5% on the read) of a coil with no
    # published part number, dimensions or current rating; it is the
    # best-evidenced figure this project has found and it is still not a
    # datasheet line item. Full search (Infineon, Wurth, OEM appliance
    # spares, the custom-wind channel): docs/evidence/2026-07-28-coil-
    # selection-research.md Sec 2.
    #
    # WHY 150uH WAS REPLACED, AND WHY IT COST NOTHING. 150uH was a
    # Wheeler/current-sheet geometry estimate cross-checked against coils
    # that turned out not to be comparable -- Wurth 760308101303 is a
    # 26mm/1.5A/20W Qi receiver coil, and Infineon AN235020's 48uH is a
    # 90-150kHz characterization of a 100-140kHz inverter (coil-selection-
    # research Sec 2.4). It was paired with l_pan_loaded_ratio = 0.399,
    # itself solved against that same out-of-band 90-150kHz measurement.
    # Both were wrong by ~1.7x in OPPOSITE directions, so their product --
    # the only quantity that resonates with c_tank_total -- was right:
    #     150uH x 0.399 = 59.850uH   ->  f_res,loaded = 37560.2Hz
    #      88uH x 0.68  = 59.840uH   ->  f_res,loaded = 37563.3Hz
    # This line and l_pan_loaded_ratio below MOVED TOGETHER, as a matched
    # pair, and must always move together. Changing this value alone with
    # the old 0.399 would put the worst-case loaded resonance at 51.7kHz
    # and the derived PLL floor at 54.3kHz -- above PLL_MIN_FREQ_HZ, so
    # the gate WOULD catch it (that is the hazardous direction). Changing
    # the ratio alone would drop f_res to 28.8kHz, which the gate CANNOT
    # catch because it fails toward more ZVS margin and less power. Read
    # docs/solutions/design-patterns/resonant-tank-only-loaded-inductance-
    # resonates-2026-07-28.md before touching either.
    #
    # THE ASSERTION BAND IS UNCHANGED AND STILL MEANS "WHICH COIL MIGHT WE
    # END UP WITH", not "how much does one coil vary" -- that second
    # question is l_tank_tolerance below. docs/evidence/2026-07-27-
    # inductance-range-sweep.md's finding that ZVS is lost below ~97uH
    # inside this band is NOT a reason to distrust 88uH: that threshold
    # was computed by applying the 90-150kHz coupling ratio (0.40) to a
    # 47kHz design, and dissolves once the in-band ratio is used (coil-
    # selection-research Sec 4.4). At 88uH x 0.68 the tank sits at ratio
    # 1.25, comfortably ZVS-holding.
    l_tank_assumed: inductance = 88uH
    assert l_tank_assumed within 50uH to 250uH  # coil-class band, NOT a part tolerance -- see l_tank_tolerance below

    # --- Inputs to the DERIVED PLL floor (2026-07-29, docs/evidence/
    # 2026-07-29-pll-floor-above-resonance.md) ---
    # These three make the loaded resonance computable from THIS file.
    # Before they existed, f_res lived only in simulation-harness constants
    # and evidence prose, so f_pll_tracking_min / PLL_MIN_FREQ_HZ could be
    # (and were) set 7.6kHz below it with nothing able to notice.
    # scripts/check_pll_range_consistency.py reads all three plus
    # l_tank_assumed above and fails closed if any is missing, unparseable,
    # or outside its sanity band -- it never skips.

    # Total series tank capacitance. MIRRORS modules.ato's c_tank1.value +
    # c_tank2.value (150nF + 150nF in parallel) and the gate CROSS-CHECKS
    # it against those two declarations, so this mirror cannot drift into
    # the same class of untethered restatement that produced the +340V_BUS
    # and 20-100kHz defects. UNCHANGED VALUE -- the 300nF commitment is
    # under separate review (docs/evidence/2026-07-28-coil-selection-
    # research.md Sec 5.2 proposes 470nF); this only makes it visible here.
    c_tank_total: capacitance = 300nF
    assert c_tank_total within 150nF to 600nF  # tank-design band, not a part tolerance

    # Loaded/unloaded coil-inductance ratio with a ferromagnetic pan --
    # the ONLY way pan coupling enters the resonance. L_loaded =
    # l_tank_assumed * this, and L_loaded is what resonates with
    # c_tank_total.
    #
    # 0.399 -> 0.68, 2026-07-29 (docs/evidence/2026-07-29-tank-coil-
    # specification.md), AS A MATCHED PAIR WITH l_tank_assumed ABOVE.
    # Neither may be changed without the other; the arithmetic and the
    # failure modes are spelled out in that block.
    #
    # PROVENANCE OF 0.68: the SAME chart as the 88uH -- Infineon EVAL-
    # IHW25N140R5L Fig. 16, which plots the 2kW cooking coil with and
    # without a vessel over 0-50kHz. At 40kHz: ~60uH loaded against ~88uH
    # unloaded = 0.68 (0.71 at 30kHz, 0.66 at 50kHz). Implied coupling
    # k = sqrt(1-0.68) = 0.57.
    #
    # WHAT 0.399 WAS, AND WHY IT WAS THE WRONG NUMBER FOR THIS BAND. It
    # was the fixed point of simulation/harness/run_tank_coil_sweep.py's
    # f_res_loaded_hz() T-model relation
    #   L_app/L1 = 1 - K^2*x^2/(RPAN^2+x^2),  x = omega*L2
    # at run_zvs_sweep.py's cast_iron/stainless preset (K=0.79, RPAN=10,
    # L2=218uH). That preset was solved to reproduce Infineon AN235020's
    # measured 0.40 loaded/unloaded ratio -- measured at 90-150kHz, on a
    # different coil, for a 100-140kHz inverter. Applied at 47kHz it
    # overstates coupling by ~1.7x (coil-selection-research Sec 4.4).
    # 0.68 is the same manufacturer's number for a comparable 2kW coil at
    # this design's own frequency, so it replaces an extrapolation with an
    # in-band reading.
    #
    # CONSEQUENCE, RECORDED NOT FIXED: simulation/harness/run_zvs_sweep.py
    # still runs PAN_PRESETS at K=0.79, so this file and that harness now
    # describe pan coupling differently. That divergence is REAL and is
    # the correct direction -- the harness preset is the one anchored to
    # out-of-band data (coil-selection-research Sec 7.2 names re-solving
    # it as required work) -- but re-solving K and re-running the ZVS/OCP
    # sweeps would restate every committed ZVS number in this file, and
    # doing that on the back of a chart reading is a bigger claim than
    # this change is entitled to make. It is out of scope here and named
    # in the evidence doc Sec 7 instead of being done quietly.
    #
    # WEAK L-DEPENDENCE, unchanged in character: the old ratio moved
    # +-0.6% over +-10% L (0.3963 to 0.4009), propagating -+0.3% into
    # f_res -- an order of magnitude inside the 1.05 ZVS margin the
    # derived floor carries. Infineon's chart gives 0.66-0.71 over
    # 30-50kHz, a comparable spread. Declaring the ratio rather than
    # (K, RPAN, L2) keeps ONE mirrored quantity instead of three.
    l_pan_loaded_ratio: dimensionless = 0.68
    assert l_pan_loaded_ratio within 0.2 to 0.8  # ferromagnetic-pan coupling band

    # Coil inductance tolerance used ONLY to pick the worst case for the
    # PLL floor. f_res scales as 1/sqrt(L), so MINIMUM L is the hazardous
    # end (highest resonance, so the floor must be highest) -- the gate
    # derives against l_tank_assumed*(1-this), never against nominal.
    # +-10% is the acceptance tolerance docs/evidence/2026-07-28-coil-
    # selection-research.md Sec 5.1 recommends specifying the coil to, and
    # since 2026-07-29 it is the tolerance actually specified: modules.ato
    # declares `inductor_conn.value = 88uH +/- 10%` and docs/hardware/
    # TANK_COIL_SPECIFICATION.md issues it to a supplier. It
    # is NOT the [50,250]uH assumption band asserted above: that band is
    # "which coil might we end up with", this is "how much does one
    # specified coil vary". Both matter; only this one belongs in a
    # unit-to-unit safety guard.
    l_tank_tolerance: dimensionless = 0.10
    assert l_tank_tolerance within 0.05 to 0.30  # a plausible part tolerance, never 0

    # Tank capacitance tolerance used ONLY to pick the worst case for the
    # PLL floor, same reasoning as l_tank_tolerance above but on the OTHER
    # factor in f_res = 1/(2*pi*sqrt(L*C)): a low-tolerance capacitor ALSO
    # raises resonance (f_res ~ 1/sqrt(C) too), so the gate must derive
    # against c_tank_total*(1-this), never against nominal, for the same
    # reason it already does that for L. Added 2026-07-29 (docs/evidence/
    # 2026-07-29-pll-floor-cap-tolerance.md): until this change the gate
    # worst-cased L but took C at nominal, so a capacitor at the bottom of
    # its tolerance band raised f_res without the floor moving to cover it.
    #
    # VALUE: 0.10 (+/-10%), decoded from the MPN actually on c_tank1/c_tank2/
    # c_tank3 (elec/src/modules.ato) since PR #410 (re-source WIMA FKP 1
    # -> 3x CDE 942C16P1K-F, 2026-07-29): `942C16P1K-F`. Confirmed from TWO
    # independent primary sources, not pattern-matched off the trailing
    # `K`:
    #   (1) CDE's own catalog (942C.pdf, cde.com/resources/catalogs/
    #       942C.pdf) p.1 Specifications table states outright:
    #       "Capacitance Tolerance: +/-10% (K) Standard; +/-5% (J) Optional".
    #       p.2's "Part Numbering System" diagram maps the 6-character
    #       ordering-key field explicitly: `K = +/-10%`, `J = +/-5%` --
    #       and the field the `K` in `942C16P1K-F` occupies IS that
    #       tolerance field per the diagram's own annotated example
    #       (942-C-6-P-22-K--F).
    #   (2) DigiKey's distributor listing for this exact part (product
    #       1929475) independently states "Tolerance: +/-10%".
    # Both agree, so this is not a single-source read. (Was 0.05 for the
    # WIMA FKP 1 part this replaces -- see git history for that decode.)
    #
    # This regressed the ZVS floor UP when it changed (2026-07-29,
    # docs/evidence/2026-07-29-pll-floor-cap-tolerance.md follow-up):
    # PLL_MIN_FREQ_HZ had to be re-raised 43000 -> 44000 in the same change
    # that raised this value, per scripts/check_pll_range_consistency.py's
    # re-derivation -- see that file's history and firmware/components/
    # control/pll_control.h for the corrected arithmetic.
    c_tank_tolerance: dimensionless = 0.10
    assert c_tank_tolerance within 0.01 to 0.30  # a plausible part tolerance, never 0

    t_ambient_max: temperature = 323.15K  # 50°C
    t_ambient_min: temperature = 273.15K  # 0°C
    assert t_ambient_max within 313.15K to 333.15K  # 40°C to 60°C
    
    eta_min: dimensionless = 0.90
    assert eta_min >= 0.85  # Minimum efficiency target

    # ==========================================================================
    # 1800 W IS A UNITS ERROR, AND THIS IS WHERE IT LIVED  (2026-08-20)
    # ==========================================================================
    # This read `p_output_max: power = 1800W` followed by
    # `assert p_output_max within 1500W to 1800W  # 15A circuit limit`:
    # a declared value pinned to the unreachable end of the band its own
    # assertion pretends to constrain it inside. It passed, permanently.
    #
    # The comment on that assertion names the real quantity. 1800 is the
    # VOLT-AMPERE capacity of a 15 A / 120 V branch circuit -- it is a
    # rated INPUT figure, which is how the whole commercial 120 V induction
    # segment quotes it (docs/evidence/2026-08-19-commercial-120v-1800w-
    # architecture.md, branch analysis/commercial-1800w-architecture). It
    # was written here as an OUTPUT power.
    #
    #     P_out = V * I * PF * eta
    #
    # so 1800 W OUT of an 1800 VA branch requires PF x eta = 1.000: unity
    # power factor AND lossless conversion, simultaneously. This design is
    # a capacitor-input voltage doubler with no PFC; docs/evidence/
    # 2026-08-19-input-stage-power-ceiling.md (branch analysis/input-stage-
    # power-ceiling, fe9cf6752) simulates it at PF 0.60-0.76 and this file
    # declares eta_min = 0.90 immediately below. Even at PERFECT power
    # factor the ceiling is 1530 W (eta 0.85) to 1656 W (eta 0.92).
    #
    # So p_output_max is now DERIVED from the branch it runs on rather than
    # typed, and it keeps the same name and the same assertion band because
    # the band is the design intent and the design intent is what fails.
    # NOTHING READS THIS FIELD -- it has no consumer in the firmware, the
    # placer, or any gate -- so the only thing it has ever done is pass its
    # own assertion. It now fails it, which is the first useful thing it
    # has done.
    #
    # THIS ASSERTION IS EXPECTED TO FAIL, at 1015 W against a 1500 W floor.
    # The floor is not lowered: 1500 W is a product decision, and the
    # finding is that this architecture cannot meet it on this branch
    # circuit. The fix space is PFC, a 240 V/20 A supply, or a lower rated
    # output -- all of them decisions, none of them an edit to this line.
    pf_input: dimensionless = 0.6265   # P/(V*I) at the central bracket case
    p_branch_va: power = ac_constraints.i_max * ac_constraints.v_ac_nominal
    p_output_max: power = p_branch_va * pf_input * eta_min
    assert p_output_max within 1500W to 1800W  # 15A circuit limit

    p_standby_max: power = 1W
    assert p_standby_max < 5W  # Energy Star standby
    
    
    # --- Power Rails ---
    signal gnd          # SELV control-domain ground. Floated from
    # power_return (the HV domain's internal reference) and DC-bonded to
    # protective earth instead -- see the GROUND ARCHITECTURE block below
    # and docs/hardware/SELV_ISOLATION_REDESIGN.md.
    # The shared ground is named by the generated netlist; assigning an
    # override here conflicts with nested ElectricPower reference nets.
    signal pe            # Protective earth, from the external AC connector
    signal dc_bus_plus  # +170V half-bus (positive rail of the Delon/cascade
    # voltage doubler in PowerInput), referenced to power_return -- the
    # doubler MIDPOINT -- not to dc_bus_minus. dc_bus_plus - dc_bus_minus
    # spans the full 340V bus; this node ALONE is +170V nominal, not 340V.
    # This net used to be named "+340V_BUS" with a "+340V" comment here;
    # that was wrong (dc_bus_plus cannot reach 340V) and had already caused
    # OVP-01's reference divider to be tuned for a voltage this node can
    # never reach in at least one revision of this design -- see
    # OVPComparator's docstring and docs/hardware/SELV_ISOLATION_REDESIGN.md.
    dc_bus_plus.override_net_name = "+170V_BUS"
    signal dc_bus_minus # Ground reference for DC bus
    dc_bus_minus.override_net_name = "DC_BUS_RTN"
    signal vcc_15v      # Gate driver supply
    vcc_15v.override_net_name = "+15V"
    signal vcc_3v3      # MCU supply
    vcc_3v3.override_net_name = "+3V3"
    signal power_return  # High-current tank/power return path (doubler midpoint)
    power_return.override_net_name = "PWR_RTN"
    signal vcc_15v_ls    # Isolated low-side gate driver supply (plan 005)
    vcc_15v_ls.override_net_name = "+15V_LS"
    signal usb_dn        # USB D-
    signal usb_dp        # USB D+
    signal i2c_sda_ui    # I2C expansion header for UI
    signal i2c_scl_ui
    
    # --- Module Instances ---
    
    # Power input (AC -> DC)
    power_in = new PowerInput

    # Active bus discharge (fail-safe, relay NC contacts; plan 2026-07-16-001)
    discharge = new BusDischarge

    # Power management (DC_BUS -> 15V -> 3.3V)
    power_mgmt = new PowerManagement
    
    # Auxiliary supply (HV -> isolated 15V SELV)
    aux_supply = new AuxSupply
    
    # Half-bridge (power stage)
    hb = new HalfBridge
    
    # Resonant tank (LC network + coil)
    tank = new ResonantTank
    
    # Current sensing (CT on DC bus)
    ct_sense = new CurrentSensing
    
    # Temperature sensing (RTD for pan/heatsink)
    rtd_pan = new RTDSensing
    
    # Safety interlock
    safety = new SafetyInterlock
    
    # Microcontroller
    mcu = new MCU

    # Forced-air cooling (fan power circuit; heatsink/TIM are chassis BOM)
    thermal = new ThermalSystem
    
    # ===========================================================================
    # TANK PEAK CURRENT, DERIVED FROM THE TANK  (2026-08-20)
    # ===========================================================================
    # Everything downstream of here that used to compare a rating against
    # the DECLARED 25A peak now compares it against the peak this L and
    # this C actually produce at this bus voltage and this switching
    # frequency. First-harmonic (FHA) solve of the series-resonant tank:
    #
    #   V1_peak = (2/pi) * V_bus            half-bridge fundamental
    #   X_L     = 2*pi*f_sw * L_unloaded * l_pan_loaded_ratio
    #   X_C     = 1 / (2*pi*f_sw * C_tank)
    #   I_peak  = V1_peak / sqrt(R_eq^2 + (X_L - X_C)^2)
    #
    # WHY THE SQUARES. The .ato assertion grammar has no sqrt, so the
    # magnitude of a complex impedance cannot be written directly. It is
    # written as I_peak^2 instead, and every assertion that consumes it is
    # squared on both sides. Squaring is monotone on non-negative
    # quantities, so `a <= b` and `a^2 <= b^2` are the same statement here;
    # the units are A^2 on both sides and the checker verifies that.
    #
    # THIS IS CROSS-CHECKED AGAINST TWO COMMITTED, INDEPENDENTLY-PRODUCED
    # NUMBERS, which is the only reason a hand-written FHA solve is
    # allowed to carry a safety assertion:
    #   * I_peak nominal comes out 29.96A, inside the 28.7-31.9A band
    #     modules.ato ResonantTank records from this repo's own ngspice
    #     harness and the coil-selection first-harmonic solve.
    #   * The implied tank-capacitor peak, I_peak * X_C = 338V, matches the
    #     "234 Vrms / 331 V peak" that ResonantTank's capacitor block
    #     records from a separate calculation.
    #
    # r_tank_eq is the ONE input here that is not read from a component.
    # It is the pan's reflected resistance plus the coil's AC resistance:
    # 3.04ohm reflected (from simulation/harness/run_zvs_sweep.py's
    # cast_iron/stainless preset, K=0.6136, RPAN=10ohm, L2=97.13uH,
    # evaluated at 47kHz) + 0.34ohm coil AC resistance at 40kHz (the figure
    # ResonantTank's inductor block already carries). It is a load
    # property, not a component this board can change, so no component
    # value can or should determine it.
    two_pi: dimensionless = 6.28318531
    r_tank_eq: resistance = 3.38ohm
    v_hb_fund_peak: voltage = v_bus_nominal * 0.63661977   # 2/pi
    c_tank_bank: capacitance = tank.c_tank1.value + tank.c_tank2.value + tank.c_tank3.value
    x_tank_l: resistance = two_pi * f_switching * tank.inductor_conn.value * l_pan_loaded_ratio
    x_tank_c: resistance = 1 / (two_pi * f_switching * c_tank_bank)
    x_tank_net: resistance = x_tank_l - x_tank_c
    z_tank_sq = r_tank_eq * r_tank_eq + x_tank_net * x_tank_net
    i_tank_peak_sq = v_hb_fund_peak * v_hb_fund_peak / z_tank_sq

    # --- UNLOADED RESONANCE, DERIVED FROM THE TANK ---
    # The check that moved here from `f_resonant_nominal` at the top of
    # this file, where it read `assert f_resonant_nominal within 20kHz to
    # 35kHz` -- 31kHz against two literals, with the coil and the
    # capacitor bank appearing nowhere in it.
    #
    #   f_res^2 = 1 / ((2*pi)^2 * L * C)
    #
    # squared for the same reason i_tank_peak_sq is (no sqrt in the
    # grammar), and the band edges squared with it. This is the UNLOADED
    # resonance -- L with no pan on the coil -- which is what the 20-35kHz
    # band has always meant; the LOADED resonance is a different quantity
    # and scripts/check_pll_range_consistency.py owns it.
    #
    # 30 975 Hz nominal, 29.5-32.7 kHz over the coil's declared +/-10%,
    # inside the band at both ends. Note what sets that interval: the
    # three tank capacitors are declared with NO tolerance at all
    # (`c_tank1.value = 100nF`), so the whole spread here is the coil's.
    # ResonantTank's own comment states the CDE 942C parts are K = +/-10%
    # and calls that a "TOLERANCE REGRESSION, DELIBERATELY NOT PAPERED
    # OVER" -- but the +/-10% is not in the declaration, so nothing in
    # this file can see it. REPORTED, NOT CHANGED HERE: adding it widens
    # this interval to 28.2-34.4 kHz and widens every other tank-derived
    # interval in this block with it.
    f_res_band_lo: frequency = 20kHz
    f_res_band_hi: frequency = 35kHz
    f_res_unloaded_sq = 1 / (two_pi * two_pi * tank.inductor_conn.value * c_tank_bank)
    # Written as two comparisons rather than one `within`: atopile's
    # `within <lo> to <hi>` takes NUMERIC LITERALS for its bounds, not
    # expressions, so a derived band has to be spelled out. (Confirmed by
    # `ato build`, not assumed -- the first draft of this line used
    # `within` and failed to parse.)
    assert f_res_unloaded_sq >= f_res_band_lo * f_res_band_lo
    assert f_res_unloaded_sq <= f_res_band_hi * f_res_band_hi

    # And the declared mirror must agree with what the parts actually do.
    # This is the "seventh check" the f_resonant_nominal comment at the top
    # of this file asked for, written in-language instead of in Python.
    #
    # IT IS DELIBERATELY NOT WRITTEN AGAINST f_res_unloaded_sq ABOVE, and
    # the reason is worth recording because the first draft got it wrong.
    # f_res_unloaded_sq carries the coil's +/-10%, so comparing a single
    # declared point against it -- even with a generous +/-10% window --
    # is undecidable by construction: `961e6 <= [959.5e6, 1171e6]` holds
    # at most of the interval and not all of it, and atopile (correctly)
    # calls that FAILED. Widening the window until it passed would have
    # been tuning a bound to keep a check green, which is exactly the move
    # this paydown exists to undo.
    #
    # So the mirror is checked against a TOLERANCE-FREE derivation:
    # l_tank_assumed (an exact declared 88uH) with c_tank_bank (the three
    # capacitors' declared values, exact, and CIRCUIT-coupled -- re-source
    # any of them and this moves). That gives an exact 959.46e6 Hz^2
    # against the declared 31kHz's 961e6, a 0.16% gap that is purely the
    # rounding of 30975Hz to 31kHz. The +/-2% window is 12x that rounding
    # and still has teeth for the drift it exists to catch: the historical
    # 25kHz declaration against this same tank is 625e6 Hz^2, off by -35%.
    #
    # The coil side of the mirror is not re-checked here because
    # scripts/check_pll_range_consistency.py check 7 already pins
    # l_tank_assumed to modules.ato's inductor_conn.value, and check 6
    # pins c_tank_total to this same capacitor bank.
    f_res_mirror_sq = 1 / (two_pi * two_pi * l_tank_assumed * c_tank_bank)
    assert f_resonant_nominal * f_resonant_nominal >= f_res_mirror_sq * 0.98
    assert f_resonant_nominal * f_resonant_nominal <= f_res_mirror_sq * 1.02

    # THE CHECK THAT MOVED HERE FROM THE TOP OF THIS FILE, where it read
    # `assert i_peak_max <= constraints.i_max` -- 25A <= 25A, a tie between
    # two hand-typed 25s. EXPECTED NOT TO PASS CLEANLY: the nominal derived
    # peak is 29.96A against a 25A HV-domain limit, and over the coil's
    # declared +/-10% the peak spans 24.5-37.8A. This is the conflict
    # modules.ato ResonantTank has carried in prose since 2026-07-29;
    # asserting it is what makes the toolchain see it. The bound is NOT
    # raised to 32A to make it green -- constraints.i_max is also what the
    # HV net class, its trace widths and LitzPad_15A's pad rating are sized
    # against, and moving it is a copper/thermal decision, not an edit.
    assert i_tank_peak_sq <= constraints.i_max * constraints.i_max

    # ===========================================================================
    # SAFETY ASSERTIONS
    # These must pass at compile-time to ensure design safety margins
    # ===========================================================================

    # IGBT Voltage Margin (>= 1.5x operating voltage)
    #
    # THE VOLTAGE-RATING FAMILY IN THIS SECTION IS LEFT DECLARATIVE ON
    # PURPOSE (2026-08-20, .ato-assertion-vacuity paydown review): these
    # two, the bootstrap diode below, the two bus-cap checks and the two
    # rectifier-diode checks all measure a node whose voltage is set by
    # TOPOLOGY, not by any value on this board. The switch node is clamped
    # between the rails by the IGBTs' antiparallel diodes; the two doubler
    # halves are each clamped to the line peak by d1 and d2; the bootstrap
    # diode's reverse stress is the full bus by construction. Change any
    # capacitor, resistor or inductor in this design and not one of those
    # numbers moves. The one voltage stress here that IS value-dependent
    # -- the tank capacitor's -- is derived, twice, and asserted below.
    #
    # The remaining exposure is turn-off overshoot from power-loop stray
    # inductance, which is a LAYOUT quantity (docs/evidence has the
    # measured loop areas) and is not expressible from component values
    # either. Recorded, not derived.
    assert hb.power_loop.q_high.voltage_rating >= v_bus_max * 1.5
    assert hb.power_loop.q_low.voltage_rating >= v_bus_max * 1.5

    # IGBT Current Margin (>= 1.5x peak current).
    # Squared form of `q.current_rating >= i_tank_peak * 1.5`; see the
    # WHY THE SQUARES note above. Was `>= i_peak_max * 1.5` against the
    # declared 25A, i.e. 40A >= 37.5A -- true, and un-falsifiable by any
    # change to the tank. At the derived peak the requirement is
    # 29.96 * 1.5 = 44.9A against IKW40N120H3's 40A rating. EXPECTED TO
    # FAIL. Note the basis question this surfaces but does not settle:
    # 40A is I_C continuous at 100C, and comparing a PEAK against a
    # continuous rating may itself be the wrong comparison -- the same
    # basis error already fixed once for i_ocp_trip below. That is the
    # power-stage owner's call; this change only stops the check from
    # measuring a number nobody could move.
    assert hb.power_loop.q_high.current_rating * hb.power_loop.q_high.current_rating >= i_tank_peak_sq * 1.5 * 1.5
    assert hb.power_loop.q_low.current_rating * hb.power_loop.q_low.current_rating >= i_tank_peak_sq * 1.5 * 1.5

    # Bootstrap Diode Rating (must withstand full bus voltage)
    assert hb.gate_hs.boot_diode.voltage_rating >= v_bus_max
    
    # Resonant Tank Capacitor Voltage (>= 2x bus for resonant overshoot)
    # Using 1000V minimum per design decision.
    # These two stay as a flat design floor and are LEFT DECLARATIVE on
    # purpose: 1000V is a procurement rule ("no tank cap below 1000V goes
    # on this board"), not a derived stress, and it is stricter than any
    # stress this tank produces. Replacing it with a derived bound would
    # LOWER it, which is the one thing a vacuity paydown must not do.
    assert tank.c_tank1.voltage_rating >= 1000V
    assert tank.c_tank2.voltage_rating >= 1000V

    # The derived stress is checked separately, and it is checked here
    # rather than in ResonantTank because the tank's operating frequency
    # lives in this file (see the FHA block above; mirroring f_switching
    # into modules.ato without a cross-checking gate is exactly the drift
    # this repo has been bitten by before).
    #   V_C_peak = I_peak * X_C, squared for the same reason I_peak is.
    # Nominal 338V, matching the "234 Vrms / 331 V peak" that ResonantTank's
    # own capacitor block records from a separate calculation. Against the
    # 1600V CDE 942C16P1K-F parts with ResonantTank's 1.43 derating this
    # passes with 3.3x margin -- and unlike the 1000V floor above it now
    # MOVES: shrink the bank and both the current and the reactance rise.
    #
    # c_tank2 AND c_tank3 ADDED 2026-08-20: this block checked only
    # c_tank1, so two of the three parallel capacitors -- which see
    # exactly the same node voltage -- had no operating-point stress
    # check at all here. They are not redundant with ResonantTank's own
    # three derived checks: those are an sqrt(L/C) envelope at the coil's
    # declared 25 A rms ceiling, this is the stress at THIS file's
    # operating frequency and derived tank current. The two bases differ
    # and both should hold.
    v_tank_cap_peak_sq = i_tank_peak_sq * x_tank_c * x_tank_c
    assert tank.c_tank1.voltage_rating * tank.c_tank1.voltage_rating >= v_tank_cap_peak_sq * 1.43 * 1.43
    assert tank.c_tank2.voltage_rating * tank.c_tank2.voltage_rating >= v_tank_cap_peak_sq * 1.43 * 1.43
    assert tank.c_tank3.voltage_rating * tank.c_tank3.voltage_rating >= v_tank_cap_peak_sq * 1.43 * 1.43
    
    # Bus capacitor voltage rating
    assert power_in.c_bus1.voltage_rating >= v_bus_max * 0.7
    assert power_in.c_bus2.voltage_rating >= v_bus_max * 0.7
    
    # Rectifier diode rating
    assert power_in.d1.voltage_rating >= v_bus_max * 1.5
    assert power_in.d2.voltage_rating >= v_bus_max * 1.5
    
    # Design bus voltage limit
    assert v_bus_max <= 400V
    
    # ===========================================================================
    # SAFETY INTERLOCK ASSERTIONS (temper-ip1.6)
    # Verify protection trips BEFORE component limits
    # Critical for IEC 60335-1 compliance
    # ===========================================================================
    
    # OCP must trip before IGBT SOA limit.
    # IGBT rated 40A continuous, SOA allows 60A pulsed.
    #
    # OCP-01 is specified as a PEAK threshold (FUNCTIONAL_TEST_CRITERIA §2.1
    # gives "50A Peak"), and there is no rectifier in the sense path, so the
    # comparator trips on instantaneous tank current. Both quantities are
    # carried here because the two limits they must clear are in different
    # bases: the SOA pulsed limit is a peak rating, the 40A device rating is
    # continuous.
    #
    # The previous form asserted a 37.6A trip against BOTH limits. That value
    # was stale after the burden was corrected to 4.99R, and comparing a peak
    # trip against a continuous rating was the wrong comparison regardless --
    # at the true 50.1A peak it would fail 50.1 < 40 while the design is
    # actually sound, because 50.1A peak is 35.4A RMS.
    # DERIVED FROM THE PROTECTION CHAIN'S OWN RESISTORS, NOT DECLARED
    # (2026-08-20, .ato-assertion-vacuity paydown). These two lines used to
    # be the literals 50.1A and 35.4A with the arithmetic in a trailing
    # comment -- "2.500V / 4.99R * 100" -- which is exactly the shape that
    # went stale once before: the comment three paragraphs up records that
    # the previous 37.6A figure "was stale after the burden was corrected
    # to 4.99R". A trip threshold written as a literal goes stale silently
    # the next time anyone re-sources r_burden or the reference divider.
    #
    # The chain, read from the parts that implement it:
    #   comparator reference = 3.3V * r_ref_bot/(r_ref_top + r_ref_bot)
    #                          (safety.ocp, TLV3201 INN divider)
    #   trip primary current = reference / r_burden * CT turns ratio
    #                          (ct_sense, Coilcraft CST3015-100ED, 1:100)
    # 3.3V stays a literal for the same reason OVPComparator's assertion
    # gives: the rail is an ElectricPower net with no component field to
    # read a magnitude from.
    #
    # Nominal comes out 49.95A, which is the figure OCPComparator's own
    # docstring reports for this resistor set; over +/-1% on all three
    # resistors the derived interval is 49.2-50.7A, inside the 48.77-51.16A
    # the docstring quotes with tempco folded in as well. Both stay inside
    # the OCP-01 45-55A window.
    v_ocp_ref: voltage = 3.3V * (safety.ocp.r_ref_bot.value / (safety.ocp.r_ref_top.value + safety.ocp.r_ref_bot.value))
    i_ocp_trip_peak: current = v_ocp_ref / ct_sense.r_burden.value * ct_sense.ct.turns_ratio
    i_ocp_trip_rms: current = i_ocp_trip_peak * 0.70710678   # peak / sqrt(2), sinusoidal tank
    i_igbt_soa_limit: current = 60A

    # Peak trip must clear the pulsed SOA limit.
    assert i_ocp_trip_peak < i_igbt_soa_limit
    # RMS-equivalent trip must clear the continuous device rating.
    assert i_ocp_trip_rms < hb.power_loop.q_high.current_rating
    
    # OVP must trip before bus capacitor ratings exceeded, and above the
    # normal operating bus so it does not nuisance-trip.
    # Bus caps rated 250V each, in series = 500V total.
    #
    # DERIVED FROM THE OVP COMPARATOR'S OWN DIVIDER, NOT DECLARED
    # (2026-08-20, .ato-assertion-vacuity paydown). These two lines used
    # to read against `v_ovp_trip: voltage = 390V`, a hand-typed number
    # with the comment "OVP trips at 390V" above it. Nothing on this
    # board could move it: re-sourcing r_div_bot, dropping one of the
    # three top resistors, or changing r_hyst would all move the real
    # trip point and leave both assertions comparing an unchanged 390 to
    # an unchanged 500 and 340. Same defect, same shape, and the same
    # fix as the OCP chain immediately above.
    #
    # THE 390 WAS ALSO WRONG, WHICH IS THE POINT. OVPComparator's own
    # comment block already carries the closed form and the arithmetic:
    #     N       = 1 + Rtop/r_div_bot     = 1 + 1290k/16.9k = 77.331
    #     V_trip  = Vref * (N + Rtop/r_hyst)
    #             = 2.5 * (77.331 + 1290k/487k) = 199.95 V
    # on the SENSED node, which is the upper half-bus. That is 399.9 V
    # on the same series-cap basis `v_cap_max` and `v_bus_max` are
    # written on -- 10 V above the 390 that was declared here, and the
    # declaration was never checked against it.
    #
    # 2.5V stays a literal for the reason OVPComparator's own assertion
    # gives: it is REF2025's fixed VREF output, an ElectricSignal net
    # with no component field to read a magnitude from. The three top
    # resistors are summed rather than written as 1290k for the same
    # reason the ADC divider below them is: losing one of the three is a
    # single-fault case this check must be able to see.
    #
    # THE x2 IS AN ASSUMPTION AND IT IS STATED, NOT HIDDEN. The
    # comparator senses dc_bus_plus against gnd, i.e. the UPPER half-bus
    # only (safety.dc_bus.line ~ dc_bus_plus in the connections below).
    # Doubling to a full-bus figure is exact only while the midpoint is
    # balanced, which the doubler's two clamping diodes and the matched
    # 22k bleeders enforce in normal operation. RECORDED, NOT FIXED: a
    # midpoint imbalance overvolts ONE bus capacitor while the total
    # stays inside v_cap_max, and no OVP on this board can see that --
    # there is no lower-half sense at all. That is a protection-coverage
    # gap for the safety owner, not a bound to be adjusted here.
    #
    # Over the declared tolerances (+/-1% on the three top resistors,
    # +/-0.1% on r_div_bot and r_hyst) the derived trip spans
    # 395.6-404.3 V full-bus. Both assertions hold across that whole
    # interval: 404.3 < 500, and 395.6 > 340.
    v_ovp_ref: voltage = 2.5V
    r_ovp_div_top: resistance = safety.ovp.r_div_top1.value + safety.ovp.r_div_top2.value + safety.ovp.r_div_top3.value
    v_ovp_trip_half: voltage = v_ovp_ref * (1 + r_ovp_div_top / safety.ovp.r_div_bot.value + r_ovp_div_top / safety.ovp.r_hyst.value)
    v_ovp_trip: voltage = v_ovp_trip_half * 2
    v_cap_max: voltage = 500V  # Series combination
    assert v_ovp_trip < v_cap_max
    assert v_ovp_trip > v_bus_max  # But after normal operation
    
    # Thermal protection must trip before component limits
    # IGBT max junction: 150°C, derate at 125°C
    # Thermal comparator set for 85°C ambient
    #
    # LEFT DECLARATIVE, AND THE REASON IS THE GRAMMAR (2026-08-20,
    # .ato-assertion-vacuity paydown review). The trip temperature IS set
    # by circuit values -- ThermalComparator's ntc / r_ntc_fixed divider
    # against its comparator reference -- but recovering a TEMPERATURE
    # from a resistance ratio requires the Beta or Steinhart-Hart
    # relation, i.e. a logarithm. The .ato assertion grammar has +, -, *
    # and / and nothing else; it has no sqrt (which is why the tank
    # quantities in this file are all written squared) and a fortiori no
    # ln. There is no squaring trick for this one: a monotone rewrite
    # would have to move the log to the other side, and the other side is
    # a temperature constant in kelvin.
    t_thermal_trip: temperature = 358.15K
    assert t_thermal_trip < thermal_constraints.igbt_derate_temp
    
    # Watchdog timeout must allow system response but catch stuck states
    # 1.6s timeout per TPS3823-33
    t_wdt_timeout: time = 1.6s
    t_fault_response_max: time = 0.1s  # System should respond in <100ms
    assert t_wdt_timeout > t_fault_response_max * 10  # Margin for normal operation
    
    # ===========================================================================
    # TIMING BUDGET CONSTRAINTS (temper-ip1.4)
    # System-level timing verification
    # ===========================================================================
    
    # MCU boot time must complete before any safety-critical operation.
    # Relay engages after ~500ms.
    #
    # READ FROM THE EN RC ITSELF, NOT MIRRORED (2026-08-20, .ato-
    # assertion-vacuity paydown). This line used to be `14ms` with the
    # comment "MCU boots in ~14ms (per EN RC delay)" -- a hand-copy of a
    # number the MCU module already DERIVES from its own parts:
    #     MCU.t_boot_rc    = r_en.value * c_en.value
    #     MCU.t_boot_delay = t_boot_rc * 1.4
    # Both are asserted there (9-11ms and 13-15ms) against the real
    # resistor and capacitor, so the derivation exists and this file was
    # simply not using it. Re-sourcing r_en or c_en moved the real boot
    # delay and left this 14ms, and the interlock built on it, unchanged.
    t_mcu_boot: time = mcu.t_boot_delay
    t_soft_start_delay: time = 500ms  # Time before relay bypass
    assert t_mcu_boot < t_soft_start_delay  # MCU ready before power stage
    
    # Dead-time budget (system-level)
    # Hardware programmed nominal: 305.4ns from the 34-kΩ RDT resistor.
    # Software configured: 300ns (in MCPWM registers)
    # IGBT turn-off: 245ns
    # Total margin: 300 - 245 = 55ns (>50ns minimum margin)
    # t_dt_hw_nominal READS THE HALF-BRIDGE'S DERIVED DEAD TIME (2026-08-20,
    # .ato-assertion-vacuity paydown) instead of hand-copying 305.4ns from
    # the comment above. HalfBridge already solves it from dt_res.value via
    # the UCC21550's own t_DT(ns) = 8.6*R_DT(kohm) + 13, so the number
    # existed; this file was restating it.
    t_dt_hw_nominal: time = hb.t_dead_time
    t_dt_sw: time = 300ns
    t_igbt_off: time = 245ns
    assert t_dt_sw > t_igbt_off + 50ns  # Software dead-time provides margin
    # AND THE HARDWARE DEAD TIME IS THE ONE THAT HAS TO CLEAR IT. The
    # UCC21550's RDT-programmed dead time is a floor the driver enforces on
    # its own outputs; the 300ns MCPWM register value above is a request
    # the driver will not honour below that floor. Nothing in this design
    # asserted the hardware figure against the IGBT's turn-off time at all
    # -- the only dead-time assertion was on the software constant, and the
    # only assertion on the hardware constant was HalfBridge's 300-310ns
    # band, which says nothing about whether the IGBT has finished turning
    # off. This closes that gap, and it is circuit-coupled: dt_res.value is
    # in the closure.
    #
    # IT IS TIGHT, AND THAT IS THE FINDING. HalfBridge's derived interval
    # is [302.5, 308.3]ns over dt_res's +/-1% alone. Against
    # 245 + 50 = 295ns the worst corner leaves 7.5ns -- 2.5% margin on a
    # 1200V half-bridge shoot-through guard, before any of the IC-corner or
    # temperature variation HalfBridge's own comment warns about
    # ("Scope verification required -- corner model may fall below 300ns")
    # is applied. Not narrowed, not widened; made visible.
    assert t_dt_hw_nominal > t_igbt_off + 50ns
    
    # ===========================================================================
    # POWER CONNECTIONS
    # ===========================================================================
    
    # AC Input (external connectors)
    # Note: AC_L, AC_N, PE come from external connector
    
    # Power input outputs
    power_in.dc_bus.hv_plus ~ dc_bus_plus
    power_in.dc_bus.hv_minus ~ dc_bus_minus
    # The doubler midpoint (gnd_ref) is the high-current power return node.
    # It must NOT be shorted directly to logic/signal ground to prevent
    # AC mains potential on user-accessible circuits (S1) and to keep
    # tank return current out of the signal ground net (S3).
    power_return ~ power_in.dc_bus.gnd_ref  # Doubler midpoint = power return
    power_in.gnd ~ gnd  # PowerInput relay control return (SELV side)
    power_in.power_15v.vcc ~ vcc_15v
    # power_in already ties power_15v.gnd ~ gnd internally; redundant
    power_in.pe ~ pe  # Protective earth, from the external AC connector
    
    # Auxiliary supply: 170VDC half-bus -> isolated 15V SELV rail
    # Replaces the floating power_mgmt.power_in_hv (P0-3)
    aux_supply.power_in.vcc ~ dc_bus_plus    # Half-bus input (~170VDC)
    aux_supply.power_in.gnd ~ power_return   # Referenced to doubler midpoint
    aux_supply.power_out.vcc ~ vcc_15v       # Isolated 15V output -> all downstream rails
    aux_supply.power_out.gnd ~ gnd           # SELV ground
    
    # Power management chain — 15V -> 3.3V
    # Note: 15V now comes from isolated AuxSupply, not from DC bus directly
    power_mgmt.power_15v.vcc ~ vcc_15v
    power_mgmt.power_15v.gnd ~ gnd
    
    power_mgmt.power_3v3.vcc ~ vcc_3v3
    # power_mgmt.power_3v3.gnd is already tied to power_mgmt.power_15v.gnd
    # inside PowerManagement; connect the shared ground once.
    
    # ===========================================================================
    # GROUND ARCHITECTURE — Floated SELV domain, PE-bonded (2026-07-26)
    #
    # REMOVED: the star join (`power_return ~ gnd`) that used to sit here.
    # That join made the AuxSupply transformer's SELV output ground (gnd) the
    # SAME NET as power_return -- the doubler midpoint, which tracks AC
    # Neutral through the common-mode choke (modules.ato: ac_n ~ cmc.W2_1 ~
    # dc_bus.gnd_ref). It shorted the IRM-10-15's 4.2kVAC isolation barrier
    # across, and is documented in full in
    # docs/hardware/IEC60335_CRITICAL_COMPONENTS.md and the "isolation
    # barrier is shorted" entry in docs/STRATEGY.md. See
    # docs/hardware/SELV_ISOLATION_REDESIGN.md for the complete fix,
    # including the exhaustive crossing survey this join's removal required.
    #
    # gnd is now referenced instead by bonding it DIRECTLY to protective
    # earth (pe), which already exists at the AC input connector and already
    # has a bond point on the power_return side (the Y1 capacitor,
    # modules.ato: dc_bus.gnd_ref ~ y_cap_pe ~ pe). Rationale:
    #   - A floating, unreferenced SELV domain is not safe either -- it
    #     capacitively couples to nearby HV nodes and drifts with EMI. A
    #     solid DC bond to a real, low-impedance reference (PE/chassis) is
    #     the standard answer for a Class I appliance (has PE) with an
    #     internal SELV domain, and it means a single HV->SELV insulation
    #     fault has a low-impedance path to trip branch overcurrent
    #     protection, rather than energizing an ungrounded domain that
    #     includes the user-touchable RTD probe.
    #   - This does NOT reintroduce the shorted-barrier problem: the Y1 cap
    #     bond (power_return -> PE) stays exactly as it was, a 2.2nF
    #     high-impedance AC/EMI-only path, doing its original common-mode
    #     job undisturbed. The new gnd -> PE bond is a separate, direct
    #     (0 ohm) DC path that never touches power_return. power_return and
    #     gnd remain two different nets, coupled only through whatever
    #     impedance exists from PE, through the Y-cap, back to power_return
    #     -- i.e. still isolated at DC, unlike before.
    #   - EMC: referencing the low-power digital domain to PE/chassis
    #     (rather than to the internally-generated, AC-N-tracking
    #     power_return) is the more common, generally quieter choice.
    #     LAYOUT REQUIREMENT (UNVERIFIED at the schematic level -- this is a
    #     PCB-layout concern, not a netlist one): the gnd->PE bond and the
    #     Y-cap's power_return->PE bond should land at the same physical PE
    #     stud/point near the AC inlet to keep the loop area between them
    #     small; this schematic cannot enforce that.
    # ===========================================================================
    gnd ~ pe  # SELV ground reference: bonded to protective earth, NOT to power_return

    # ===========================================================================
    # HALF-BRIDGE CONNECTIONS
    # ===========================================================================
    
    hb.dc_bus.hv_plus ~ dc_bus_plus
    # OCP-02 IS WIRED IN (2026-08-07, Option A -- second current
    # transformer). History: docs/hardware/OCP02_DESIGN.md originally
    # claimed a low-side INA240 shunt in DC_BUS_RTN keeps common mode near
    # ground. That was wrong -- this is a voltage-doubler topology:
    # `power_return` IS the doubler midpoint and IS signal ground, so
    # DC_BUS_RTN sits at roughly -170 V with respect to it, ~2x the
    # INA240's -4..+80 V common-mode range -- far outside its absolute
    # maximum. See docs/hardware/OCP02_DECISION_BRIEF.md (the A/B/C/D
    # options considered) and docs/hardware/OCP02_QUANTIFIED_TRADEOFF.md
    # (the quantified evidence that settled it) for the full decision
    # record; SecondaryOCPComparator's own docstring has the current
    # derivation and worst-case arithmetic.
    #
    # A current transformer sidesteps the common-mode problem entirely
    # (magnetically isolated secondary, referenced to signal ground
    # regardless of DC_BUS_RTN's absolute potential) -- the same technique
    # OCP-01's own CT (ct_sense) already uses on the tank-return path.
    # SecondaryOCPComparator's CT primary is spliced IN SERIES in the
    # DC_BUS_RTN conductor, at the same point the original shunt design
    # used: between the half-bridge (this connection, below) and the
    # shared dc_bus_minus net that power_in/discharge sit on. This mirrors
    # ct_sense's own tank-return splice (tank.out ~ ct_sense.primary_in;
    # ct_sense.primary_out ~ power_return, above).
    #
    # KNOWN, PENDING BOARD FOLLOW-ON (elec/ only in this change; pcb/ is
    # out of scope): the second CST3015-100ED footprint has not been placed
    # on pcb/temper.kicad_pcb. docs/hardware/OCP02_QUANTIFIED_TRADEOFF.md
    # SS3 measured (real kicad-cli DRC, scratch board copies) a ~44mm HV
    # run from this splice to a domain-safe candidate site costing 9 new
    # creepage violations (7 after correcting an unrelated, pre-existing
    # netclass-pattern gap), 6 against U7 (the high-side gate driver) --
    # known and attributed, not yet remediated. A BOM row is also still
    # needed (docs/hardware/BOM.md untouched by this change, per
    # instruction).
    hb.dc_bus.hv_minus ~ safety.ocp2_bus_in
    safety.ocp2_bus_out ~ dc_bus_minus
    hb.power_15v.vcc ~ vcc_15v
    hb.power_15v.gnd ~ gnd
    hb.power_3v3.vcc ~ vcc_3v3
    # hb already ties power_3v3.gnd ~ gnd internally; redundant
    
    # Low-side gate driver supply: vcc_15v_ls must come from an isolated 
    # aux winding on the flyback transformer, referenced to hv_minus.
    # Until the transformer winding is specified (plan 005 magnetics
    # follow-up), this net is a placeholder.
    hb.power_15v_ls.vcc ~ vcc_15v_ls
    
    # PWM from MCU
    mcu.pwm_h ~ hb.pwm_h
    mcu.pwm_l ~ hb.pwm_l
    hb.pwm_h.override_net_name = "PWM_HS"
    hb.pwm_l.override_net_name = "PWM_LS"
    
    # ===========================================================================
    # RESONANT TANK CONNECTIONS
    # ===========================================================================
    
    hb.switch_node ~ tank.in
    hb.switch_node.override_net_name = "SW_NODE"
    # tank.in is the same electrical net as hb.switch_node; keep one
    # authoritative override name (SW_NODE).
    # CT primary: current transformer measures tank return current
    # The primary wire (tank return) passes through the CT core
    tank.out ~ ct_sense.primary_in
    ct_sense.primary_out ~ power_return  # Tank return passes THROUGH the CT primary
    
    # ===========================================================================
    # SENSING CONNECTIONS
    # ===========================================================================
    
    # Current sensing
    ct_sense.vcc_3v3_ct ~ vcc_3v3  # Bias supply for CT output
    ct_sense.i_sense.reference ~ gnd
    ct_sense.i_sense.line ~ mcu.adc_i_sense
    ct_sense.i_sense ~ safety.i_sense
    ct_sense.i_sense.line.override_net_name = "I_SENSE"
    
    # RTD temperature sensing (pan temperature)
    rtd_pan.power.vcc ~ vcc_3v3
    rtd_pan.power.gnd ~ gnd
    rtd_pan.cs.line ~ mcu.cs_rtd.line
    rtd_pan.spi.sclk ~ mcu.spi.sclk
    rtd_pan.spi.mosi ~ mcu.spi.mosi
    rtd_pan.spi.miso ~ mcu.spi.miso
    rtd_pan.drdy.line ~ mcu.rtd_drdy.line
    rtd_pan.drdy.line.override_net_name = "RTD_DRDY"
    rtd_pan.rtd_hw_fault.line ~ safety.rtd_hw_fault.line
    rtd_pan.rtd_hw_fault.line.override_net_name = "RTD_HW_FAULT"
    
    rtd_pan.spi.sclk.override_net_name = "RTD_SCK"
    rtd_pan.spi.mosi.override_net_name = "RTD_SDI"
    rtd_pan.spi.miso.override_net_name = "RTD_SDO"
    rtd_pan.cs.line.override_net_name = "RTD_CS_N"
    
    # ===========================================================================
    # SAFETY INTERLOCK CONNECTIONS
    # ===========================================================================
    
    safety.power_3v3.vcc ~ vcc_3v3
    safety.power_3v3.gnd ~ gnd
    safety.power_15v.vcc ~ vcc_15v
    safety.power_15v.gnd ~ gnd
    
    # Sensor inputs to safety system
    safety.dc_bus.line ~ dc_bus_plus
    safety.dc_bus.reference ~ gnd
    # safety.i_sense already connected above
    # NTC for heatsink temperature monitoring
    safety.ntc_sense.line ~ mcu.adc_ntc
    # safety already ties ntc_sense.reference ~ gnd internally; redundant
    mcu.adc_v_bus.override_net_name = "V_BUS_SENSE"
    safety.ovp.adc_v_bus.line ~ mcu.adc_v_bus

    # OVP-01 REF2025 re-reference (Option C, 2026-07-27, docs/evidence/
    # 2026-07-27-ovp01-ref2025-implementation.md): OVPComparator's comp.INN
    # is referenced to RTDSensing's REF2025.VREF (2.5V, +/-0.05%/8ppm/C)
    # instead of a resistor divider off vcc_3v3 -- see OVPComparator's
    # docstring and r_div_bot's comment for the full derivation.
    safety.ovp.vref_ext.line ~ rtd_pan.reference.VREF
    safety.ovp.vref_ext.line.override_net_name = "OVP_VREF_2V5"

    # OCP-02 REF2025 reference (Option A implementation, 2026-08-07): same
    # pattern as OVP-01 above -- SecondaryOCPComparator's comp.INN is
    # referenced to the SAME REF2025.VREF (a second load on this buffered,
    # actively-driven output; its 20mA rating has enormous headroom against
    # a second TLV3201's ~pA CMOS input bias current) rather than a
    # resistor divider off vcc_3v3. See SecondaryOCPComparator's docstring
    # ("WHY REF2025") for the full derivation.
    safety.ocp2.vref_ext.line ~ rtd_pan.reference.VREF
    safety.ocp2.vref_ext.line.override_net_name = "OCP2_VREF_2V5"

    # Watchdog
    mcu.wdt_kick.line ~ safety.wdt_kick.line
    mcu.wdt_kick.line.override_net_name = "WDT_KICK"
    safety.wdt_reset_n.line ~ mcu.wdt_reset_in.line
    safety.wdt_reset_n.line.override_net_name = "WDT_RESET_N"
    
    # Shutdown output is active-high per the UCC21550 contract.
    safety.shutdown.line ~ hb.gate_hs.driver.DIS
    safety.shutdown.line.override_net_name = "SHUTDOWN"
    
    # Fault status to MCU
    safety.fault_status.line ~ mcu.fault_status_in.line
    # fault_status is the MCU sense alias of the same latched SHUTDOWN net;
    # do not assign a competing net name here.
    safety.reset_n_in.line ~ mcu.reset_n.line
    safety.runaway_cut.line ~ mcu.runaway_cut.line
    
    # Gate HS/LS
    hb.gate_hs.driver.OUTA.override_net_name = "GATE_HS"
    # Gate LS is RG_ON.p2 in the task description
    # hb.gate_ls.rg_on.p2 doesn't exist directly in Top, but we can access it via hb
    hb.gate_ls.rg_on.p2.override_net_name = "GATE_LS"
    
    # ===========================================================================
    # MCU CONNECTIONS
    # ===========================================================================
    
    mcu.power.vcc ~ vcc_3v3
    mcu.power.gnd ~ gnd

    # Fan supply
    thermal.power_15v.vcc ~ vcc_15v
    thermal.power_15v.gnd ~ gnd
    
    # Relay control for soft-start bypass
    mcu.relay_ctrl.line ~ power_in.relay_ctrl
    mcu.relay_ctrl.line.override_net_name = "RELAY_CTRL"

    # ===========================================================================
    # ACTIVE BUS DISCHARGE CONNECTIONS
    # One 2x4.7k/5W string + relay NC contact across each half-bus.
    # Coils held from the 15V rail while running; any power loss (or MCU
    # dead: IO47 boots Hi-Z) de-energizes the coils and the NC contacts
    # engage discharge -- <60s to <34V per half-bus, no MCU involvement.
    # ===========================================================================
    discharge.hv_plus ~ dc_bus_plus
    discharge.mid ~ power_return
    discharge.hv_minus ~ dc_bus_minus
    discharge.power_15v.vcc ~ vcc_15v
    # discharge already ties power_15v.gnd ~ gnd internally; connect once
    discharge.gnd ~ gnd
    mcu.discharge_ctrl.line ~ discharge.ctrl
    mcu.discharge_ctrl.line.override_net_name = "DISCHARGE_CTRL"

    # USB connections
    mcu.usb_dn ~ usb_dn
    mcu.usb_dp ~ usb_dp
    
    # I2C UI connections
    mcu.i2c.sda ~ i2c_sda_ui
    mcu.i2c.scl ~ i2c_scl_ui

# ==============================================================================
# FOOTPRINT COMPILATION
# Instantiate generative footprints to ensure they compile
# ==============================================================================

module Footprints:
    igbt_fac = new IGBT_TO247
    driver_fac = new SOIC16W_Isolated
    litz_fac = new LitzPad_15A
    ct_fac = new CST1005_Footprint

# ==============================================================================
# TOP-LEVEL INSTANCES
# ==============================================================================

temper = new Top
footprints = new Footprints
