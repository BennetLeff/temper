# main.ato
# Temper Induction Cooker - Top Level Design
# Reference: pcb/temper.kicad_sch
#
# System Overview:
# - AC Input (120V) -> Voltage Doubler -> DC Bus (340V)
# - DC Bus -> Half-Bridge -> Resonant Tank -> Coil
# - ESP32-S3 controls PWM, monitors sensors, kicks watchdog
# - Hardware safety interlock: OCP, OVP, Thermal, Watchdog -> SHUTDOWN_N
#
# Power Rails:
# - DC_BUS: 340V nominal (rectified mains)
# - +15V: Gate driver, safety logic (from auxiliary supply)
# - +3.3V: MCU, digital logic (from LDO)

# Module imports
import HalfBridge from "modules.ato"
import ResonantTank from "modules.ato"
import PowerInput from "modules.ato"
import BusDischarge from "modules.ato"
import PowerManagement from "modules.ato"
import AuxSupply from "modules.ato"
import CurrentSensing from "modules.ato"
import RTDSensing from "modules.ato"
import SafetyInterlock from "modules.ato"
import ThermalSystem from "modules.ato"
import MCU from "modules.ato"
import HighVoltageConstraints from "constraints.ato"
import ThermalZonesConstraints from "constraints.ato"

# Footprint imports for FAC
import IGBT_TO247 from "footprints.ato"
import SOIC16W_Isolated from "footprints.ato"
import LitzPad_15A from "footprints.ato"
import CST1005_Footprint from "footprints.ato"

# ==============================================================================
# TOP-LEVEL MODULE: Complete Induction Cooker System
# ==============================================================================

module Top:
    """Top-level Temper induction cooker assembly."""

    constraints = new HighVoltageConstraints
    thermal_constraints = new ThermalZonesConstraints

    
    # --- System Operating Conditions ---
    v_bus_max = 340V
    v_bus_abs_max = 400V
    i_peak_max = 25A
    v_ac_nominal = 120V
    power_max = 1800W
    
    # --- Operating Envelope Assertions (temper-ofq.4) ---
    assert v_ac_nominal within 100V to 130V  # NEMA 5-15 tolerance
    
    # Verify against constraints (temper-ofq.6)
    assert v_bus_max <= constraints.v_max
    assert i_peak_max <= constraints.i_max
    
    f_line: frequency = 60Hz
    assert f_line within 59Hz to 61Hz  # US grid tolerance
    
    v_bus_nominal: voltage = 340V
    assert v_bus_nominal within 280V to 380V  # Doubler output range
    
    v_bus_ripple_max: voltage = 20V
    assert v_bus_ripple_max < v_bus_nominal * 0.1  # <10% ripple
    
    # CORRECTED 2026-07-27 (docs/evidence/2026-07-27-zvs-operating-point.md,
    # docs/evidence/2026-07-27-pan-preset-correction.md): the previous value
    # here, 35kHz, was found to lose ZVS COMPLETELY for ferromagnetic pans
    # (cast_iron/stainless) once the pan-coupling model was corrected to
    # Infineon AN235020's measured K=0.79 -- 100.7% margin lost, i.e. full
    # hard switching of a 1200V IGBT half-bridge, not a tuning shortfall.
    # aluminum/no_pan were unaffected (their K was not raised).
    #
    # 47kHz is the best-evidenced replacement: at an ASSUMED coil L=150uH
    # (see f_resonant_nominal below and inductor_conn's docstring --
    # inductor_conn is still a placeholder; no coil has been specified),
    # ratio~=1.25 over that assumption's K=0.79 loaded resonance
    # (37.58kHz) delivers ~1804W, holds ZVS (0.8% margin, re-verified
    # 2026-07-27 for ALL FOUR pan presets, not just cast_iron), and clears
    # OCP-01's 50.1A peak trip by 43% (28.76A vs. 48.18A at the old 35kHz/
    # same-L point). This number is CONTINGENT on L=150uH: a smaller real
    # coil raises the required minimum further (e.g. at 80uH, the K=0.79
    # loaded resonance is ~52kHz, which 47kHz would NOT clear) -- it must
    # be re-derived once the coil is actually specified (see
    # docs/hardware/TANK_COIL_SPECIFICATION.md).
    #
    # LOWER BOUND ON THIS VALUE IS NOW MACHINE-DERIVED (2026-07-29,
    # docs/evidence/2026-07-29-pll-floor-above-resonance.md): f_switching
    # must stay above f_pll_tracking_min, which
    # scripts/check_pll_range_consistency.py derives from
    # l_tank_assumed / l_pan_loaded_ratio / c_tank_total / l_tank_tolerance
    # below as 1.05 x the WORST-CASE (minimum-L) loaded resonance. Below
    # the loaded resonance the series tank is CAPACITIVE and the bridge
    # hard-switches; 47kHz sits at ratio 1.25 over the nominal loaded
    # resonance (37.58kHz) and at 1.18 over the -10%-coil worst case
    # (39.73kHz). Do not lower f_switching without re-running that gate.
    f_switching: frequency = 47kHz
    # NOTE (2026-07-28, docs/evidence/2026-07-28-pll-defaults-and-range-
    # gate.md): this 20-100kHz window is an LC-TANK THEORETICAL bound, not
    # the firmware's actual capability -- it overstates what the PLL can
    # deliver by 5x at the top end. See f_pll_tracking_min/max immediately
    # below for the real, firmware-matched range and the gate that
    # cross-checks both.
    assert f_switching within 20kHz to 100kHz  # LC tank theoretical bound (NOT firmware capability)

    # --- PLL frequency tracking range: the firmware's ACTUAL capability ---
    # DECLARED 2026-07-28 (docs/evidence/2026-07-28-pll-defaults-and-range-
    # gate.md, docs/evidence/2026-07-28-pll-ratio-tracking-check.md). This
    # mirrors firmware/components/control/pll_control.h's PLL_MIN_FREQ_HZ /
    # PLL_MAX_FREQ_HZ exactly -- NOT the 20-100kHz "LC tank theoretical
    # bound" above, which the firmware cannot reach.
    # scripts/check_pll_range_consistency.py enforces that these two stay
    # equal and that f_switching falls inside them; it fails the build if
    # this file and pll_control.h ever disagree again.
    #
    # FLOOR RAISED 30kHz -> 42kHz, 2026-07-29 (docs/evidence/2026-07-29-
    # pll-floor-above-resonance.md). The 30kHz floor sat 7.6kHz BELOW the
    # loaded resonance (37.58kHz at the declared L/K/C below). This is a
    # SERIES-resonant inverter: above resonance the tank is inductive and
    # the bridge switches at zero voltage; below resonance the tank is
    # CAPACITIVE and the bridge hard-switches -- turn-on loss plus diode
    # reverse recovery on a 1200V IGBT half-bridge at full bus. The old
    # range therefore declared a device-destroying regime legal. Worse,
    # 30kHz delivers ~1783W under this repo's own committed T-model, i.e.
    # essentially the rated 1800W: a power-seeking control loop could
    # settle there and read as nominal while hard-switching.
    #
    # 42kHz IS NOT HAND-PICKED. scripts/check_pll_range_consistency.py
    # DERIVES the required floor from l_tank_assumed, l_pan_loaded_ratio,
    # c_tank_total and l_tank_tolerance (all declared below) as
    #     1.05 x 1/(2*pi*sqrt(l_tank_assumed*(1-l_tank_tolerance)
    #                         * l_pan_loaded_ratio * c_tank_total))
    # = 1.05 x 39.59kHz = 41.57kHz, and FAILS if PLL_MIN_FREQ_HZ is below
    # it. The 1.05 is the ZVS cliff from docs/hardware/TANK_COIL_
    # SPECIFICATION.md, confirmed a threshold (not a gradient) in
    # docs/evidence/2026-07-27-inductance-range-sweep.md Sec 2.3. The gate
    # keys off the WORST-CASE (minimum) coil inductance, not nominal,
    # because f_res scales as 1/sqrt(L): a low-tolerance coil raises
    # resonance, so nominal-L would under-protect exactly the unit that
    # needs protecting most.
    #
    # WHAT THE RAISED FLOOR COSTS: for a series-resonant inverter lower
    # f_sw means MORE power, so the floor caps maximum deliverable power.
    # It does not threaten 1800W -- that point is at 47.1kHz nominal, and
    # the floor still admits ~3.7kW (2.1x rated). The band removed
    # (30-42kHz) was entirely either hard-switching (<37.6kHz) or
    # 3.7-5.7kW at 42-52A peak against OCP-01's 50.1A trip (37.6-42kHz).
    # Nothing usable was given up.
    #
    # OPEN HARDWARE QUESTION -- NOT RESOLVED BY THIS DECLARATION:
    # docs/evidence/2026-07-27-inductance-range-sweep.md Sec 3 finds that
    # the ratio-tracking ZVS mitigation (retuning f_sw in real time to hold
    # f_sw/f_res_loaded ~= 1.25 as L varies) needs 35.7-83.0kHz agility to
    # hold ZVS across the plausible L in [50, 250]uH range. That sweep
    # cited "every comparable real coil ... (Infineon AN235020, Wurth
    # 760308101303, APHO2025) measures 47-50uH" -- CORRECTED 2026-07-28 by
    # docs/evidence/2026-07-28-coil-selection-research.md Sec 2.4: the
    # Wurth part is a 26mm/1.5A/20W Qi wireless-power receiver coil and
    # APHO2025's bench coil was validated against it, so that "cluster of
    # three independent sources" is ONE comparable coil, measured only at
    # 90-150kHz for a 100-140kHz inverter. At this design's 20-50kHz band
    # the same manufacturer publishes ~88uH unloaded / ~60uH loaded for a
    # 2kW cooking coil -- which lands on the SAME L_loaded ~= 60uH this
    # file's 150uH x 0.399 already assumes. The capability gap above is
    # therefore weaker evidenced than when written, but it is deliberately
    # NOT declared closed here.
    #
    # Raising PLL_MAX_FREQ_HZ toward 83-100kHz is explicitly NOT done here
    # and must not be done by silently editing a constant: whether the
    # bridge, gate drive and snubber network tolerate that frequency is a
    # switching-loss / hardware question a human must decide, informed by
    # bench data this project does not yet have. Widening the firmware to
    # an unvalidated range just to make f_switching's assertion agree with
    # the mitigation's requirement would recreate the exact failure mode
    # (a declared value later readers trust) this gate exists to prevent.
    # The 2026-07-29 floor change did NOT widen the top of the window to
    # compensate: f_pll_tracking_max is unchanged at 50kHz. One consequence
    # is recorded rather than fixed -- at -10% coil the 1800W point moves
    # to 50.05kHz, i.e. marginally ABOVE the ceiling, so a low-tolerance
    # coil trades full power, not ZVS. That is the correct direction to
    # fail, and widening the ceiling to recover it is a separate decision.
    f_pll_tracking_min: frequency = 42kHz
    f_pll_tracking_max: frequency = 50kHz
    assert f_pll_tracking_min < f_pll_tracking_max
    assert f_switching >= f_pll_tracking_min
    assert f_switching <= f_pll_tracking_max

    # NOT changed by the 2026-07-27 correction above -- flagged, not
    # resolved. 25kHz here, at the fixed 300nF C_TANK (c_tank1+c_tank2,
    # modules.ato), algebraically implies L=135.1uH -- a THIRD coil-
    # inductance assumption, distinct from both the simulation harness's
    # own 80uH PANLOAD_TRANSFORMER default (implying an unloaded 32.5kHz,
    # still within this assertion's band but not equal to the 25kHz
    # declared here) and the 150uH assumption behind f_switching's 47kHz
    # above (implying an unloaded 23.7kHz). None of the three has ever
    # been measured against the real coil/pan, and this pass does not
    # pick a winner among them: doing so by changing THIS value would
    # just be inventing the same unspecified L via a different variable.
    # See docs/evidence/2026-07-27-zvs-operating-point.md for the full
    # three-way comparison, including that even using this line's OWN
    # 25kHz-implied 135.1uH, the K=0.79 loaded resonance comes to
    # ~39.7kHz -- ABOVE the pre-correction 35kHz f_switching -- so the
    # ZVS-loss finding above does not depend on which of the three L
    # assumptions is used.
    # AMBIGUOUS AND UNRESOLVED (2026-07-27): this does not state whether it
    # names the LOADED or UNLOADED resonance, and with the corrected pan
    # coupling the two differ by roughly 60%. At L=150uH: unloaded 23.7kHz,
    # loaded ~38kHz. Only the loaded figure is meaningful for the ZVS ratio --
    # read as unloaded, f_switching=47kHz appears to sit at ~1.98x resonance
    # (implying almost no power transfer) rather than the ~1.24x the analysis
    # actually found.
    #
    # This same ambiguity already caused a real bug: run_tank_coil_sweep.py
    # referenced its ratio against the UNLOADED resonance, silently
    # reintroducing the under-loading error the moment K was corrected. It
    # needed a self-consistent f_res_loaded_hz() fixed-point solver to fix.
    #
    # Also note 25kHz is a third value matching neither the simulation's 80uH
    # default (32.5kHz) nor the L=150uH the ZVS analysis recommends (23.7kHz).
    # All three fall inside the assertion window below, which is why the
    # divergence was never caught. See
    # docs/evidence/2026-07-27-zvs-operating-point.md.
    #
    # STATED EXPLICITLY (2026-07-27, docs/evidence/2026-07-27-inductance-
    # range-sweep.md): this value is the UNLOADED resonance (L1/C_TANK
    # only -- it is what "1/(2*pi*sqrt(L*C))" means with no pan on the
    # coil). It is NOT the loaded resonance ZVS margin must be referenced
    # against (loaded and unloaded differ by ~60% for ferromagnetic pans
    # at K=0.79 -- see f_switching's comment above). This label does not
    # change the number (that would just be picking a different
    # unverified L again, per the note above); it only makes the
    # loaded-vs-unloaded ambiguity impossible to miss on read.
    f_resonant_nominal: frequency = 25kHz
    assert f_resonant_nominal within 20kHz to 35kHz  # LC tank range, UNLOADED

    # DECLARED EXPLICITLY (2026-07-27, was previously invisible -- L only
    # existed as an assumption buried in simulation harness constants and
    # evidence-doc prose; `inductor_conn` below remains an unplaced Litz
    # footprint placeholder, so this is still NOT a specified/measured
    # coil). `150uH` is the exact assumption
    # docs/evidence/2026-07-27-pan-preset-correction.md's ratio sweep used
    # to land on f_switching=47kHz above; the range is a GEOMETRY-BOUNDED
    # ESTIMATE (Wheeler/current-sheet spiral formula over plausible turn
    # counts and inner diameters within COIL_BRACKET_DESIGN.md's OD<=200mm
    # ceiling), cross-checked against real comparable-power-class flat
    # coils (Infineon AN235020 ~48-50uH, Wurth 760308101303 ~47uH, both
    # already cited in docs/evidence/2026-07-27-coil-pan-coupling-prior-
    # art.md) -- NOT a measurement of this project's own coil.
    #
    # docs/evidence/2026-07-27-inductance-range-sweep.md sweeps this whole
    # range at the COMMITTED, FIXED f_switching=47kHz above and finds ZVS
    # is COMPLETELY LOST (100%+ margin, full hard-switching of the 1200V
    # half-bridge) for ferromagnetic pans below ~97uH -- i.e. within, not
    # outside, this declared range, and closer to the low end than the
    # 150uH design point. If the real coil lands nearer the 48-50uH
    # external references than the 150uH assumption, the design as
    # committed today does NOT hold. Read that document before treating
    # 150uH as settled.
    l_tank_assumed: inductance = 150uH
    assert l_tank_assumed within 50uH to 250uH  # bounded estimate, NOT measured -- see docs/evidence/2026-07-27-inductance-range-sweep.md

    # --- Inputs to the DERIVED PLL floor (2026-07-29, docs/evidence/
    # 2026-07-29-pll-floor-above-resonance.md) ---
    # These three make the loaded resonance computable from THIS file.
    # Before they existed, f_res lived only in simulation-harness constants
    # and evidence prose, so f_pll_tracking_min / PLL_MIN_FREQ_HZ could be
    # (and were) set 7.6kHz below it with nothing able to notice.
    # scripts/check_pll_range_consistency.py reads all three plus
    # l_tank_assumed above and fails closed if any is missing, unparseable,
    # or outside its sanity band -- it never skips.

    # Total series tank capacitance. MIRRORS modules.ato's c_tank1.value +
    # c_tank2.value (150nF + 150nF in parallel) and the gate CROSS-CHECKS
    # it against those two declarations, so this mirror cannot drift into
    # the same class of untethered restatement that produced the +340V_BUS
    # and 20-100kHz defects. UNCHANGED VALUE -- the 300nF commitment is
    # under separate review (docs/evidence/2026-07-28-coil-selection-
    # research.md Sec 5.2 proposes 470nF); this only makes it visible here.
    c_tank_total: capacitance = 300nF
    assert c_tank_total within 150nF to 600nF  # tank-design band, not a part tolerance

    # Loaded/unloaded coil-inductance ratio with a ferromagnetic pan --
    # the ONLY way pan coupling enters the resonance. L_loaded =
    # l_tank_assumed * this, and L_loaded is what resonates with
    # c_tank_total. 0.399 is the fixed point of simulation/harness/
    # run_tank_coil_sweep.py's f_res_loaded_hz() T-model relation
    #   L_app/L1 = 1 - K^2*x^2/(RPAN^2+x^2),  x = omega*L2
    # at run_zvs_sweep.py's committed cast_iron/stainless preset
    # (K=0.79, RPAN=10ohm, L2=218uH), evaluated at the resulting 37.58kHz.
    # It is WEAKLY L-dependent (0.3963 at -10% L, 0.4009 at +10% L, i.e.
    # +-0.6%, propagating to only -+0.3% in f_res) -- an order of magnitude
    # inside the 1.05 ZVS margin the derived floor carries, and inside the
    # floor's actual 1.057 worst-case margin. Declaring the ratio rather
    # than (K, RPAN, L2) keeps ONE mirrored quantity instead of three.
    # CORROBORATION, not independence: the 88uH/0.68 measured coil of
    # docs/evidence/2026-07-28-coil-selection-research.md Sec 4.4 gives
    # L_loaded = 59.8uH against this model's 59.8uH -- the two models
    # disagree about the coil by 1.7x and about the pan by 1.7x the other
    # way, and agree about f_res to 0.7%. That is why the floor below is
    # robust even though the coil is not specified.
    l_pan_loaded_ratio: dimensionless = 0.399
    assert l_pan_loaded_ratio within 0.2 to 0.8  # ferromagnetic-pan coupling band

    # Coil inductance tolerance used ONLY to pick the worst case for the
    # PLL floor. f_res scales as 1/sqrt(L), so MINIMUM L is the hazardous
    # end (highest resonance, so the floor must be highest) -- the gate
    # derives against l_tank_assumed*(1-this), never against nominal.
    # +-10% is the acceptance tolerance docs/evidence/2026-07-28-coil-
    # selection-research.md Sec 5.1 recommends specifying the coil to. It
    # is NOT the [50,250]uH assumption band asserted above: that band is
    # "which coil might we end up with", this is "how much does one
    # specified coil vary". Both matter; only this one belongs in a
    # unit-to-unit safety guard.
    l_tank_tolerance: dimensionless = 0.10
    assert l_tank_tolerance within 0.05 to 0.30  # a plausible part tolerance, never 0

    t_ambient_max: temperature = 323.15K  # 50°C
    t_ambient_min: temperature = 273.15K  # 0°C
    assert t_ambient_max within 313.15K to 333.15K  # 40°C to 60°C
    
    p_output_max: power = 1800W
    assert p_output_max within 1500W to 1800W  # 15A circuit limit
    
    p_standby_max: power = 1W
    assert p_standby_max < 5W  # Energy Star standby
    
    eta_min: dimensionless = 0.90
    assert eta_min >= 0.85  # Minimum efficiency target
    
    # --- Power Rails ---
    signal gnd          # SELV control-domain ground. Floated from
    # power_return (the HV domain's internal reference) and DC-bonded to
    # protective earth instead -- see the GROUND ARCHITECTURE block below
    # and docs/hardware/SELV_ISOLATION_REDESIGN.md.
    # The shared ground is named by the generated netlist; assigning an
    # override here conflicts with nested ElectricPower reference nets.
    signal pe            # Protective earth, from the external AC connector
    signal dc_bus_plus  # +170V half-bus (positive rail of the Delon/cascade
    # voltage doubler in PowerInput), referenced to power_return -- the
    # doubler MIDPOINT -- not to dc_bus_minus. dc_bus_plus - dc_bus_minus
    # spans the full 340V bus; this node ALONE is +170V nominal, not 340V.
    # This net used to be named "+340V_BUS" with a "+340V" comment here;
    # that was wrong (dc_bus_plus cannot reach 340V) and had already caused
    # OVP-01's reference divider to be tuned for a voltage this node can
    # never reach in at least one revision of this design -- see
    # OVPComparator's docstring and docs/hardware/SELV_ISOLATION_REDESIGN.md.
    dc_bus_plus.override_net_name = "+170V_BUS"
    signal dc_bus_minus # Ground reference for DC bus
    dc_bus_minus.override_net_name = "DC_BUS_RTN"
    signal vcc_15v      # Gate driver supply
    vcc_15v.override_net_name = "+15V"
    signal vcc_3v3      # MCU supply
    vcc_3v3.override_net_name = "+3V3"
    signal power_return  # High-current tank/power return path (doubler midpoint)
    power_return.override_net_name = "PWR_RTN"
    signal vcc_15v_ls    # Isolated low-side gate driver supply (plan 005)
    vcc_15v_ls.override_net_name = "+15V_LS"
    signal usb_dn        # USB D-
    signal usb_dp        # USB D+
    signal i2c_sda_ui    # I2C expansion header for UI
    signal i2c_scl_ui
    
    # --- Module Instances ---
    
    # Power input (AC -> DC)
    power_in = new PowerInput

    # Active bus discharge (fail-safe, relay NC contacts; plan 2026-07-16-001)
    discharge = new BusDischarge

    # Power management (DC_BUS -> 15V -> 3.3V)
    power_mgmt = new PowerManagement
    
    # Auxiliary supply (HV -> isolated 15V SELV)
    aux_supply = new AuxSupply
    
    # Half-bridge (power stage)
    hb = new HalfBridge
    
    # Resonant tank (LC network + coil)
    tank = new ResonantTank
    
    # Current sensing (CT on DC bus)
    ct_sense = new CurrentSensing
    
    # Temperature sensing (RTD for pan/heatsink)
    rtd_pan = new RTDSensing
    
    # Safety interlock
    safety = new SafetyInterlock
    
    # Microcontroller
    mcu = new MCU

    # Forced-air cooling (fan power circuit; heatsink/TIM are chassis BOM)
    thermal = new ThermalSystem
    
    # ===========================================================================
    # SAFETY ASSERTIONS
    # These must pass at compile-time to ensure design safety margins
    # ===========================================================================
    
    # IGBT Voltage Margin (>= 1.5x operating voltage)
    assert hb.power_loop.q_high.voltage_rating >= v_bus_max * 1.5
    assert hb.power_loop.q_low.voltage_rating >= v_bus_max * 1.5
    
    # IGBT Current Margin (>= 1.5x peak current)
    assert hb.power_loop.q_high.current_rating >= i_peak_max * 1.5
    assert hb.power_loop.q_low.current_rating >= i_peak_max * 1.5
    
    # Bootstrap Diode Rating (must withstand full bus voltage)
    assert hb.gate_hs.boot_diode.voltage_rating >= v_bus_max
    
    # Resonant Tank Capacitor Voltage (>= 2x bus for resonant overshoot)
    # Using 1000V minimum per design decision
    assert tank.c_tank1.voltage_rating >= 1000V
    assert tank.c_tank2.voltage_rating >= 1000V
    
    # Bus capacitor voltage rating
    assert power_in.c_bus1.voltage_rating >= v_bus_max * 0.7
    assert power_in.c_bus2.voltage_rating >= v_bus_max * 0.7
    
    # Rectifier diode rating
    assert power_in.d1.voltage_rating >= v_bus_max * 1.5
    assert power_in.d2.voltage_rating >= v_bus_max * 1.5
    
    # Design bus voltage limit
    assert v_bus_max <= 400V
    
    # ===========================================================================
    # SAFETY INTERLOCK ASSERTIONS (temper-ip1.6)
    # Verify protection trips BEFORE component limits
    # Critical for IEC 60335-1 compliance
    # ===========================================================================
    
    # OCP must trip before IGBT SOA limit.
    # IGBT rated 40A continuous, SOA allows 60A pulsed.
    #
    # OCP-01 is specified as a PEAK threshold (FUNCTIONAL_TEST_CRITERIA §2.1
    # gives "50A Peak"), and there is no rectifier in the sense path, so the
    # comparator trips on instantaneous tank current. Both quantities are
    # carried here because the two limits they must clear are in different
    # bases: the SOA pulsed limit is a peak rating, the 40A device rating is
    # continuous.
    #
    # The previous form asserted a 37.6A trip against BOTH limits. That value
    # was stale after the burden was corrected to 4.99R, and comparing a peak
    # trip against a continuous rating was the wrong comparison regardless --
    # at the true 50.1A peak it would fail 50.1 < 40 while the design is
    # actually sound, because 50.1A peak is 35.4A RMS.
    i_ocp_trip_peak: current = 50.1A          # 2.500V / 4.99R * 100
    i_ocp_trip_rms: current = 35.4A           # peak / sqrt(2), sinusoidal tank
    i_igbt_soa_limit: current = 60A

    # Peak trip must clear the pulsed SOA limit.
    assert i_ocp_trip_peak < i_igbt_soa_limit
    # RMS-equivalent trip must clear the continuous device rating.
    assert i_ocp_trip_rms < hb.power_loop.q_high.current_rating
    
    # OVP must trip before bus capacitor ratings exceeded
    # Bus caps rated 250V each, in series = 500V total
    # OVP trips at 390V
    v_ovp_trip: voltage = 390V
    v_cap_max: voltage = 500V  # Series combination
    assert v_ovp_trip < v_cap_max
    assert v_ovp_trip > v_bus_max  # But after normal operation
    
    # Thermal protection must trip before component limits
    # IGBT max junction: 150°C, derate at 125°C
    # Thermal comparator set for 85°C ambient
    t_thermal_trip: temperature = 358.15K
    assert t_thermal_trip < thermal_constraints.igbt_derate_temp
    
    # Watchdog timeout must allow system response but catch stuck states
    # 1.6s timeout per TPS3823-33
    t_wdt_timeout: time = 1.6s
    t_fault_response_max: time = 0.1s  # System should respond in <100ms
    assert t_wdt_timeout > t_fault_response_max * 10  # Margin for normal operation
    
    # ===========================================================================
    # TIMING BUDGET CONSTRAINTS (temper-ip1.4)
    # System-level timing verification
    # ===========================================================================
    
    # MCU boot time must complete before any safety-critical operation
    # MCU boots in ~14ms (per EN RC delay), relay engages after ~500ms
    t_mcu_boot: time = 14ms
    t_soft_start_delay: time = 500ms  # Time before relay bypass
    assert t_mcu_boot < t_soft_start_delay  # MCU ready before power stage
    
    # Dead-time budget (system-level)
    # Hardware programmed nominal: 305.4ns from the 34-kΩ RDT resistor.
    # Software configured: 300ns (in MCPWM registers)
    # IGBT turn-off: 245ns
    # Total margin: 300 - 245 = 55ns (>50ns minimum margin)
    t_dt_hw_nominal: time = 305.4ns
    t_dt_sw: time = 300ns
    t_igbt_off: time = 245ns
    assert t_dt_sw > t_igbt_off + 50ns  # Software dead-time provides margin
    
    # ===========================================================================
    # POWER CONNECTIONS
    # ===========================================================================
    
    # AC Input (external connectors)
    # Note: AC_L, AC_N, PE come from external connector
    
    # Power input outputs
    power_in.dc_bus.hv_plus ~ dc_bus_plus
    power_in.dc_bus.hv_minus ~ dc_bus_minus
    # The doubler midpoint (gnd_ref) is the high-current power return node.
    # It must NOT be shorted directly to logic/signal ground to prevent
    # AC mains potential on user-accessible circuits (S1) and to keep
    # tank return current out of the signal ground net (S3).
    power_return ~ power_in.dc_bus.gnd_ref  # Doubler midpoint = power return
    power_in.gnd ~ gnd  # PowerInput relay control return (SELV side)
    power_in.power_15v.vcc ~ vcc_15v
    # power_in already ties power_15v.gnd ~ gnd internally; redundant
    power_in.vcc_3v3 ~ vcc_3v3  # SELV supply for the isolated ZCD opto output
    power_in.pe ~ pe  # Protective earth, from the external AC connector
    
    # Auxiliary supply: 170VDC half-bus -> isolated 15V SELV rail
    # Replaces the floating power_mgmt.power_in_hv (P0-3)
    aux_supply.power_in.vcc ~ dc_bus_plus    # Half-bus input (~170VDC)
    aux_supply.power_in.gnd ~ power_return   # Referenced to doubler midpoint
    aux_supply.power_out.vcc ~ vcc_15v       # Isolated 15V output -> all downstream rails
    aux_supply.power_out.gnd ~ gnd           # SELV ground
    
    # Power management chain — 15V -> 3.3V
    # Note: 15V now comes from isolated AuxSupply, not from DC bus directly
    power_mgmt.power_15v.vcc ~ vcc_15v
    power_mgmt.power_15v.gnd ~ gnd
    
    power_mgmt.power_3v3.vcc ~ vcc_3v3
    # power_mgmt.power_3v3.gnd is already tied to power_mgmt.power_15v.gnd
    # inside PowerManagement; connect the shared ground once.
    
    # ===========================================================================
    # GROUND ARCHITECTURE — Floated SELV domain, PE-bonded (2026-07-26)
    #
    # REMOVED: the star join (`power_return ~ gnd`) that used to sit here.
    # That join made the AuxSupply transformer's SELV output ground (gnd) the
    # SAME NET as power_return -- the doubler midpoint, which tracks AC
    # Neutral through the common-mode choke (modules.ato: ac_n ~ cmc.W2_1 ~
    # dc_bus.gnd_ref). It shorted the IRM-10-15's 4.2kVAC isolation barrier
    # across, and is documented in full in
    # docs/hardware/IEC60335_CRITICAL_COMPONENTS.md and the "isolation
    # barrier is shorted" entry in docs/STRATEGY.md. See
    # docs/hardware/SELV_ISOLATION_REDESIGN.md for the complete fix,
    # including the exhaustive crossing survey this join's removal required.
    #
    # gnd is now referenced instead by bonding it DIRECTLY to protective
    # earth (pe), which already exists at the AC input connector and already
    # has a bond point on the power_return side (the Y1 capacitor,
    # modules.ato: dc_bus.gnd_ref ~ y_cap_pe ~ pe). Rationale:
    #   - A floating, unreferenced SELV domain is not safe either -- it
    #     capacitively couples to nearby HV nodes and drifts with EMI. A
    #     solid DC bond to a real, low-impedance reference (PE/chassis) is
    #     the standard answer for a Class I appliance (has PE) with an
    #     internal SELV domain, and it means a single HV->SELV insulation
    #     fault has a low-impedance path to trip branch overcurrent
    #     protection, rather than energizing an ungrounded domain that
    #     includes the user-touchable RTD probe.
    #   - This does NOT reintroduce the shorted-barrier problem: the Y1 cap
    #     bond (power_return -> PE) stays exactly as it was, a 2.2nF
    #     high-impedance AC/EMI-only path, doing its original common-mode
    #     job undisturbed. The new gnd -> PE bond is a separate, direct
    #     (0 ohm) DC path that never touches power_return. power_return and
    #     gnd remain two different nets, coupled only through whatever
    #     impedance exists from PE, through the Y-cap, back to power_return
    #     -- i.e. still isolated at DC, unlike before.
    #   - EMC: referencing the low-power digital domain to PE/chassis
    #     (rather than to the internally-generated, AC-N-tracking
    #     power_return) is the more common, generally quieter choice.
    #     LAYOUT REQUIREMENT (UNVERIFIED at the schematic level -- this is a
    #     PCB-layout concern, not a netlist one): the gnd->PE bond and the
    #     Y-cap's power_return->PE bond should land at the same physical PE
    #     stud/point near the AC inlet to keep the loop area between them
    #     small; this schematic cannot enforce that.
    # ===========================================================================
    gnd ~ pe  # SELV ground reference: bonded to protective earth, NOT to power_return

    # ===========================================================================
    # HALF-BRIDGE CONNECTIONS
    # ===========================================================================
    
    hb.dc_bus.hv_plus ~ dc_bus_plus
    # OCP-02 IS NOT WIRED IN. The shunt splice that belongs here is removed
    # deliberately -- as designed it would destroy the sense amplifier.
    #
    # docs/hardware/OCP02_DESIGN.md claimed a low-side shunt in DC_BUS_RTN
    # keeps the INA240's common mode near ground. That is wrong. This is a
    # voltage-doubler topology: `power_return` IS the doubler midpoint
    # (main.ato:247) and IS signal ground (main.ato:283), so DC_BUS_RTN sits
    # at roughly -170 V with respect to it. The INA240's common-mode range is
    # -4 V to +80 V, so the part would see ~170 V of common mode -- far
    # outside its absolute maximum.
    #
    # SecondaryOCPComparator remains defined in modules.ato with the
    # verified INA240 pinout, ready to wire once the sensing domain is
    # resolved. The options are a shunt at the doubler midpoint (common mode
    # ~0 V, but that is the tank return, which erodes OCP-02's independence
    # from OCP-01), an isolated amplifier (AMC1300 / ACPL-C79A class), or a
    # high-common-mode part. That is a topology decision, not a value change.
    hb.dc_bus.hv_minus ~ dc_bus_minus
    hb.power_15v.vcc ~ vcc_15v
    hb.power_15v.gnd ~ gnd
    hb.power_3v3.vcc ~ vcc_3v3
    # hb already ties power_3v3.gnd ~ gnd internally; redundant
    
    # Low-side gate driver supply: vcc_15v_ls must come from an isolated 
    # aux winding on the flyback transformer, referenced to hv_minus.
    # Until the transformer winding is specified (plan 005 magnetics
    # follow-up), this net is a placeholder.
    hb.power_15v_ls.vcc ~ vcc_15v_ls
    
    # PWM from MCU
    mcu.pwm_h ~ hb.pwm_h
    mcu.pwm_l ~ hb.pwm_l
    hb.pwm_h.override_net_name = "PWM_HS"
    hb.pwm_l.override_net_name = "PWM_LS"
    
    # ===========================================================================
    # RESONANT TANK CONNECTIONS
    # ===========================================================================
    
    hb.switch_node ~ tank.in
    hb.switch_node.override_net_name = "SW_NODE"
    # tank.in is the same electrical net as hb.switch_node; keep one
    # authoritative override name (SW_NODE).
    # CT primary: current transformer measures tank return current
    # The primary wire (tank return) passes through the CT core
    tank.out ~ ct_sense.primary_in
    ct_sense.primary_out ~ power_return  # Tank return passes THROUGH the CT primary
    
    # ===========================================================================
    # SENSING CONNECTIONS
    # ===========================================================================
    
    # Current sensing
    ct_sense.vcc_3v3_ct ~ vcc_3v3  # Bias supply for CT output
    ct_sense.i_sense.reference ~ gnd
    ct_sense.i_sense.line ~ mcu.adc_i_sense
    ct_sense.i_sense ~ safety.i_sense
    ct_sense.i_sense.line.override_net_name = "I_SENSE"
    
    # RTD temperature sensing (pan temperature)
    rtd_pan.power.vcc ~ vcc_3v3
    rtd_pan.power.gnd ~ gnd
    rtd_pan.cs.line ~ mcu.cs_rtd.line
    rtd_pan.spi.sclk ~ mcu.spi.sclk
    rtd_pan.spi.mosi ~ mcu.spi.mosi
    rtd_pan.spi.miso ~ mcu.spi.miso
    rtd_pan.drdy.line ~ mcu.rtd_drdy.line
    rtd_pan.drdy.line.override_net_name = "RTD_DRDY"
    rtd_pan.rtd_hw_fault.line ~ safety.rtd_hw_fault.line
    rtd_pan.rtd_hw_fault.line.override_net_name = "RTD_HW_FAULT"
    
    rtd_pan.spi.sclk.override_net_name = "RTD_SCK"
    rtd_pan.spi.mosi.override_net_name = "RTD_SDI"
    rtd_pan.spi.miso.override_net_name = "RTD_SDO"
    rtd_pan.cs.line.override_net_name = "RTD_CS_N"
    
    # ===========================================================================
    # SAFETY INTERLOCK CONNECTIONS
    # ===========================================================================
    
    safety.power_3v3.vcc ~ vcc_3v3
    safety.power_3v3.gnd ~ gnd
    safety.power_15v.vcc ~ vcc_15v
    safety.power_15v.gnd ~ gnd
    
    # Sensor inputs to safety system
    safety.dc_bus.line ~ dc_bus_plus
    safety.dc_bus.reference ~ gnd
    # safety.i_sense already connected above
    # NTC for heatsink temperature monitoring
    safety.ntc_sense.line ~ mcu.adc_ntc
    # safety already ties ntc_sense.reference ~ gnd internally; redundant
    mcu.adc_v_bus.override_net_name = "V_BUS_SENSE"
    safety.ovp.adc_v_bus.line ~ mcu.adc_v_bus

    # OVP-01 REF2025 re-reference (Option C, 2026-07-27, docs/evidence/
    # 2026-07-27-ovp01-ref2025-implementation.md): OVPComparator's comp.INN
    # is referenced to RTDSensing's REF2025.VREF (2.5V, +/-0.05%/8ppm/C)
    # instead of a resistor divider off vcc_3v3 -- see OVPComparator's
    # docstring and r_div_bot's comment for the full derivation. VREF was
    # otherwise completely unused; this is the only place it is wired.
    safety.ovp.vref_ext.line ~ rtd_pan.reference.VREF
    safety.ovp.vref_ext.line.override_net_name = "OVP_VREF_2V5"

    # Watchdog
    mcu.wdt_kick.line ~ safety.wdt_kick.line
    mcu.wdt_kick.line.override_net_name = "WDT_KICK"
    safety.wdt_reset_n.line ~ mcu.wdt_reset_in.line
    safety.wdt_reset_n.line.override_net_name = "WDT_RESET_N"
    
    # Shutdown output is active-high per the UCC21550 contract.
    safety.shutdown.line ~ hb.gate_hs.driver.DIS
    safety.shutdown.line.override_net_name = "SHUTDOWN"
    
    # Fault status to MCU
    safety.fault_status.line ~ mcu.fault_status_in.line
    # fault_status is the MCU sense alias of the same latched SHUTDOWN net;
    # do not assign a competing net name here.
    safety.reset_n_in.line ~ mcu.reset_n.line
    safety.runaway_cut.line ~ mcu.runaway_cut.line
    
    # Gate HS/LS
    hb.gate_hs.driver.OUTA.override_net_name = "GATE_HS"
    # Gate LS is RG_ON.p2 in the task description
    # hb.gate_ls.rg_on.p2 doesn't exist directly in Top, but we can access it via hb
    hb.gate_ls.rg_on.p2.override_net_name = "GATE_LS"
    
    # ===========================================================================
    # MCU CONNECTIONS
    # ===========================================================================
    
    mcu.power.vcc ~ vcc_3v3
    mcu.power.gnd ~ gnd

    # Fan supply
    thermal.power_15v.vcc ~ vcc_15v
    thermal.power_15v.gnd ~ gnd
    
    # Relay control for soft-start bypass
    mcu.relay_ctrl.line ~ power_in.relay_ctrl
    mcu.relay_ctrl.line.override_net_name = "RELAY_CTRL"

    # ===========================================================================
    # ACTIVE BUS DISCHARGE CONNECTIONS
    # One 2x4.7k/5W string + relay NC contact across each half-bus.
    # Coils held from the 15V rail while running; any power loss (or MCU
    # dead: IO47 boots Hi-Z) de-energizes the coils and the NC contacts
    # engage discharge -- <60s to <34V per half-bus, no MCU involvement.
    # ===========================================================================
    discharge.hv_plus ~ dc_bus_plus
    discharge.mid ~ power_return
    discharge.hv_minus ~ dc_bus_minus
    discharge.power_15v.vcc ~ vcc_15v
    # discharge already ties power_15v.gnd ~ gnd internally; connect once
    discharge.gnd ~ gnd
    mcu.discharge_ctrl.line ~ discharge.ctrl
    mcu.discharge_ctrl.line.override_net_name = "DISCHARGE_CTRL"
    
    # Zero-crossing detection for soft-start timing. Isolated via an H11L1
    # optocoupler inside PowerInput (2026-07-26, SELV isolation redesign) --
    # power_in.zcd (HV side, raw divider node) no longer leaves the module;
    # power_in.zcd_out is the SELV-side, galvanically isolated signal.
    power_in.zcd_out.line ~ mcu.zcd_in.line
    power_in.zcd_out.line.override_net_name = "ZCD_ISO"
    
    # USB connections
    mcu.usb_dn ~ usb_dn
    mcu.usb_dp ~ usb_dp
    
    # I2C UI connections
    mcu.i2c.sda ~ i2c_sda_ui
    mcu.i2c.scl ~ i2c_scl_ui

# ==============================================================================
# FOOTPRINT COMPILATION
# Instantiate generative footprints to ensure they compile
# ==============================================================================

module Footprints:
    igbt_fac = new IGBT_TO247
    driver_fac = new SOIC16W_Isolated
    litz_fac = new LitzPad_15A
    ct_fac = new CST1005_Footprint

# ==============================================================================
# TOP-LEVEL INSTANCES
# ==============================================================================

temper = new Top
footprints = new Footprints
