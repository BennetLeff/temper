component ESP32_S3_WROOM_1:
    """ESP32-S3 Module with WiFi/BLE"""
    footprint = "ESP32-S3-WROOM-1"  # Custom footprint
    mpn = "ESP32-S3-WROOM-1-N8R8"
    manufacturer = "Espressif"
    
    # Key characteristics
    flash_size = 8MB
    psram_size = 8MB
    
    # Power pins
    signal GND ~ pin 1
    signal VCC3V3 ~ pin 2
    
    # SPI pins (remapped to avoid conflict with PWM/Control)
    signal SPI_CLK ~ pin 12 # IO8
    signal SPI_CS ~ pin 18  # IO10
    signal SPI_MOSI ~ pin 19 # IO11
    signal SPI_MISO ~ pin 20 # IO12
    
    # GPIO for PWM
    signal GPIO16 ~ pin 9 # IO16
    signal GPIO17 ~ pin 10 # IO17
    
    # ADC pins
    signal GPIO1 ~ pin 39 # IO1
    signal GPIO2 ~ pin 38 # IO2
    signal GPIO3 ~ pin 15 # IO3
    
    # Control pins
    signal GPIO18 ~ pin 11 # IO18
    signal GPIO19 ~ pin 13 # IO19
    signal GPIO20 ~ pin 14 # IO20
    
    # UART (debug)
    signal TXD0 ~ pin 37 # TXD0
    signal RXD0 ~ pin 36 # RXD0
    
    # Status LEDs
    signal GPIO21 ~ pin 23 # IO21
    signal GPIO35 ~ pin 28 # IO35
    signal GPIO36 ~ pin 29 # IO36
    signal GPIO37 ~ pin 30 # IO37
    
    # I2C
    signal SDA ~ pin 4 # IO4 - Reassigning to valid pin
    signal SCL ~ pin 5 # IO5 - Reassigning to valid pin
    
    # Enable/Reset
    signal EN ~ pin 3

    # Internal IOs for ref (not all exposed)
    signal IO0 ~ pin 27
    signal IO1 ~ pin 39
    signal IO2 ~ pin 38
    signal IO3 ~ pin 15
    signal IO4 ~ pin 4
    signal IO5 ~ pin 5
    signal IO6 ~ pin 6
    signal IO7 ~ pin 7
    signal IO8 ~ pin 12
    signal IO9 ~ pin 17
    signal IO10 ~ pin 18
    signal IO11 ~ pin 19
    signal IO12 ~ pin 20
    signal IO13 ~ pin 21
    signal IO14 ~ pin 22
    signal IO15 ~ pin 8
    signal IO16 ~ pin 9
    signal IO17 ~ pin 10
    signal IO18 ~ pin 11
    signal IO19 ~ pin 13
    signal IO20 ~ pin 14
    signal IO21 ~ pin 23
    signal IO35 ~ pin 28
    signal IO36 ~ pin 29
    signal IO37 ~ pin 30
    signal IO38 ~ pin 31
    signal IO39 ~ pin 32
    signal IO40 ~ pin 33
    signal IO41 ~ pin 34
    signal IO42 ~ pin 35
    signal IO45 ~ pin 26
    signal IO46 ~ pin 16
    signal IO47 ~ pin 24
    signal IO48 ~ pin 25

