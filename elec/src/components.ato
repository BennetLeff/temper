component TPS3823:
    """Supervisor with Watchdog, 1.6s timeout"""
    footprint = "Package_TO_SOT_SMD:SOT-23-5"
    mpn = "TPS3823-33DBVR"
    manufacturer = "Texas Instruments"
    
    # Ratings
    wdt_timeout = 1.6s
    # VIT- (falling reset threshold), verified 2026-07-26 directly against
    # TI's TPS382x datasheet (SLVS165O, rev March 2025), TPS3823-33/
    # TPS3823A-33 row, -40C to 85C: min 2.86V, typ 2.93V, max 3.00V.
    # V_HYS (VIT+ - VIT-) = 30mV typ, no min/max given -- i.e. not a
    # guaranteed spec. Rising threshold VIT- + V_HYS = 2.89/2.96/3.03V
    # min/typ/max. The previous value here (3.08V) did not match either the
    # datasheet or docs/hardware/SAFETY_INTERLOCK_DESIGN.md's own secondhand
    # citation (2.93V) and its source was never established -- corrected.
    # This part fails UVL-02 (FUNCTIONAL_TEST_CRITERIA.md SS2.4: <2.9V
    # falling / >3.0V rising) in both directions even at nominal: 2.93V typ
    # falling trips ABOVE the 2.9V ceiling, and 2.96V typ rising recovers
    # BELOW the 3.0V floor. See docs/hardware/UVL02_DESIGN.md.
    v_threshold = 2.93V
    v_threshold_hysteresis = 30mV

    signal GND ~ pin 1
    signal RESET_N ~ pin 2
    signal MR_N ~ pin 3
    signal WDI ~ pin 4
    signal VDD ~ pin 5

component SN74HC4075:
    """Triple 3-Input OR Gate

    Pin map verified against the real datasheet-sourced pinout (Intersil
    CD4075, pin-compatible; cross-checked via KiCad's bundled 4xxx.kicad_sym
    "4075" symbol -- see docs/solutions/tooling-decisions/
    kicad-embedded-symbols-lose-pin-semantics-2026-07-14.md). The previous
    version of this model had gate 1 and gate 3 pin numbers wrong (Y1/C1
    swapped with gate 3's numbering); this was worked around directly in
    pcb/safety_interlock.kicad_sch's wiring but never corrected here until
    2026-07-14.
    """
    footprint = "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"
    mpn = "SN74HC4075DR"
    manufacturer = "Texas Instruments"

    signal A1 ~ pin 1
    signal B1 ~ pin 2
    signal A2 ~ pin 3
    signal B2 ~ pin 4
    signal C2 ~ pin 5
    signal Y2 ~ pin 6
    signal GND ~ pin 7
    signal C1 ~ pin 8
    signal Y1 ~ pin 9
    signal Y3 ~ pin 10
    signal A3 ~ pin 11
    signal B3 ~ pin 12
    signal C3 ~ pin 13
    signal VCC ~ pin 14

component SN74HC00:
    """Quad 2-Input NAND Gate"""
    footprint = "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"
    mpn = "SN74HC00DR"
    manufacturer = "Texas Instruments"
    
    signal A1 ~ pin 1
    signal B1 ~ pin 2
    signal Y1 ~ pin 3
    signal A2 ~ pin 4
    signal B2 ~ pin 5
    signal Y2 ~ pin 6
    signal GND ~ pin 7
    signal Y3 ~ pin 8
    signal A3 ~ pin 9
    signal B3 ~ pin 10
    signal Y4 ~ pin 11
    signal A4 ~ pin 12
    signal B4 ~ pin 13
    signal VCC ~ pin 14

# ==============================================================================
# MCU COMPONENTS  
