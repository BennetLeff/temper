# modules.ato
# Module definitions for Temper Induction Cooker
# Reference: pcb/*.kicad_sch

# Enable experimental features for interfaces
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("TRAITS")

import IKW40N120H3 from "components.ato"
import UCC21550BDWK from "components.ato"
import Resistor from "components.ato"
import Capacitor from "components.ato"
import MOSFET_N from "components.ato"
import Diode from "components.ato"
import HighVoltageConstraints from "constraints.ato"
import ACMainsConstraints from "constraints.ato"
import GateDriveConstraints from "constraints.ato"

# Import standard interfaces
import ElectricPower from "generics/interfaces.ato"
import SPI from "generics/interfaces.ato"
import ElectricLogic from "generics/interfaces.ato"
import I2C from "generics/interfaces.ato"
import UART from "generics/interfaces.ato"
import ElectricSignal from "generics/interfaces.ato"

# Custom Temper interfaces
import HighVoltageBus from "interfaces.ato"
import GateDrive from "interfaces.ato"
import CTInterface from "interfaces.ato"
import AnalogSense from "interfaces.ato"

# Power input components
import Fuse from "components.ato"
import NTC_Inrush from "components.ato"
import MUR1560 from "components.ato"
import ES1J from "components.ato"
import CapPolarized from "components.ato"
import Relay_SPST from "components.ato"
import MOV_Varistor from "components.ato"

# Power management components
import LMR51430 from "components.ato"
# import XC6220 from "components.ato"  # Removed: LDO3V3 replaced by BuckConverter3V3 (plan 005)
import Inductor from "components.ato"

# Sensing components
import MAX31865 from "components.ato"
# ADUM1250 I2C isolator no longer needed for RTD isolation; the isolation
# barrier is between the HV power domain and the SELV control domain
# (Option A, plan 003). Component definition retained in components.ato
# for future isolated I2C expansion if needed.
import CST2010_100L from "components.ato"
import IRM_10_15 from "components.ato"

# Safety components
import TLV3201 from "components.ato"
import TPS3823 from "components.ato"
import REF2025 from "components.ato"
import TPS3700 from "components.ato"
import SN74HC4075 from "components.ato"
import SN74HC00 from "components.ato"
import SN74LVC1G08 from "components.ato"
import SN74LVC1G38 from "components.ato"

# MCU
import ESP32_S3_WROOM_1 from "components.ato"
import TestPoint from "components.ato"
import Button from "components.ato"

module PowerLoop:
    constraints = new HighVoltageConstraints
    q_high = new IKW40N120H3
    q_low = new IKW40N120H3
    
    q_high.voltage_rating = 1200V
    q_high.current_rating = 40A
    q_low.voltage_rating = 1200V
    q_low.current_rating = 40A
    
    # Verify ratings against constraints (temper-ofq.6)
    assert q_high.voltage_rating >= constraints.v_max
    assert q_high.current_rating >= constraints.i_max
    assert q_low.voltage_rating >= constraints.v_max
    assert q_low.current_rating >= constraints.i_max

module GateDriveHS:
    constraints = new GateDriveConstraints
    driver = new UCC21550BDWK
    rg_on = new Resistor
    rgs = new Resistor
    boot_diode = new ES1J
    boot_cap = new Capacitor
    neg_bias_zener = new Diode
    
    # EMI Filters (temper-jf7)
    # 51Ω + 220pF provides >15dB attenuation @ 100MHz
    r_filt_a = new Resistor
    c_filt_a = new Capacitor
    r_filt_b = new Resistor
    c_filt_b = new Capacitor
    
    r_filt_a.value = 51ohm +/- 1%
    r_filt_a.mpn = "RC0603FR-0751RL"
    r_filt_a.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_filt_b.value = 51ohm +/- 1%
    r_filt_b.mpn = "RC0603FR-0751RL"
    r_filt_b.footprint = "Resistor_SMD:R_0603_1608Metric"

    c_filt_a.value = 220pF +/- 5%
    c_filt_a.dielectric = "C0G"
    c_filt_a.voltage_rating = 50V
    c_filt_a.mpn = "GRM1885C1H221JA01D"
    c_filt_a.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    c_filt_b.value = 220pF +/- 5%
    c_filt_b.dielectric = "C0G"
    c_filt_b.voltage_rating = 50V
    c_filt_b.mpn = "GRM1885C1H221JA01D"
    c_filt_b.footprint = "Capacitor_SMD:C_0603_1608Metric"

    # Input Signals
    signal pwm_in_a
    signal pwm_in_b

    # Filter Connections
    pwm_in_a ~ r_filt_a.p1
    r_filt_a.p2 ~ driver.INA
    driver.INA ~ c_filt_a.p1
    c_filt_a.p2 ~ driver.GNDI
    
    pwm_in_b ~ r_filt_b.p1
    r_filt_b.p2 ~ driver.INB
    driver.INB ~ c_filt_b.p1
    c_filt_b.p2 ~ driver.GNDI

    # Output interface to IGBT
    drive = new GateDrive
    
    boot_cap.value = 10uF +/- 20%
    boot_cap.dielectric = "X7R"
    boot_cap.voltage_rating = 50V
    boot_cap.mpn = "GRM32ER71H106KA12L"
    boot_cap.footprint = "Capacitor_SMD:C_1210_3225Metric"
    
    neg_bias_zener.voltage_rating = 5.1V
    neg_bias_zener.mpn = "BZT52C5V1-7-F"
    neg_bias_zener.footprint = "Diode_SMD:D_SOD-123"

    # Gate resistor: controls turn-on speed and dI/dt
    # Rg = 2.2Ω: 15V/2.2Ω ≈ 6.8A peak demand, UCC21550 limits to 4A source
    # Gate rise is driver-limited, not resistor-limited. This is acceptable
    # but a 3.9Ω resistor would match the driver's 4A capability.
    rg_on.value = 2.2ohm +/- 5%
    rg_on.power_rating = 0.5W
    rg_on.mpn = "RC1206FR-072R2L"
    rg_on.footprint = "Resistor_SMD:R_1206_3216Metric"

    # Gate-source pulldown: keeps gate low when driver off
    rgs.value = 2200ohm +/- 5%
    rgs.power_rating = 0.1W
    rgs.mpn = "RC0603FR-072K2L"
    rgs.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # Power assertion: gate resistor must handle average dissipation (temper-ip1.3)
    p_rg_avg: power = 0.25W
    assert rg_on.power_rating >= p_rg_avg * 1.5
    
    # Verify gate drive current within constraint (temper-ofq.6)
    assert driver.i_source_peak >= constraints.i_max
    
    # Connections
    driver.OUTA ~ rg_on.p1
    rg_on.p2 ~ drive.out
    rgs.p1 ~ drive.out
    rgs.p2 ~ drive.vss
    
    # Zener negative-bias clamp:
    #   cathode (K) → switch node / IGBT emitter (drive.vss)
    #   anode (A)   → driver VSSA
    # This establishes VSSA = switch_node - Vz.
    # When driver output is LOW: gate = VSSA = emitter - 5.1V → V_GS = -5.1V
    # True negative off-bias; boot cap charges to full VDD (15V).
    
    # Connections:
    # driver.OUTA ~ rg_on.p1
    # rg_on.p2 ~ drive.out
    # rgs.p1 ~ drive.out
    # rgs.p2 ~ drive.vss
    
    # Zener connections (negative bias):
    neg_bias_zener.A ~ driver.VSSA
    neg_bias_zener.K ~ drive.vss
    boot_cap.p2 ~ driver.VSSA
    boot_cap.p1 ~ driver.VDDA
    boot_diode.K ~ driver.VDDA
    
    # Inputs
    # vcc_15v (from HalfBridge) ~ boot_diode.A

module GateDriveLS:
    rg_on = new Resistor
    rgs = new Resistor
    
    drive = new GateDrive
    signal input
    signal input_ref

    # Gate resistor: controls turn-on speed and dI/dt
    rg_on.value = 2.2ohm +/- 5%
    rg_on.power_rating = 0.5W
    rg_on.mpn = "RC1206FR-072R2L"
    rg_on.footprint = "Resistor_SMD:R_1206_3216Metric"

    # Gate-source pulldown: keeps gate low when driver off
    rgs.value = 2200ohm +/- 5%
    rgs.power_rating = 0.1W
    rgs.mpn = "RC0603FR-072K2L"
    rgs.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # Power assertion (temper-ip1.3)
    p_rg_avg: power = 0.25W
    assert rg_on.power_rating >= p_rg_avg * 1.5
    
    # Connections
    input ~ rg_on.p1
    input_ref ~ rgs.p2
    rg_on.p2 ~ drive.out
    rgs.p1 ~ drive.out
    rgs.p2 ~ drive.vss
    drive.vss ~ input_ref

module HalfBridge:
    # Interface
    signal pwm_h
    pwm_h.required = true
    signal pwm_l
    pwm_l.required = true
    # HalfBridge owns the required declarations for the shared PWM inputs;
    # MCU exposes these nets without a second required assignment so the
    # connected endpoints have one authoritative value.
    
    constraints = new HighVoltageConstraints
    # UCC21550 VCCI is the 3.0–5.5 V control-side supply. Keep it separate
    # from the 15 V secondary gate-drive rail (VDDA/VDDB).
    power_3v3 = new ElectricPower
    power_15v = new ElectricPower
    power_15v_ls = new ElectricPower  # Low-side gate driver supply, MUST float on hv_minus
    dc_bus = new HighVoltageBus
    
    signal switch_node
    
    # Instances (Critical Loop Grouping)
    power_loop = new PowerLoop
    gate_hs = new GateDriveHS
    gate_ls = new GateDriveLS

    # Dead-time config
    # TI's nominal relationship is t_DT(ns) ~= 8.6 * R_DT(kohm) + 13;
    # 34 kohm gives 305.4 ns nominal from TI's equation. The bounded corner
    # model shows that IC/temperature variation can fall below 300 ns, so this
    # is a nominal starting value only; scope verification remains required.
    dt_res = new Resistor
    dt_res.value = 34kohm +/- 1%
    dt_res.power_rating = 0.1W
    dt_res.voltage_rating = 10V
    dt_res.mpn = "RC0603FR-0734KL"
    dt_res.footprint = "Resistor_SMD:R_0603_1608Metric"
    dt_res.p1 ~ gate_hs.driver.DT
    dt_res.p2 ~ gate_hs.driver.GNDI

    # t_dead_time per TI UCC21550 datasheet: t_DT(ns) ≈ 8.6 × R_DT(kΩ) + 13
    # With R_DT = 34kΩ: t_DT ≈ 8.6 × 34 + 13 ≈ 305.4ns (nominal)
    # Scope verification required — corner model may fall below 300ns
    t_dead_time: time = 305.4ns
    assert t_dead_time within 300ns to 310ns
    
    # UCC21550 bypass capacitors
    # VCCI bypass: 0.1µF + 1µF at each VCCI pin
    c_vcci1 = new Capacitor
    c_vcci1.value = 100nF +/- 10%
    c_vcci1.dielectric = "X7R"
    c_vcci1.voltage_rating = 16V
    c_vcci1.mpn = "GRM188R71E104KA01D"
    c_vcci1.footprint = "Capacitor_SMD:C_0603_1608Metric"
    power_3v3.vcc ~ c_vcci1.p1
    c_vcci1.p2 ~ power_3v3.gnd

    c_vcci2 = new Capacitor
    c_vcci2.value = 1uF +/- 10%
    c_vcci2.dielectric = "X7R"
    c_vcci2.voltage_rating = 16V
    c_vcci2.mpn = "GRM188R71C105KA12D"
    c_vcci2.footprint = "Capacitor_SMD:C_0603_1608Metric"
    power_3v3.vcc ~ c_vcci2.p1
    c_vcci2.p2 ~ power_3v3.gnd

    # VDDA bypass (high-side): placed at the gate driver IC
    c_vdda = new Capacitor
    c_vdda.value = 100nF +/- 10%
    c_vdda.dielectric = "X7R"
    c_vdda.voltage_rating = 25V
    c_vdda.mpn = "GRM188R71E104KA01D"
    c_vdda.footprint = "Capacitor_SMD:C_0603_1608Metric"
    gate_hs.driver.VDDA ~ c_vdda.p1
    c_vdda.p2 ~ gate_hs.driver.VSSA

    # VDDB bypass (low-side): placed at the gate driver IC
    c_vddb = new Capacitor
    c_vddb.value = 100nF +/- 10%
    c_vddb.dielectric = "X7R"
    c_vddb.voltage_rating = 25V
    c_vddb.mpn = "GRM188R71E104KA01D"
    c_vddb.footprint = "Capacitor_SMD:C_0603_1608Metric"
    gate_hs.driver.VDDB ~ c_vddb.p1
    c_vddb.p2 ~ gate_hs.driver.VSSB

    # DC bus HF bypass: film cap across HV+/HV- near the bridge
    c_dc_hf = new Capacitor
    c_dc_hf.value = 470nF +/- 10%
    c_dc_hf.dielectric = "PP"
    c_dc_hf.voltage_rating = 630V
    c_dc_hf.mpn = "B32671L6474K000"  # EPCOS/TDK 0.47µF 630VDC PP film
    c_dc_hf.footprint = "Capacitor_THT:C_Rect_L18.0mm_W11.0mm_P15.00mm_FKS3_FKP3"
    dc_bus.hv_plus ~ c_dc_hf.p1
    c_dc_hf.p2 ~ dc_bus.hv_minus
    
    # IGBT timing
    t_igbt_turn_off: time = 245ns
    t_dead_time_required: time = 300ns
    
    # Constraint Assignments
    dc_bus.v_max = constraints.v_max
    # Keep the limit on the HighVoltageBus interface. Repeating v_max on the
    # connected switch-node net makes Atopile merge two separately-defined
    # values for the same attribute.
    
    # Connections - Primary Side
    pwm_h ~ gate_hs.pwm_in_a
    pwm_l ~ gate_hs.pwm_in_b
    power_3v3.vcc ~ gate_hs.driver.VCCI_1
    power_3v3.vcc ~ gate_hs.driver.VCCI_2
    power_3v3.gnd ~ gate_hs.driver.GNDI
    power_15v.gnd ~ gate_hs.driver.GNDI

    # Power Stage Connections
    dc_bus.hv_plus ~ power_loop.q_high.C
    power_loop.q_high.E ~ switch_node
    switch_node ~ power_loop.q_low.C
    power_loop.q_low.E ~ dc_bus.hv_minus

    # High Side Drive
    gate_hs.drive.out ~ power_loop.q_high.G
    gate_hs.drive.vss ~ power_loop.q_high.E

    # High Side Power (Bootstrap)
    power_15v.vcc ~ gate_hs.boot_diode.A
    # Internal connections handled in GateDriveHS
    # Just need to connect Zener Anode (drive.vss) to switch_node
    gate_hs.drive.vss ~ switch_node

    # Low Side Drive
    gate_hs.driver.OUTB ~ gate_ls.input
    dc_bus.hv_minus ~ gate_hs.driver.VSSB # VSSB is driver output ref
    gate_hs.driver.VSSB ~ gate_ls.input_ref
    
    gate_ls.drive.out ~ power_loop.q_low.G
    gate_ls.drive.vss ~ power_loop.q_low.E

    # Low Side Power — supply MUST be referenced to hv_minus (VSSB).
    # VDDB and VSSB are the secondary-side supply pins for channel B of the
    # UCC21550. VDDB must stay within 25V of VSSB (abs max, v_cc_sec_max).
    # This supply must come from an isolated auxiliary winding or DC-DC
    # module floating on hv_minus (plan 005).
    power_15v_ls.vcc ~ gate_hs.driver.VDDB
    power_15v_ls.gnd ~ dc_bus.hv_minus  # Referenced to hv_minus, NOT logic gnd
    power_15v_ls.voltage = 15V
    assert power_15v_ls.voltage <= gate_hs.driver.v_cc_sec_max
    # VSSB connected above to dc_bus.hv_minus

module ResonantTank:
    signal in
    signal out
    
    c_tank1 = new Capacitor
    c_tank1.value = 150nF
    c_tank1.dielectric = "PP"
    c_tank1.voltage_rating = 1600V
    c_tank1.mpn = "FKP1U021507E00JSSD"
    c_tank1.footprint = "Capacitor_THT:C_Rect_L31.5mm_W13.0mm_P27.50mm_MKS4"
    
    c_tank2 = new Capacitor
    c_tank2.value = 150nF
    c_tank2.dielectric = "PP"
    c_tank2.voltage_rating = 1600V
    c_tank2.mpn = "FKP1U021507E00JSSD"
    c_tank2.footprint = "Capacitor_THT:C_Rect_L31.5mm_W13.0mm_P27.50mm_MKS4"
    
    v_tank_peak: voltage = 400V
    assert c_tank1.voltage_rating >= v_tank_peak * 1.43
    assert c_tank2.voltage_rating >= v_tank_peak * 1.43
    
    inductor_conn = new Resistor # Placeholder for Litz interface
    inductor_conn.mpn = "CUSTOM_LITZ_COIL"
    inductor_conn.footprint = "LitzPad_15A"
    
    in ~ c_tank1.p1
    in ~ c_tank2.p1
    c_tank1.p2 ~ inductor_conn.p1
    c_tank2.p2 ~ inductor_conn.p1
    inductor_conn.p2 ~ out

module PowerInput:
    """AC input with EMI filter, soft-start, and voltage doubler."""

    # WARNING: Bus capacitors store hazardous energy (>300VDC combined).
    # Discharge after power-off: ~9 minutes to safe level (<34V).
    # Always verify bus voltage with a meter before servicing.

    constraints = new ACMainsConstraints
    
    dc_bus = new HighVoltageBus
    
    signal ac_l
    ac_l.required = true
    signal ac_n
    ac_n.required = true
    signal pe
    pe.required = true
    signal gnd
    signal zcd
    signal relay_ctrl
    power_15v = new ElectricPower

    fuse = new Fuse
    fuse.current_rating = 16A
    fuse.voltage_rating = 250V
    # VERIFIED 2026-07-16: 0034.3128 is the 12.5A FST variant — under the 15A
    # branch load. 0034.3129 is the 16A time-lag 5x20 sibling (same footprint).
    fuse.mpn = "0034.3129"
    assert fuse.current_rating >= constraints.i_max
    assert fuse.voltage_rating >= constraints.v_max
    
    # MOV: 150VAC surge protection across L-N (after fuse)
    mov = new MOV_Varistor
    mov.voltage_rating = 150V
    mov.mpn = "V150LA10AP"
    mov.footprint = "Varistor:RV_Disc_D15.5mm_W5.2mm_P7.5mm"

    # X2 EMI capacitor: differential-mode filtering L-N (after fuse, after MOV)
    c_x2 = new Capacitor
    c_x2.value = 0.22uF +/- 20%
    c_x2.dielectric = "X2"
    c_x2.voltage_rating = 310V
    c_x2.mpn = "DE2E3KH221MA3B"
    c_x2.footprint = "Capacitor_THT:C_Disc_D10.0mm_W5.0mm_P5.00mm"

    # CMC: common-mode choke for conducted EMI suppression
    # Two windings modeled as two inductors in the signal path
    cmc_w1 = new Inductor
    cmc_w1.value = 10mH
    cmc_w1.current_rating = 15A
    cmc_w1.dcr = 0.02ohm
    cmc_w1.mpn = "B82725J2152N1"  # VERIFY: EPCOS B82725J ring-core double choke — confirm exact variant & 15A/250VAC rating
    cmc_w1.footprint = "Inductor_THT:L_Toroid_Horizontal_D25.4mm_P22.90mm_Vishay_TJ5"

    cmc_w2 = new Inductor
    cmc_w2.value = 10mH
    cmc_w2.current_rating = 15A
    cmc_w2.dcr = 0.02ohm
    cmc_w2.mpn = "B82725J2152N1"
    cmc_w2.footprint = "Inductor_THT:L_Toroid_Horizontal_D25.4mm_P22.90mm_Vishay_TJ5"
    
    ntc = new NTC_Inrush
    ntc.resistance_cold = 10ohm
    ntc.current_rating = 15A
    
    bypass_relay = new Relay_SPST
    bypass_relay.coil_voltage = 12V
    bypass_relay.contact_current = 20A
    bypass_relay.mpn = "G4A-1A-E DC12"
    bypass_relay.footprint = "temper:Relay_SPST_Omron-G4A-E"

    # Coil driver: RELAY_CTRL (3.3V GPIO) cannot drive the 75mA/12V coil directly.
    q_relay_drv = new MOSFET_N
    q_relay_drv.mpn = "AO3400A"

    r_relay_drop = new Resistor
    r_relay_drop.value = 39ohm +/- 5%
    r_relay_drop.power_rating = 1W
    r_relay_drop.voltage_rating = 25V
    r_relay_drop.mpn = "RSF100JB-73-39R"  # Yageo 1W axial metal film 39Ω ±5%
    r_relay_drop.footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"

    r_gate = new Resistor
    r_gate.value = 1kohm +/- 5%
    r_gate.power_rating = 0.125W
    r_gate.voltage_rating = 25V
    r_gate.mpn = "CRCW08051K00FKEA"
    r_gate.footprint = "Resistor_SMD:R_0805_2012Metric"

    r_gate_pd = new Resistor
    r_gate_pd.value = 100kohm +/- 5%
    r_gate_pd.power_rating = 0.125W
    r_gate_pd.voltage_rating = 25V
    r_gate_pd.mpn = "CRCW0805100KFKEA"
    r_gate_pd.footprint = "Resistor_SMD:R_0805_2012Metric"

    d_flyback = new Diode
    d_flyback.mpn = "SS14"
    d_flyback.voltage_rating = 40V
    d_flyback.current_rating = 1A
    d_flyback.footprint = "Diode_SMD:D_SMA"


    d1 = new MUR1560
    d2 = new MUR1560
    
    c_bus1 = new CapPolarized
    c_bus1.value = 1800uF
    c_bus1.voltage_rating = 250V
    # Chemi-Con KMQ 250V snap-in, largest of the series (CAT E1001E, verified
    # 2026-07-16). Two in parallel per half-bus replace the fictional
    # 3300uF/250V EKZE part; 2x 2.7Arms@120Hz ripple rating per half.
    c_bus1.mpn = "EKMQ251VSN182MA50S"
    c_bus1.footprint = "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn"
    
    c_bus2 = new CapPolarized
    c_bus2.value = 1800uF
    c_bus2.voltage_rating = 250V
    c_bus2.mpn = "EKMQ251VSN182MA50S"
    c_bus2.footprint = "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn"

    # Parallel partners: 2x 1800uF per half-bus = 3600uF (>= the original
    # 3300uF target for ripple), since no single 3300uF/250V snap-in exists
    # in this family.
    c_bus1b = new CapPolarized
    c_bus1b.value = 1800uF
    c_bus1b.voltage_rating = 250V
    c_bus1b.mpn = "EKMQ251VSN182MA50S"
    c_bus1b.footprint = "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn"
    c_bus2b = new CapPolarized
    c_bus2b.value = 1800uF
    c_bus2b.voltage_rating = 250V
    c_bus2b.mpn = "EKMQ251VSN182MA50S"
    c_bus2b.footprint = "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn"
    
    r_bleed1 = new Resistor
    r_bleed1.value = 22kohm +/- 1%
    r_bleed1.power_rating = 2W
    r_bleed1.voltage_rating = 250V
    r_bleed1.mpn = "CRGP2512F22K"  # VERIFIED 2026-07-16: CRGP2512 = 2W@70C pulse-withstanding; orderable variant is F (1%)
    r_bleed1.footprint = "Resistor_SMD:R_2512_6332Metric"
    
    r_bleed2 = new Resistor
    r_bleed2.value = 22kohm +/- 1%
    r_bleed2.power_rating = 2W
    r_bleed2.voltage_rating = 250V
    r_bleed2.mpn = "CRGP2512F22K"  # VERIFIED 2026-07-16: CRGP2512 = 2W@70C pulse-withstanding; orderable variant is F (1%)
    r_bleed2.footprint = "Resistor_SMD:R_2512_6332Metric"
    
    v_bus_half: voltage = 170V
    # WARNING: Discharge τ = 22kΩ × 3300μF ≈ 73s per half-bus.
    # Discharge to <34V: ~4.6 min per half-bus (~9 min total).
    # Add active discharge circuit before production.
    p_bleed_actual: power = v_bus_half * v_bus_half / r_bleed1.value  # 170V x 170V / 22kΩ ≈ 1.31W
    
    # Voltage derating check (temper-ofq.2)
    assert r_bleed1.voltage_rating >= v_bus_half * 1.25
    assert r_bleed2.voltage_rating >= v_bus_half * 1.25
    
    # Power handling check (temper-ip1.3)
    assert r_bleed1.power_rating >= p_bleed_actual * 0.5  # 50% derating
    assert r_bleed2.power_rating >= p_bleed_actual * 0.5
    
    # Voltage derating for electrolytic capacitors
    assert c_bus1.voltage_rating >= v_bus_half * 1.25
    assert c_bus2.voltage_rating >= v_bus_half * 1.25
    
    # Connections
    ac_l ~ fuse.p1
    # MOV and X2 cap: parallel across L-N after fuse
    fuse.p2 ~ mov.p1
    mov.p2 ~ ac_n
    fuse.p2 ~ c_x2.p1
    c_x2.p2 ~ ac_n
    # CMC: L path — fuse → CMC winding 1 → NTC/relay
    fuse.p2 ~ cmc_w1.p1
    cmc_w1.p2 ~ ntc.p1
    ntc.p2 ~ d1.A
    
    cmc_w1.p2 ~ bypass_relay.COM
    bypass_relay.NO ~ d1.A

    r_gate.p1 ~ relay_ctrl
    r_gate.p2 ~ q_relay_drv.G
    r_gate_pd.p1 ~ q_relay_drv.G
    r_gate_pd.p2 ~ gnd

    r_relay_drop.p1 ~ power_15v.vcc
    r_relay_drop.p2 ~ bypass_relay.coil1
    d_flyback.K ~ bypass_relay.coil1
    d_flyback.A ~ bypass_relay.coil2
    q_relay_drv.D ~ bypass_relay.coil2
    q_relay_drv.S ~ gnd
    power_15v.gnd ~ gnd
    
    d1.K ~ dc_bus.hv_plus
    c_bus1.plus ~ dc_bus.hv_plus
    c_bus1.minus ~ dc_bus.gnd_ref
    c_bus1b.plus ~ dc_bus.hv_plus
    c_bus1b.minus ~ dc_bus.gnd_ref
    
    ac_n ~ cmc_w2.p1
    cmc_w2.p2 ~ dc_bus.gnd_ref
    d2.K ~ d1.A
    d2.A ~ dc_bus.hv_minus
    c_bus2.plus ~ dc_bus.gnd_ref
    c_bus2.minus ~ dc_bus.hv_minus
    c_bus2b.plus ~ dc_bus.gnd_ref
    c_bus2b.minus ~ dc_bus.hv_minus
    
    r_bleed1.p1 ~ dc_bus.hv_plus
    r_bleed1.p2 ~ dc_bus.gnd_ref
    r_bleed2.p1 ~ dc_bus.gnd_ref
    r_bleed2.p2 ~ dc_bus.hv_minus
    
    # Y-capacitor: PE bonding from doubler midpoint to protective earth.
    # Class I appliance pattern: provides EMI return path from the power
    # return net to PE without a DC short. Y1 safety rating required
    # per IEC 60335-1 for line-to-ground (250VAC) applications.
    y_cap_pe = new Capacitor
    y_cap_pe.value = 2.2nF +/- 20%
    y_cap_pe.dielectric = "Y1"
    y_cap_pe.voltage_rating = 250V  # Y1 certified 250VAC line-to-ground
    y_cap_pe.mpn = "DE1E3KX222MA4BA01"
    y_cap_pe.footprint = "Capacitor_THT:C_Disc_D10.0mm_W5.0mm_P5.00mm"
    
    dc_bus.gnd_ref ~ y_cap_pe.p1
    y_cap_pe.p2 ~ pe
    
    # Zero-crossing detection: resistive divider from AC line
    # Provides a scaled, clamped AC signal to the MCU for soft-start timing
    r_zcd_top1 = new Resistor
    r_zcd_top1.value = 220kohm +/- 5%
    r_zcd_top1.power_rating = 0.25W
    r_zcd_top1.voltage_rating = 250V
    r_zcd_top1.mpn = "RC1206FR-07220KL"
    r_zcd_top1.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_zcd_top2 = new Resistor
    r_zcd_top2.value = 220kohm +/- 5%
    r_zcd_top2.power_rating = 0.25W
    r_zcd_top2.voltage_rating = 250V
    r_zcd_top2.mpn = "RC1206FR-07220KL"
    r_zcd_top2.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_zcd_bot = new Resistor
    r_zcd_bot.value = 10kohm +/- 5%
    r_zcd_bot.power_rating = 0.1W
    r_zcd_bot.mpn = "RC0603FR-0710KL"
    r_zcd_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # ZCD clamping: 3.3V zener to protect MCU input
    d_zcd_clamp = new Diode
    d_zcd_clamp.voltage_rating = 3.3V
    d_zcd_clamp.mpn = "BZT52C3V3-7-F"
    d_zcd_clamp.footprint = "Diode_SMD:D_SOD-123"
    
    # Divider: AC_L -> 220k -> 220k -> zcd -> 10k -> GND
    # At 120VAC peak (170V): V_zcd = 170 * 10k/(220k+220k+10k) ~= 3.78V
    # Zener clamps to 3.3V protecting MCU input
    # TODO: ZCD signal crosses isolation barrier (HV -> SELV).
    # Option A: Add optocoupler (H11L1) for isolated ZCD
    # Option B: Place ZCD divider on SELV side (post-isolation aux winding)
    # For now, ZCD is on HV side; plan for optocoupler in follow-up.
    ac_l ~ r_zcd_top1.p1
    r_zcd_top1.p2 ~ r_zcd_top2.p1
    r_zcd_top2.p2 ~ zcd
    zcd ~ r_zcd_bot.p1
    r_zcd_bot.p2 ~ dc_bus.gnd_ref
    zcd ~ d_zcd_clamp.K
    d_zcd_clamp.A ~ dc_bus.gnd_ref


module BuckConverter3V3:
    """3.3V synchronous buck converter for MCU and logic.
    Replaces XC6220 LDO which had Vin_max=6V but was fed from 15V rail (P0-7).
    Uses a simple buck topology suitable for 15V→3.3V conversion at ~1A."""
    
    power_in = new ElectricPower
    power_out = new ElectricPower
    power_out.voltage = 3.3V
    enable = new ElectricLogic
    enable.reference ~ power_in.gnd
    
    c_in = new Capacitor
    c_in.value = 10uF +/- 20%
    c_in.dielectric = "X7R"
    c_in.voltage_rating = 25V
    c_in.mpn = "GRM32ER71E106KA12L"
    c_in.footprint = "Capacitor_SMD:C_1210_3225Metric"
    
    c_out = new Capacitor
    c_out.value = 22uF +/- 20%
    c_out.dielectric = "X7R"
    c_out.voltage_rating = 10V
    c_out.mpn = "GRM31CR71A226KE15L"
    c_out.footprint = "Capacitor_SMD:C_1206_3216Metric"
    
    c_out_hf = new Capacitor
    c_out_hf.value = 100nF +/- 10%
    c_out_hf.dielectric = "X7R"
    c_out_hf.voltage_rating = 10V
    c_out_hf.mpn = "GRM188R71E104KA01D"
    c_out_hf.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    # Inductor placeholder (specific buck converter IC TBD)
    l_out = new Inductor
    l_out.value = 10uH
    l_out.current_rating = 1.5A
    l_out.dcr = 0.1ohm
    l_out.mpn = "SRP1265A-100M"
    l_out.footprint = "Inductor_SMD:L_Bourns_SRP1265A"
    
    power_in.vcc ~ c_in.p1
    c_in.p2 ~ power_in.gnd
    enable.line ~ power_in.vcc
    
    power_out.vcc ~ c_out.p1
    c_out.p2 ~ power_out.gnd
    power_out.vcc ~ c_out_hf.p1
    c_out_hf.p2 ~ power_out.gnd
    
    # Ground
    power_in.gnd ~ power_out.gnd
    
    assert power_out.voltage within 3.3V +/- 5%

module PowerManagement:
    """Power management subsystem: 15V -> 3.3V.
    
    15V is supplied by the isolated AuxSupply module (plan 005).
    The 3.3V buck converter replaces the XC6220 LDO which had Vin_max=6V
    but was fed from the 15V rail (P0-7)."""
    
    power_15v = new ElectricPower  # 15V input from AuxSupply
    power_3v3 = new ElectricPower  # 3.3V output to MCU/logic
    
    buck_3v3 = new BuckConverter3V3
    
    # Connections
    power_15v ~ buck_3v3.power_in
    buck_3v3.enable.line ~ power_15v.vcc
    
    buck_3v3.power_out ~ power_3v3
    
    # Ground chain
    power_15v.gnd ~ power_3v3.gnd

module AuxSupply:
    """Offline isolated auxiliary power supply. 
    Takes rectified AC (~170VDC from half-bus) and produces an isolated 15V rail
    for gate drivers, relay, and downstream regulation.
    Uses a LinkSwitch-TN or VIPer-based flyback topology.
    The transformer provides galvanic isolation between HV and SELV domains."""
    
    power_in = new ElectricPower    # ~170VDC from half-bus (post-rectifier)
    power_out = new ElectricPower   # Isolated 15V output (SELV side)
    power_out.voltage = 15V
    
    enable = new ElectricLogic
    enable.reference ~ power_in.gnd
    
    # Mean Well IRM-10-15 encapsulated AC/DC module does the actual
    # conversion: 170VDC half-bus in (120-430VDC rated), isolated 15V out.
    psu = new IRM_10_15
    
    # Input bulk capacitor
    c_in_bulk = new Capacitor
    c_in_bulk.value = 10uF +/- 20%
    c_in_bulk.dielectric = "X7R"
    c_in_bulk.voltage_rating = 250V
    c_in_bulk.mpn = "GRM55DR72E106KW01L"
    c_in_bulk.footprint = "Capacitor_SMD:C_2220_5750Metric"
    
    # Output filter
    c_out = new Capacitor
    c_out.value = 100uF +/- 20%
    c_out.dielectric = "X7R"
    c_out.voltage_rating = 25V
    c_out.mpn = "GRM32ER71E107ME15L"  # 100uF 25V X7R 1210
    c_out.footprint = "Capacitor_SMD:C_1210_3225Metric"
    
    c_out_hf = new Capacitor
    c_out_hf.value = 100nF +/- 10%
    c_out_hf.dielectric = "X7R"
    c_out_hf.voltage_rating = 25V
    c_out_hf.mpn = "GRM188R71E104KA01D"
    c_out_hf.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    # Connections
    power_in.vcc ~ c_in_bulk.p1
    c_in_bulk.p2 ~ power_in.gnd
    power_in.vcc ~ psu.ACL
    power_in.gnd ~ psu.ACN
    psu.VP ~ power_out.vcc
    psu.VN ~ power_out.gnd
    
    power_out.vcc ~ c_out.p1
    c_out.p2 ~ power_out.gnd
    power_out.vcc ~ c_out_hf.p1
    c_out_hf.p2 ~ power_out.gnd
    
    enable.line ~ power_in.vcc  # Always on when input present
    
    # Verify output voltage
    assert power_out.voltage within 15V +/- 10%
    
    # Power budget assertion: must supply gate driver + relay + MCU + safety logic
    # Gate driver: ~2W (2 channels, switching), Relay coil: ~1W (75mA @ 12V),
    # MCU+logic: ~1.5W (500mA @ 3.3V after downstream buck)
    # Total: ~5W. Design for 8W for margin.
    p_out_max: power = 8W
    assert c_in_bulk.voltage_rating >= 170V * 1.25  # half-bus + margin

module CurrentSensing:
    """Current transformer with burden resistor."""
    
    signal primary_in
    primary_in.required = true
    
    i_sense = new ElectricSignal
    
    signal primary_out
    ct = new CST2010_100L
    
    r_burden = new Resistor
    # 1:100 ratio: 6.65R keeps the OCP trip at 2.5V/6.65R*100 = 37.6A,
    # identical to the old 1:1000 * 66.5R design point. Steady-state 15A RMS
    # dissipates 0.15W; the 0.94W seen at the trip level is transient (the
    # latch kills PWM within microseconds).
    r_burden.value = 6.65ohm +/- 1%
    r_burden.power_rating = 0.25W
    r_burden.mpn = "RC1206FR-076R65L"
    r_burden.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    i_ct_max: current = 250mA  # 25A peak / 100
    v_burden_max: voltage = i_ct_max * r_burden.value
    assert v_burden_max within 1.5V to 1.8V
    
    c_filter = new Capacitor
    c_filter.value = 100nF
    c_filter.dielectric = "C0G"
    c_filter.voltage_rating = 16V
    c_filter.mpn = "GRM1885C1H104JA01D"
    c_filter.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    primary_in ~ ct.P1
    ct.P2 ~ primary_out
    ct.S1 ~ r_burden.p1
    ct.S2 ~ i_sense.reference
    r_burden.p2 ~ i_sense.reference
    ct.S1 ~ i_sense.line
    i_sense.line ~ c_filter.p1
    c_filter.p2 ~ i_sense.reference
    
    # DC bias network: 1.65V mid-rail for bipolar CT output
    r_bias_top = new Resistor
    r_bias_top.value = 10kohm +/- 1%
    r_bias_top.mpn = "RC0603FR-0710KL"
    r_bias_top.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_bias_bot = new Resistor
    r_bias_bot.value = 10kohm +/- 1%
    r_bias_bot.mpn = "RC0603FR-0710KL"
    r_bias_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # Bias injection: VCC_3V3 -> r_bias_top -> I_SENSE -> r_bias_bot -> GND
    signal vcc_3v3_ct
    vcc_3v3_ct ~ r_bias_top.p1
    r_bias_top.p2 ~ i_sense.line
    i_sense.line ~ r_bias_bot.p1
    r_bias_bot.p2 ~ i_sense.reference

module RTDSensing:
    """MAX31865 RTD interface for PT100.
    
    Isolation: With Option A (isolated SELV control domain, plan 003), the
    RTD probe and MAX31865 are on the SELV side — galvanically isolated from
    the HV power domain by the auxiliary supply transformer. The user-touchable
    RTD food probe is therefore separated from AC mains potential. The
    isolation barrier sits between the HV domain (DC bus, IGBTs, resonant
    tank) and the SELV control domain (MCU, sensors, gate-driver control side),
    NOT at the RTD interface itself.
    """
    
    power = new ElectricPower
    power.voltage = 3.3V
    spi = new SPI
    cs = new ElectricLogic
    drdy = new ElectricLogic
    rtd_hw_fault = new ElectricLogic
    rtd_hw_fault.reference ~ power.gnd
    rtd_hw_fault.line.required = true
    
    # Assertions
    assert power.voltage within 3.3V +/- 10%
    
    signal rtd_force_p
    rtd_force_p.required = true
    signal rtd_force_n
    rtd_force_n.required = true
    signal rtd_sense_p
    rtd_sense_p.required = true
    signal rtd_sense_n
    rtd_sense_n.required = true
    
    adc = new MAX31865
    
    r_ref = new Resistor
    r_ref.value = 430ohm +/- 0.1%
    r_ref.mpn = "ERA-6AEB431V"
    r_ref.footprint = "Resistor_SMD:R_0805_2012Metric"
    
    c_vdd = new Capacitor
    c_vdd.value = 100nF
    c_vdd.voltage_rating = 10V
    c_vdd.mpn = "GRM188R71E104KA01D"
    c_vdd.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    # EMI Filtering (temper-en5)
    # Series resistors on SPI lines to dampen ringing
    r_sclk = new Resistor
    r_mosi = new Resistor
    r_cs = new Resistor
    r_miso = new Resistor
    
    r_sclk.value = 33ohm +/- 5%
    r_sclk.mpn = "RC0603FR-0733RL"
    r_sclk.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_mosi.value = 33ohm +/- 5%
    r_mosi.mpn = "RC0603FR-0733RL"
    r_mosi.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_cs.value = 33ohm +/- 5%
    r_cs.mpn = "RC0603FR-0733RL"
    r_cs.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_miso.value = 33ohm +/- 5%
    r_miso.mpn = "RC0603FR-0733RL"
    r_miso.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # Ferrite bead on power input for high frequency noise rejection (temper-en5)
    # Target: ~120ohm @ 100MHz
    fb_power = new Resistor # Using Resistor component as generic placeholder for Ferrite Bead
    fb_power.value = 120ohm 
    fb_power.mpn = "BLM18AG121SN1D"
    fb_power.footprint = "Inductor_SMD:L_0603_1608Metric"
    
    # Power connections through Ferrite Bead
    power.vcc ~ fb_power.p1
    fb_power.p2 ~ adc.VDD
    fb_power.p2 ~ adc.DVDD
    fb_power.p2 ~ c_vdd.p1 # Decoupling cap after bead
    
    c_vdd.p2 ~ power.gnd
    power.gnd ~ adc.GND1
    power.gnd ~ adc.GND2
    power.gnd ~ adc.DGND

    # Each added analogue/logic IC gets a local 100 nF bypass footprint.  They
    # share the electrical rail in the netlist, but the separate references
    # force placement review to keep each capacitor at its IC supply pins.
    c_reference = new Capacitor
    c_low_window = new Capacitor
    c_high_window = new Capacitor
    c_window_and = new Capacitor
    c_rail_monitor = new Capacitor
    c_fault_nand = new Capacitor
    c_reference.value = 100nF
    c_low_window.value = 100nF
    c_high_window.value = 100nF
    c_window_and.value = 100nF
    c_rail_monitor.value = 100nF
    c_fault_nand.value = 100nF
    c_reference.voltage_rating = 10V
    c_low_window.voltage_rating = 10V
    c_high_window.voltage_rating = 10V
    c_window_and.voltage_rating = 10V
    c_rail_monitor.voltage_rating = 10V
    c_fault_nand.voltage_rating = 10V
    c_reference.dielectric = "X7R"
    c_low_window.dielectric = "X7R"
    c_high_window.dielectric = "X7R"
    c_window_and.dielectric = "X7R"
    c_rail_monitor.dielectric = "X7R"
    c_fault_nand.dielectric = "X7R"
    c_reference.mpn = "GRM188R71E104KA01D"
    c_low_window.mpn = "GRM188R71E104KA01D"
    c_high_window.mpn = "GRM188R71E104KA01D"
    c_window_and.mpn = "GRM188R71E104KA01D"
    c_rail_monitor.mpn = "GRM188R71E104KA01D"
    c_fault_nand.mpn = "GRM188R71E104KA01D"
    power.vcc ~ c_reference.p1
    c_reference.p2 ~ power.gnd
    fb_power.p2 ~ c_low_window.p1
    c_low_window.p2 ~ power.gnd
    fb_power.p2 ~ c_high_window.p1
    c_high_window.p2 ~ power.gnd
    fb_power.p2 ~ c_window_and.p1
    c_window_and.p2 ~ power.gnd
    power.vcc ~ c_rail_monitor.p1
    c_rail_monitor.p2 ~ power.gnd
    fb_power.p2 ~ c_fault_nand.p1
    c_fault_nand.p2 ~ power.gnd
    
    # SPI connections through Series Resistors
    cs.line ~ r_cs.p1
    r_cs.p2 ~ adc.CS_N
    
    spi.sclk ~ r_sclk.p1
    r_sclk.p2 ~ adc.SCLK
    
    spi.mosi ~ r_mosi.p1
    r_mosi.p2 ~ adc.SDI
    
    adc.SDO ~ r_miso.p1
    r_miso.p2 ~ spi.miso
    
    adc.DRDY ~ drdy.line
    
    # MAX31865 4-wire reference network (datasheet Figure 4): BIAS drives
    # REFIN+, the 430 ohm RREF spans REFIN+ to REFIN-, and ISENSOR returns
    # to REFIN-.  Do not put RREF in series with BIAS: that leaves the
    # converter reference network and sensor-current monitor disconnected.
    adc.BIAS ~ adc.REFIN_P
    adc.REFIN_P ~ r_ref.p1
    r_ref.p2 ~ adc.REFIN_N
    adc.ISENSOR ~ adc.REFIN_N

    # Independent hardware RTD window.  REF2025 runs from upstream 3.3 V so
    # its 1.25 V VBIAS threshold reference remains defined while the
    # post-ferrite RTD_AVDD rail browns out.  The comparators observe the local
    # REFIN-/ISENSOR RTD-drop node; they do not assume RTDIN- is board ground.
    reference = new REF2025
    reference.VIN ~ power.vcc
    reference.EN ~ power.vcc
    reference.GND ~ power.gnd

    r_low_top = new Resistor
    r_low_top.value = 61.3kohm +/- 0.1%
    r_low_top.mpn = "ERA-3AEB6132V"
    r_low_bottom = new Resistor
    r_low_bottom.value = 10kohm +/- 0.1%
    r_low_bottom.mpn = "ERA-3AEB103V"
    r_high_top = new Resistor
    r_high_top.value = 5.93kohm +/- 0.1%
    r_high_top.mpn = "ERA-3AEB5931V"
    r_high_bottom = new Resistor
    r_high_bottom.value = 10kohm +/- 0.1%
    r_high_bottom.mpn = "ERA-3AEB103V"

    low_window = new TLV3201
    high_window = new TLV3201
    low_window.VCC ~ fb_power.p2
    high_window.VCC ~ fb_power.p2
    low_window.GND ~ power.gnd
    high_window.GND ~ power.gnd
    adc.REFIN_N ~ low_window.INP
    reference.VBIAS ~ r_low_top.p1
    r_low_top.p2 ~ low_window.INN
    low_window.INN ~ r_low_bottom.p1
    r_low_bottom.p2 ~ power.gnd
    # Invert the high comparison so both outputs are high only inside the
    # permitted RTD voltage window.
    reference.VBIAS ~ r_high_top.p1
    r_high_top.p2 ~ high_window.INP
    high_window.INP ~ r_high_bottom.p1
    r_high_bottom.p2 ~ power.gnd
    adc.REFIN_N ~ high_window.INN

    window_and = new SN74LVC1G08
    window_and.VCC ~ fb_power.p2
    window_and.GND ~ power.gnd
    low_window.OUT ~ window_and.A
    high_window.OUT ~ window_and.B
    # Keep the downstream NAND input deterministically low if the post-rail
    # AND output is unpowered or high impedance during a fault transition.
    r_window_ok_pulldown = new Resistor
    r_window_ok_pulldown.value = 100kohm +/- 1%
    r_window_ok_pulldown.mpn = "RC0603FR-07100KL"
    window_and.Y ~ r_window_ok_pulldown.p1
    r_window_ok_pulldown.p2 ~ power.gnd

    # TPS3700 is powered upstream of the ferrite.  OUTA is pulled high only
    # while RTD_AVDD is above its approximately 2.82 V nominal UV threshold; it pulls low
    # through brownout before the post-rail TLV3201 operation is unspecified.
    rail_monitor = new TPS3700
    rail_monitor.VDD ~ power.vcc
    rail_monitor.GND ~ power.gnd
    rail_monitor.INB_N ~ power.gnd
    r_avdd_top = new Resistor
    r_avdd_top.value = 616kohm +/- 0.1%
    r_avdd_top.mpn = "ERA-3AEB6163V"
    r_avdd_bottom = new Resistor
    r_avdd_bottom.value = 100kohm +/- 0.1%
    r_avdd_bottom.mpn = "ERA-3AEB104V"
    fb_power.p2 ~ r_avdd_top.p1
    r_avdd_top.p2 ~ rail_monitor.INA_P
    rail_monitor.INA_P ~ r_avdd_bottom.p1
    r_avdd_bottom.p2 ~ power.gnd
    r_rail_ok_pullup = new Resistor
    r_rail_ok_pullup.value = 10kohm +/- 1%
    r_rail_ok_pullup.mpn = "RC0603FR-0710KL"
    power.vcc ~ r_rail_ok_pullup.p1
    r_rail_ok_pullup.p2 ~ rail_monitor.OUTA

    # The Ioff-rated open-drain NAND is the only device allowed to hold the
    # active-high fault net low. A short/open window violation, local-rail
    # brownout/loss, or logic supply loss releases the upstream pull-up.
    fault_nand = new SN74LVC1G38
    fault_nand.VCC ~ fb_power.p2
    fault_nand.GND ~ power.gnd
    window_and.Y ~ fault_nand.A
    rail_monitor.OUTA ~ fault_nand.B
    r_fault_pullup = new Resistor
    r_fault_pullup.value = 10kohm +/- 1%
    r_fault_pullup.mpn = "RC0603FR-0710KL"
    power.vcc ~ r_fault_pullup.p1
    r_fault_pullup.p2 ~ rtd_hw_fault.line
    fault_nand.Y ~ rtd_hw_fault.line

    # This board uses the datasheet's 4-wire topology. FORCE2 is grounded;
    # FORCE+/RTDIN+ and FORCE-/RTDIN- remain separate connector conductors.
    adc.FORCE2 ~ power.gnd
    adc.FORCE_P ~ rtd_force_p
    adc.FORCE_N ~ rtd_force_n
    adc.RTDIN_P ~ rtd_sense_p
    adc.RTDIN_N ~ rtd_sense_n

module OCPComparator:
    """Over-current protection comparator, 50A threshold."""
    
    power = new ElectricPower
    i_sense = new ElectricSignal
    i_sense.reference ~ power.gnd
    
    fault = new ElectricLogic
    fault.reference ~ power.gnd
    fault.line.required = true
    
    comp = new TLV3201
    
    r_ref_top = new Resistor
    r_ref_top.value = 3200ohm +/- 1%
    r_ref_top.mpn = "RC0603FR-073K2L"
    r_ref_top.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_ref_bot = new Resistor
    r_ref_bot.value = 10000ohm +/- 1%
    r_ref_bot.mpn = "RC0603FR-0710KL"
    r_ref_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    power.vcc ~ comp.VCC
    power.gnd ~ comp.GND
    power.vcc ~ r_ref_top.p1
    r_ref_top.p2 ~ comp.INN
    comp.INN ~ r_ref_bot.p1
    r_ref_bot.p2 ~ power.gnd
    i_sense.line ~ comp.INP
    comp.OUT ~ fault.line

module OVPComparator:
    """Over-voltage protection, 390V threshold."""
    
    power = new ElectricPower
    v_bus = new ElectricSignal
    # Note: v_bus reference might be different (HV ground), but here it's measuring relative to signal ground via divider?
    # Actually OVP measures HV bus. The divider is connected to v_bus.
    # v_bus input to this module is the HV rail.
    # So v_bus.reference is HV ground.
    
    fault = new ElectricLogic
    fault.reference ~ power.gnd
    fault.line.required = true
    
    comp = new TLV3201
    
    r_div_top1 = new Resistor
    r_div_top1.value = 430kohm +/- 1%
    r_div_top1.power_rating = 0.25W
    r_div_top1.mpn = "RC1206FR-07430KL"
    r_div_top1.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_div_top2 = new Resistor
    r_div_top2.value = 430kohm +/- 1%
    r_div_top2.power_rating = 0.25W
    r_div_top2.mpn = "RC1206FR-07430KL"
    r_div_top2.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_div_top3 = new Resistor
    r_div_top3.value = 430kohm +/- 1%
    r_div_top3.power_rating = 0.25W
    r_div_top3.mpn = "RC1206FR-07430KL"
    r_div_top3.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_div_bot = new Resistor
    r_div_bot.value = 10000ohm +/- 1%
    r_div_bot.power_rating = 0.1W
    r_div_bot.mpn = "RC0603FR-0710KL"
    r_div_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_ref_top = new Resistor
    r_ref_top.value = 12000ohm +/- 1%
    r_ref_top.mpn = "RC0603FR-0712KL"
    r_ref_top.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_ref_bot = new Resistor
    r_ref_bot.value = 10000ohm +/- 1%
    r_ref_bot.mpn = "RC0603FR-0710KL"
    r_ref_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    power.vcc ~ comp.VCC
    power.gnd ~ comp.GND
    
    v_bus.line ~ r_div_top1.p1
    r_div_top1.p2 ~ r_div_top2.p1
    r_div_top2.p2 ~ r_div_top3.p1
    r_div_top3.p2 ~ comp.INP
    comp.INP ~ r_div_bot.p1
    r_div_bot.p2 ~ power.gnd
    
    power.vcc ~ r_ref_top.p1
    r_ref_top.p2 ~ comp.INN
    comp.INN ~ r_ref_bot.p1
    r_ref_bot.p2 ~ power.gnd
    comp.OUT ~ fault.line
    
    # Verify trip point: divider = 3x430k + 10k, ratio = 10k/(3*430k+10k) = 1/130
    # Trip when V_bus_half * (1/130) = V_ref = 1.50V
    # V_bus_half_trip = 1.50 * 130 = 195V
    # V_bus_full_trip = 195V * 2 = 390V
    assert 180V * (10000 / (3 * 430000 + 10000)) < 3.3V * (10000 / (12000 + 10000))
    
    # Bus voltage ADC sense: separate divider from the same v_bus net
    # 510k + 10k -> 170V gives 3.27V at ADC (stays within 3.3V range)
    adc_v_bus = new ElectricSignal
    adc_v_bus.reference ~ power.gnd
    
    r_adc_top = new Resistor
    r_adc_top.value = 510kohm +/- 1%
    r_adc_top.power_rating = 0.1W
    r_adc_top.voltage_rating = 250V
    r_adc_top.mpn = "RC1206FR-07510KL"
    r_adc_top.footprint = "Resistor_SMD:R_1206_3216Metric"
    
    r_adc_bot = new Resistor
    r_adc_bot.value = 10kohm +/- 1%
    r_adc_bot.power_rating = 0.1W
    r_adc_bot.mpn = "RC0603FR-0710KL"
    r_adc_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    c_adc_filter = new Capacitor
    c_adc_filter.value = 100nF +/- 10%
    c_adc_filter.dielectric = "X7R"
    c_adc_filter.voltage_rating = 10V
    c_adc_filter.mpn = "GRM188R71E104KA01D"
    c_adc_filter.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    v_bus.line ~ r_adc_top.p1
    r_adc_top.p2 ~ adc_v_bus.line
    adc_v_bus.line ~ r_adc_bot.p1
    r_adc_bot.p2 ~ power.gnd
    adc_v_bus.line ~ c_adc_filter.p1
    c_adc_filter.p2 ~ power.gnd
    
    # Verify ADC range
    v_adc_max: voltage = 170V * (10kohm / (510kohm + 10kohm))
    assert v_adc_max <= 3.3V

module ThermalComparator:
    """Thermal protection, 85C threshold with hysteresis."""
    
    power = new ElectricPower
    ntc_sense = new ElectricSignal
    ntc_sense.reference ~ power.gnd
    
    fault = new ElectricLogic
    fault.reference ~ power.gnd
    fault.line.required = true
    
    comp = new TLV3201
    
    # NTC thermistor: 100k at 25C, B=3950 on heatsink
    ntc = new Resistor  # Using Resistor as NTC placeholder
    ntc.value = 100kohm  # Resistance at 25C
    ntc.mpn = "NTCALUG103A104GCA"  # Vishay 100k NTC (R25=100k: "104"), axial glass-bead
    # Stand-in 2-pad axial footprint; no NTC/thermistor lib in the committed
    # fp-lib-table. The lug-mount part is wired via flying leads anyway.
    ntc.footprint = "Resistor_THT:R_Axial_DIN0204_L3.6mm_D1.6mm_P2.54mm_Vertical"
    
    # Fixed resistor for NTC divider
    r_ntc_fixed = new Resistor
    r_ntc_fixed.value = 100kohm +/- 1%
    r_ntc_fixed.mpn = "RC0603FR-07100KL"
    r_ntc_fixed.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # NTC divider: VCC -> r_ntc_fixed -> ntc_sense -> NTC -> GND
    # At 25C: V_sense = 3.3 * 100k/(100k+100k) = 1.65V
    power.vcc ~ r_ntc_fixed.p1
    r_ntc_fixed.p2 ~ ntc_sense.line
    ntc_sense.line ~ ntc.p1
    ntc.p2 ~ power.gnd
    
    # Reference divider: sets trip threshold (~100C where NTC ~= 6.8k)
    # V_sense at trip = 3.3 * 6.8k/(100k+6.8k) ~= 0.21V
    # Set reference to ~0.21V via divider: 3.3 * 10k/(150k+10k) ~= 0.206V
    r_ref_top = new Resistor
    r_ref_top.value = 150kohm +/- 1%
    r_ref_top.mpn = "RC0603FR-07150KL"
    r_ref_top.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    r_ref_bot = new Resistor
    r_ref_bot.value = 10kohm +/- 1%
    r_ref_bot.mpn = "RC0603FR-0710KL"
    r_ref_bot.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    # Reference: VCC -> r_ref_top -> INP -> r_ref_bot -> GND
    # V_INP = 3.3 * 10k/(150k+10k) ~= 0.206V
    power.vcc ~ r_ref_top.p1
    r_ref_top.p2 ~ comp.INP
    comp.INP ~ r_ref_bot.p1
    r_ref_bot.p2 ~ power.gnd
    
    # Hysteresis: positive feedback from output to INP
    r_hyst = new Resistor
    r_hyst.value = 100kohm +/- 1%
    r_hyst.mpn = "RC0603FR-07100KL"
    r_hyst.footprint = "Resistor_SMD:R_0603_1608Metric"
    comp.INP ~ r_hyst.p1
    r_hyst.p2 ~ comp.OUT
    
    power.vcc ~ comp.VCC
    power.gnd ~ comp.GND
    
    # NTC sense to comparator inverting input (fault when V_NTC < V_ref = hot)
    ntc_sense.line ~ comp.INN
    comp.OUT ~ fault.line

module Watchdog:
    """External watchdog with 1.6s timeout."""
    
    power = new ElectricPower
    wdi = new ElectricLogic
    wdi.reference ~ power.gnd
    wdi.line.required = true
    
    reset_n = new ElectricLogic
    reset_n.reference ~ power.gnd
    reset_n.line.required = true
    
    wdt = new TPS3823
    
    c_bypass = new Capacitor
    c_bypass.value = 100nF
    c_bypass.voltage_rating = 10V
    c_bypass.mpn = "GRM188R71E104KA01D"
    c_bypass.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    power.vcc ~ wdt.VDD
    power.vcc ~ c_bypass.p1
    c_bypass.p2 ~ power.gnd
    power.gnd ~ wdt.GND
    
    wdi.line ~ wdt.WDI
    wdt.RESET_N ~ reset_n.line
    power.vcc ~ wdt.MR_N

module SafetyInterlock:
    """Complete safety interlock system."""
    
    power_3v3 = new ElectricPower
    power_15v = new ElectricPower
    
    i_sense = new ElectricSignal
    i_sense.reference ~ power_3v3.gnd
    
    dc_bus = new ElectricSignal
    # dc_bus ref is HV ground, handled in OVPComparator connection
    
    ntc_sense = new ElectricSignal
    ntc_sense.reference ~ power_3v3.gnd
    
    wdt_kick = new ElectricLogic
    wdt_kick.reference ~ power_3v3.gnd
    
    # Active-high shutdown output for UCC21550 DIS. This replaces the legacy
    # active-low SHUTDOWN_N net; a latched high level disables the driver.
    shutdown = new ElectricLogic
    shutdown.reference ~ power_3v3.gnd
    shutdown.line.required = true

    reset_n_in = new ElectricLogic
    reset_n_in.reference ~ power_3v3.gnd

    # Firmware runaway-cut output is active-high and is an independent
    # hardware fault source.
    runaway_cut = new ElectricLogic
    runaway_cut.reference ~ power_3v3.gnd

    # Independent RTD hardware window fault. This is deliberately distinct
    # from the MCU's GPIO15 runaway-cut request.
    rtd_hw_fault = new ElectricLogic
    rtd_hw_fault.reference ~ power_3v3.gnd
    
    fault_status = new ElectricLogic
    fault_status.reference ~ power_3v3.gnd
    # fault_status is the latch output alias; shutdown_n carries the single
    # required declaration for this shared net.
    
    wdt_reset_n = new ElectricLogic
    wdt_reset_n.reference ~ power_3v3.gnd
    
    ocp_led = new ElectricLogic
    ovp_led = new ElectricLogic
    thermal_led = new ElectricLogic
    wdt_led = new ElectricLogic
    
    ocp = new OCPComparator
    ovp = new OVPComparator
    thermal = new ThermalComparator
    wdt = new Watchdog
    fault_or = new SN74HC4075
    fault_any_or = new SN74HC4075
    latch = new SN74HC00
    
    ocp.power ~ power_3v3
    ocp.i_sense.line ~ i_sense.line
    
    ovp.power ~ power_3v3
    ovp.v_bus.line ~ dc_bus.line
    
    thermal.power ~ power_3v3
    thermal.ntc_sense.line ~ ntc_sense.line
    
    wdt.power ~ power_3v3
    wdt.wdi.line ~ wdt_kick.line
    wdt.reset_n.line ~ wdt_reset_n.line
    
    fault_or.VCC ~ power_3v3.vcc
    fault_or.GND ~ power_3v3.gnd
    ocp.fault.line ~ fault_or.A1
    ovp.fault.line ~ fault_or.B1
    thermal.fault.line ~ fault_or.C1
    
    latch.VCC ~ power_3v3.vcc
    latch.GND ~ power_3v3.gnd
    
    # Base aggregation: Y1 combines OCP/OVP/thermal; Y2 adds the watchdog
    # fault (RESET_N is active-low and is inverted by NAND gate 4) and the MCU
    # runaway-cut request. RTD_HW_FAULT is intentionally added only below by
    # the separate FAULT_ANY stage because all base-OR inputs are occupied.
    fault_or.Y1 ~ fault_or.A2
    wdt.reset_n.line ~ latch.A4
    power_3v3.vcc ~ latch.B4
    latch.Y4 ~ fault_or.B2
    runaway_cut.line ~ fault_or.C2

    # Fault-any expansion. Both consumers of the historical fault_or.Y2 move
    # here: the latch set input and reset qualification. A live RTD hardware
    # fault can therefore neither be hidden by GPIO15 nor cleared by reset.
    fault_any_or.VCC ~ power_3v3.vcc
    fault_any_or.GND ~ power_3v3.gnd
    fault_or.Y2 ~ fault_any_or.A1
    rtd_hw_fault.line ~ fault_any_or.B1
    power_3v3.gnd ~ fault_any_or.C1
    fault_any_or.Y1 ~ latch.A1

    # Set-dominant NAND SR latch. Gate 1 inverts the active-high fault bus;
    # gates 2 and 3 cross-couple Q/Q-bar. Reset is explicit and active-low.
    power_3v3.vcc ~ latch.B1
    latch.Y1 ~ latch.A2
    latch.Y3 ~ latch.B2
    # Fault-qualified reset: R_N = FAULT_OR_RESET_REQUEST. A live fault keeps
    # the latch set even if firmware requests reset.
    fault_any_or.Y1 ~ fault_any_or.A2
    reset_n_in.line ~ fault_any_or.B2
    power_3v3.gnd ~ fault_any_or.C2
    fault_any_or.Y2 ~ latch.A3

    # Unused base-OR gate has defined inputs and no safety consumer.
    power_3v3.gnd ~ fault_or.A3
    power_3v3.gnd ~ fault_or.B3
    power_3v3.gnd ~ fault_or.C3
    latch.Y2 ~ latch.B3
    latch.Y2 ~ shutdown.line
    latch.Y2 ~ fault_status.line

    tp_shutdown = new TestPoint
    tp_shutdown.p1 ~ shutdown.line
    tp_fault = new TestPoint
    tp_fault.p1 ~ fault_status.line
    
    # LED indicators remain unassigned until their current-limiting circuits
    # are specified; they must not be used as safety logic.

module MCU:
    """ESP32-S3 microcontroller with support circuitry."""
    
    power = new ElectricPower
    power.voltage = 3.3V
    spi = new SPI
    i2c = new I2C
    uart = new UART
    
    cs_rtd = new ElectricLogic
    rtd_drdy = new ElectricLogic
    wdt_kick = new ElectricLogic
    relay_ctrl = new ElectricLogic
    fault_status_in = new ElectricLogic
    reset_n = new ElectricLogic
    zcd_in = new ElectricLogic
    wdt_reset_in = new ElectricLogic
    runaway_cut = new ElectricLogic
    
    # Assertions
    assert power.voltage within 3.3V +/- 5%
    
    # Boot timing assertions
    t_boot_rc: time = r_en.value * c_en.value
    assert t_boot_rc within 9ms to 11ms
    t_boot_delay: time = t_boot_rc * 1.4
    assert t_boot_delay within 13ms to 15ms
    
    signal pwm_h
    signal pwm_l
    # HalfBridge owns the required declarations for the shared PWM inputs;
    # repeating them here conflicts when Atopile merges the connected nets.
    signal adc_i_sense
    adc_i_sense.required = true
    signal adc_v_bus
    adc_v_bus.required = true
    signal adc_ntc
    adc_ntc.required = true
    signal usb_dn
    signal usb_dp
    
    mcu = new ESP32_S3_WROOM_1
    
    c_vcc1 = new Capacitor
    c_vcc1.value = 100nF
    c_vcc1.voltage_rating = 10V
    c_vcc1.mpn = "GRM188R71E104KA01D"
    c_vcc1.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    c_vcc2 = new Capacitor
    c_vcc2.value = 10uF
    c_vcc2.voltage_rating = 10V
    c_vcc2.mpn = "GRM21BR71A106KE51L"
    c_vcc2.footprint = "Capacitor_SMD:C_0805_2012Metric"
    
    r_en = new Resistor
    r_en.value = 10kohm +/- 2%
    r_en.mpn = "RC0603FR-0710KL"
    r_en.footprint = "Resistor_SMD:R_0603_1608Metric"
    
    c_en = new Capacitor
    c_en.value = 1uF +/- 2%
    c_en.voltage_rating = 10V
    c_en.mpn = "GRM188R71A105KA61D"
    c_en.footprint = "Capacitor_SMD:C_0603_1608Metric"
    
    power.vcc ~ mcu.VCC3V3
    power.vcc ~ c_vcc1.p1
    c_vcc1.p2 ~ power.gnd
    power.vcc ~ c_vcc2.p1
    c_vcc2.p2 ~ power.gnd
    power.gnd ~ mcu.GND
    power.vcc ~ r_en.p1
    r_en.p2 ~ mcu.EN
    mcu.EN ~ c_en.p1
    c_en.p2 ~ power.gnd
    
    # USB D+/D- connections (native USB on GPIO19 = D-, GPIO20 = D+)
    usb_dn ~ mcu.IO19
    usb_dp ~ mcu.IO20
    
    # IO0 bootstrap: 10k pull-up to 3.3V, button to GND for download mode
    r_boot = new Resistor
    r_boot.value = 10kohm
    r_boot.mpn = "RC0603FR-0710KL"
    r_boot.footprint = "Resistor_SMD:R_0603_1608Metric"
    power.vcc ~ r_boot.p1
    r_boot.p2 ~ mcu.IO0
    
    # EN reset button (parallel to RC: button pulls EN to GND for reset)
    btn_reset = new Button
    btn_reset.p1 ~ mcu.EN
    btn_reset.p2 ~ power.gnd
    
    # BOOT button for download mode
    btn_boot = new Button
    btn_boot.p1 ~ mcu.IO0
    btn_boot.p2 ~ power.gnd
    
    # I2C pull-up resistors (4.7k to 3.3V)
    r_sda_pullup = new Resistor
    r_sda_pullup.value = 4.7kohm
    r_sda_pullup.mpn = "RC0603FR-074K7L"
    r_sda_pullup.footprint = "Resistor_SMD:R_0603_1608Metric"
    power.vcc ~ r_sda_pullup.p1
    r_sda_pullup.p2 ~ mcu.IO38  # SDA
    
    r_scl_pullup = new Resistor
    r_scl_pullup.value = 4.7kohm
    r_scl_pullup.mpn = "RC0603FR-074K7L"
    r_scl_pullup.footprint = "Resistor_SMD:R_0603_1608Metric"
    power.vcc ~ r_scl_pullup.p1
    r_scl_pullup.p2 ~ mcu.IO39  # SCL
    
    mcu.IO4 ~ pwm_h
    mcu.IO5 ~ pwm_l
    mcu.GPIO1 ~ adc_i_sense
    mcu.GPIO2 ~ adc_v_bus
    mcu.GPIO3 ~ adc_ntc
    
    cs_rtd.line ~ mcu.SPI_CS
    spi.sclk ~ mcu.SPI_CLK
    spi.mosi ~ mcu.SPI_MOSI
    spi.miso ~ mcu.SPI_MISO
    rtd_drdy.line ~ mcu.IO9  # Assuming IO9 for DRDY based on schematic or defaults
    
    wdt_kick.line ~ mcu.IO7
    relay_ctrl.line ~ mcu.IO16
    fault_status_in.line ~ mcu.IO17
    # GPIO6 is an input from the TPS3823 RESET_N output; keep it separate from
    # the explicit latch-reset request on GPIO14 to avoid output contention.
    wdt_reset_in.line ~ mcu.IO6
    reset_n.line ~ mcu.IO14
    # GPIO15 is the dedicated active-high hardware runaway-cut output.  GPIO4
    # and GPIO5 are already reserved for PWM_H/PWM_L.
    runaway_cut.line ~ mcu.IO15
    # Zero-crossing input is a real MCU interface; IO13 is reserved for this
    # signal in the local ESP32-S3 component model.
    zcd_in.line ~ mcu.IO13
    zcd_in.reference ~ power.gnd

    # Default I2C/UART pin mappings (can be overridden).  Keep I2C off the
    # SPI clock (IO8) and status LED pins (IO17/18); the firmware manifest
    # reserves the exposed IO38/39 pair for this optional bus.
    i2c.sda ~ mcu.IO38
    i2c.scl ~ mcu.IO39
    uart.tx ~ mcu.TXD0
    uart.rx ~ mcu.RXD0
