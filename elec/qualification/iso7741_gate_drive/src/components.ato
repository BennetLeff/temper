# Candidate-only component declarations for ISO7741 gate-drive qualification.
#
# The authority packet has not yet supplied manufacturer-controlled pin maps,
# land patterns, UVLO corners, or negative-bias limits for this candidate.  The
# declarations below are therefore an isolated, buildable netlist envelope,
# not a production selection.  validation/schematic_layout.json and the
# candidate contract test keep the pending boundary explicit.

component ISO7741FQDWWRQ1:
    """TI ISO7741F-Q1 DWW-16 candidate; pin map pending authority review."""
    footprint = "temper_iso7741_gate_drive:ISO7741_DWW16"
    mpn = "ISO7741FQDWWRQ1"
    manufacturer = "Texas Instruments"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16

