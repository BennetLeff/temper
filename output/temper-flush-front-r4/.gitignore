# Keep rebuildable source, inputs and compact validation receipts in Git.
/*
!/.gitignore
!/README.md
!/design.md
!/front-panel-engineering-plan.md
!/requirements-*.txt
!/package.py
!/inputs/
!/src/
!/checks/
!/evidence/
!/renders/
!/CURRENT.json
!/bend-layout.json
!/change-register.csv
!/sensor-test-record.csv
!/sensor-validation-plan.txt
__pycache__/
*.pyc
/evidence/*
!/evidence/build.json
!/evidence/front-panel-validation.json
!/evidence/validation.json
!/evidence/assembly-correspondence.json
!/evidence/service-access.json
!/evidence/dxf-checks.json
/renders/*
!/renders/r4-chamber-section.png
