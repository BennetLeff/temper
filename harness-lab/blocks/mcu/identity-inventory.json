  "compiler_notes": [
    "Atopile exits nonzero on a FAILED assertion but still writes netlist/BOM artifacts (measured 2026-09-10: rc=1 with the old 9-11ms band under the honest +/-10% tolerance, artifacts present). Downstream stages must gate on return code AND the assertions report and never consume artifacts from a failed build. U2 bridge takes this as an input.",
    "Netlist value fields are '?' for every component and libsource carries the MPN alias: per KTD3 neither is an authoritative part identity. Exact MPNs come from the CSV joined through the designator map, values from resolved attributes (U2 bridge).",
    "Each ElectricLogic interface contributes one connected 'mcu-line*' net and one empty 'mcu-reference*' net (9 empties). References are unconnected interface members, not physical pads; they must not become copper."
  ],
  "discrepancies_fixed": [
    {
      "evidence": "fresh-workspace build with honest +/-10% tolerance FAILS the old bands (8.82-11.22ms vs 9-11ms); passes the new ones",
      "field": "elec/src/modules.ato MCU.c_en.value, t_boot_rc/t_boot_delay asserts",
      "finding": "c_en declared 1uF +/-2% but the selected MPN GRM188R71A105KA61D tolerance code K is +/-10%; the old 9-11ms/13-15ms RC bands passed only against the fictional tolerance",
      "fix": "declare 1uF +/-10%; widen bands to 8.5-11.5ms / 12-16ms containing the honest worst case (R +/-2% declared, C +/-10%) with margin; main.ato t_mcu_boot=14ms literal still inside the delay band, no main.ato change"
    },
    {
      "field": "elec/src/modules.ato MCU rtd_drdy comment",
      "finding": "DRDY mapping carried an 'Assuming IO9' comment with no provenance",
      "fix": "comment now cites firmware ground truth: temper_pins.h PIN_RTD_DRDY=9, main.c bootstrap, README; pin moves must change both sides together"
    },
    {
      "field": "components/ESP32-S3/ESP32-S3-WROOM-1.kicad_sym MPN + Description",
      "finding": "symbol carried MPN ESP32-S3-WROOM-1-N4 (4MB, no PSRAM) while elec source, BOM \u00a73.1 (reconciled 2026-07-26), and bom-reconciliation-allowlist all require N8R8 (8MB flash + 8MB PSRAM)",
      "fix": "MPN -> ESP32-S3-WROOM-1-N8R8, Description -> 8MB Flash + 8MB PSRAM; no test pinned N4; firmware sdkconfig sets no flash/PSRAM size so no firmware side effect"
    }
  ],
