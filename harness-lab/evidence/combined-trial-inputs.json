{
  "model": "opencode/muse-spark-1.3-contributor-free",
  "instructions": "Place and route this two-footprint PCB using only the five PCB tools.\nInspect first. Only C9's position and orientation (0,90,180,270) may move; U3 stays fixed.\nKeep footprints inside the outline, without courtyard overlap. Both mapped pad-center distances must be at most 5 mm.\nConnect C9.1 to U3.3 (+15V) and C9.2 to U3.1 (gnd) with actual copper. U3.5 shares +15V but must remain disconnected; connect no other pads.\nChoose all poses and route vertices from native geometry and feedback. A place leaves all existing tracks in place: it does not move, remove or repair copper. A route replaces that net's tracks with exactly your polyline.\nHonor the protected native track keepout. Tracks are straight, 0.25 mm F.Cu only, at most 22; no vias, arcs or zones. Keep copper inside the outline with 0.2 mm clearance.\nThere is ONE total budget of ten edits shared by place, route and remove_route, and five minutes for the whole task.\nUse introduced/resolved findings to refine. Stop on indeterminate measurements. Finish with check returning pass and briefly report the measured outcome.\nA pass covers this tiny placement and routing fixture only, not electrical or manufacturing approval.\n",
  "prompt": "Place C9 and route both required connections in this fixture using the admitted PCB tools. Start with inspect and finish with a passing check.",
  "tools": [
    {
      "name": "inspect",
      "description": "Read native pad geometry, tracks, physical connectivity, constraints and findings. Coordinates are mm; x right, y down.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "place",
      "description": "Move only C9 to x_mm/y_mm and its native orientation. Existing tracks stay in place; no copper follows, disappears or is repaired. Returns native state and DRC deltas. Placement, routing and removal share ten total edits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x_mm": {
            "type": "number"
          },
          "y_mm": {
            "type": "number"
          },
          "angle_deg": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ]
          }
        },
        "required": [
          "x_mm",
          "y_mm",
          "angle_deg"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "route",
      "description": "Replace one net's tracks with exactly this polyline of 2\u201312 explicit vertices. Fixed 0.25 mm width on F.Cu. No snapping or routing search. Returns native connectivity and DRC deltas. Maximum ten total edits including placement and removals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string",
            "enum": [
              "+15V",
              "gnd"
            ]
          },
          "points_mm": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "net",
          "points_mm"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remove_route",
      "description": "Remove all tracks for the selected net and return native connectivity and DRC deltas. Counts as one routing edit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string",
            "enum": [
              "+15V",
              "gnd"
            ]
          }
        },
        "required": [
          "net"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check",
      "description": "Reload and check placement constraints, physical copper connectivity, all applicable KiCad DRC and protected state. Finish only after this returns pass.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
