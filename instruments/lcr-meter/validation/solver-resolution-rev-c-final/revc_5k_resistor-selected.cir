RevC exact full chain; official models; real FDA bias and ADC RC loads
.include models/opa2810_a.lib
.include models/opa810_a.lib
.include models/ths4551.lib
.options reltol=1e-5 abstol=1e-12 vntol=1e-7 method=gear
.include final-seed.inc
Rbiso1 bfbp badc_p 4.32
Cfbb1 bfbm bip 100p
Raint1 aom afbm 22
RG source hi 5000
Rbint1 bom bfbm 22
Vp vp 0 12
X7B low lowbuf lowbuf vp vn OPA2810
R32 acin 0 100k
Rbf1 bfbm bip 1k
C35 lp2 0 1n
Rbiso2 bfbm badc_m 4.32
Rai2 lowbuf aim 1k
Rai1 highbuf aip 1k
Cbadc2 badc_m 0 16p
Cadiff aadc_p aadc_m 3.3n
Rbf2 bfbp bim 1k
X7A 0 low tia vp vn OPA2810
Raf2 afbp aim 1k
Caadc2 aadc_m 0 16p
Vcm cm 0 2.048
R31 lp1 lp2 330
Raiso1 afbp aadc_p 4.32
Xb bip bim bop bom cm v5 0 THS4551
Xa aip aim aop aom cm v5 0 THS4551
RF low tia 5000
Caflt1 aadc_p 0 330p
Cfbb2 bfbp bim 100p
X6B hi highbuf highbuf vp vn OPA2810
CF low tia 10p
Vdds dds0 0 DC 0.3 AC 1 SIN(0.3 0.3 50k)
Vn vn 0 -12
Cbdiff badc_p badc_m 3.3n
Raiso2 afbm aadc_m 4.32
R34 srcfb 0 1k
Rbint2 bop bfbp 22
C34 lp1 0 1n
X6A excite source source vp vn OPA2810
X5 acin srcfb excite vp vn OPA810
C36 lp2 acin 1u
Cbflt1 badc_p 0 330p
R33 excite srcfb 5k
RDUT hi low 5000
Raint2 aop afbp 22
Cbflt2 badc_m 0 330p
R30 dds lp1 330
Cbadc1 badc_p 0 16p
Caflt2 aadc_m 0 330p
Rdds dds0 dds 200
Caadc1 aadc_p 0 16p
Raf1 afbm aip 1k
Rbi2 tia bim 1k
Cfba1 afbm aip 100p
Rbi1 lowbuf bip 1k
Cfba2 afbp aim 100p
V5 v5 0 5
.control
set klu
set wr_singlescale
set wr_vecnames
set filetype=ascii
op
write revc_5k_resistor-selected_op.raw all
let ihload=(v(highbuf)-v(aip))/1000
let ilload=(v(lowbuf)-v(aim))/1000+(v(lowbuf)-v(bip))/1000
let itload=(v(tia)-v(low))/5000+(v(tia)-v(bim))/1000
let kh=(-i(v.x6b.x_h3.vh_h3))-ihload
let kl=(-i(v.x7b.x_h3.vh_h3))-ilload
let kt=(-i(v.x7a.x_h3.vh_h3))-itload
print v(source) v(hi) v(low) v(tia) v(highbuf) v(lowbuf) v(aip) v(aim) v(bip) v(bim) v(aop) v(aom) v(bop) v(bom) (-i(v.x6b.x_h3.vh_h3)) (-i(v.x7b.x_h3.vh_h3)) (-i(v.x7a.x_h3.vh_h3)) kh kl kt
wrdata revc_5k_resistor-selected_dc.dat v(source) v(hi) v(low) v(tia) v(highbuf) v(lowbuf) v(aip) v(aim) v(bip) v(bim) v(aop) v(aom) v(bop) v(bom) (-i(v.x6b.x_h3.vh_h3)) (-i(v.x7b.x_h3.vh_h3)) (-i(v.x7a.x_h3.vh_h3)) kh kl kt
ac dec 80 10 100Meg
let a=v(aadc_p)-v(aadc_m)
let b=v(badc_p)-v(badc_m)
let ratio=a/b
wrdata revc_5k_resistor-selected_ac.dat real(ratio) imag(ratio) mag(a) mag(b)
tran 10n 120u 0 10n
let a=v(aadc_p)-v(aadc_m)
let b=v(badc_p)-v(badc_m)
wrdata revc_5k_resistor-selected_tran.dat v(dds0) v(source) v(hi) v(low) v(tia) v(highbuf) v(lowbuf) v(aadc_p) v(aadc_m) v(badc_p) v(badc_m) a b
quit
.endc
.end
