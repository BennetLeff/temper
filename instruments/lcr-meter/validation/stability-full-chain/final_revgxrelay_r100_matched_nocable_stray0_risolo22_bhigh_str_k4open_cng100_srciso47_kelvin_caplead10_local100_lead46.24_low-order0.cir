Cb2c b2 b2c 1u
Cb2cl b2c 0 10p
Rb2p b2c b2pin 470
Rb2in b2pin vcm 40k
Cb2pin b2pin 0 10p
Rsrciso source srcbus 47
Risolo low sum 22
Cstraylo jlc 0 0.000000000000000000000001
Cstrayhi jhc 0 0.000000000000000000000001
Rbridge lowbuf probe_f 0.01
Iinj 0 lowbuf DC 0 AC 1
Iinj2 0 probe_f DC 0 AC 0
Clocal sum local_cf_out 0.0000000001
Llocal local_cf_out tia 0.00000001
Lfeedback rf_end tia 0.00000004624
.control
set klu
optran 1 0 0 0 0 0
set filetype=ascii
set numdgt=17
op
write final_revgxrelay_r100_matched_nocable_stray0_risolo22_bhigh_str_k4open_cng100_srciso47_kelvin_caplead10_local100_lead46.24_low-order0.raw all
quit
.endc
.end
