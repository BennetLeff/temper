Cxg_srcdrv source 0 0.9854p
Cxg_hpot hpot 0 4.5008p
Cxg_lpot lpot 0 4.8510p
Cxg_refa refa 0 2.9058p
Cxm_sum_low sum low 0.1106p
Cxm_sum_tia sum tia 0.4072p
Cxm_sum_ru1 sum ru1 0.1031p
Cxm_sum_ru2 sum ru2 0.1095p
Cxm_sum_lowbuf sum lowbuf 0.0037p
Cxm_sum_lpot sum lpot 0.0012p
Cxm_low_tia low tia 0.0015p
Cxm_tia_ru1 tia ru1 0.0114p
Cxm_tia_ru2 tia ru2 0.1150p
Cxm_tia_lowbuf tia lowbuf 0.0044p
Cxm_tia_lpot tia lpot 0.0013p
Cxm_hi_source hi srcbus 0.1045p
Cxm_hi_rgu1 hi rgu1 0.1022p
Cxm_hi_rgu2 hi rgu2 0.1020p
Cxm_hi_hpot hi hpot 0.0051p
Cxm_ru1_ru2 ru1 ru2 0.0053p
Cxm_lowbuf_lpot lowbuf lpot 0.1491p
Cxm_highbuf_srcdrv highbuf source 0.0029p
Cxm_highbuf_hpot highbuf hpot 0.1490p
Cxm_source_rgu1 srcbus rgu1 0.0029p
Cxm_source_rgu2 srcbus rgu2 0.0031p
Cxm_source_srcdrv srcbus source 0.0025p
Ru1 sum ru1 5000
Cocf1 ru1 tia 2p
Ccf1 ru1 0 5p
Rgu1 hi rgu1 5000
Cocs1 rgu1 srcbus 2p
Ccs1 rgu1 0 5p
Cpp1 srcbus ru1 2p
Cppx1 rgu1 tia 2p
Ru2 sum ru2 100000
Cocf2 ru2 tia 2p
Ccf2 ru2 0 5p
Rgu2 hi rgu2 100000
Cocs2 rgu2 srcbus 2p
Ccs2 rgu2 0 5p
Cpp2 srcbus ru2 2p
Cppx2 rgu2 tia 2p
Ccsel_t tia 0 5p
Ccsel_s srcbus 0 5p
Cppsel srcbus tia 2p
RgpHC jhc hi 12
Cgp1HC jhc 0 2e-10
Rgpg1HC jhc 0 149996
Cgp2HC hi 0 2.5e-11
Rgpg2HC hi 0 5.1704e+09
RgpHP jhp hpot 102
Cgp1HP jhp 0 2e-10
Rgpg1HP jhp 0 5.1704e+09
Cgp2HP hpot 0 1.025e-09
Rgpg2HP hpot 0 5.1704e+09
RgpLP jlp lpot 102
Cgp1LP jlp 0 2e-10
Rgpg1LP jlp 0 5.1704e+09
Cgp2LP lpot 0 1.025e-09
Rgpg2LP lpot 0 5.1704e+09
RgpLC jlc low 12
Cgp1LC jlc 0 2e-10
Rgpg1LC jlc 0 149996
Cgp2LC low 0 6e-12
Rgpg2LC low 0 3.25387e+06
R105 jhc jhp 1k
R106 jlc jlp 1k
R107 refa jlc 1k
Cc4h jhc 0 5p
Cc4r refa 0 5p
Coc4 jhc refa 2p
Cc4bp jhp 0 5p
Coc4b jhc jhp 2p
RDUT jhc jlc 100
RF sum rf_end 100.075
CF sum rf_end 0.000000000000000000000001
X6B hpot highbuf highbuf vp vn OPA2810
X7B lpot lowbuf probe_f vp vn OPA2810
X7A 0 sum tia vp vn OPA2810
Vvcm vcm 0 1.375
Ra1s highbuf a1 1k
Ra1g a1 0 1k
Ca1aa a1 0 560p
Ca1c a1 a1c 1u
Ca1cl a1c 0 10p
Ra1p a1c a1pin 470
Ra1in a1pin vcm 40k
