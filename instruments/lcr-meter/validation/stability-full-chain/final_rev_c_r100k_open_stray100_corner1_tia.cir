RevC final exact full chain; official models; real FDA bias and ADC RC loads
.include ../../sources/ti/models/opa2810_a.lib
.include ../../sources/ti/models/opa810_a.lib
.include ../../sources/ti/models/ths4551.lib
.options reltol=1e-5 abstol=1e-12 vntol=1e-7 method=gear
.include ../solver-resolution-rev-c-final/final-seed.inc
.nodeset v(probe_f)=0.000100193
Cbflt2 badc_m 0 330p
Caadc1 aadc_p 0 16p
Cbflt1 badc_p 0 330p
C35 lp2 0 1n
Rbiso1 bfbp badc_p 4.32
Raint1 aom afbm 22
Cstraylo low 0 0.0000000001
Iinj2 0 probe_f DC 0 AC 0
R30 dds lp1 330
Rbiso2 bfbm badc_m 4.32
C34 lp1 0 1n
Rbf2 bfbp bim 1k
X5 acin srcfb excite vp vn OPA810
Raf2 afbp aim 1k
Vp vp 0 12.600000000000001
Cstrayhi hi 0 0.0000000001
Rbint1 bom bfbm 22
Rbf1 bfbm bip 1k
Caflt2 aadc_m 0 330p
Cbdiff badc_p badc_m 3.3n
RG source hi 100099.99999999999
R31 lp1 lp2 330
Cfbb1 bfbm bip 100p
Rbridge low probe_f 100
R33 excite srcfb 5k
Raiso1 afbp aadc_p 4.32
X6B hi highbuf highbuf vp vn OPA2810
Cfba1 afbm aip 100p
Cfba2 afbp aim 100p
X7B low lowbuf lowbuf vp vn OPA2810
Cfbb2 bfbp bim 100p
Xb bip bim bop bom cm v5 0 THS4551
R34 srcfb 0 1k
Vdds dds0 0 DC 0.3 AC 0
Raf1 afbm aip 1k
X7A 0 probe_f tia vp vn OPA2810
V5 v5 0 5.25
CF low tia 0.00000000000525
Rai1 highbuf aip 1k
R32 acin 0 100k
Caadc2 aadc_m 0 16p
Raiso2 afbm aadc_m 4.32
Cadiff aadc_p aadc_m 3.3n
Rbi1 lowbuf bip 1k
Rdds dds0 dds 200
C36 lp2 acin 1u
Rbi2 tia bim 1k
Rai2 lowbuf aim 1k
RDUT hi low 1e12
Vn vn 0 -12.600000000000001
RF low tia 99900
Cbadc1 badc_p 0 16p
X6A excite source source vp vn OPA2810
Cbadc2 badc_m 0 16p
Caflt1 aadc_p 0 330p
Rbint2 bop bfbp 22
Xa aip aim aop aom cm v5 0 THS4551
Iinj 0 low DC 0 AC 1
Raint2 aop afbp 22
Vcm cm 0 2.048
.control
set klu
optran 1 0 0 0 0 0
set wr_singlescale
set wr_vecnames
set numdgt=17
op
wrdata final_rev_c_r100k_open_stray100_corner1_tia_dc.dat v(x5.mid) v(x6a.mid) v(x6b.mid) v(x7a.mid) v(x7b.mid) v(xa.mid) v(xb.mid) v(acin) v(source) v(hi) v(low) v(tia) v(highbuf) v(lowbuf) v(aop) v(aom) v(bop) v(bom)
ac dec 120 1 1G
let ve=v(low)
let vf=v(probe_f)
wrdata final_rev_c_r100k_open_stray100_corner1_tia_e.dat real(ve) imag(ve) real(vf) imag(vf)
alter Iinj ac=0
alter Iinj2 ac=1
ac dec 120 1 1G
let ve=v(low)
let vf=v(probe_f)
wrdata final_rev_c_r100k_open_stray100_corner1_tia_f.dat real(ve) imag(ve) real(vf) imag(vf)
quit
.endc
.end
