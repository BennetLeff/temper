# Large regenerable outputs: SPICE vectors, packages and native build products.
*.dat
*.raw
*.zip
/build/
# Vendor datasheets are fetched by URL; hashes live in sources/*-lookup.json and rev-c-source-audit.md.
/sources/**/*.pdf
# Vendor SPICE models (*.lib) are ignored repo-wide; restore them from the source audit before rerunning.
# KiCad local history
/cad/.history/
# Raw sweep vectors and solver logs are regenerated by the committed decks and scripts;
# the cited numbers live in the validation READMEs/summaries.
/validation/**/*.csv
/validation/**/*.log
/archive/**/*.csv
/archive/**/*.log
/archive/**/*.pdf
/.superpowers/
# Vendor 3D models (EasyEDA/LCSC) placed by cad/tools/models_3d.py; rerun it after a fresh checkout.
/cad/3dmodels/*.step
