; TAC5112 primary ASI, TDM, 32-bit slots, TX_OFFSET 0, default polarities; RP2040 is the
; clock controller. side bits [1:0] = FSYNC, BCLK on consecutive GPIO 5, 4.
; 10 cycles per BCLK at clock divider 1 (120 MHz -> 12 MHz), 64 BCLK per frame (187.5 kHz).
; Every bit: rising edge launches DIN and FSYNC (5 cycles high), falling edge samples DOUT
; (5 cycles low). The codec launches DOUT on the rising edge (<= 14 ns) and latches DIN and
; FSYNC on the falling edge (SLASF24A 7.3.1.2.1, 6.10, 6.11).
; Slot 0: DAC channel 1 out, ADC channel 1 in. Slot 1: zeros out, ADC channel 2 in.
; The next DAC word is pulled at slot 1 bit 16, half a slot away from either push, so the
; DMA chain that fires on a TX refill (src/main.c) always lands between the two pushes.
; A TX underflow stalls on the blocking pull (FDEBUG TXSTALL); a full RX FIFO drops the
; word on the non-blocking push (FDEBUG RXSTALL). The firmware treats either as a fault.
.program tdm
.side_set 2
    pull block           side 0b00      ; first DAC word
.wrap_target
    out pins, 1          side 0b11 [4]  ; slot 0 bit 31, FSYNC high
    in pins, 1           side 0b10 [3]
    set x, 29            side 0b10
slot0:
    out pins, 1          side 0b01 [4]  ; bits 30..1
    in pins, 1           side 0b00 [3]
    jmp x-- slot0        side 0b00
    out pins, 1          side 0b01 [4]  ; bit 0
    in pins, 1           side 0b00
    push noblock         side 0b00      ; ADC channel 1 (frame cycle 316)
    set x, 14            side 0b00 [2]
slot1a:
    mov pins, null       side 0b01 [4]  ; slot 1 bits 31..17
    in pins, 1           side 0b00 [3]
    jmp x-- slot1a       side 0b00
    mov pins, null       side 0b01 [4]  ; bit 16
    in pins, 1           side 0b00
    pull block           side 0b00      ; next DAC word (frame cycle 476)
    set x, 14            side 0b00 [2]
slot1b:
    mov pins, null       side 0b01 [4]  ; bits 15..1
    in pins, 1           side 0b00 [3]
    jmp x-- slot1b       side 0b00
    mov pins, null       side 0b01 [4]  ; bit 0
    in pins, 1           side 0b00
    push noblock         side 0b00 [3]  ; ADC channel 2 (frame cycle 636)
.wrap
