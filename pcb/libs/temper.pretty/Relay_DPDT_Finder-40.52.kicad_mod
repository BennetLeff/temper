		(uuid "d770a021-0000-0000-0000-000000000002")
	)
	;; Pole 1, EN 50005 function identity unchanged (11=COM,12=NC,14=NO) -- PHYSICAL ORDER CORRECTED
	;; this session: manufacturer's real left-to-right order is NC(12), COM(11), NO(14), i.e. the NC
	;; pin sits nearest the coil, not COM as the prior footprint placed it. x-positions: 12 at -4.5mm
	;; (10mm from case left edge = 7.5mm from coil, the load-bearing MEASURED figure), 11 at 0.5mm
	;; (15mm from case left edge), 14 at 5.5mm (20mm from case left edge) -- all MEASURED, catalog p.3.
	(pad "12" thru_hole circle
		(at -4.5 3.75)
		(size 2.2 2.2)
		(drill 1.7)
		(layers "*.Cu" "*.Mask")
		(uuid "d770a030-0000-0000-0000-000000000002")
	)
	(pad "11" thru_hole circle
		(at 0.5 3.75)
		(size 2.2 2.2)
		(drill 1.7)
		(layers "*.Cu" "*.Mask")
		(uuid "d770a031-0000-0000-0000-000000000002")
	)
	(pad "14" thru_hole circle
		(at 5.5 3.75)
		(size 2.2 2.2)
		(drill 1.7)
		(layers "*.Cu" "*.Mask")
		(uuid "d770a032-0000-0000-0000-000000000002")
	)
	;; Pole 2 -- mirrors pole 1's corrected column order and pitch (NC=22 nearest coil, COM=21
	;; middle, NO=24 farthest), same x-positions as pole 1, bottom row.
	(pad "22" thru_hole circle
		(at -4.5 -3.75)
		(size 2.2 2.2)
