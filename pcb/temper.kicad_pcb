    (fp_line (start 3 11.36) (end 37 11.36) (layer "F.SilkS") (stroke (width 0.12) (type solid)))
    (fp_line (start 3 -11.36) (end 3 11.36) (layer "F.SilkS") (stroke (width 0.12) (type solid)))
