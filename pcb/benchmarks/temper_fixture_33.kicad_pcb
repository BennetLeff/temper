(kicad_pcb (version 20221018) (generator temper_placer)

  (general
    (thickness 1.6)
  )

  (paper "A3")
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal)
    (2 "In2.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
    )
  )
  (net_class "ACMains" "Auto-generated from netclass_rules.yaml" (clearance 6.0) (trace_width 3.0) (via_dia 1.2) (via_drill 0.6))
  (net_class "FinePitch" "Auto-generated from netclass_rules.yaml" (clearance 0.1) (trace_width 0.127) (via_dia 0.4) (via_drill 0.2))
  (net_class "GND" "Auto-generated from netclass_rules.yaml" (clearance 0.3) (trace_width 1.0) (via_dia 1.0) (via_drill 0.5))
  (net_class "GateDrive" "Auto-generated from netclass_rules.yaml" (clearance 0.25) (trace_width 0.4) (via_dia 0.8) (via_drill 0.4))
  (net_class "HighCurrent" "Auto-generated from netclass_rules.yaml" (clearance 0.25) (trace_width 0.5) (via_dia 0.8) (via_drill 0.4))
  (net_class "HighSpeed" "Auto-generated from netclass_rules.yaml" (clearance 0.2) (trace_width 0.15) (via_dia 0.6) (via_drill 0.3))
  (net_class "HighVoltage" "Auto-generated from netclass_rules.yaml" (clearance 6.0) (trace_width 3.0) (via_dia 1.2) (via_drill 0.6))
  (net_class "Power" "Auto-generated from netclass_rules.yaml" (clearance 0.25) (trace_width 0.5) (via_dia 0.8) (via_drill 0.4))
  (net_class "Signal" "Auto-generated from netclass_rules.yaml" (clearance 0.15) (trace_width 0.2) (via_dia 0.6) (via_drill 0.3))


  # Net definitions
  (net 0 "")
  (net 1 "GND")
  (net 2 "PGND")
  (net 3 "CGND")
  (net 4 "+3V3")
  (net 5 "+5V")
  (net 6 "+15V")
  (net 7 "VCC_BOOT")
  (net 8 "DC_BUS+")
  (net 9 "DC_BUS-")
  (net 10 "SW_NODE")
  (net 11 "GATE_H")
  (net 12 "GATE_L")
  (net 13 "PWM_H")
  (net 14 "PWM_L")
  (net 15 "I_SENSE")
  (net 16 "TEMP_SENSE")
  (net 17 "ZCD")
  (net 18 "SHUTDOWN_N")
  (net 19 "AC_L")
  (net 20 "AC_N")
  (net 21 "SPI_CLK")
  (net 22 "SPI_MOSI")
  (net 23 "SPI_MISO")
  (net 24 "SPI_CS_TEMP")
  (net 25 "USB_D+")
  (net 26 "USB_D-")

  # ========== POWER INPUT SECTION ==========
  
  # AC Input Connector (IEC C14)
  (footprint "Connector_IEC:IEC_C14_Male" (layer "F.Cu")
    (tstamp 00000001-0001-0000-0000-000000000001)
    (at 41.6500 2.2500)
    (property "Reference" "J_AC_IN")
    (property "Value" "IEC_C14")
    (property "Footprint" "Connector_IEC:IEC_C14_Male")
    (attr through_hole)
    (pad "1" thru_hole circle (at 0 0) (size 3.5 3.5) (drill 2.5) (layers "*.Cu" "*.Mask")
      (net 19 "AC_L"))
    (pad "2" thru_hole circle (at 0 10) (size 3.5 3.5) (drill 2.5) (layers "*.Cu" "*.Mask")
      (net 20 "AC_N"))
    (pad "3" thru_hole circle (at 0 20) (size 3.5 3.5) (drill 2.5) (layers "*.Cu" "*.Mask")
      (net 1 "GND"))
  )

