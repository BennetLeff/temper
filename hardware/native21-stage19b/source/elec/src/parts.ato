component TcoLoopHeader:
    """JST B2P3-VH(LF)(SN): VH header with post 2 omitted (7.92 mm pitch, 250 V AC/DC 10 A, JST
    eVH.pdf p.1 / p.6 item 3; "headers with posts omitted are available", p.3), series loop through
    the off-board heatsink and under-glass Microtemp G4A thermal cutoffs. With the TCO open the two
    posts see line voltage: the 3.96 mm B2P-VH left 1.26 mm of copper, this leaves 5.22 mm (review
    M7, 2026-10-08). Unshrouded: the shrouded -FB-B (14.9 mm courtyard) does not fit between PS2 and
    F1. Mates VHR-3M (cavity 2 empty), SVH-21T-P1.1 / SVH-41T-P1.1 crimps."""
    designator_prefix = "J"
    mpn = "B2P3-VH(LF)(SN)"
    manufacturer = "JST"
    footprint = "Connector_JST:JST_VH_B2P3-VH_1x02_P7.92mm_Vertical"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

