(footprint "CST-1005"
	(version 20231120)
	(generator "temper-hand")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "Triad Magnetics CST-1005 current sense transformer, 1:1000, 5A. Dimensions from the official datasheet (https://catalog.triadmagnetics.com/Asset/CST-1005.pdf): secondary pin pitch 15.00mm, pin diameter 0.8+/-0.1mm, primary conductor window (dimension F) 8.50mm dia. Pad numbers match the placed KiCad symbol (Device:Transformer_1P_1S), NOT the datasheet's own silkscreen PIN1/PIN2/PIN3 marking -- mapping: footprint pad 3 = datasheet PIN1, pad 4 = datasheet PIN2 (both real THT secondary pins, 15.00mm apart). Footprint pads 1/2 correspond to the symbol's primary winding terminals (AA/AB) -- the real part's primary is a bare conductor/busbar threaded through the center window, not a soldered pin, so datasheet PIN3 (mechanical support only per Note 1) is omitted here and pads 1/2 are modeled as SMD (no-drill) placeholder pads purely for netlist/footprint pin-count parity with the 4-pin symbol, positioned above the secondary row as directional entry/exit markers for wherever the primary trace or busbar actually threads through in the final board layout -- their exact position is not a measured datasheet value and should be adjusted to match the real primary current path during layout.")
	(tags "current transformer CST-1005 triad")
	(property "Reference" "REF**"
		(at 7.5 -16 0)
		(layer "F.SilkS")
		(uuid "b8a1c001-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "CST-1005"
		(at 7.5 18 0)
		(layer "F.Fab")
		(uuid "b8a1c002-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Datasheet" "https://catalog.triadmagnetics.com/Asset/CST-1005.pdf"
		(at 7.5 0 0)
		(layer "F.Fab")
		(hide yes)
		(uuid "b8a1c003-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	;; Courtyard: generous bound containing all pads with margin (not a precise body trace -- see descr)
	(fp_rect
		(start -6.0 -9.0)
		(end 21.0 15.0)
		(layer "F.CrtYd")
		(width 0.05)
		(fill none)
		(uuid "b8a1c010-0000-0000-0000-000000000001")
	)
	(fp_rect
		(start -3.0 -7.9)
		(end 18.0 7.9)
		(layer "F.SilkS")
		(width 0.12)
		(fill none)
		(uuid "b8a1c011-0000-0000-0000-000000000001")
	)
	;; Center window for the primary conductor (F=8.50mm dia, informational only, no copper)
	(fp_circle
		(center 7.5 0)
		(end 11.75 0)
		(layer "F.Fab")
		(width 0.1)
		(fill none)
		(uuid "b8a1c012-0000-0000-0000-000000000001")
	)
	;; Secondary pins -- real THT pads. Footprint 3 = datasheet PIN1, footprint 4 = datasheet PIN2.
	(pad "3" thru_hole circle
		(at 0 0)
		(size 1.8 1.8)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a1c020-0000-0000-0000-000000000001")
	)
	(pad "4" thru_hole circle
		(at 15.0 0)
		(size 1.8 1.8)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a1c021-0000-0000-0000-000000000001")
	)
	;; Primary pass-through markers (AA/AB) -- SMD placeholder pads for netlist parity only, see descr
	(pad "1" smd rect
		(at -3.0 12.0)
		(size 3.0 1.5)
		(layers "F.Cu")
		(uuid "b8a1c022-0000-0000-0000-000000000001")
	)
	(pad "2" smd rect
		(at 18.0 12.0)
		(size 3.0 1.5)
		(layers "F.Cu")
		(uuid "b8a1c023-0000-0000-0000-000000000001")
	)
)
