(footprint "Converter_DCDC_RECOM_RP-S"
	(version 20231120)
	(generator "temper-hand")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "RECOM RP-series single-output isolated 1W DC-DC converter (used here as RP-1505S), SIP7 package with 5 of 7 positions populated. Dimensions from the official RECOM RP datasheet (https://recom-power.com/pdf/Econoline/RP.pdf, REV 7/2024, page 6 'Dimension and Physical Characteristics'): pin pitch 2.54mm, body 19.65 x 7.05 x 10.2mm max, pin diameter 0.5mm nominal. Pin span verified two independent ways in the datasheet's own table: '6 x 2.54 = 15.24mm' (pin1-to-pin7) and '4 x 2.54 = 10.16mm' (pin1-to-pin5), both internally consistent with a plain 2.54mm 7-position grid. Real datasheet pinning (Single-output variant): pin1=+Vin, pin2=-Vin, pin5=-Vout, pin7=+Vout; pins 3, 4, and 6 are genuinely absent (not just unused -- no lead is present). Footprint pad numbers instead match the placed KiCad symbol (temper:DCDC_Isolated: 1=VIN, 2=GND_IN, 3=VOUT, 4=GND_OUT), NOT the datasheet's own pin numbers -- mapping: footprint pad 1 = datasheet pin1 (+Vin), pad 2 = datasheet pin2 (-Vin), pad 3 = datasheet pin7 (+Vout), pad 4 = datasheet pin5 (-Vout). Physical X positions are the real, datasheet-sourced pin-grid locations; only the pad *labels* were remapped. Replaces a prior placeholder Footprint reference (Converter_DCDC:Converter_DCDC_RECOM_RxxxxS-1WR2_THT) that did not exist in any installed KiCad library.")
	(tags "dc-dc converter isolated RP RECOM SIP7")
	(attr through_hole)
	(property "Reference" "REF**"
		(at 8.6 -6.0 0)
		(layer "F.SilkS")
		(uuid "b8a3c001-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "RP-1505S"
		(at 8.6 8.0 0)
		(layer "F.Fab")
		(uuid "b8a3c002-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Datasheet" "https://recom-power.com/pdf/Econoline/RP.pdf"
		(at 8.6 0 0)
		(layer "F.Fab")
		(hide yes)
		(uuid "b8a3c003-0000-0000-0000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	;; Courtyard/silkscreen: 19.65 x 7.05mm body, pin1 set back 2.00mm from the left body edge per datasheet
	(fp_rect
		(start -2.0 -3.525)
		(end 17.65 3.525)
		(layer "F.CrtYd")
		(width 0.05)
		(fill none)
		(uuid "b8a3c010-0000-0000-0000-000000000001")
	)
	(fp_rect
		(start -2.0 -3.525)
		(end 17.65 3.525)
		(layer "F.SilkS")
		(width 0.12)
		(fill none)
		(uuid "b8a3c011-0000-0000-0000-000000000001")
	)
	;; Pad "1" = symbol VIN = datasheet pin1 (+Vin). Square pad, standard THT pin-1 convention.
	(pad "1" thru_hole rect
		(at 0 0)
		(size 1.4 1.4)
		(drill 0.8)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a3c020-0000-0000-0000-000000000001")
	)
	;; Pad "2" = symbol GND_IN = datasheet pin2 (-Vin)
	(pad "2" thru_hole circle
		(at 2.54 0)
		(size 1.4 1.4)
		(drill 0.8)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a3c021-0000-0000-0000-000000000001")
	)
	;; datasheet pins 3, 4 genuinely absent on the Single-output variant -- no footprint pad here
	;; Pad "4" = symbol GND_OUT = datasheet pin5 (-Vout)
	(pad "4" thru_hole circle
		(at 10.16 0)
		(size 1.4 1.4)
		(drill 0.8)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a3c022-0000-0000-0000-000000000001")
	)
	;; datasheet pin 6 genuinely absent on the Single-output variant -- no footprint pad here
	;; Pad "3" = symbol VOUT = datasheet pin7 (+Vout)
	(pad "3" thru_hole circle
		(at 15.24 0)
		(size 1.4 1.4)
		(drill 0.8)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a3c023-0000-0000-0000-000000000001")
	)
)
