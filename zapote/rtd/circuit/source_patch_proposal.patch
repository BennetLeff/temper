+
+    # A differential RTDIN filter is required at the converter pins. The
+    # datasheet shows 100 nF as a typical 100 ohm application value, but that
+    # value cannot meet this design's 100 ms open-SENSE+ bound with the
+    # 1 Mohm diagnostic pullup paired with 1 nF C0G gives a worst-case
+    # 1.323 ms temperature-adjusted tau including a 200 pF harness/PCB
+    # parasitic budget, 100 ppm/C pullup TCR, and 30 ppm/C C0G tempco over
+    # 60 C (10.5 tau = 13.9 ms). The MAX's 10 Mohm recommendation is too slow with its
+    # typical 100 nF filter. Input-leakage and connected-load error still need
+    # electrical acceptance.
+    c_rtd_input = new Capacitor
+    c_rtd_input.value = 1nF
+    c_rtd_input.dielectric = "C0G"
+    c_rtd_input.voltage_rating = 50V
+    c_rtd_input.mpn = "C0603C102J5GACTU"
+    c_rtd_input.footprint = "Capacitor_SMD:C_0603_1608Metric"
+    adc.RTDIN_P ~ c_rtd_input.p1
+    c_rtd_input.p2 ~ adc.RTDIN_N
+
+    # MAX31865 datasheet p20 recommends this optional bias for a broken
+    # RTDIN+ lead. A matched pullup on RTDIN- gives the open-SENSE- case a
+    # bounded negative differential rather than leaving it unclassified.
+    r_rtdin_p_bias = new Resistor
+    r_rtdin_p_bias.value = 1Mohm +/- 5%
+    r_rtdin_p_bias.mpn = "RC0603JR-071ML"
+    r_rtdin_p_bias.footprint = "Resistor_SMD:R_0603_1608Metric"
+    adc.RTDIN_P ~ r_rtdin_p_bias.p1
+    r_rtdin_p_bias.p2 ~ adc.BIAS
+
+    # Apply the same bounded bias to RTDIN-. This is not in the MAX typical
+    # figure, but it gives an open-SENSE- lead a deterministic negative RTD
+    # differential (short/low code) with negligible connected-load error.
+    r_rtdin_n_bias = new Resistor
+    r_rtdin_n_bias.value = 1Mohm +/- 5%
+    r_rtdin_n_bias.mpn = "RC0603JR-071ML"
+    r_rtdin_n_bias.footprint = "Resistor_SMD:R_0603_1608Metric"
+    adc.RTDIN_N ~ r_rtdin_n_bias.p1
+    r_rtdin_n_bias.p2 ~ adc.BIAS
     
