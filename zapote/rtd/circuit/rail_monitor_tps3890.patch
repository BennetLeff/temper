+component TPS3890:
+    """Adjustable single-channel RTD rail supervisor; RESET is low below threshold."""
+    footprint = "Temper_RTD:TPS389001DSER_WSON-6_DSE"
+    mpn = "TPS389001DSER"
+    manufacturer = "Texas Instruments"
+
+    # TI TPS3890 DSE top view: SENSE=1, GND=2, MR=3, VDD=4, CT=5, RESET=6.
+    signal SENSE ~ pin 1
+    signal GND ~ pin 2
+    signal MR ~ pin 3
+    signal VDD ~ pin 4
+    signal CT ~ pin 5
+    signal RESET ~ pin 6
 
