+        .findings
+        .iter()
+        .any(|f| f.rule == "DRC.RTD.SENSITIVE_AGGRESSOR_GEOMETRY"
+            && f.status == zapote_core::Status::Fail));
+    assert!(report.findings.iter().any(|f| {
