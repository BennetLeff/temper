+fn segment_crossing_parameter(
+    start: [f64; 2],
+    end: [f64; 2],
+    edge_start: [f64; 2],
+    edge_end: [f64; 2],
+) -> Option<f64> {
+    let r = [end[0] - start[0], end[1] - start[1]];
+    let s = [edge_end[0] - edge_start[0], edge_end[1] - edge_start[1]];
+    let denominator = r[0] * s[1] - r[1] * s[0];
+    if denominator.abs() < 1e-12 {
+        return None;
+    }
