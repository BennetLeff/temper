# Temper fascia UI board, revision 2 (2026-10-12 owner decision: owned controls). Schematic
# capture, no layout. One board parallel to the fascia (enclosure R33 DECISIONS 3, R41
# r33_world.py): the NHD-3.12-25664UCW2 OLED on a 1x20 socket, three C&K KSC223G LFG tactile
# switches under owned metal caps, an MCP23S08 SPI expander, a TMP122 temperature sensor, a
# self-oscillating buzzer, a TMAG5170A1 Hall sensor on a sensor tab (read through the 3 mm
# fascia, die plane 9.2 mm in front of this board) and the CS qualification gates, with one
# 12-way JST XH jumper to controller J7. Removed: Grayhill encoder socket J2, its comparator
# and pull-ups, the APEM IPR3PAD2 buttons (DECISIONS U19).
#
# Contract (read-only): zapote/controller DECISIONS C26 and ENCLOSURE-HANDOFF.md (J7 pin
# map), firmware ui_board_map.h at 780eaab89 (expander bit map). Decisions: ../../DECISIONS.md.
# Verification: ../../tools/verify_ui.py.
#
# J7:  1 +5V (V5_UI, <= 30 mA)  2 +3V3  3 GND  4 SCK  5 GND  6 MOSI  7 MISO  8 GND
#      9 CS_OLED#  10 OLED D/C  11 GND  12 CS_EXP#
# MCP23S08 (opcode 0x40, A1 = A0 = 0):
#      GP0 START  GP1 STOP  GP2 BACK/RESET  GP3 TMAG select (low = select)
#      GP4 TMAG ALERT (input)  GP5 spare (input)  GP6 buzzer (high = on)
#      GP7 TMP122 select (low = select)
# CS qualification (DECISIONS U20): CS_dev# = GPx OR NAND(CS_EXP#, CS_OLED#). A device is
# selected only when its GP is low AND CS_EXP# is high AND CS_OLED# is high.

#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("TRAITS")

from "ui_parts.ato" import Resistor, Capacitor, Capacitor0805, Diode1n4148ws
from "ui_parts.ato" import Mcp23s08, Tmp122, Srv05_4, Ao3400a, BuzzerGsd9605Yb5v
from "ui_parts.ato" import XhHeader12, OledSocket20, TactKsc223g
from "ui_parts.ato" import Tmag5170, Nand2, Or2x2, ShHeader10

module UiBoard:
    # ------------------------------------------------------------------ nets
    signal gnd
    signal v3v3
    signal v5_ui
    gnd.override_net_name = "GND"
    v3v3.override_net_name = "V3V3"
    v5_ui.override_net_name = "V5_UI"
    # J7-side bus nets (the controller's own net names)
    signal j7_sck
    signal j7_mosi
    signal j7_miso
    signal j7_cs_oled_n
    signal j7_dc
    signal j7_cs_exp_n
    j7_sck.override_net_name = "J7_SCK"
    j7_mosi.override_net_name = "J7_MOSI"
    j7_miso.override_net_name = "J7_MISO"
    j7_cs_oled_n.override_net_name = "J7_CS_OLED_N"
    j7_dc.override_net_name = "J7_DC"
    j7_cs_exp_n.override_net_name = "J7_CS_EXP_N"
    # board-local nets
    signal miso_local
    signal btn_start_raw
    signal btn_stop_raw
    signal btn_back_raw
    signal btn_start
    signal btn_stop
    signal btn_back
    signal buz_drv
    signal buz_n
    signal buz_gate
    signal gp3_tmag_sel_n
    signal gp4_tmag_alert
    signal gp5_spare
    signal gp7_tmp_sel_n
    signal bus_busy
    signal cs_tmag_n
    signal cs_tmp_n
    signal tmag_sdo
    signal exp_reset
    signal oled_res_n
    miso_local.override_net_name = "MISO_LOCAL"
    btn_start_raw.override_net_name = "BTN_START_RAW"
    btn_stop_raw.override_net_name = "BTN_STOP_RAW"
    btn_back_raw.override_net_name = "BTN_BACK_RAW"
    btn_start.override_net_name = "GP0_BTN_START"
    btn_stop.override_net_name = "GP1_BTN_STOP"
    btn_back.override_net_name = "GP2_BTN_BACK"
    buz_drv.override_net_name = "GP6_BUZZER"
    buz_n.override_net_name = "BUZ_N"
    buz_gate.override_net_name = "BUZ_GATE"
    gp3_tmag_sel_n.override_net_name = "GP3_TMAG_SEL_N"
    gp4_tmag_alert.override_net_name = "GP4_TMAG_ALERT"
    gp5_spare.override_net_name = "GP5_SPARE"
    gp7_tmp_sel_n.override_net_name = "GP7_TMP_SEL_N"
    bus_busy.override_net_name = "BUS_BUSY"
    cs_tmag_n.override_net_name = "CS_TMAG_N"
    cs_tmp_n.override_net_name = "CS_TMP_N"
    tmag_sdo.override_net_name = "TMAG_SDO"
    exp_reset.override_net_name = "EXP_RESET"
    oled_res_n.override_net_name = "OLED_RES_N"

    # ------------------------------------------------------------ J7 and power
    j_ui = new XhHeader12
    j_ui.designator = "J7"
    j_ui.p1 ~ v5_ui
    j_ui.p2 ~ v3v3
    j_ui.p3 ~ gnd
    j_ui.p4 ~ j7_sck
    j_ui.p5 ~ gnd
    j_ui.p6 ~ j7_mosi
    j_ui.p7 ~ j7_miso
    j_ui.p8 ~ gnd
    j_ui.p9 ~ j7_cs_oled_n
    j_ui.p10 ~ j7_dc
    j_ui.p11 ~ gnd
    j_ui.p12 ~ j7_cs_exp_n

    # 3V3 entry: bulk for the OLED boost start-up and the buzzer, plus HF.
    c_3v3_bulk = new Capacitor0805
    c_3v3_bulk.designator = "C1"
    c_3v3_bulk.value = 22uF +/- 20%
    c_3v3_bulk.mpn = "CL21A226MAQNNNE"
    c_3v3_bulk.p1 ~ v3v3
    c_3v3_bulk.p2 ~ gnd
    c_3v3_hf = new Capacitor
    c_3v3_hf.designator = "C2"
    c_3v3_hf.value = 100nF +/- 10%
    c_3v3_hf.mpn = "CC0603KRX7R9BB104"
    c_3v3_hf.p1 ~ v3v3
    c_3v3_hf.p2 ~ gnd
    # V5_UI is not used (DECISIONS U3: the OLED boost needs 170 mA at 5 V, the budget is 30 mA); the
    # pin ends in a capacitor and a bleed so the controller's TLV76050 sees a defined output.
    c_v5 = new Capacitor
    c_v5.designator = "C11"
    c_v5.value = 100nF +/- 10%
    c_v5.mpn = "CC0603KRX7R9BB104"
    c_v5.p1 ~ v5_ui
    c_v5.p2 ~ gnd
    # 0.5 mA bleed so the unused 5 V output is never left floating at no load.
    r_v5_bleed = new Resistor
    r_v5_bleed.designator = "R23"
    r_v5_bleed.value = 10kohm +/- 1%
    r_v5_bleed.mpn = "0603WAF1002T5E"
    r_v5_bleed.p1 ~ v5_ui
    r_v5_bleed.p2 ~ gnd

    # ---------------------------------------------------------- ESD at J7 entry
    # Controller end already has 100 ohm in series on every signal (C26). Here: SRV05-4
    # clamps (Vcc on V3V3) at the connector. MISO is driven from this board, so it
    # gets its own 100 ohm source termination (R20) between the chips and J7.
    u_esd_j7a = new Srv05_4
    u_esd_j7a.designator = "U4"
    u_esd_j7a.VCC ~ v3v3
    u_esd_j7a.GND ~ gnd
    u_esd_j7a.IO1 ~ j7_sck
    u_esd_j7a.IO2 ~ j7_mosi
    u_esd_j7a.IO3 ~ j7_miso
    u_esd_j7a.IO4 ~ j7_cs_oled_n
    u_esd_j7b = new Srv05_4
    u_esd_j7b.designator = "U5"
    u_esd_j7b.VCC ~ v3v3
    u_esd_j7b.GND ~ gnd
    u_esd_j7b.IO1 ~ j7_dc
    u_esd_j7b.IO2 ~ j7_cs_exp_n
    r_miso = new Resistor
    r_miso.designator = "R20"
    r_miso.value = 100ohm +/- 1%
    r_miso.mpn = "0603WAF1000T5E"
    r_miso.p1 ~ miso_local
    r_miso.p2 ~ j7_miso

    # ------------------------------------------------------------- expander U1
    u_exp = new Mcp23s08
    u_exp.designator = "U1"
    u_exp.VDD ~ v3v3
    u_exp.VSS ~ gnd
    u_exp.A0 ~ gnd
    u_exp.A1 ~ gnd
    u_exp.SCK ~ j7_sck
    u_exp.SI ~ j7_mosi
    u_exp.SO ~ miso_local
    u_exp.CS ~ j7_cs_exp_n
    u_exp.RESET ~ exp_reset
    u_exp.GP0 ~ btn_start
    u_exp.GP1 ~ btn_stop
    u_exp.GP2 ~ btn_back
    u_exp.GP3 ~ gp3_tmag_sel_n
    u_exp.GP4 ~ gp4_tmag_alert
    u_exp.GP5 ~ gp5_spare
    u_exp.GP6 ~ buz_drv
    u_exp.GP7 ~ gp7_tmp_sel_n
    c_exp = new Capacitor
    c_exp.designator = "C3"
    c_exp.value = 100nF +/- 10%
    c_exp.mpn = "CC0603KRX7R9BB104"
    c_exp.p1 ~ v3v3
    c_exp.p2 ~ gnd
    # No reset line on J7: tie RESET high through 10 k (DS Table 1-1: "must be biased externally").
    r_exp_reset = new Resistor
    r_exp_reset.designator = "R18"
    r_exp_reset.value = 10kohm +/- 1%
    r_exp_reset.mpn = "0603WAF1002T5E"
    r_exp_reset.p1 ~ v3v3
    r_exp_reset.p2 ~ exp_reset

    # ---------------------------------------------------------- temperature U2
    u_tmp = new Tmp122
    u_tmp.designator = "U2"
    u_tmp.VP ~ v3v3
    u_tmp.GND ~ gnd
    u_tmp.SCK ~ j7_sck
    u_tmp.CS ~ cs_tmp_n
    u_tmp.SIO ~ miso_local
    c_tmp = new Capacitor
    c_tmp.designator = "C4"
    c_tmp.value = 100nF +/- 10%
    c_tmp.mpn = "CC0603KRX7R9BB104"
    c_tmp.p1 ~ v3v3
    c_tmp.p2 ~ gnd
    # GP7 (expander side of the qualification gate) is an input with this pull-up at reset:
    # high = TMP122 not requested. The device-side pull-up R29 holds CS# high if the gate is
    # unpowered.
    r_tmp_cs = new Resistor
    r_tmp_cs.designator = "R17"
    r_tmp_cs.value = 10kohm +/- 1%
    r_tmp_cs.mpn = "0603WAF1002T5E"
    r_tmp_cs.p1 ~ v3v3
    r_tmp_cs.p2 ~ gp7_tmp_sel_n
    r_tmp_cs_dev = new Resistor
    r_tmp_cs_dev.designator = "R29"
    r_tmp_cs_dev.value = 10kohm +/- 1%
    r_tmp_cs_dev.mpn = "0603WAF1002T5E"
    r_tmp_cs_dev.p1 ~ v3v3
    r_tmp_cs_dev.p2 ~ cs_tmp_n

    # --------------------------------------------------- OLED socket J3 (SSD1322)
    # 4-wire SPI (BS1 = BS0 = 0). Pins per NHD rev 7 p.4: 1 VSS, 2 VDD, 3 BC_VDD (NC),
    # 4 D/C, 5-6 R/W, E tied low, 7 SCLK, 8 SDIN, 9 NC, 10-14 D3-D7 tied low, 15 VCC (NC),
    # 16 /RES, 17 /CS, 18 G_VDD (NC), 19 BS1, 20 BS0. Default jumpers: the module makes its
    # 12 V panel supply itself from VDD (rev 7 p.6), so pins 3, 15 and 18 stay open.
    # D/C goes straight to J7.10: the controller's GPIO45 is a strap pin, nothing here pulls it up.
    j_oled = new OledSocket20
    j_oled.designator = "J3"
    j_oled.p1 ~ gnd
    j_oled.p2 ~ v3v3
    j_oled.p4 ~ j7_dc
    j_oled.p5 ~ gnd
    j_oled.p6 ~ gnd
    j_oled.p7 ~ j7_sck
    j_oled.p8 ~ j7_mosi
    j_oled.p10 ~ gnd
    j_oled.p11 ~ gnd
    j_oled.p12 ~ gnd
    j_oled.p13 ~ gnd
    j_oled.p14 ~ gnd
    j_oled.p16 ~ oled_res_n
    j_oled.p17 ~ j7_cs_oled_n
    j_oled.p19 ~ gnd
    j_oled.p20 ~ gnd
    c_oled_bulk = new Capacitor0805
    c_oled_bulk.designator = "C6"
    c_oled_bulk.value = 22uF +/- 20%
    c_oled_bulk.mpn = "CL21A226MAQNNNE"
    c_oled_bulk.p1 ~ v3v3
    c_oled_bulk.p2 ~ gnd
    c_oled_hf = new Capacitor
    c_oled_hf.designator = "C7"
    c_oled_hf.value = 100nF +/- 10%
    c_oled_hf.mpn = "CC0603KRX7R9BB104"
    c_oled_hf.p1 ~ v3v3
    c_oled_hf.p2 ~ gnd
    # Power-on reset: RES# is held low while 10 k charges 1 uF, and D2 discharges the
    # capacitor when V3V3 drops, so every power cycle resets the display.
    r_res = new Resistor
    r_res.designator = "R19"
    r_res.value = 10kohm +/- 1%
    r_res.mpn = "0603WAF1002T5E"
    r_res.p1 ~ v3v3
    r_res.p2 ~ oled_res_n
    c_res = new Capacitor
    c_res.designator = "C12"
    c_res.value = 1uF +/- 10%
    c_res.mpn = "CL10A105KB8NNNC"
    c_res.p1 ~ oled_res_n
    c_res.p2 ~ gnd
    d_res = new Diode1n4148ws
    d_res.designator = "D2"
    d_res.A ~ oled_res_n
    d_res.K ~ v3v3

    # ----------------------------------------------------------------- buttons
    # SW1 select/start (u -35), SW2 stop (u 5), SW3 back/reset (u -75): C&K KSC223G LFG tactile,
    # normally open, close to GND, under owned metal caps (enclosure R44).
    # Per line: switch pin -> [SRV05-4 clamp + 10 k pull-up] -> 1 k -> expander pin.
    sw_start = new TactKsc223g
    sw_start.designator = "SW1"
    sw_start.A ~ btn_start_raw
    sw_start.B ~ gnd
    sw_stop = new TactKsc223g
    sw_stop.designator = "SW2"
    sw_stop.A ~ btn_stop_raw
    sw_stop.B ~ gnd
    sw_back = new TactKsc223g
    sw_back.designator = "SW3"
    sw_back.A ~ btn_back_raw
    sw_back.B ~ gnd
    r_pu_start = new Resistor
    r_pu_start.designator = "R4"
    r_pu_start.value = 10kohm +/- 1%
    r_pu_start.mpn = "0603WAF1002T5E"
    r_pu_start.p1 ~ v3v3
    r_pu_start.p2 ~ btn_start_raw
    r_pu_stop = new Resistor
    r_pu_stop.designator = "R5"
    r_pu_stop.value = 10kohm +/- 1%
    r_pu_stop.mpn = "0603WAF1002T5E"
    r_pu_stop.p1 ~ v3v3
    r_pu_stop.p2 ~ btn_stop_raw
    r_pu_back = new Resistor
    r_pu_back.designator = "R6"
    r_pu_back.value = 10kohm +/- 1%
    r_pu_back.mpn = "0603WAF1002T5E"
    r_pu_back.p1 ~ v3v3
    r_pu_back.p2 ~ btn_back_raw
    r_se_start = new Resistor
    r_se_start.designator = "R1"
    r_se_start.value = 1kohm +/- 1%
    r_se_start.mpn = "0603WAF1001T5E"
    r_se_start.p1 ~ btn_start_raw
    r_se_start.p2 ~ btn_start
    r_se_stop = new Resistor
    r_se_stop.designator = "R2"
    r_se_stop.value = 1kohm +/- 1%
    r_se_stop.mpn = "0603WAF1001T5E"
    r_se_stop.p1 ~ btn_stop_raw
    r_se_stop.p2 ~ btn_stop
    r_se_back = new Resistor
    r_se_back.designator = "R3"
    r_se_back.value = 1kohm +/- 1%
    r_se_back.mpn = "0603WAF1001T5E"
    r_se_back.p1 ~ btn_back_raw
    r_se_back.p2 ~ btn_back

    # ---------------------------------------------------- ESD at the controls
    # Contact discharge from a cap or the knob goes to the bonded fascia through the enclosure's
    # deliberate contacts, never through this board's ground (DECISIONS U26). The clamps are for
    # whatever gets through to the switch pins. Channel 4 is spare.
    u_esd_ctl_a = new Srv05_4
    u_esd_ctl_a.designator = "U6"
    u_esd_ctl_a.VCC ~ v3v3
    u_esd_ctl_a.GND ~ gnd
    u_esd_ctl_a.IO1 ~ btn_start_raw
    u_esd_ctl_a.IO2 ~ btn_stop_raw
    u_esd_ctl_a.IO3 ~ btn_back_raw

    # ------------------------------------------------------------------- buzzer
    # GSD9605YB-5V2800 (85 C part; the 70 C 3V2800 was replaced, DECISIONS U28).
    # Self-oscillating electromagnetic buzzer on V3V3, low-side switched by Q1. GP6 is an
    # input (high impedance) at reset and R22 holds the gate low, so the buzzer is off until
    # firmware sets IODIR.6 = 0 and OLAT.6 = 1. D1 clamps the coil kick.
    bz = new BuzzerGsd9605Yb5v
    bz.designator = "BZ1"
    bz.P ~ v3v3
    bz.N ~ buz_n
    q_buz = new Ao3400a
    q_buz.designator = "Q1"
    q_buz.D ~ buz_n
    q_buz.S ~ gnd
    q_buz.G ~ buz_gate
    d_buz = new Diode1n4148ws
    d_buz.designator = "D1"
    d_buz.A ~ buz_n
    d_buz.K ~ v3v3
    r_gate = new Resistor
    r_gate.designator = "R21"
    r_gate.value = 100ohm +/- 1%
    r_gate.mpn = "0603WAF1000T5E"
    r_gate.p1 ~ buz_drv
    r_gate.p2 ~ buz_gate
    r_gate_pd = new Resistor
    r_gate_pd.designator = "R22"
    r_gate_pd.value = 100kohm +/- 1%
    r_gate_pd.mpn = "0603WAF1003T5E"
    r_gate_pd.p1 ~ buz_gate
    r_gate_pd.p2 ~ gnd
    c_buz = new Capacitor
    c_buz.designator = "C10"
    c_buz.value = 10uF +/- 10%
    c_buz.mpn = "CL10A106KP8NNNC"
    c_buz.p1 ~ v3v3
    c_buz.p2 ~ gnd

    # ------------------------------------------------- CS qualification (DECISIONS U20)
    # BUS_BUSY = NAND(CS_EXP#, CS_OLED#): high while the expander or the OLED is being accessed.
    # CS_dev# = GPx OR BUS_BUSY: low (selected) only when GPx is low AND CS_EXP# is high AND
    # CS_OLED# is high. GP3 and GP7 are inputs with pull-ups at reset, so both devices are
    # deselected until firmware drives a GP low (R26 and R17), and the device-side pull-ups
    # (R24 at the sensor, R29 at the TMP122) hold CS# high if a gate is unpowered.
    u_busy = new Nand2
    u_busy.designator = "U9"
    u_busy.VCC ~ v3v3
    u_busy.GND ~ gnd
    u_busy.A ~ j7_cs_exp_n
    u_busy.B ~ j7_cs_oled_n
    u_busy.Y ~ bus_busy
    c_busy = new Capacitor
    c_busy.designator = "C17"
    c_busy.value = 100nF +/- 10%
    c_busy.mpn = "CC0603KRX7R9BB104"
    c_busy.p1 ~ v3v3
    c_busy.p2 ~ gnd
    u_sel = new Or2x2
    u_sel.designator = "U10"
    u_sel.VCC ~ v3v3
    u_sel.GND ~ gnd
    u_sel.A1 ~ gp3_tmag_sel_n
    u_sel.B1 ~ bus_busy
    u_sel.Y1 ~ cs_tmag_n
    u_sel.A2 ~ gp7_tmp_sel_n
    u_sel.B2 ~ bus_busy
    u_sel.Y2 ~ cs_tmp_n
    c_sel = new Capacitor
    c_sel.designator = "C18"
    c_sel.value = 100nF +/- 10%
    c_sel.mpn = "CC0603KRX7R9BB104"
    c_sel.p1 ~ v3v3
    c_sel.p2 ~ gnd
    r_gp3_pu = new Resistor
    r_gp3_pu.designator = "R26"
    r_gp3_pu.value = 10kohm +/- 1%
    r_gp3_pu.mpn = "0603WAF1002T5E"
    r_gp3_pu.p1 ~ v3v3
    r_gp3_pu.p2 ~ gp3_tmag_sel_n
    # GP4 reads the sensor's ALERT (open-drain class output, polled with the buttons); GP5 is spare.
    r_alert_pu = new Resistor
    r_alert_pu.designator = "R25"
    r_alert_pu.value = 10kohm +/- 1%
    r_alert_pu.mpn = "0603WAF1002T5E"
    r_alert_pu.p1 ~ v3v3
    r_alert_pu.p2 ~ gp4_tmag_alert
    r_gp5_pu = new Resistor
    r_gp5_pu.designator = "R27"
    r_gp5_pu.value = 10kohm +/- 1%
    r_gp5_pu.mpn = "0603WAF1002T5E"
    r_gp5_pu.p1 ~ v3v3
    r_gp5_pu.p2 ~ gp5_spare

    # ------------------------------------------- sensor tab harness, main-board end (J8)
    # 10-way JST SH, 1:1 to J9 on the sensor tab. GND beside every signal.
    # 1 CS_TMAG#, 2 GND, 3 SCK, 4 GND, 5 MOSI, 6 GND, 7 MISO (via R28 at the sensor), 8 GND,
    # 9 ALERT, 10 V3V3.
    j_tab = new ShHeader10
    j_tab.designator = "J8"
    j_tab.p1 ~ cs_tmag_n
    j_tab.p2 ~ gnd
    j_tab.p3 ~ j7_sck
    j_tab.p4 ~ gnd
    j_tab.p5 ~ j7_mosi
    j_tab.p6 ~ gnd
    j_tab.p7 ~ miso_local
    j_tab.p8 ~ gnd
    j_tab.p9 ~ gp4_tmag_alert
    j_tab.p10 ~ v3v3

    # ----------------------------------------------------------- SENSOR TAB (separate PCB)
    # A 60 x 32 mm tab behind the fascia, die plane at w = -4.00 (DECISIONS U26), connected to J8
    # by a 1:1 harness. Everything below is on the tab.
    j_tabr = new ShHeader10
    j_tabr.designator = "J9"
    j_tabr.p1 ~ cs_tmag_n
    j_tabr.p2 ~ gnd
    j_tabr.p3 ~ j7_sck
    j_tabr.p4 ~ gnd
    j_tabr.p5 ~ j7_mosi
    j_tabr.p6 ~ gnd
    j_tabr.p7 ~ miso_local
    j_tabr.p8 ~ gnd
    j_tabr.p9 ~ gp4_tmag_alert
    j_tabr.p10 ~ v3v3
    u_tmag = new Tmag5170
    u_tmag.designator = "U8"
    u_tmag.VCC ~ v3v3
    u_tmag.GND ~ gnd
    u_tmag.TEST ~ gnd
    u_tmag.SCK ~ j7_sck
    u_tmag.SDI ~ j7_mosi
    u_tmag.SDO ~ tmag_sdo
    u_tmag.CS ~ cs_tmag_n
    u_tmag.ALERT ~ gp4_tmag_alert
    c_tmag = new Capacitor
    c_tmag.designator = "C16"
    c_tmag.value = 100nF +/- 10%
    c_tmag.mpn = "CC0603KRX7R9BB104"
    c_tmag.p1 ~ v3v3
    c_tmag.p2 ~ gnd
    # 390 ohm in the sensor's SDO: with two drivers enabled by a firmware error the shorted
    # current stays under the sensor's 10 mA absolute maximum (3.465 V / 390 ohm = 8.9 mA).
    r_sdo = new Resistor
    r_sdo.designator = "R28"
    r_sdo.value = 390ohm +/- 1%
    r_sdo.mpn = "0603WAF3900T5E"
    r_sdo.p1 ~ tmag_sdo
    r_sdo.p2 ~ miso_local
    r_cs_tmag_pu = new Resistor
    r_cs_tmag_pu.designator = "R24"
    r_cs_tmag_pu.value = 10kohm +/- 1%
    r_cs_tmag_pu.mpn = "0603WAF1002T5E"
    r_cs_tmag_pu.p1 ~ v3v3
    r_cs_tmag_pu.p2 ~ cs_tmag_n
    # SRV05-4 on the tab's four inputs toward the sensor (SCK, MOSI, CS#, ALERT); MISO has R28.
    u_esd_tab = new Srv05_4
    u_esd_tab.designator = "U7"
    u_esd_tab.VCC ~ v3v3
    u_esd_tab.GND ~ gnd
    u_esd_tab.IO1 ~ j7_sck
    u_esd_tab.IO2 ~ j7_mosi
    u_esd_tab.IO3 ~ cs_tmag_n
    u_esd_tab.IO4 ~ gp4_tmag_alert
