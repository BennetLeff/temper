# Parts of the fascia UI board. Each docstring cites the datasheet table or page its pin
# numbers were checked against (the datasheets live outside the repo; see DECISIONS.md U-refs).
# Resistor / Capacitor / Diode keep the attribute names of the shared library in the
# controller's components.ato, so tools/verify_ui.py reads them the same way.

component Resistor:
    designator_prefix = "R"
    footprint = "Resistor_SMD:R_0603_1608Metric"
    value: ohm
    mpn: str
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor:
    designator_prefix = "C"
    footprint = "Capacitor_SMD:C_0603_1608Metric"
    value: farad
    mpn: str
    voltage_rating: voltage
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor0805:
    designator_prefix = "C"
    footprint = "Capacitor_SMD:C_0805_2012Metric"
    value: farad
    mpn: str
    voltage_rating: voltage
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Diode1n4148ws:
    """Nexperia/Changjiang-class 1N4148WS switching diode, SOD-323 (LCSC C2128). Pin 1 is
    the cathode (band side), pin 2 the anode."""
    designator_prefix = "D"
    mpn = "1N4148WS"
    manufacturer = "Jiangsu Changjing Electronics"
    footprint = "Diode_SMD:D_SOD-323"
    signal K ~ pin 1
    signal A ~ pin 2

component Bead0603:
    """Murata BLM18PG121SN1D ferrite bead, 120 ohm at 100 MHz, 2 A, 50 mohm max DC
    resistance (LCSC C14709, JLC basic)."""
    designator_prefix = "FB"
    mpn = "BLM18PG121SN1D"
    manufacturer = "Murata"
    footprint = "Inductor_SMD:L_0603_1608Metric"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Mcp23s08:
    """Microchip MCP23S08-E/SO, 8-bit SPI I/O expander, SOIC-18 300 mil (LCSC C152205).
    DS20001919F Table 1-1 / Package Types (PDIP/SOIC): SCK 1, SI 2, SO 3, A1 4, A0 5,
    RESET 6, CS 7, INT 8, VSS 9, GP0-GP7 10-17, VDD 18. Opcode 0100 A1 A0 R/W."""
    designator_prefix = "U"
    mpn = "MCP23S08-E/SO"
    manufacturer = "Microchip"
    footprint = "Package_SO:SOIC-18W_7.5x11.6mm_P1.27mm"
    signal SCK ~ pin 1
    signal SI ~ pin 2
    signal SO ~ pin 3
    signal A1 ~ pin 4
    signal A0 ~ pin 5
    signal RESET ~ pin 6
    signal CS ~ pin 7
    signal INT ~ pin 8
    signal VSS ~ pin 9
    signal GP0 ~ pin 10
    signal GP1 ~ pin 11
    signal GP2 ~ pin 12
    signal GP3 ~ pin 13
    signal GP4 ~ pin 14
    signal GP5 ~ pin 15
    signal GP6 ~ pin 16
    signal GP7 ~ pin 17
    signal VDD ~ pin 18

component Tmp122:
    """TI TMP122AIDBVR, 1.5 C digital temperature sensor, SPI, SOT-23-6 (LCSC C2877606).
    SBOS272B Pin Configurations (SOT23-6): ALERT 1, GND 2, V+ 3, SCK 4, CS 5, SO/I 6.
    SO/I is high impedance while CS is high (t7 <= 30 ns). Power-on default: active,
    12-bit, comparator mode, so a read-only wiring (SO/I to MISO) is enough."""
    designator_prefix = "U"
    mpn = "TMP122AIDBVR"
    manufacturer = "Texas Instruments"
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    signal ALERT ~ pin 1
    signal GND ~ pin 2
    signal VP ~ pin 3
    signal SCK ~ pin 4
    signal CS ~ pin 5
    signal SIO ~ pin 6

component Tlv3202:
    """TI TLV3202AIDR dual rail-to-rail comparator, push-pull, SOIC-8 (LCSC C129325).
    SBOS561C Pin Functions: TLV3202 (D package): 1OUT 1, 1IN- 2, 1IN+ 3, GND 4, 2IN+ 5,
    2IN- 6, 2OUT 7, VCC 8."""
    designator_prefix = "U"
    mpn = "TLV3202AIDR"
    manufacturer = "Texas Instruments"
    footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    signal OUT1 ~ pin 1
    signal IN1N ~ pin 2
    signal IN1P ~ pin 3
    signal GND ~ pin 4
    signal IN2P ~ pin 5
    signal IN2N ~ pin 6
    signal OUT2 ~ pin 7
    signal VCC ~ pin 8

component Srv05_4:
    """MSKSEMI SRV05-4 4-line ESD array, SOT-23-6 (LCSC C2836319), the part the controller
    uses at its J7. Pin Configuration and Functions: IO1 1, GND 2, IO2 3, IO3 4, Vcc 5,
    IO4 6. VRWM 5 V, IEC 61000-4-2 +/-12 kV contact, 0.6 pF typ. Vcc ties to the 3.3 V
    rail, so the steering diodes clamp each line to V3V3 + VF."""
    designator_prefix = "U"
    mpn = "SRV05-4"
    manufacturer = "MSKSEMI"
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    signal IO1 ~ pin 1
    signal GND ~ pin 2
    signal IO2 ~ pin 3
    signal IO3 ~ pin 4
    signal VCC ~ pin 5
    signal IO4 ~ pin 6

component Ao3400a:
    """AO3400A 30 V N-channel logic-level MOSFET, SOT-23 (LCSC C20917, JLC basic): G 1,
    S 2, D 3. VGS(th) 0.65-1.45 V (LCSC listing 1.45 V max), 48 mohm at 2.5 V."""
    designator_prefix = "Q"
    mpn = "AO3400A"
    manufacturer = "Alpha & Omega"
    footprint = "Package_TO_SOT_SMD:SOT-23"
    signal G ~ pin 1
    signal S ~ pin 2
    signal D ~ pin 3

component BuzzerGsd9605:
    """Inghai GSD9605YB-3V2800 SMD electromagnetic active buzzer with built-in driver
    (LCSC C255327): 9.6 x 9.6 x 5.0 mm, 2.7 kHz, 2-5 V operating, 3.3 V rated, 30 mA max
    at 3.3 V, 80 dB min at 10 cm, -20..+70 C. Spec sheet p.1 (electromagnetic, active) and
    p.2 table. Pin 1 is the + terminal (drawing p.2, to confirm against the layout
    footprint)."""
    designator_prefix = "BZ"
    mpn = "GSD9605YB-3V2800"
    manufacturer = "Inghai"
    footprint = "Buzzer_Beeper:Buzzer_9.6x9.6mm_SMD"
    signal P ~ pin 1
    signal N ~ pin 2

component XhHeader12:
    """JST B12B-XH-A(LF)(SN), 12-pin 2.50 mm vertical (LCSC C158027), the part on the
    controller's J7. Body 32.4 x 5.75 mm, 7.0 mm above the board, 9.8 mm mated."""
    designator_prefix = "J"
    mpn = "B12B-XH-A(LF)(SN)"
    manufacturer = "JST"
    footprint = "Connector_JST:JST_XH_B12B-XH-A_1x12_P2.50mm_Vertical"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12

component MicroMatch6:
    """TE 7-215079-6 Micro-MaTch 6-position PCB receptacle, 1.27 mm (2 x 3) (LCSC C306122).
    Mates the 7-215083-6 on the Grayhill 62VG encoder lead (Grayhill 62AG/VG datasheet
    Rev. 02/2024, p.1 "Connector is AMP P/N 7-215083-6"). Pin n of the lead meets pin n here."""
    designator_prefix = "J"
    mpn = "7-215079-6"
    manufacturer = "TE Connectivity"
    footprint = "Temper_UI:TE_Micro-MaTch_7-215079-6_2x03_P1.27mm"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6

component OledSocket20:
    """1 x 20, 2.54 mm female socket for the NHD-3.12-25664UCW2 header (LCSC C46595982,
    PM254V-11-20-H85). 8.5 mm tall: it does NOT fit the 3.0 mm gap the enclosure models
    (R41 r33_world.py stacker); open item U-OPEN-1. Pin numbers are the Newhaven module's
    20 header pins, product specification rev. 7 (2024-08-25) p.4 Pin Description."""
    designator_prefix = "J"
    mpn = "PM254V-11-20-H85"
    manufacturer = "Boom Precision"
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x20_P2.54mm_Vertical"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16
    signal p17 ~ pin 17
    signal p18 ~ pin 18
    signal p19 ~ pin 19
    signal p20 ~ pin 20

component PushbuttonIpr3pad2:
    """APEM IPR3PAD2, IP67 panel pushbutton, normally open, straight PC terminals, 5.08 mm
    pitch (APEM IP series catalogue: "also available with straight PC terminals: IP.3PAD";
    ratings 200 mA 50 VDC, contact bounce 10 ms, silver gold-plated contacts). Hand-fitted
    panel part: no LCSC listing (bom/ui-parts.json lcsc_exception)."""
    designator_prefix = "SW"
    mpn = "IPR3PAD2"
    manufacturer = "APEM"
    footprint = "Temper_UI:APEM_IPR3PAD2_PC_P5.08mm"
    signal A ~ pin 1
    signal B ~ pin 2
