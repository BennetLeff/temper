SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Mesh.MshFileVersion = 2.2;
Mesh.ElementOrder = 1;
Mesh.CharacteristicLengthMin = 0.0002;
Mesh.CharacteristicLengthMax = 0.0002;
// Coordinates in metres. Native trace direction localized to +Y.
Rectangle(1) = {-0.0015, -0.00010000000000000005, 0.00144, 0.003, 0.0002000000000000001};
Disk(2)={0,-0.00010000000000000005, 0.00144,0.0015,0.0015};
Disk(3)={0,0.00010000000000000005, 0.00144,0.0015,0.0015};
pad[]=BooleanUnion{Surface{1};Delete;}{Surface{2,3};Delete;};
trace=news; Rectangle(trace)={-0.00125,0,0.00144,0.0025,0.009000000000000001};
face[]=BooleanUnion{Surface{pad[]};Delete;}{Surface{trace};Delete;};
cu[]=Extrude{0,0,0.000077}{Surface{face[]};};
substrate=newv; Box(substrate)={-0.0025,-0.002,0,0.005,0.011000000000000001,0.00144};
hole=newv; Cylinder(hole)={0,0,-0.0001,0,0,0.002,0.0008};
solids[]=BooleanDifference{Volume{cu[1],substrate};Delete;}{Volume{hole};Delete;};
joined[]=BooleanFragments{Volume{solids[]};Delete;}{};
eps=1e-6;
copper[]=Volume In BoundingBox{-0.0025-eps,-0.002-eps,0.00144-eps,0.0025+eps,0.009000000000000001+eps,0.0015170000000000001+eps};
fr4[]=Volume In BoundingBox{-0.0025-eps,-0.002-eps,-eps,0.0025+eps,0.009000000000000001+eps,0.00144+eps};
terminal[]=Surface In BoundingBox{-0.0008-eps,-0.0008-eps,0.00144-eps,0.0008+eps,0.0008+eps,0.0015170000000000001+eps};
far[]=Surface In BoundingBox{-0.00125-eps,0.009000000000000001-eps,0.00144-eps,0.00125+eps,0.009000000000000001+eps,0.0015170000000000001+eps};
outer[]=CombinedBoundary{Volume{joined[]};};
outer[]=Abs(outer[]);
outer[]-={terminal[],far[]};
Physical Volume(1)={copper[]};
Physical Volume(2)={fr4[]};
Physical Surface(11)={terminal[]};
Physical Surface(12)={far[]};
Physical Surface(13)={outer[]};
