SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Mesh.MshFileVersion = 2.2;
Mesh.MinimumCirclePoints = 64;
Mesh.MeshSizeFromCurvature = 64;
Mesh.CharacteristicLengthMin = 0.000100000000;
Mesh.CharacteristicLengthMax = 0.000300000000;
w=0.003000000000; L=0.008500000000; tc=0.000070000000; h=0.001440000000;
ri=0.000800000000; ro=ri+0.000025000000; lw=0.001145000000; lt=0.000510000000;
pw=0.003000000000; pl=0.003200000000; st=0.000150000000; top=0.003000000000;
e=1e-6;
Box(1)={-w/2,0,0,w,L,tc};
Box(2)={-pw/2,-pl/2,0,pw,pl,tc};
topCu()=BooleanUnion {Volume{1};Delete;}{Volume{2};Delete;};
Cylinder(3)={0,0,-h-tc,0,0,h+2*tc,ro};
cuTop()=BooleanDifference {Volume{topCu()};Delete;}{Volume{3};};
Box(4)={-pw/2,-pl/2,-h-tc,pw,pl,tc};
cuBottom()=BooleanDifference {Volume{4};Delete;}{Volume{3};};
Cylinder(5)={0,0,-h-tc,0,0,h+2*tc,ri};
barrel()=BooleanDifference {Volume{3};Delete;}{Volume{5};Delete;};
copper()=BooleanUnion {Volume{cuTop()};Delete;}{Volume{cuBottom(),barrel()};Delete;};
Box(10)={-0.003000000000,-0.003000000000,-h,0.006000000000,L+0.003000000000,h};
Cylinder(11)={0,0,-h,0,0,h,ro};
board()=BooleanDifference {Volume{10};Delete;}{Volume{11};Delete;};
Box(20)={-lw/2,-lt/2,-h-tc,lw,lt,top+h+tc};
Cylinder(21)={0,0,-h-tc,0,0,h+2*tc,ri};
Box(22)={-pw/2,-pl/2,tc,pw,pl,st};
solderBulk()=BooleanUnion {Volume{21};Delete;}{Volume{22};Delete;};
solder()=BooleanDifference {Volume{solderBulk()};Delete;}{Volume{20};};
all()=BooleanFragments {Volume{copper(),board(),solder(),20};Delete;}{};
Physical Volume(1)={copper()};
Physical Volume(2)={board()};
Physical Volume(3)={solder()};
Physical Volume(4)={20};
package()=Surface In BoundingBox {-lw/2-e,-lt/2-e,top-e,lw/2+e,lt/2+e,top+e};
farCu()=Surface In BoundingBox {-w/2-e,L-e,-e,w/2+e,L+e,tc+e};
farBoard()=Surface In BoundingBox {-0.003000000000-e,L-e,-h-e,0.003000000000+e,L+e,e};
Physical Surface(11)={package()};
Physical Surface(12)={farBoard()};
Physical Surface(14)={farCu()};
