SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Mesh.MshFileVersion = 2.2;
Mesh.MinimumCirclePoints = 64;
Mesh.MeshSizeFromCurvature = 64;
Mesh.CharacteristicLengthMin = 0.0001;
Mesh.CharacteristicLengthMax = 0.0006;
w=0.0025; L=0.0085; tc=0.00007; h=0.00144;
ri=0.0008; ro=ri+0.000025; lw=0.0008; lt=0.0006;
pw=0.003; pl=0.0032; st=0.00015; top=0.0012;
e=1e-6;
Box(1)={-w/2,0,0,w,L,tc};
Box(300)={-pw/2,-(pl-pw)/2,0,pw,pl-pw,tc};
Cylinder(301)={0,-(pl-pw)/2,0,0,0,tc,pw/2};
Cylinder(302)={0,(pl-pw)/2,0,0,0,tc,pw/2};
padTop()=BooleanUnion {Volume{300};Delete;}{Volume{301,302};Delete;};
topCu()=BooleanUnion {Volume{1};Delete;}{Volume{padTop()};Delete;};
Cylinder(3)={0,0,-h-tc,0,0,h+2*tc,ro};
cuTop()=BooleanDifference {Volume{topCu()};Delete;}{Volume{3};};
Box(310)={-pw/2,-(pl-pw)/2,-h-tc,pw,pl-pw,tc};
Cylinder(311)={0,-(pl-pw)/2,-h-tc,0,0,tc,pw/2};
Cylinder(312)={0,(pl-pw)/2,-h-tc,0,0,tc,pw/2};
padBottom()=BooleanUnion {Volume{310};Delete;}{Volume{311,312};Delete;};
cuBottom()=BooleanDifference {Volume{padBottom()};Delete;}{Volume{3};};
Cylinder(5)={0,0,-h-tc,0,0,h+2*tc,ri};
barrel()=BooleanDifference {Volume{3};Delete;}{Volume{5};Delete;};
copper()=BooleanUnion {Volume{cuTop()};Delete;}{Volume{cuBottom(),barrel()};Delete;};
Box(10)={-0.003,-0.003,-h,0.006,L+0.003,h};
Cylinder(11)={0,0,-h,0,0,h,ro};
board()=BooleanDifference {Volume{10};Delete;}{Volume{11};Delete;};
Box(20)={-lw/2,-lt/2,-h-tc,lw,lt,top+h+tc};
Cylinder(21)={0,0,-h-tc,0,0,h+2*tc,ri};
Box(320)={-pw/2,-(pl-pw)/2,tc,pw,pl-pw,st};
Cylinder(321)={0,-(pl-pw)/2,tc,0,0,st,pw/2};
Cylinder(322)={0,(pl-pw)/2,tc,0,0,st,pw/2};
solderTop()=BooleanUnion {Volume{320};Delete;}{Volume{321,322};Delete;};
solderBulk()=BooleanUnion {Volume{21};Delete;}{Volume{solderTop()};Delete;};
solder()=BooleanDifference {Volume{solderBulk()};Delete;}{Volume{20};};
all()=BooleanFragments {Volume{copper(),board(),solder(),20};Delete;}{};
Physical Volume(1)={copper()};
Physical Volume(2)={board()};
Physical Volume(3)={solder()};
Physical Volume(4)={20};
package()=Surface In BoundingBox {-lw/2-e,-lt/2-e,top-e,lw/2+e,lt/2+e,top+e};
farCu()=Surface In BoundingBox {-w/2-e,L-e,-e,w/2+e,L+e,tc+e};
farBoard()=Surface In BoundingBox {-0.003-e,L-e,-h-e,0.003+e,L+e,e};
Physical Surface(11)={package()};
Physical Surface(12)={farBoard()};
Physical Surface(14)={farCu()};
