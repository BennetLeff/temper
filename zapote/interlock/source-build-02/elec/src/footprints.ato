import ThermalViaArray, HighCurrentPad, CreepageSlot from "fac_utils.ato"

module LitzPad_15A:
    """High-current pad for Litz wire (Resonant Tank).

    R30's own termination: bare solder PTH pads for the tank coil's litz
    leads, not a purchased connector (docs/hardware/TANK_COIL_SPECIFICATION.md
    req #10; docs/hardware/BOM.md L_TANK line). Name kept for continuity
    with pcb/libs/lib.pretty/LitzPad_15A.kicad_mod and the R30 designator
    (both now historical, not descriptive -- see that file's descr and
    modules.ato:598-616). current_rating corrected 2026-08-13 from 15A
    (already exceeded 1.38-1.5x by the tank's 20.7-22.5A rms continuous
    operating current, docs/hardware/PART_STRESS_AUDIT.md Sec 1.3) to 25A,
    matching inductor_conn.current_rating (modules.ato:620) and
    TANK_COIL_SPECIFICATION.md req #6's imposed continuous-thermal figure.
    annular_ring widened to match the geometry the kicad_mod's descr
    derives via IPC-2221B (docs/hardware/TRACE_WIDTH_CALCULATIONS.md Sec 2)
    at that current: 3.0mm drill + 2x6.0mm ring = 15.0mm pad OD, pitch
    25.0mm (= diameter + 10.0mm PD3 creepage). See
    docs/evidence/2026-08-13-coil-connector-rating.md.
    """
    pad = new HighCurrentPad
    pad.drill_size = 2.5mm # Large for Litz bundles -- pre-existing drift
    # against the kicad_mod's actual 3.0mm drill, not touched by this pass
    pad.annular_ring = 6.0mm
    pad.current_rating = 25A

    signal in ~ pad

module CST1005_Footprint:
    """Current Transformer footprint with HV primary clearance."""
    # Secondary pins (burden resistor side)
    sec_pad1 = new HighCurrentPad
    sec_pad1.drill_size = 0.8mm
    sec_pad1.annular_ring = 0.4mm
    
    sec_pad2 = new HighCurrentPad
    sec_pad2.drill_size = 0.8mm
    sec_pad2.annular_ring = 0.4mm
    
    # Primary 'pin' is just a large hole for the wire.
    # 8.50mm per the real Triad Magnetics datasheet (dimension F,
    # https://catalog.triadmagnetics.com/Asset/CST-1005.pdf) -- was 5.0mm,
    # an unsourced placeholder that didn't match the real part.
    primary_hole_dia = 8.5mm
    
    signal S1 ~ sec_pad1
    signal S2 ~ sec_pad2

module SOIC16W_Isolated:

    """Isolated SOIC-16W footprint with integrated creepage slot."""
    # Physical dimensions
    body_width = 7.5mm
    body_length = 10.3mm
    pitch = 1.27mm
    
    # Isolation Barrier
    # Reinforced insulation requires 8mm design target
    isolation_slot = new CreepageSlot
    isolation_slot.length = body_length + 2.0mm
    isolation_slot.width = 1.0mm
    
    # Pads are generated here (conceptual placeholder)
    # Signal mapping to standard SOIC-16W pins
    signal pin1, pin2, pin3, pin4, pin5, pin6, pin7, pin8
    signal pin9, pin10, pin11, pin12, pin13, pin14, pin15, pin16

module IGBT_TO247:

    """Generative TO-247 footprint for high-power IGBTs."""
    # Pin Pitch
    pitch = 5.45mm
    
    # Pads
    gate_pad = new HighCurrentPad
    gate_pad.drill_size = 1.2mm
    gate_pad.annular_ring = 0.6mm
    
    collector_pad = new HighCurrentPad
    collector_pad.drill_size = 1.2mm
    collector_pad.annular_ring = 1.0mm # Larger for high current
    
    emitter_pad = new HighCurrentPad
    emitter_pad.drill_size = 1.2mm
    emitter_pad.annular_ring = 1.0mm

    # Thermal Management
    collector_thermal = new ThermalViaArray
    collector_thermal.rows = 3
    collector_thermal.cols = 3
    
    # Pin Mappings
    signal G ~ gate_pad
    signal C ~ collector_pad
    signal E ~ emitter_pad
