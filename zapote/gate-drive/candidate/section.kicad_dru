(version 1)
# Prototype spacing requirements; not a certification statement.
(rule "CONTROL_POWER_BARRIER" (condition "((A.NetName == 'pwm_h' || A.NetName == 'pwm_l' || A.NetName == 'permit' || A.NetName == 'ctrl_gnd' || A.NetName == 'v3v3' || A.NetName == 'g' || A.NetName == 'dis' || A.NetName == 'dt' || A.NetName == 'nc_7') && (B.NetName == 'gate_h_out' || B.NetName == 'gate_h_kelvin' || B.NetName == 'outa' || B.NetName == 'vdda' || B.NetName == 'gate_l_out' || B.NetName == 'gate_l_kelvin' || B.NetName == 'outb' || B.NetName == 'v15_ls')) || ((A.NetName == 'gate_h_out' || A.NetName == 'gate_h_kelvin' || A.NetName == 'outa' || A.NetName == 'vdda' || A.NetName == 'gate_l_out' || A.NetName == 'gate_l_kelvin' || A.NetName == 'outb' || A.NetName == 'v15_ls') && (B.NetName == 'pwm_h' || B.NetName == 'pwm_l' || B.NetName == 'permit' || B.NetName == 'ctrl_gnd' || B.NetName == 'v3v3' || B.NetName == 'g' || B.NetName == 'dis' || B.NetName == 'dt' || B.NetName == 'nc_7'))") (constraint clearance (min 8.0mm)))
(rule "HS_LS_WORKING_SPACING" (condition "((A.NetName == 'gate_h_out' || A.NetName == 'gate_h_kelvin' || A.NetName == 'outa' || A.NetName == 'vdda') && (B.NetName == 'gate_l_out' || B.NetName == 'gate_l_kelvin' || B.NetName == 'outb' || B.NetName == 'v15_ls')) || ((A.NetName == 'gate_l_out' || A.NetName == 'gate_l_kelvin' || A.NetName == 'outb' || A.NetName == 'v15_ls') && (B.NetName == 'gate_h_out' || B.NetName == 'gate_h_kelvin' || B.NetName == 'outa' || B.NetName == 'vdda'))") (constraint clearance (min 2.0mm)))
