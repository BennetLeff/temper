(version 1)
(rule "Baseline" (constraint clearance (min 0.2mm)))
(rule "HV to SELV provisional 8mm" (condition "A.NetName != '' && B.NetName != '' && ((A.NetName == 'L_SER' || A.NetName == 'L_PRE' || A.NetName == 'VPRE_TAP' || A.NetName == 'VPRE_DCDC_H' || A.NetName == 'VPRE_HLDO' || A.NetName == 'VPRE_DIV0' || A.NetName == 'VPRE_DIV1' || A.NetName == 'VPRE_DIV2' || A.NetName == 'unconnected-(U1-NC-Pad4)') != (B.NetName == 'L_SER' || B.NetName == 'L_PRE' || B.NetName == 'VPRE_TAP' || B.NetName == 'VPRE_DCDC_H' || B.NetName == 'VPRE_HLDO' || B.NetName == 'VPRE_DIV0' || B.NetName == 'VPRE_DIV1' || B.NetName == 'VPRE_DIV2' || B.NetName == 'unconnected-(U1-NC-Pad4)'))") (constraint clearance (min 8mm)) (constraint creepage (min 8mm)))
