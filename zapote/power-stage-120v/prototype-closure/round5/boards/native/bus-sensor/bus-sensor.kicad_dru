(version 1)
(rule "Baseline" (constraint clearance (min 0.2mm)))
(rule "HV to SELV provisional 8mm" (condition "A.NetName != '' && B.NetName != '' && ((A.NetName == 'BUS_P' || A.NetName == 'HV_RET' || A.NetName == 'VBUS_TAP' || A.NetName == 'VBUS_DCDC_H' || A.NetName == 'VBUS_HLDO' || A.NetName == 'VBUS_DIV0' || A.NetName == 'VBUS_DIV1' || A.NetName == 'VBUS_DIV2' || A.NetName == 'VBUS_DIV3' || A.NetName == 'VBUS_DIV4' || A.NetName == 'VBUS_DIV5' || A.NetName == 'VBUS_DIV6' || A.NetName == 'unconnected-(U1-NC-Pad4)') != (B.NetName == 'BUS_P' || B.NetName == 'HV_RET' || B.NetName == 'VBUS_TAP' || B.NetName == 'VBUS_DCDC_H' || B.NetName == 'VBUS_HLDO' || B.NetName == 'VBUS_DIV0' || B.NetName == 'VBUS_DIV1' || B.NetName == 'VBUS_DIV2' || B.NetName == 'VBUS_DIV3' || B.NetName == 'VBUS_DIV4' || B.NetName == 'VBUS_DIV5' || B.NetName == 'VBUS_DIV6' || B.NetName == 'unconnected-(U1-NC-Pad4)'))") (constraint clearance (min 8mm)) (constraint creepage (min 8mm)))
