(version 1)
(rule "Baseline" (constraint clearance (min 0.2mm)))
(rule "HV to SELV provisional 8mm" (condition "A.NetName != '' && B.NetName != '' && ((A.NetName == 'RES_A' || A.NetName == 'SW_B' || A.NetName == 'VTANK_TAP' || A.NetName == 'VTANK_DCDC_H' || A.NetName == 'VTANK_HLDO' || A.NetName == 'VTANK_DIV0' || A.NetName == 'VTANK_DIV1' || A.NetName == 'VTANK_DIV2' || A.NetName == 'VTANK_DIV3' || A.NetName == 'VTANK_DIV4' || A.NetName == 'VTANK_DIV5' || A.NetName == 'VTANK_DIV6' || A.NetName == 'VTANK_DIV7' || A.NetName == 'VTANK_DIV8' || A.NetName == 'VTANK_DIV9' || A.NetName == 'VTANK_DIV10' || A.NetName == 'unconnected-(U1-NC-Pad4)') != (B.NetName == 'RES_A' || B.NetName == 'SW_B' || B.NetName == 'VTANK_TAP' || B.NetName == 'VTANK_DCDC_H' || B.NetName == 'VTANK_HLDO' || B.NetName == 'VTANK_DIV0' || B.NetName == 'VTANK_DIV1' || B.NetName == 'VTANK_DIV2' || B.NetName == 'VTANK_DIV3' || B.NetName == 'VTANK_DIV4' || B.NetName == 'VTANK_DIV5' || B.NetName == 'VTANK_DIV6' || B.NetName == 'VTANK_DIV7' || B.NetName == 'VTANK_DIV8' || B.NetName == 'VTANK_DIV9' || B.NetName == 'VTANK_DIV10' || B.NetName == 'unconnected-(U1-NC-Pad4)'))") (constraint clearance (min 8mm)) (constraint creepage (min 8mm)))
