(version 1)
(rule "Baseline" (constraint clearance (min 0.2mm)))
(rule "HV to SELV provisional 8mm" (condition "A.NetName != '' && B.NetName != '' && ((A.NetName == 'HV_RET' || A.NetName == 'CATCH_P' || A.NetName == 'VCATCH_TAP' || A.NetName == 'VCATCH_DCDC_H' || A.NetName == 'VCATCH_HLDO' || A.NetName == 'VCATCH_DIV0' || A.NetName == 'VCATCH_DIV1' || A.NetName == 'VCATCH_DIV2' || A.NetName == 'VCATCH_DIV3' || A.NetName == 'VCATCH_DIV4' || A.NetName == 'VCATCH_DIV5' || A.NetName == 'VCATCH_DIV6' || A.NetName == 'unconnected-(U1-NC-Pad4)') != (B.NetName == 'HV_RET' || B.NetName == 'CATCH_P' || B.NetName == 'VCATCH_TAP' || B.NetName == 'VCATCH_DCDC_H' || B.NetName == 'VCATCH_HLDO' || B.NetName == 'VCATCH_DIV0' || B.NetName == 'VCATCH_DIV1' || B.NetName == 'VCATCH_DIV2' || B.NetName == 'VCATCH_DIV3' || B.NetName == 'VCATCH_DIV4' || B.NetName == 'VCATCH_DIV5' || B.NetName == 'VCATCH_DIV6' || B.NetName == 'unconnected-(U1-NC-Pad4)'))") (constraint clearance (min 8mm)) (constraint creepage (min 8mm)))
