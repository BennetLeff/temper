    mpn = "IRM-05-15"
    manufacturer = "MEAN WELL"
    footprint = "Converter_ACDC:Converter_ACDC_MeanWell_IRM-05-xx_THT"
    signal ACN ~ pin 1
    signal ACL ~ pin 2
    signal VN ~ pin 3
    signal VP ~ pin 4

component Irm20_15:
    """MEAN WELL IRM-20-15, 15 V 1.4 A, 4.2 kVac I/O. Pin 1 = AC/L, 2 = AC/N."""
