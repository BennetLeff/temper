# Exact parts for the 120 V full-bridge power stage.
# Selection and justification: docs/hardware/power-section-120v/POWER-SECTION.md.
# Each distinct MPN is its own component type: Atopile 0.2.69 can alias
# unlike MPNs that share a footprint, and the Rust audit checks every
# reference's MPN in the built BOM.
# Footprints named temper:*_ReviewOnly are drawn from the manufacturer drawing; the suffix is a
# legacy name kept so library references do not change (FOOTPRINTS.md; checks recorded in
# 13-external-review-2026-10-13/FINDINGS.md #8).

# ---------------------------------------------------------------- mains entry

component MainsTerminal2:
    """Phoenix MKDS 5/2-9,5 (1714971), L/N only. UL/cUL use group B 300 V 30 A, CSA 300 V 30 A
    (UL file E60425), IEC 32 A; 9.52 mm pitch, 14-10 AWG. Stage 27 (DECISIONS 29): the former
    MKDS 3/2-5,08 (1711725) is only 15 A cULus / 10 A CSA against the 13.5-15 A input.
    PE uses a separate chassis branch terminal."""
    designator_prefix = "J"
    mpn = "1714971"
    manufacturer = "Phoenix Contact"
    footprint = "temper:Phoenix_MKDS-5-2-9.52_1714971"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component PowerTerminalM4:
    """Wuerth REDCUBE SMT WP-SMBU M4, internal through-hole thread (7466004R,
    tape and reel): 50 A max at 20 C, 1.2 N m torque (datasheet rev 001.003 p.1).
    One D8.5 SMD solder pad round a D5.2 non-plated hole; no PCB-thickness limit.
    Stage 35 (candidate 35): replaces the REDCUBE THR 74650074, whose 1.6-2.0 mm
    board-thickness window JLC cannot guarantee (DECISIONS 42). No manufacturer
    voltage rating: PCB, lug and wire spacing determine insulation."""
    designator_prefix = "J"
    mpn = "7466004R"
    manufacturer = "Wuerth Elektronik"
    footprint = "temper:Wuerth_REDCUBE-SMT_WP-SMBU_7466004R"
    signal p1 ~ pin 1

component PeBranchTerminal:
    """Phoenix KDS 3, one potential with two solder pins. Branch from the
    chassis PE stud only; never in series with the primary cord PE bond."""
    designator_prefix = "J"
    mpn = "1704004"
    manufacturer = "Phoenix Contact"
    footprint = "temper:Phoenix_KDS3_1704004_1Pos_2Pin_ReviewOnly"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component MainsFuse25A:
    """Littelfuse KLDR025.TXP: UL Class CC (UL 248-4), 25 A time-delay, 600 Vac, 200 kA interrupting,
    10.3 x 38.1 mm (KLDR datasheet Rev 092821: p.1 ratings, p.5 I2t 226 / 1,710 A2s, p.6 ~10 %
    downrating at 50 C, so 25 x 0.75 x 0.90 ~ 16.9 A continuous against the 15 A input limit).
    Alternate: Eaton Bussmann LP-CC-25. Chosen 2026-10-09 for the 120-127 V~ nameplate (Mexico from
    day 1): the 6.3 x 32 MDA-25-R is rated 1.5 kA at 250 Vac, against a cord-limited fault bound of
    4.7-8.4 kA at 127 V + 10 %; 200 kA ends the question for UL, CSA and NOM. Held in 2 x Littelfuse
    01250003H 125-series clips (30 A, LCSC C223911), custom footprint, hand-assembled
    (validation-results/08-manufacturing-package/native-21/owner-items/f1cc/)."""
    designator_prefix = "F"
    mpn = "KLDR025.TXP"
    manufacturer = "Littelfuse"
    footprint = "temper:Fuseholder_Clip-10.3x38mm_Littelfuse_125_Inline_P41.76x10.80mm_Slot1.2x2.5mm_Horizontal"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component BranchFuseT3A15:
    """Schurter UMT-H 3403.0279.23: SMD 3.15 A time-lag (T), 15.4 x 5.35 mm, breaking capacity 1500 A at
    277 VAC (UL 248-14, cURus E41599) / 1500 A at 250 VAC (IEC 60127-7); melting I2t 39 A2s at 10 In
    (Schurter UMT-H data sheet, fetched 2026-10-13). Fuses the blower-supply mains tap (stage 16, DECISIONS
    15-16) to PS3. Stage 28 (DECISIONS 30, F4): replaces the UMT 250 3403.0171, whose 200 A was below the
    1.09-1.45 kA prospective fault at J11; with the series limiter R_blw the fault is bounded at 784 A."""
    designator_prefix = "F"
    mpn = "3403.0279.23"
    manufacturer = "Schurter"
    footprint = "temper:Fuse_Schurter_UMT-H_15.4x5.35mm"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component BranchLimiter0R15:
    """Vishay AC05 0.15 ohm 5 W cemented wirewound (AC05000001507JAC00), D 7.5 x L 18 mm max, mounted
    upright. Stage 28 (DECISIONS 30, F4): in series after F2, bounding the J11 fault current to
    139.7 V / (0.0283 + 0.15) ohm = 784 A (1.91x inside F2's 1.5 kA); 0.30 W at 1.42 A. Pulse capacity
    about 125 A2s at 0.15 ohm (Vishay AC chart) against F2's 39 A2s melting and the 56-67 A2s current-limiting
    clearing estimate (11-candidates/c28-f2); a bench short at J11 confirms it."""
    designator_prefix = "R"
    mpn = "AC05000001507JAC00"
    manufacturer = "Vishay"
    footprint = "temper:R_Axial_Vishay_AC05_D7.5mm_P5.08mm_Vertical"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component MainsTapHeader:
    """JST B2P3-VH(LF)(SN) (as TcoLoopHeader): the blower-supply mains tap J11 to the chassis-mounted
    PS3 (stage 16). 7.92 mm between the two posts (post 2 omitted), 250 V / 10 A; mates VHR-3N with
    cavity 2 empty, SVH-21T-P1.1 crimps, 18 AWG. Cannot cross-mate the controller's 3.96 mm J13."""
    designator_prefix = "J"
    mpn = "B2P3-VH(LF)(SN)"
    manufacturer = "JST"
    footprint = "Connector_JST:JST_VH_B2P3-VH_1x02_P7.92mm_Vertical"
