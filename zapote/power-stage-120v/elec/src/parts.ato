# Exact parts for the 120 V full-bridge power stage.
# Selection and justification: docs/hardware/power-section-120v/POWER-SECTION.md.
# Each distinct MPN is its own component type: Atopile 0.2.69 can alias
# unlike MPNs that share a footprint, and the Rust audit checks every
# reference's MPN in the built BOM.
# Footprints named temper:*_ReviewOnly do not exist yet and must be drawn
# from the manufacturer drawing before native board work.

# ---------------------------------------------------------------- mains entry

component MainsTerminal3:
    """Phoenix Contact MKDS 3/3-5,08 (1711039), 24 A, 400 V: L, N, PE."""
    designator_prefix = "J"
    mpn = "1711039"
    manufacturer = "Phoenix Contact"
    footprint = "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-3-3-5.08_1x03_P5.08mm_Horizontal"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component CoilTerminal2:
    """Phoenix Contact MKDS 3/2-5,08, 24 A, 400 V: coil leads. Order number
    to confirm; the litz termination may replace it once the coil exists."""
    designator_prefix = "J"
    mpn = "1711026"
    manufacturer = "Phoenix Contact"
    footprint = "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-3-2-5.08_1x02_P5.08mm_Horizontal"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component MainsFuse20A:
    """Littelfuse 0326020.MXP 20 A 250 V slo-blo ceramic 6.3x32 mm, in a
    102071 clip pair (clip current rating to confirm >= 20 A)."""
    designator_prefix = "F"
    mpn = "0326020.MXP"
    manufacturer = "Littelfuse"
    footprint = "Fuse:Fuseholder_Clip-6.3x32mm_Littelfuse_102071_Inline_P34.70x7.60mm_D2.00mm_Horizontal"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Tmov175:
    """Littelfuse TMOV20RP175E thermally protected MOV, 175 Vrms, Vc 455 V."""
    designator_prefix = "RV"
    mpn = "TMOV20RP175E"
    manufacturer = "Littelfuse"
    footprint = "temper:TMOV20RP_ReviewOnly"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Cmc20A:
    """TDK B82726S2203A020 current-compensated choke, 20 A, 1.6 mH, ~4.5 mOhm.
    TDK B82726S22*3A020 datasheet (5/26), "Dimensional drawing and pin
    configuration": windings are 1-4 and 2-3 (no polarity); pins 1,2 on one
    row and 4,3 opposite, 10 mm within a row, 25 mm between rows, 2 mm pins."""
    designator_prefix = "L"
    mpn = "B82726S2203A020"
    manufacturer = "TDK"
    footprint = "temper:B82726S2_ReviewOnly"
    signal a_in ~ pin 1
    signal a_out ~ pin 4
    signal b_in ~ pin 2
    signal b_out ~ pin 3

component CapX2_1u:
    """KEMET R463R410000M1M X2 1 uF 310 VAC, 22.5 mm pitch."""
    designator_prefix = "C"
    mpn = "R463R410000M1M"
    manufacturer = "KEMET"
    footprint = "Capacitor_THT:C_Rect_L26.5mm_W10.5mm_P22.50mm_MKS4"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component CapY1_2n2:
    """Murata DE1E3RA222MA4BP01F X1/Y1 2.2 nF disc, 10 mm pitch."""
    designator_prefix = "C"
    mpn = "DE1E3RA222MA4BP01F"
    manufacturer = "Murata"
    footprint = "Capacitor_THT:C_Disc_D10.5mm_W5.0mm_P10.00mm"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component R120k1206:
    """X-capacitor bleed, 2 in series (tau 0.48 s with 2 uF)."""
    designator_prefix = "R"
    mpn = "RC1206FR-07120KL"
    manufacturer = "Yageo"
    footprint = "Resistor_SMD:R_1206_3216Metric"
    value: resistance
    signal p1 ~ pin 1
    signal p2 ~ pin 2

