# --------------------------------------------------------- supplies and cutoffs

component Irm05_15:
    """MEAN WELL IRM-05-15, 15 V 0.33 A, 4.2 kVac I/O. NOTE pin 1 = AC/N,
    pin 2 = AC/L (differs from IRM-20; KiCad Converter_ACDC symbol)."""
