component Iso7710:
    """TI ISO7710DWR, reinforced 5 kVrms, default-HIGH output on input-side
    power loss. DW: 1/7 GND1, 3 VCC1, 4 IN, 9/16 GND2, 13 OUT, 14 VCC2."""
    designator_prefix = "U"
    mpn = "ISO7710DWR"
    manufacturer = "Texas Instruments"
    # TI DW0016B HV / isolation land pattern: 8.1 mm across the barrier
    # (SLLSER9E p. 33); the IPC-7351 nominal pattern gives only 7.3 mm.
    footprint = "lib:SOIC16W_DW0016B_HV"
    signal GND1 ~ pin 1
    signal NC2 ~ pin 2
    signal VCC1 ~ pin 3
    signal IN ~ pin 4
    signal NC5 ~ pin 5
    signal NC6 ~ pin 6
    signal GND1B ~ pin 7
    signal NC8 ~ pin 8
    signal GND2 ~ pin 9
    signal NC10 ~ pin 10
    signal NC11 ~ pin 11
    signal NC12 ~ pin 12
    signal OUT ~ pin 13
    signal VCC2 ~ pin 14
    signal NC15 ~ pin 15
    signal GND2B ~ pin 16

