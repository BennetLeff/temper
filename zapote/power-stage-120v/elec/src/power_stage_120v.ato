# 120 V full-bridge induction power stage (single board).
#
# Design basis: docs/hardware/power-section-120v/ (POWER-SECTION.md,
# LOSS-REFACTOR.md, COIL-MC.md). Unfiltered-bus front end, no PFC; full
# bridge of four IPW65R018CFD7; series resonant capacitor; tank CT to the
# SELV current-sense board; DC-bus shunt OCP for shoot-through; thermal
# cutoffs in series with the gate-driver supply; AMC1311 bus sense; bus
# over-voltage comparator NANDed with the OCP into the isolated fault-high line.
#
# Domains:
#   mains / HOT:  AC_*, L_*, N_*, BUS_P, HV_RET, LEG_RET, SW_*, tank nets.
#                 LEG_RET carries gate-driver recharge and bridge current.
#                 OCP_KELVIN_P returns the LDO, protection and isolated hot
#                 control circuits to the separate R5 sense terminal. This is
#                 a loaded Kelvin reference, not a zero-current sense lead.
#   SELV:         everything on the 16-pin controller header, isolated by
#                 UCC21550, AMC1311, ISO7710, CST3015 and the IRM-20-15.
#
# Coil-dependent values (resonant capacitance, CT burden on the
# current-sense board) are provisional for the 70 uH / 32 kHz nominal coil
# until the coil and pan measurements in COIL-MC.md are taken.

from "parts.ato" import MainsTerminal2, PowerTerminalM4, PeBranchTerminal, MainsFuse20A, Tmov175, Cmc20A
from "parts.ato" import CapX2_1u, CapY1_2n2, R120k1206, BridgeGbj2510, BusFilm2u7, LocalBus100n
from "parts.ato" import R220k1206, Shunt1m, MosfetCfd7, Snubber1n1kV, UCC21550BDWK
from "parts.ato" import PermitFet, R3R9Gate, R49k9Dt, R10k0603, R100k0603, R100R0603
from "parts.ato" import R1k0603, R330R0603, C100n0603, C10u1210, Res942C12P22, Res942C12P1
from "parts.ato" import CST3015_100E, Irm20_15, TcoLoopHeader
from "parts.ato" import Amc1311, R470k1206, R15k8Thin, C1nC0G0603, C100pC0G0603
from "parts.ato" import Tlv3201, Ref2V5, R10kThin, R10k6Thin, R140kThin, R5k6Bias
from "parts.ato" import Iso7710, SelvHeader16, Nand3Lvc1g10, FunctionalEarthLink
from "parts.ato" import Hot5Supervisor, Hot5SchmittBuffer, R105kThin
from "parts.ato" import BusTvsMrt130kp295
from "parts.ato" import Burden1R5, C100nC0G1206, R1kThin, R3k32Thin, R1k1206, ClampBas116h, Or3Lvc1g332

from "f6_parts.ato" import HotSupply24, HotLdo, GateDischarge, Gate1R, DisOr, BiasPushPull, Bias18k2, Bias30k1, Bias4k99, Bias4u7, Bias680, Bias10u
from "f6_bias.ato" import BiasReservoir, RegulatedSplit, RailMonitor, HighBias, LineZeroCross

module BusBringupLink:
    """Two M4 landings for one removable insulated jumper (ASSEMBLY.md).
    Separate source nets deliberately describe the OPEN link. Fit the
    external jumper in normal operation; remove BOTH rail jumpers for
    floating low-voltage DC bring-up. No PCB copper bridges these nets."""
    signal rectifier
    signal bus
    terminal_rect = new PowerTerminalM4
    terminal_bus = new PowerTerminalM4
    terminal_rect.p1 ~ rectifier
    terminal_bus.p1 ~ bus

module BridgeLeg:
    """One half-bridge leg: UCC21550 (A = high side, B = low side), fail-safe
    DIS receiver, dead time, monitored F6 bias, gate networks, two MOSFETs, snubbers.
    PERMIT low, floating or unpowered leaves DIS high (outputs disabled)."""
    signal v3v3
    signal selv_gnd
    signal pwm_h
    signal pwm_l
    signal permit
    signal v15_ls
    signal hot_gnd
    signal bus_p
    signal sw
    signal dis
    signal p_hs
    signal n_hs
    signal n_ls
    signal bias_bad
    signal driver_dis
    signal gate_h
    signal gate_l
    signal out_h
    signal out_l
    signal permit_gate

    driver = new UCC21550BDWK
    driver.VCCI_1 ~ v3v3
    driver.VCCI_2 ~ v3v3
    driver.GNDI ~ selv_gnd
    driver.INA ~ pwm_h
    driver.INB ~ pwm_l
    c_vcci = new C100n0603
    c_vcci.value = 100nF
    c_vcci.p1 ~ v3v3
    c_vcci.p2 ~ selv_gnd

    # DIS is active-high. PERMIT high turns the FET on and pulls DIS low.
    permit_fet = new PermitFet
    # 100 ohm PERMIT gate resistor, 100 k pulldown, and 330 ohm DIS pullup
    # (D-31: 1 k -> 330 ohm cuts the allocated DIS rise ~361 -> ~119 ns;
    # ~10.5 mA per leg from V3V3 while PERMIT holds DIS low).
    # Loaded PERMIT-to-DIS delay needs qualification; the earlier ~0.35 us
    # estimate is not a worst-case bound (prototype-closure/round2/d17/ECO.md).
    r_permit = new R100R0603
    r_permit.value = 100ohm
    r_permit_pd = new R100k0603
    r_permit_pd.value = 100kohm
    r_dis_pu = new R330R0603
    r_dis_pu.value = 330ohm
    permit ~ r_permit.p1
    r_permit.p2 ~ permit_gate
    permit_gate ~ permit_fet.G
    permit_gate ~ r_permit_pd.p1
    r_permit_pd.p2 ~ selv_gnd
    permit_fet.S ~ selv_gnd
    permit_fet.D ~ dis
    driver_dis ~ driver.DIS
    dis ~ r_dis_pu.p1
    r_dis_pu.p2 ~ v3v3

    # TI: tDT ~= 8.6 * RDT[kohm] + 13 ns -> ~442 ns nominal; verify at bring-up.
    r_dt = new R49k9Dt
    r_dt.value = 49.9kohm
    r_dt.p1 ~ driver.DT
    r_dt.p2 ~ selv_gnd

    # Low side (channel B) on the floating 15 V referenced to HOT_GND.
    driver.VDDB ~ v15_ls
    driver.VSSB ~ n_ls
    c_ls = new C100n0603
    c_ls.value = 100nF
    c_ls.p1 ~ v15_ls
    c_ls.p2 ~ n_ls
    c_ls_bulk = new C10u1210
    c_ls_bulk.value = 10uF
    c_ls_bulk.p1 ~ v15_ls
    c_ls_bulk.p2 ~ n_ls

    # The two high-side transformers and shared low-side split are HOT-powered.
    driver.VDDA ~ p_hs
    driver.VSSA ~ n_hs
    bias_h = new BiasReservoir
    bias_h.src ~ sw
    bias_h.n ~ n_hs
    bias_h.p ~ p_hs
    bias_l = new BiasReservoir
    bias_l.src ~ hot_gnd
    bias_l.n ~ n_ls
    bias_l.p ~ v15_ls
    dis_or = new DisOr
    dis_or.A ~ dis
    dis_or.B ~ bias_bad
    dis_or.Y ~ driver_dis
    dis_or.VCC ~ v3v3
    dis_or.GND ~ selv_gnd
    c_dis_or = new C100n0603
    c_dis_or.value = 100nF
    c_dis_or.p1 ~ v3v3
    c_dis_or.p2 ~ selv_gnd
    r_driver_dis = new R10k0603
    r_driver_dis.value = 10kohm
    r_driver_dis.p1 ~ v3v3
    r_driver_dis.p2 ~ driver_dis

    # Gate networks: series 3.9 ohm, 10 k gate-source hold-off.
    driver.OUTA ~ out_h
    r_gh = new R3R9Gate
    r_gh.value = 3.9ohm
    r_gh.p1 ~ out_h
    r_gh.p2 ~ gate_h
    r_gh_pd = new R10k0603
    r_gh_pd.value = 10kohm
    r_gh_pd.p1 ~ gate_h
    r_gh_pd.p2 ~ sw
    driver.OUTB ~ out_l
    r_gl = new R3R9Gate
    r_gl.value = 3.9ohm
    r_gl.p1 ~ out_l
    r_gl.p2 ~ gate_l
    r_gl_pd = new R10k0603
    r_gl_pd.value = 10kohm
    r_gl_pd.p1 ~ gate_l
    r_gl_pd.p2 ~ hot_gnd

    signal off_h
    cgs_h = new C1nC0G0603
    cgs_h.value = 1nF
    cgs_h.p1 ~ gate_h
    cgs_h.p2 ~ sw
    doff_h = new GateDischarge
    doff_h.A ~ gate_h
    doff_h.K ~ off_h
    roff_h = new Gate1R
    roff_h.value = 1ohm
    roff_h.p1 ~ off_h
    roff_h.p2 ~ out_h
    signal off_l
    cgs_l = new C1nC0G0603
    cgs_l.value = 1nF
    cgs_l.p1 ~ gate_l
    cgs_l.p2 ~ hot_gnd
    doff_l = new GateDischarge
    doff_l.A ~ gate_l
    doff_l.K ~ off_l
    roff_l = new Gate1R
    roff_l.value = 1ohm
    roff_l.p1 ~ off_l
    roff_l.p2 ~ out_l

    q_high = new MosfetCfd7
    q_high.G ~ gate_h
    q_high.D ~ bus_p
    q_high.S ~ sw
    q_low = new MosfetCfd7
    q_low.G ~ gate_l
    q_low.D ~ sw
    q_low.S ~ hot_gnd

    c_snub_h = new Snubber1n1kV
    c_snub_h.p1 ~ bus_p
    c_snub_h.p2 ~ sw
    c_snub_l = new Snubber1n1kV
    c_snub_l.p1 ~ sw
    c_snub_l.p2 ~ hot_gnd


module PowerStage120V:
    # ---------------- nets
    signal AC_L_IN
    signal AC_N_IN
    signal PE
    signal L_F
    signal XBLEED_MID
    signal L_FILT
    signal N_FILT
    signal RECT_P
    signal RECT_N
    signal BUS_P
    signal HV_RET
    signal BUSBLEED_MID
    signal LEG_RET
    signal OCP_KELVIN_P
    signal SW_A
    signal SW_B
    signal COIL_FEED
    signal RES_A
    signal CRBLEED_1
    signal CRBLEED_2
    signal CRBLEED_3
    signal TCO_L
    signal V15_LS
    signal N_LS
    signal V24_RAW
    signal P_HA
    signal N_HA
    signal P_HB
    signal N_HB
    signal BIAS_BAD
    signal BIAS_LS_BAD
    signal BIAS_HA_BAD
    signal BIAS_HB_BAD
    signal LINE_ZC
    signal BIAS_SW1
    signal BIAS_SW2
    signal HOT5
    signal VDIV_1
    signal VDIV_2
    signal VDIV_3
    signal VSENSE_IN
    signal REF25
    signal OCP_KELVIN_N
    signal OCP_NODE
    signal OCP_THRESH
    signal OCP_OK_HOT
    signal OVP_THRESH
    signal OVP_OK_HOT
    signal HOT5_UV_SENSE
    signal HOT5_UV_RAW
    signal HOT5_OK_HOT
    signal BUS_FAULT_HOT
    # SELV
    signal V15_SELV
    signal SELV_GND
    signal V3V3
    signal PWM_HA
    signal PWM_LA
    signal PWM_HB
    signal PWM_LB
    signal PERMIT
    signal BUS_FAULT
    signal VBUS_P
    signal VBUS_N
    signal CT_S1
    signal CT_S2
    signal CT_SENSE_MON
    signal CT_REF_HI
    signal CT_REF_LO
    signal CT_OC_POS
    signal CT_OC_NEG
    signal CT_ZC
    signal CT_MON
    signal BUS_FAULT_ISO

    # ---------------- mains entry and EMI filter
    j_mains = new MainsTerminal2
    j_mains.p1 ~ AC_L_IN
    j_mains.p2 ~ AC_N_IN
    f1 = new MainsFuse20A
    f1.p1 ~ AC_L_IN
    f1.p2 ~ L_F
    rv1 = new Tmov175
    rv1.p1 ~ L_F
    rv1.p2 ~ AC_N_IN
    cx1 = new CapX2_1u
    cx1.p1 ~ L_F
    cx1.p2 ~ AC_N_IN
    rb1a = new R120k1206
    rb1a.value = 120kohm
    rb1a.p1 ~ L_F
    rb1a.p2 ~ XBLEED_MID
    rb1b = new R120k1206
    rb1b.value = 120kohm
    rb1b.p1 ~ XBLEED_MID
    rb1b.p2 ~ AC_N_IN
    l1 = new Cmc20A
    l1.a_in ~ L_F
    l1.a_out ~ L_FILT
    l1.b_in ~ AC_N_IN
    l1.b_out ~ N_FILT
    cx2 = new CapX2_1u
    cx2.p1 ~ L_FILT
    cx2.p2 ~ N_FILT
    cy1 = new CapY1_2n2
    cy1.p1 ~ L_FILT
    cy1.p2 ~ PE
    cy2 = new CapY1_2n2
    cy2.p1 ~ N_FILT
    cy2.p2 ~ PE

    # ---------------- rectifier, film bus, bleed, DC shunt
    br1 = new BridgeGbj2510
    br1.AC1 ~ L_FILT
    br1.AC2 ~ N_FILT
    br1.PLUS ~ RECT_P
    br1.MINUS ~ RECT_N
    c_bus1 = new BusFilm2u7
    c_bus1.p1 ~ BUS_P
    c_bus1.p2 ~ BUS_P
    c_bus1.p3 ~ HV_RET
    c_bus1.p4 ~ HV_RET
    c_bus2 = new BusFilm2u7
    c_bus2.p1 ~ BUS_P
    c_bus2.p2 ~ BUS_P
    c_bus2.p3 ~ HV_RET
    c_bus2.p4 ~ HV_RET
    r_bus1 = new R220k1206
    r_bus1.value = 220kohm
    r_bus1.p1 ~ BUS_P
    r_bus1.p2 ~ BUSBLEED_MID
    r_bus2 = new R220k1206
    r_bus2.value = 220kohm
    r_bus2.p1 ~ BUSBLEED_MID
    r_bus2.p2 ~ HV_RET
    # Keep I1 and E1 on different PCB nets: the selected four-terminal part
    # joins them internally. Gate-supply recharge returns through I1, never E1.
    # Legs return through the shunt to the bus capacitors, so shoot-through
    # current (which never enters the tank CT) is measured here.
    r_shunt = new Shunt1m
    r_shunt.I1 ~ LEG_RET
    r_shunt.S1 ~ OCP_KELVIN_P
    r_shunt.S2 ~ OCP_KELVIN_N
    r_shunt.I2 ~ HV_RET

    # ---------------- full bridge
    leg_a = new BridgeLeg
    leg_a.v3v3 ~ V3V3
    leg_a.selv_gnd ~ SELV_GND
    leg_a.pwm_h ~ PWM_HA
    leg_a.pwm_l ~ PWM_LA
    leg_a.permit ~ PERMIT
    leg_a.v15_ls ~ V15_LS
    leg_a.n_ls ~ N_LS
    leg_a.p_hs ~ P_HA
    leg_a.n_hs ~ N_HA
    leg_a.bias_bad ~ BIAS_BAD
    leg_a.hot_gnd ~ LEG_RET
    leg_a.bus_p ~ BUS_P
    leg_a.sw ~ SW_A
    leg_b = new BridgeLeg
    leg_b.v3v3 ~ V3V3
    leg_b.selv_gnd ~ SELV_GND
    leg_b.pwm_h ~ PWM_HB
    leg_b.pwm_l ~ PWM_LB
    leg_b.permit ~ PERMIT
    leg_b.v15_ls ~ V15_LS
    leg_b.n_ls ~ N_LS
    leg_b.p_hs ~ P_HB
    leg_b.n_hs ~ N_HB
    leg_b.bias_bad ~ BIAS_BAD
    leg_b.hot_gnd ~ LEG_RET
    leg_b.bus_p ~ BUS_P
    leg_b.sw ~ SW_B

    # ---------------- resonant tank: SW_A -> CT -> coil -> C_res -> SW_B
    # The CT primary sits on the switch node (HF insulation basis open), not
    # the resonant node (up to ~640 V pk at 33-60 kHz): see ORACLE-ANSWER.md
    # Q4. Tank current still enters P1, so the CT sign is unchanged.
    t_ct = new CST3015_100E
    t_ct.P1 ~ SW_A
    t_ct.P2 ~ COIL_FEED
    t_ct.S1 ~ CT_S1
    t_ct.S2 ~ CT_S2
    j_coil = new PowerTerminalM4
    j_coil.p1 ~ COIL_FEED
    # 0.22 + 0.22 + 0.10 = 0.54 uF for the nominal 70 uH / 32 kHz coil.
    c_res1 = new Res942C12P22
    c_res1.p1 ~ RES_A
    c_res1.p2 ~ SW_B
    c_res2 = new Res942C12P22
    c_res2.p1 ~ RES_A
    c_res2.p2 ~ SW_B
    c_res3 = new Res942C12P1
    c_res3.p1 ~ RES_A
    c_res3.p2 ~ SW_B
    # Bleed: an OCP trip can leave C_res holding ~250 V with no discharge
    # path. 4 x 470 k = 1.88 M, tau ~1 s, ~26 mW in operation.
    r_crb1 = new R470k1206
    r_crb1.value = 470kohm
    r_crb1.p1 ~ RES_A
    r_crb1.p2 ~ CRBLEED_1
    r_crb2 = new R470k1206
    r_crb2.value = 470kohm
    r_crb2.p1 ~ CRBLEED_1
    r_crb2.p2 ~ CRBLEED_2
    r_crb3 = new R470k1206
    r_crb3.value = 470kohm
    r_crb3.p1 ~ CRBLEED_2
    r_crb3.p2 ~ CRBLEED_3
    r_crb4 = new R470k1206
    r_crb4.value = 470kohm
    r_crb4.p1 ~ CRBLEED_3
    r_crb4.p2 ~ SW_B

    # ---------------- supplies
    # SELV 15 V for the controller, fan and sensor boards.
    ps_selv = new Irm20_15
    ps_selv.ACL ~ L_FILT
    ps_selv.ACN ~ N_FILT
    ps_selv.VP ~ V15_SELV
    ps_selv.VN ~ SELV_GND
    # Gate-driver supply through the off-board thermal-cutoff loop: an open
    # TCO removes all gate drive, the HOT 5 V rail and the OCP "OK" signal.
    j_tco = new TcoLoopHeader
    j_tco.p1 ~ L_FILT
    j_tco.p2 ~ TCO_L
    ps_gate = new HotSupply24
    ps_gate.ACL ~ TCO_L
    ps_gate.ACN ~ N_FILT
    ps_gate.VP ~ V24_RAW
    ps_gate.VN ~ N_LS
    c_v15 = new C10u1210
    c_v15.value = 10uF
    c_v15.p1 ~ V15_LS
    c_v15.p2 ~ N_LS
    u_ldo = new HotLdo
    u_ldo.IN ~ V15_LS
    u_ldo.EN ~ V15_LS
    u_ldo.GND ~ OCP_KELVIN_P
    u_ldo.OUT ~ HOT5
    c_ldo_in = new C100n0603
    c_ldo_in.value = 100nF
    c_ldo_in.p1 ~ V15_LS
    c_ldo_in.p2 ~ OCP_KELVIN_P
    c_ldo_out = new C10u1210
    c_ldo_out.value = 10uF
    c_ldo_out.p1 ~ HOT5
    c_ldo_out.p2 ~ OCP_KELVIN_P

    # ---------------- bus voltage sense: 1.88 M / 15.8 k = 1/120
    r_div1 = new R470k1206
    r_div1.value = 470kohm
    r_div1.p1 ~ BUS_P
    r_div1.p2 ~ VDIV_1
    r_div2 = new R470k1206
    r_div2.value = 470kohm
    r_div2.p1 ~ VDIV_1
    r_div2.p2 ~ VDIV_2
    r_div3 = new R470k1206
    r_div3.value = 470kohm
    r_div3.p1 ~ VDIV_2
    r_div3.p2 ~ VDIV_3
    r_div4 = new R470k1206
    r_div4.value = 470kohm
    r_div4.p1 ~ VDIV_3
    r_div4.p2 ~ VSENSE_IN
    r_div_bot = new R15k8Thin
    r_div_bot.value = 15.8kohm
    r_div_bot.p1 ~ VSENSE_IN
    r_div_bot.p2 ~ OCP_KELVIN_P
    c_div = new C1nC0G0603
    c_div.value = 1nF
    c_div.p1 ~ VSENSE_IN
    c_div.p2 ~ OCP_KELVIN_P
    u_vsense = new Amc1311
    u_vsense.VDD1 ~ HOT5
    u_vsense.GND1 ~ OCP_KELVIN_P
    u_vsense.VINP ~ VSENSE_IN
    u_vsense.SHTDN ~ OCP_KELVIN_P
    u_vsense.VDD2 ~ V3V3
    u_vsense.GND2 ~ SELV_GND
    u_vsense.VOUTP ~ VBUS_P
    u_vsense.VOUTN ~ VBUS_N
    c_vs1 = new C100n0603
    c_vs1.value = 100nF
    c_vs1.p1 ~ HOT5
    c_vs1.p2 ~ OCP_KELVIN_P
    c_vs2 = new C100n0603
    c_vs2.value = 100nF
    c_vs2.p1 ~ V3V3
    c_vs2.p2 ~ SELV_GND

    # ---------------- DC-bus OCP (shoot-through), referenced to LEG_RET.
    # V(OCP_KELVIN_N) = -I*1 mohm. OCP_NODE = 1.25 V + 0.5 * V(KELVIN_N);
    # OCP_THRESH = 2.5 * 10.0/(10.6+10.0) = 1.2136 V -> trip at ~73 A nominal
    # (D-31 / task 02 decision B: corner band 49.73-97.98 A, was 38.44-85.55 A)
    # (TLV3201 offset +/-5 mV max = +/-10 A; normal peak <= 45 A). The lower
    # trip reduces risk; returned tank energy is not bounded: ORACLE-REVIEW.md.
    # Comparator output high = OK. NAND + default-HIGH isolation make
    # BUS_FAULT high on either trip or complete HOT-side power loss.
    r_ref_bias = new R5k6Bias
    r_ref_bias.value = 5.6kohm
    r_ref_bias.p1 ~ HOT5
    r_ref_bias.p2 ~ REF25
    u_ref = new Ref2V5
    u_ref.K ~ REF25
    u_ref.A ~ OCP_KELVIN_P
    r_ocp_ref = new R10kThin
    r_ocp_ref.value = 10kohm
    r_ocp_ref.p1 ~ REF25
    r_ocp_ref.p2 ~ OCP_NODE
    r_ocp_sense = new R10kThin
    r_ocp_sense.value = 10kohm
    r_ocp_sense.p1 ~ OCP_NODE
    r_ocp_sense.p2 ~ OCP_KELVIN_N
    c_ocp_node = new C100pC0G0603
    c_ocp_node.value = 100pF
    c_ocp_node.p1 ~ OCP_NODE
    c_ocp_node.p2 ~ OCP_KELVIN_P
    r_th_top = new R10k6Thin
    r_th_top.value = 10.6kohm
    r_th_top.p1 ~ REF25
    r_th_top.p2 ~ OCP_THRESH
    r_th_bot = new R10kThin
    r_th_bot.value = 10kohm
    r_th_bot.p1 ~ OCP_THRESH
    r_th_bot.p2 ~ OCP_KELVIN_P
    c_th = new C1nC0G0603
    c_th.value = 1nF
    c_th.p1 ~ OCP_THRESH
    c_th.p2 ~ OCP_KELVIN_P
    u_ocp = new Tlv3201
    u_ocp.VCC ~ HOT5
    u_ocp.GND ~ OCP_KELVIN_P
    u_ocp.INP ~ OCP_NODE
    u_ocp.INN ~ OCP_THRESH
    u_ocp.OUT ~ OCP_OK_HOT
    c_ocp_vcc = new C100n0603
    c_ocp_vcc.value = 100nF
    c_ocp_vcc.p1 ~ HOT5
    c_ocp_vcc.p2 ~ OCP_KELVIN_P
    # Bus OVP: VSENSE_IN = Vbus/120 vs 2.5 * 140/150 = 2.333 V -> ~280 V.
    # Output high = OK. Hardware restart inhibit through the controller latch.
    r_ovp_top = new R10kThin
    r_ovp_top.value = 10kohm
    r_ovp_top.p1 ~ REF25
    r_ovp_top.p2 ~ OVP_THRESH
    r_ovp_bot = new R140kThin
    r_ovp_bot.value = 140kohm
    r_ovp_bot.p1 ~ OVP_THRESH
    r_ovp_bot.p2 ~ OCP_KELVIN_P
    c_ovp_th = new C1nC0G0603
    c_ovp_th.value = 1nF
    c_ovp_th.p1 ~ OVP_THRESH
    c_ovp_th.p2 ~ OCP_KELVIN_P
    u_ovp = new Tlv3201
    u_ovp.VCC ~ HOT5
    u_ovp.GND ~ OCP_KELVIN_P
    u_ovp.INP ~ OVP_THRESH
    u_ovp.INN ~ VSENSE_IN
    u_ovp.OUT ~ OVP_OK_HOT
    c_ovp_vcc = new C100n0603
    c_ovp_vcc.value = 100nF
    c_ovp_vcc.p1 ~ HOT5
    c_ovp_vcc.p2 ~ OCP_KELVIN_P
    # BUS_FAULT_HOT = NOT(OCP_OK_HOT AND OVP_OK_HOT AND HOT5_OK_HOT).
    # Healthy = low; either trip = high. ISO7710 (non-F) defaults high
    # on input-side power loss while the SELV output supply remains valid.
    u_nand = new Nand3Lvc1g10
    u_nand.A ~ OCP_OK_HOT
    u_nand.B ~ OVP_OK_HOT
    u_nand.C ~ HOT5_OK_HOT
    u_nand.Y ~ BUS_FAULT_HOT
    u_nand.VCC ~ HOT5
    u_nand.GND ~ OCP_KELVIN_P
    c_nand_vcc = new C100n0603
    c_nand_vcc.value = 100nF
    c_nand_vcc.p1 ~ HOT5
    c_nand_vcc.p2 ~ OCP_KELVIN_P
    u_iso = new Iso7710
    u_iso.VCC1 ~ HOT5
    u_iso.GND1 ~ OCP_KELVIN_P
    u_iso.GND1B ~ OCP_KELVIN_P
    u_iso.IN ~ BUS_FAULT_HOT
    u_iso.VCC2 ~ V3V3
    u_iso.GND2 ~ SELV_GND
    u_iso.GND2B ~ SELV_GND
    u_iso.OUT ~ BUS_FAULT_ISO
    c_iso1 = new C100n0603
    c_iso1.value = 100nF
    c_iso1.p1 ~ HOT5
    c_iso1.p2 ~ OCP_KELVIN_P
    c_iso2 = new C100n0603
    c_iso2.value = 100nF
    c_iso2.p1 ~ V3V3
    c_iso2.p2 ~ SELV_GND

    # ---------------- SELV controller header (Micro-Fit 2x8)
    j_selv = new SelvHeader16
    j_selv.p1 ~ V15_SELV
    j_selv.p2 ~ SELV_GND
    j_selv.p3 ~ V3V3
    j_selv.p4 ~ SELV_GND
    j_selv.p5 ~ PWM_HA
    j_selv.p6 ~ PWM_LA
    j_selv.p7 ~ PWM_HB
    j_selv.p8 ~ PWM_LB
    j_selv.p9 ~ PERMIT
    j_selv.p10 ~ BUS_FAULT
    j_selv.p11 ~ VBUS_P
    j_selv.p12 ~ VBUS_N
    j_selv.p13 ~ CT_ZC
    j_selv.p14 ~ CT_MON
    j_selv.p15 ~ SELV_GND
    j_selv.p16 ~ LINE_ZC

    # D5 functional earth: place beside the separate PCB PE branch terminal. This link is
    # not protective earthing. Reinforced isolation remains required with
    # PE open; SELV_GND is the historical name of the earthed ELV return.
    r_fe = new FunctionalEarthLink
    r_fe.value = 0ohm
    r_fe.p1 ~ PE
    r_fe.p2 ~ SELV_GND

    # Place the bidirectional TVS at the DC-link capacitor terminals. This
    # source join specifies protection topology, not the surge/energy rating
    # of the assembled commutation loop.
    tvs_bus = new BusTvsMrt130kp295
    tvs_bus.p1 ~ BUS_P
    tvs_bus.p2 ~ HV_RET

    # Separate coil return stud; external coil connects j_coil to this stud.
    j_coil_return = new PowerTerminalM4
    j_coil_return.p1 ~ RES_A
    j_pe = new PeBranchTerminal
    j_pe.p1 ~ PE
    j_pe.p2 ~ PE

    # Two local capacitors per leg. HV_RET preserves shoot-through sensing;
    # LEG_RET would bypass the shunt. Keep the shunt power path short/wide.
    c_hf_a1 = new LocalBus100n
    c_hf_a1.p1 ~ BUS_P
    c_hf_a1.p2 ~ HV_RET
    c_hf_a2 = new LocalBus100n
    c_hf_a2.p1 ~ BUS_P
    c_hf_a2.p2 ~ HV_RET
    c_hf_b1 = new LocalBus100n
    c_hf_b1.p1 ~ BUS_P
    c_hf_b1.p2 ~ HV_RET
    c_hf_b2 = new LocalBus100n
    c_hf_b2.p1 ~ BUS_P
    c_hf_b2.p2 ~ HV_RET

    # RECT_* studs stay mains-live with links removed. Bench supply connects
    # only to the bus-side studs (BUS_P/HV_RET), never to LEG_RET.
    link_pos = new BusBringupLink
    link_pos.rectifier ~ RECT_P
    link_pos.bus ~ BUS_P
    link_neg = new BusBringupLink
    link_neg.rectifier ~ RECT_N
    link_neg.bus ~ HV_RET

    # ---------------- tank-CT detector (SELV), at T1
    # Kept last in the module so existing designators do not renumber.
    # T1's secondary is terminated here and never crosses the connector: an
    # open CT secondary spikes to hundreds of volts on SELV pins
    # (validation-results/06-controller-interface). Ported from
    # zapote/current-sense/circuit/current_sense_unit.ato: floating 1.5 ohm
    # burden around a bypassed 1.65 V midpoint (CT_S2), 1 k series input with
    # low-leakage BAS116H rail clamps, and a comparator per polarity. References 3.32k/10k
    # put the tank over-current trip at ~55 A (DC corner band 50.9-59.5 A:
    # tools/ct_detector). A third comparator gives the zero crossing; the
    # biased current waveform leaves through 1 k. The trip ORs with the
    # isolated bus fault onto the existing active-high BUS_FAULT line.
    r_ct_burden = new Burden1R5
    r_ct_burden.value = 1.5ohm
    r_ct_burden.p1 ~ CT_S1
    r_ct_burden.p2 ~ CT_S2
    c_ct_burden = new C100nC0G1206
    c_ct_burden.value = 100nF
    c_ct_burden.p1 ~ CT_S1
    c_ct_burden.p2 ~ CT_S2
    r_ct_bias_top = new R1kThin
    r_ct_bias_top.value = 1kohm
    r_ct_bias_top.p1 ~ V3V3
    r_ct_bias_top.p2 ~ CT_S2
    r_ct_bias_bot = new R1kThin
    r_ct_bias_bot.value = 1kohm
    r_ct_bias_bot.p1 ~ CT_S2
    r_ct_bias_bot.p2 ~ SELV_GND
    c_ct_bias = new C100nC0G1206
    c_ct_bias.value = 100nF
    c_ct_bias.p1 ~ CT_S2
    c_ct_bias.p2 ~ SELV_GND
    r_ct_series = new R1k1206
    r_ct_series.value = 1kohm
    r_ct_series.p1 ~ CT_S1
    r_ct_series.p2 ~ CT_SENSE_MON
    d_ct_hi = new ClampBas116h
    d_ct_hi.A ~ CT_SENSE_MON
    d_ct_hi.K ~ V3V3
    d_ct_lo = new ClampBas116h
    d_ct_lo.A ~ SELV_GND
    d_ct_lo.K ~ CT_SENSE_MON
    r_ct_hi_top = new R3k32Thin
    r_ct_hi_top.value = 3.32kohm
    r_ct_hi_top.p1 ~ V3V3
    r_ct_hi_top.p2 ~ CT_REF_HI
    r_ct_hi_bot = new R10kThin
    r_ct_hi_bot.value = 10kohm
    r_ct_hi_bot.p1 ~ CT_REF_HI
    r_ct_hi_bot.p2 ~ SELV_GND
    r_ct_lo_top = new R10kThin
    r_ct_lo_top.value = 10kohm
    r_ct_lo_top.p1 ~ V3V3
    r_ct_lo_top.p2 ~ CT_REF_LO
    r_ct_lo_bot = new R3k32Thin
    r_ct_lo_bot.value = 3.32kohm
    r_ct_lo_bot.p1 ~ CT_REF_LO
    r_ct_lo_bot.p2 ~ SELV_GND
    u_ct_pos = new Tlv3201
    u_ct_pos.INP ~ CT_SENSE_MON
    u_ct_pos.INN ~ CT_REF_HI
    u_ct_pos.OUT ~ CT_OC_POS
    u_ct_pos.VCC ~ V3V3
    u_ct_pos.GND ~ SELV_GND
    c_ct_pos = new C100n0603
    c_ct_pos.value = 100nF
    c_ct_pos.p1 ~ V3V3
    c_ct_pos.p2 ~ SELV_GND
    u_ct_neg = new Tlv3201
    u_ct_neg.INP ~ CT_REF_LO
    u_ct_neg.INN ~ CT_SENSE_MON
    u_ct_neg.OUT ~ CT_OC_NEG
    u_ct_neg.VCC ~ V3V3
    u_ct_neg.GND ~ SELV_GND
    c_ct_neg = new C100n0603
    c_ct_neg.value = 100nF
    c_ct_neg.p1 ~ V3V3
    c_ct_neg.p2 ~ SELV_GND
    u_ct_zc = new Tlv3201
    u_ct_zc.INP ~ CT_SENSE_MON
    u_ct_zc.INN ~ CT_S2
    u_ct_zc.OUT ~ CT_ZC
    u_ct_zc.VCC ~ V3V3
    u_ct_zc.GND ~ SELV_GND
    c_ct_zc = new C100n0603
    c_ct_zc.value = 100nF
    c_ct_zc.p1 ~ V3V3
    c_ct_zc.p2 ~ SELV_GND
    u_fault_or = new Or3Lvc1g332
    u_fault_or.A ~ BUS_FAULT_ISO
    u_fault_or.B ~ CT_OC_POS
    u_fault_or.C ~ CT_OC_NEG
    u_fault_or.Y ~ BUS_FAULT
    u_fault_or.VCC ~ V3V3
    u_fault_or.GND ~ SELV_GND
    c_fault_or = new C100n0603
    c_fault_or.value = 100nF
    c_fault_or.p1 ~ V3V3
    c_fault_or.p2 ~ SELV_GND
    r_ct_mon = new R1k0603
    r_ct_mon.value = 1kohm
    r_ct_mon.p1 ~ CT_SENSE_MON
    r_ct_mon.p2 ~ CT_MON

    # Append the new HOT5 circuit after all previously established devices.
    # This preserves their reference designators in the frozen netlist and
    # native18 integration baseline. The nets above may be joined later.
    # TPS3700 uses V15_LS independently of the HOT5 rail it measures.
    u_hot5_uv = new Hot5Supervisor
    u_hot5_uv.VDD ~ V15_LS
    u_hot5_uv.GND ~ OCP_KELVIN_P
    u_hot5_uv.INA ~ HOT5_UV_SENSE
    u_hot5_uv.INB ~ OCP_KELVIN_P
    u_hot5_uv.OUTA ~ HOT5_UV_RAW
    r_hot5_uv_top = new R105kThin
    r_hot5_uv_top.value = 105kohm
    r_hot5_uv_top.p1 ~ HOT5
    r_hot5_uv_top.p2 ~ HOT5_UV_SENSE
    r_hot5_uv_bot = new R10kThin
    r_hot5_uv_bot.value = 10kohm
    r_hot5_uv_bot.p1 ~ HOT5_UV_SENSE
    r_hot5_uv_bot.p2 ~ OCP_KELVIN_P
    r_hot5_uv_pull = new R10kThin
    r_hot5_uv_pull.value = 10kohm
    r_hot5_uv_pull.p1 ~ HOT5
    r_hot5_uv_pull.p2 ~ HOT5_UV_RAW
    c_hot5_uv = new C100n0603
    c_hot5_uv.value = 100nF
    c_hot5_uv.p1 ~ V15_LS
    c_hot5_uv.p2 ~ OCP_KELVIN_P
    u_hot5_schmitt = new Hot5SchmittBuffer
    u_hot5_schmitt.VCC ~ HOT5
    u_hot5_schmitt.GND ~ OCP_KELVIN_P
    u_hot5_schmitt.A ~ HOT5_UV_RAW
    u_hot5_schmitt.Y ~ HOT5_OK_HOT
    c_hot5_schmitt = new C100n0603
    c_hot5_schmitt.value = 100nF
    c_hot5_schmitt.p1 ~ HOT5
    c_hot5_schmitt.p2 ~ OCP_KELVIN_P

    # D-33 HOT bias; PS2 negative is N_LS, shunt midpoint is LEG_RET.
    bias_ls = new RegulatedSplit
    bias_ls.raw ~ V24_RAW
    bias_ls.p ~ V15_LS
    bias_ls.n ~ N_LS
    bias_ls.src ~ LEG_RET
    monitor_ls = new RailMonitor
    monitor_ls.src ~ LEG_RET
    monitor_ls.p ~ V15_LS
    monitor_ls.n ~ N_LS
    monitor_ls.selv_v ~ V3V3
    monitor_ls.selv_gnd ~ SELV_GND
    monitor_ls.bad ~ BIAS_LS_BAD
    bias_driver = new BiasPushPull
    bias_driver.VCC ~ V24_RAW
    bias_driver.EN ~ V24_RAW
    bias_driver.GND1 ~ N_LS
    bias_driver.GND2 ~ N_LS
    bias_driver.EP ~ N_LS
    bias_driver.SW1 ~ BIAS_SW1
    bias_driver.SW2 ~ BIAS_SW2
    # DC is intentionally open: no duty-cycle control. External clock unused.
    bias_rclk = new Bias18k2
    bias_rclk.value = 18.2kohm
    bias_rclk.p1 ~ bias_driver.CLK
    bias_rclk.p2 ~ N_LS
    bias_rlim = new Bias30k1
    bias_rlim.value = 30.1kohm
    bias_rlim.p1 ~ bias_driver.SS
    bias_rlim.p2 ~ N_LS
    bias_css = new Bias4u7
    bias_css.value = 4.7uF
    bias_css.p1 ~ bias_driver.SS
    bias_css.p2 ~ N_LS
    bias_rsr = new Bias4k99
    bias_rsr.value = 4.99kohm
    bias_rsr.p1 ~ bias_driver.SR
    bias_rsr.p2 ~ N_LS
    bias_cin = new Bias10u
    bias_cin.value = 10uF
    bias_cin.p1 ~ V24_RAW
    bias_cin.p2 ~ N_LS
    bias_chf = new C100n0603
    bias_chf.value = 100nF
    bias_chf.p1 ~ V24_RAW
    bias_chf.p2 ~ N_LS
    signal BIAS_SN1
    bias_rsn1 = new Bias680
    bias_rsn1.value = 680ohm
    bias_rsn1.p1 ~ BIAS_SW1
    bias_rsn1.p2 ~ BIAS_SN1
    bias_csn1 = new C100pC0G0603
    bias_csn1.value = 100pF
    bias_csn1.p1 ~ BIAS_SN1
    bias_csn1.p2 ~ V24_RAW
    signal BIAS_SN2
    bias_rsn2 = new Bias680
    bias_rsn2.value = 680ohm
    bias_rsn2.p1 ~ BIAS_SW2
    bias_rsn2.p2 ~ BIAS_SN2
    bias_csn2 = new C100pC0G0603
    bias_csn2.value = 100pF
    bias_csn2.p1 ~ BIAS_SN2
    bias_csn2.p2 ~ V24_RAW
    bias_ha = new HighBias
    bias_ha.p ~ P_HA
    bias_ha.n ~ N_HA
    bias_ha.raw24 ~ V24_RAW
    bias_ha.sw1 ~ BIAS_SW1
    bias_ha.sw2 ~ BIAS_SW2
    bias_ha.src ~ SW_A
    bias_ha.selv_v ~ V3V3
    bias_ha.selv_gnd ~ SELV_GND
    bias_ha.bad ~ BIAS_HA_BAD
    bias_hb = new HighBias
    bias_hb.p ~ P_HB
    bias_hb.n ~ N_HB
    bias_hb.raw24 ~ V24_RAW
    bias_hb.sw1 ~ BIAS_SW1
    bias_hb.sw2 ~ BIAS_SW2
    bias_hb.src ~ SW_B
    bias_hb.selv_v ~ V3V3
    bias_hb.selv_gnd ~ SELV_GND
    bias_hb.bad ~ BIAS_HB_BAD
    bias_or = new Or3Lvc1g332
    bias_or.A ~ BIAS_LS_BAD
    bias_or.B ~ BIAS_HA_BAD
    bias_or.C ~ BIAS_HB_BAD
    bias_or.Y ~ BIAS_BAD
    bias_or.VCC ~ V3V3
    bias_or.GND ~ SELV_GND
    bias_c_or = new C100n0603
    bias_c_or.value = 100nF
    bias_c_or.p1 ~ V3V3
    bias_c_or.p2 ~ SELV_GND
    line_zc = new LineZeroCross
    line_zc.line ~ L_FILT
    line_zc.neutral ~ N_FILT
    line_zc.selv_v ~ V3V3
    line_zc.selv_gnd ~ SELV_GND
    line_zc.out ~ LINE_ZC

    # Preserve native-20 designators; removed bootstrap references stay vacant.
    j_mains.designator = "J1"
    f1.designator = "F1"
    rv1.designator = "RV1"
    cx1.designator = "C1"
    cx2.designator = "C2"
    rb1a.designator = "R1"
    rb1b.designator = "R2"
    r_bus1.designator = "R3"
    r_bus2.designator = "R4"
    leg_a.r_gh.designator = "R10"
    leg_a.r_gl.designator = "R12"
    leg_b.r_gh.designator = "R18"
    leg_b.r_gl.designator = "R20"
    r_crb1.designator = "R22"
    r_crb2.designator = "R23"
    r_crb3.designator = "R24"
    r_crb4.designator = "R25"
    r_div1.designator = "R26"
    r_div2.designator = "R27"
    r_div3.designator = "R28"
    r_div4.designator = "R29"
    r_ct_burden.designator = "R39"
    r_ct_series.designator = "R42"
    l1.designator = "L1"
    cy1.designator = "C3"
    cy2.designator = "C4"
    br1.designator = "BR1"
    c_bus1.designator = "C5"
    c_bus2.designator = "C6"
    r_shunt.designator = "R5"
    leg_a.driver.designator = "U1"
    leg_b.driver.designator = "U2"
    leg_a.c_vcci.designator = "C7"
    leg_a.c_ls.designator = "C8"
    leg_b.c_vcci.designator = "C14"
    leg_b.c_ls.designator = "C15"
    c_ldo_in.designator = "C25"
    c_div.designator = "C27"
    c_vs1.designator = "C28"
    c_vs2.designator = "C29"
    c_ocp_node.designator = "C30"
    c_th.designator = "C31"
    c_ocp_vcc.designator = "C32"
    c_ovp_th.designator = "C33"
    c_ovp_vcc.designator = "C34"
    c_nand_vcc.designator = "C35"
    c_iso1.designator = "C36"
    c_iso2.designator = "C37"
    c_ct_pos.designator = "C44"
    c_ct_neg.designator = "C45"
    c_ct_zc.designator = "C46"
    c_fault_or.designator = "C47"
    c_hot5_uv.designator = "C48"
    c_hot5_schmitt.designator = "C49"
    leg_a.permit_fet.designator = "Q1"
    leg_b.permit_fet.designator = "Q4"
    u_ref.designator = "U5"
    leg_a.r_permit.designator = "R6"
    leg_a.r_permit_pd.designator = "R7"
    leg_a.r_dis_pu.designator = "R8"
    leg_a.r_dt.designator = "R9"
    leg_a.r_gh_pd.designator = "R11"
    leg_a.r_gl_pd.designator = "R13"
    leg_b.r_permit.designator = "R14"
    leg_b.r_permit_pd.designator = "R15"
    leg_b.r_dis_pu.designator = "R16"
    leg_b.r_dt.designator = "R17"
    leg_b.r_gh_pd.designator = "R19"
    leg_b.r_gl_pd.designator = "R21"
    r_div_bot.designator = "R30"
    r_ref_bias.designator = "R31"
    r_ocp_ref.designator = "R32"
    r_ocp_sense.designator = "R33"
    r_th_top.designator = "R34"
    r_th_bot.designator = "R35"
    r_ovp_top.designator = "R36"
    r_ovp_bot.designator = "R37"
    r_fe.designator = "R38"
    r_ct_bias_top.designator = "R40"
    r_ct_bias_bot.designator = "R41"
    r_ct_hi_top.designator = "R43"
    r_ct_hi_bot.designator = "R44"
    r_ct_lo_top.designator = "R45"
    r_ct_lo_bot.designator = "R46"
    r_ct_mon.designator = "R47"
    r_hot5_uv_top.designator = "R48"
    r_hot5_uv_bot.designator = "R49"
    r_hot5_uv_pull.designator = "R50"
    leg_a.c_ls_bulk.designator = "C9"
    leg_b.c_ls_bulk.designator = "C16"
    c_v15.designator = "C24"
    c_ldo_out.designator = "C26"
    leg_a.q_high.designator = "Q2"
    leg_a.q_low.designator = "Q3"
    leg_b.q_high.designator = "Q5"
    leg_b.q_low.designator = "Q6"
    leg_a.c_snub_h.designator = "C12"
    leg_a.c_snub_l.designator = "C13"
    leg_b.c_snub_h.designator = "C19"
    leg_b.c_snub_l.designator = "C20"
    c_ct_burden.designator = "C42"
    c_ct_bias.designator = "C43"
    t_ct.designator = "T1"
    j_coil.designator = "J2"
    j_coil_return.designator = "J5"
    link_pos.terminal_rect.designator = "J7"
    link_pos.terminal_bus.designator = "J8"
    link_neg.terminal_rect.designator = "J9"
    link_neg.terminal_bus.designator = "J10"
    c_res1.designator = "C21"
    c_res2.designator = "C22"
    c_res3.designator = "C23"
    ps_selv.designator = "PS1"
    j_tco.designator = "J3"
    ps_gate.designator = "PS2"
    u_ldo.designator = "U3"
    u_vsense.designator = "U4"
    u_ocp.designator = "U6"
    u_ovp.designator = "U7"
    u_ct_pos.designator = "U10"
    u_ct_neg.designator = "U11"
    u_ct_zc.designator = "U12"
    u_hot5_schmitt.designator = "U15"
    u_nand.designator = "U8"
    u_fault_or.designator = "U13"
    u_hot5_uv.designator = "U14"
    u_iso.designator = "U9"
    j_selv.designator = "J4"
    tvs_bus.designator = "D3"
    j_pe.designator = "J6"
    c_hf_a1.designator = "C38"
    c_hf_a2.designator = "C39"
    c_hf_b1.designator = "C40"
    c_hf_b2.designator = "C41"
    d_ct_hi.designator = "D4"
    d_ct_lo.designator = "D5"

    # D-33 additions have explicit references above the native-20 maxima.
    leg_a.bias_h.rdamp.designator = "R51"
    leg_a.bias_l.rdamp.designator = "R52"
    leg_a.roff_h.designator = "R53"
    leg_a.roff_l.designator = "R54"
    leg_b.bias_h.rdamp.designator = "R55"
    leg_b.bias_l.rdamp.designator = "R56"
    leg_b.roff_h.designator = "R57"
    leg_b.roff_l.designator = "R58"
    monitor_ls.rref.designator = "R59"
