# 120 V full-bridge induction power stage (single board).
#
# Design basis: docs/hardware/power-section-120v/ (POWER-SECTION.md,
# LOSS-REFACTOR.md, COIL-MC.md). Unfiltered-bus front end, no PFC; full
# bridge of four IPW65R018CFD7; series resonant capacitor; tank CT to the
# SELV current-sense board; DC-bus shunt OCP for shoot-through; thermal
# cutoffs in series with the gate-driver supply; AMC1311 bus sense; bus
# over-voltage comparator NANDed with the OCP into the isolated fault-high line.
#
# Domains:
#   mains / HOT:  AC_*, L_*, N_*, BUS_P, HV_RET, LEG_RET, SW_*, tank nets.
#                 LEG_RET carries gate-driver recharge and bridge current.
#                 OCP_KELVIN_P returns the LDO, protection and isolated hot
#                 control circuits to the separate R5 sense terminal. This is
#                 a loaded Kelvin reference, not a zero-current sense lead.
#   SELV:         everything on the 16-pin controller header, isolated by
#                 UCC21550, AMC1311, CA-IS3720 (was ISO7710) and CST3015. Stage 38 (candidate 23): no
#                 mains supply feeds the SELV side on this board any more; the controller's logic runs
#                 from PS3 over its J13 (controller DECISIONS), and J4 pin 1 is not connected.
#
# Coil-dependent values (resonant capacitance, CT burden on the
# current-sense board) are provisional for the 70 uH / 32 kHz nominal coil
# until the coil and pan measurements in COIL-MC.md are taken.

from "parts.ato" import MainsTerminal2, PowerTerminalM4, PeBranchTerminal, MainsFuse25A, Tmov175, Cmc20A
from "parts.ato" import CapX2_1u, CapY1_2n2, R100k1206, BridgeGbj2510, BusFilm2u7, LocalBus100n
from "parts.ato" import R220k1206, Shunt1m, MosfetCfd7, Snubber1n1kV, UCC21550BDWK, Driver2EDR8259X
from "parts.ato" import R3R9Gate, R8R2Gate, R68Gate2512, R49k9Dt, R10k0603, R100k0603, R100R0603
from "parts.ato" import R1k0603, R330R0603, C100n0603, C10u1210, C10u0805, ResB32654
from "parts.ato" import C100n0805, C1u0805
from "parts.ato" import CST3015_200E, TcoLoopHeader, BranchFuseT3A15, BranchLimiter0R15, MainsTapHeader
from "parts.ato" import Amc1311, R470k1206, R15k8Thin, C1nC0G0603, C4n7C0G0603, C100pC0G0603
from "parts.ato" import Tlv3201, Ref2V5, R10kThin, R12k6Thin, R11k7Thin, R140kThin, R5k6Bias
from "parts.ato" import IsoReinfH, SelvHeader16, Nand3Lvc1g10, FunctionalEarthLink, SchmittBuf17
from "parts.ato" import Hot5Supervisor, Hot5SchmittBuffer, R105kThin
from "parts.ato" import BusTvs30kpa150
from "parts.ato" import Burden3R0, C100nC0G1206, R1kThin, R2k21Thin, R1k1206, ClampBas116h, Or3Lvc1g332

from "f6_parts.ato" import HotSupply24, HotLdo, GateDischarge, Gate1R, DisNand, BiasGoodSchmitt, Bias4k99, Bias10u, Bias27k
from "f6_bias.ato" import BiasReservoir, RegulatedSplit, RailMonitor, HighBiasLink, LineZeroCross, Heartbeat

module BridgeLeg:
    """One half-bridge leg: UCC21550 (A = high side, B = low side), fail-safe
    DIS receiver, dead time, monitored F6 bias, gate networks, two MOSFETs, snubbers.
    PERMIT low, floating or unpowered leaves DIS high (outputs disabled)."""
    signal v3v3
    signal selv_gnd
    signal pwm_h
    signal pwm_l
    signal permit
    signal v15_ls
    signal hot_gnd
    signal bus_p
    signal sw
    signal dis
    signal p_hs
    signal n_hs
    signal n_ls
    signal bias_good
    signal driver_dis
    signal gate_h
    signal gate_l
    signal out_h
    signal out_l
    signal permit_gate

    driver = new Driver2EDR8259X   # stage 29 (DECISIONS 31): 2EDR8259X, CMTI >= 150 V/ns
    driver.VCCI_1 ~ v3v3
    driver.VCCI_2 ~ v3v3
    driver.GNDI ~ selv_gnd
    driver.INA ~ pwm_h
    driver.INB ~ pwm_l
    c_vcci = new C100n0603
    c_vcci.value = 100nF
    c_vcci.p1 ~ v3v3
    c_vcci.p2 ~ selv_gnd

    # DIS is active-high. Stage 22 (DECISIONS 27): DIS = NAND(permit_gate, bias_good), so DIS is low (drive enabled)
    # only with PERMIT high AND the bias rails good; PERMIT low / floating (100 k pulldown) or BIAS_GOOD low gives DIS high.
    # Replaces the AO3400A inverter + 330 ohm pull-up (D-31; ~10.5 mA per leg) and the LVC1G32 OR: same truth table,
    # PERMIT-to-DIS now a gate delay (bench-qualified).
    r_permit = new R100R0603
    r_permit.value = 100ohm
    r_permit_pd = new R100k0603
    r_permit_pd.value = 100kohm
    permit ~ r_permit.p1
    r_permit.p2 ~ permit_gate
    permit_gate ~ r_permit_pd.p1
    r_permit_pd.p2 ~ selv_gnd
    driver_dis ~ driver.DIS

    # TI: tDT ~= 8.6 * RDT[kohm] + 13 ns -> ~442 ns nominal; verify at bring-up.
    r_dt = new R49k9Dt
    r_dt.value = 49.9kohm
    r_dt.p1 ~ driver.DT
    r_dt.p2 ~ selv_gnd

    # Low side (channel B) on the floating 15 V referenced to HOT_GND.
    driver.VDDB ~ v15_ls
    driver.VSSB ~ n_ls
    # VDDB-VSSB: 100 nF + 1 uF 0805s straddling OUTB right at pins 11 / 9 (stage 9, review B1)
    c_ls = new C100n0805
    c_ls.value = 100nF
    c_ls.p1 ~ v15_ls
    c_ls.p2 ~ n_ls
    c_ls_1u = new C1u0805
    c_ls_1u.value = 1uF
    c_ls_1u.p1 ~ v15_ls
    c_ls_1u.p2 ~ n_ls
    c_ls_bulk = new C10u1210
    c_ls_bulk.value = 10uF
    c_ls_bulk.p1 ~ v15_ls
    c_ls_bulk.p2 ~ n_ls

    # The two high-side transformers and shared low-side split are HOT-powered.
    driver.VDDA ~ p_hs
    driver.VSSA ~ n_hs
    # VDDA-VSSA decoupling at the driver pins (independent review 2026-10-08, B1): turn-on gate
    # charge (~0.7 uC edge allowance, bias_sizing.py) comes from here, not from the LDO 50 mm away.
    # Mirrors channel B's c_ls / c_ls_bulk. Stage 9: 100 nF + 1 uF + 10 uF 0805s straddle OUTA right
    # at pins 16 / 14, a ~3 mm loop with no vias (the stage-8 placement left a 30 mm VSSA return).
    c_hs = new C100n0805
    c_hs.value = 100nF
    c_hs.p1 ~ p_hs
    c_hs.p2 ~ n_hs
    c_hs_1u = new C1u0805
    c_hs_1u.value = 1uF
    c_hs_1u.p1 ~ p_hs
    c_hs_1u.p2 ~ n_hs
    c_hs_bulk = new C10u0805
    c_hs_bulk.value = 10uF
    c_hs_bulk.p1 ~ p_hs
    c_hs_bulk.p2 ~ n_hs
    bias_h = new BiasReservoir
    bias_h.src ~ sw
    bias_h.n ~ n_hs
    bias_h.p ~ p_hs
    bias_l = new BiasReservoir
    bias_l.src ~ hot_gnd
    bias_l.n ~ n_ls
    bias_l.p ~ v15_ls
    dis_or = new DisNand
    dis_or.A ~ permit_gate
    dis_or.B ~ bias_good
    dis_or.Y ~ driver_dis
    dis_or.VCC ~ v3v3
    dis_or.GND ~ selv_gnd
    c_dis_or = new C100n0603
    c_dis_or.value = 100nF
    c_dis_or.p1 ~ v3v3
    c_dis_or.p2 ~ selv_gnd
    r_driver_dis = new R10k0603
    r_driver_dis.value = 10kohm
    r_driver_dis.p1 ~ v3v3
    r_driver_dis.p2 ~ driver_dis

    # Gate networks: split turn-on / turn-off, 10 k gate-source hold-off.
    # Stage 42 (candidate 39, DECISIONS 54): turn-on 68 ohm 2512 and Cgs 4.7 nF C0G hold the S4 reverse-diode limits of
    # the CFD7 (stage 29 to 41: 8.2 ohm 1206 and 1 nF). The PMEG6030EP + 1 ohm turn-off path is unchanged.
    driver.OUTA ~ out_h
    r_gh = new R68Gate2512
    r_gh.value = 68ohm
    r_gh.p1 ~ out_h
    r_gh.p2 ~ gate_h
    r_gh_pd = new R10k0603
    r_gh_pd.value = 10kohm
    r_gh_pd.p1 ~ gate_h
    r_gh_pd.p2 ~ sw
    driver.OUTB ~ out_l
    r_gl = new R68Gate2512
    r_gl.value = 68ohm
    r_gl.p1 ~ out_l
    r_gl.p2 ~ gate_l
    r_gl_pd = new R10k0603
    r_gl_pd.value = 10kohm
    r_gl_pd.p1 ~ gate_l
    r_gl_pd.p2 ~ hot_gnd

    signal off_h
    cgs_h = new C4n7C0G0603
    cgs_h.value = 4.7nF
    cgs_h.p1 ~ gate_h
    cgs_h.p2 ~ sw
    doff_h = new GateDischarge
    doff_h.A ~ gate_h
    doff_h.K ~ off_h
    roff_h = new Gate1R
    roff_h.value = 1ohm
    roff_h.p1 ~ off_h
    roff_h.p2 ~ out_h
    signal off_l
    cgs_l = new C4n7C0G0603
    cgs_l.value = 4.7nF
    cgs_l.p1 ~ gate_l
    cgs_l.p2 ~ hot_gnd
    doff_l = new GateDischarge
    doff_l.A ~ gate_l
    doff_l.K ~ off_l
    roff_l = new Gate1R
    roff_l.value = 1ohm
    roff_l.p1 ~ off_l
    roff_l.p2 ~ out_l

    q_high = new MosfetCfd7
    q_high.G ~ gate_h
    q_high.D ~ bus_p
    q_high.S ~ sw
    q_low = new MosfetCfd7
    q_low.G ~ gate_l
    q_low.D ~ sw
    q_low.S ~ hot_gnd

    c_snub_h = new Snubber1n1kV
    c_snub_h.p1 ~ bus_p
    c_snub_h.p2 ~ sw
    c_snub_l = new Snubber1n1kV
    c_snub_l.p1 ~ sw
    c_snub_l.p2 ~ hot_gnd


module PowerStage120V:
    # ---------------- nets
    signal AC_L_IN
    signal AC_N_IN
    signal PE
    signal L_F
    signal XBLEED_MID
    signal L_FILT
    signal N_FILT
    signal BUS_P
    signal HV_RET
    signal BUSBLEED_MID
    signal LEG_RET
    signal OCP_KELVIN_P
    signal SW_A
    signal SW_B
    signal COIL_FEED
    signal RES_A
    signal CRBLEED_1
    signal CRBLEED_2
    signal CRBLEED_3
    signal TCO_L
    signal BLW_L
    signal BLW_LR   # stage 28: F2 -> R_blw (limiter) -> J11
    signal V15_LS
    signal N_LS
    signal V24_RAW
    signal P_HA
    signal N_HA
    signal P_HB
    signal N_HB
    signal BIAS_GOOD
    signal MON_GOOD_HA
    signal MON_GOOD_HB
    signal HSB_GOOD
    signal LINE_ZC
    signal HOT5
    signal VDIV_1
    signal VDIV_2
    signal VDIV_3
    signal VSENSE_IN
    signal REF25
    signal OCP_KELVIN_N
    signal OCP_NODE
    signal OCP_THRESH
    signal OCP_OK_HOT
    signal OVP_THRESH
    signal OVP_OK_HOT
    signal HOT5_UV_SENSE
    signal HOT5_UV_RAW
    signal HOT5_OK_HOT
    signal BUS_FAULT_HOT
    # SELV
    signal SELV_GND
    signal J4_NC1   # stage 38: J4 pin 1 (was V15_SELV from PS1), not connected; a named single-pin SELV net
    signal V3V3
    signal PWM_HA
    signal PWM_LA
    signal PWM_HB
    signal PWM_LB
    signal PERMIT
    signal BUS_FAULT
    signal VBUS_P
    signal VBUS_N
    signal CT_S1
    signal CT_S2
    signal CT_SENSE_MON
    signal CT_REF_HI
    signal CT_REF_LO
    signal CT_OC_POS
    signal CT_OC_NEG
    signal CT_ZC
    signal CT_MON
    signal BUS_FAULT_ISO
    signal BUS_FAULT_FLT

    # ---------------- mains entry and EMI filter
    j_mains = new MainsTerminal2
    j_mains.p1 ~ AC_L_IN
    j_mains.p2 ~ AC_N_IN
    f1 = new MainsFuse25A
    f1.p1 ~ AC_L_IN
    f1.p2 ~ L_F
    rv1 = new Tmov175
    rv1.p1 ~ L_F
    rv1.p2 ~ AC_N_IN
    cx1 = new CapX2_1u
    cx1.p1 ~ L_F
    cx1.p2 ~ AC_N_IN
    rb1a = new R100k1206
    rb1a.value = 100kohm
    rb1a.p1 ~ L_F
    rb1a.p2 ~ XBLEED_MID
    rb1b = new R100k1206
    rb1b.value = 100kohm
    rb1b.p1 ~ XBLEED_MID
    rb1b.p2 ~ AC_N_IN
    l1 = new Cmc20A
    l1.a_in ~ L_F
    l1.a_out ~ L_FILT
    l1.b_in ~ AC_N_IN
    l1.b_out ~ N_FILT
    cx2 = new CapX2_1u
    cx2.p1 ~ L_FILT
    cx2.p2 ~ N_FILT
    cy1 = new CapY1_2n2
    cy1.p1 ~ L_FILT
    cy1.p2 ~ PE
    cy2 = new CapY1_2n2
    cy2.p1 ~ N_FILT
    cy2.p2 ~ PE

    # ---------------- rectifier, film bus, bleed, DC shunt
    br1 = new BridgeGbj2510
    br1.AC1 ~ L_FILT
    br1.AC2 ~ N_FILT
    # Stage 21 (DECISIONS 25): BR1 feeds the bus directly; the J7-J10 rail links are gone. Floating
    # low-voltage bring-up leaves BR1 unfitted and lands the bench supply in BR1's + / - holes (ASSEMBLY.md).
    br1.PLUS ~ BUS_P
    br1.MINUS ~ HV_RET
    c_bus1 = new BusFilm2u7
    c_bus1.p1 ~ BUS_P
    c_bus1.p2 ~ BUS_P
    c_bus1.p3 ~ HV_RET
    c_bus1.p4 ~ HV_RET
    c_bus2 = new BusFilm2u7
    c_bus2.p1 ~ BUS_P
    c_bus2.p2 ~ BUS_P
    c_bus2.p3 ~ HV_RET
    c_bus2.p4 ~ HV_RET
    r_bus1 = new R220k1206
    r_bus1.value = 220kohm
    r_bus1.p1 ~ BUS_P
    r_bus1.p2 ~ BUSBLEED_MID
    r_bus2 = new R220k1206
    r_bus2.value = 220kohm
    r_bus2.p1 ~ BUSBLEED_MID
    r_bus2.p2 ~ HV_RET
    # Keep I1 and E1 on different PCB nets: the selected four-terminal part
    # joins them internally. Gate-supply recharge returns through I1, never E1.
    # Legs return through the shunt to the bus capacitors, so shoot-through
    # current (which never enters the tank CT) is measured here.
    r_shunt = new Shunt1m
    r_shunt.I1 ~ LEG_RET
    r_shunt.S1 ~ OCP_KELVIN_P
    r_shunt.S2 ~ OCP_KELVIN_N
    r_shunt.I2 ~ HV_RET

    # ---------------- full bridge
    leg_a = new BridgeLeg
    leg_a.v3v3 ~ V3V3
    leg_a.selv_gnd ~ SELV_GND
    leg_a.pwm_h ~ PWM_HA
    leg_a.pwm_l ~ PWM_LA
    leg_a.permit ~ PERMIT
    leg_a.v15_ls ~ V15_LS
    leg_a.n_ls ~ N_LS
    leg_a.p_hs ~ P_HA
    leg_a.n_hs ~ N_HA
    leg_a.bias_good ~ BIAS_GOOD
    leg_a.hot_gnd ~ LEG_RET
    leg_a.bus_p ~ BUS_P
    leg_a.sw ~ SW_A
    leg_b = new BridgeLeg
    leg_b.v3v3 ~ V3V3
    leg_b.selv_gnd ~ SELV_GND
    leg_b.pwm_h ~ PWM_HB
    leg_b.pwm_l ~ PWM_LB
    leg_b.permit ~ PERMIT
    leg_b.v15_ls ~ V15_LS
    leg_b.n_ls ~ N_LS
    leg_b.p_hs ~ P_HB
    leg_b.n_hs ~ N_HB
    leg_b.bias_good ~ BIAS_GOOD
    leg_b.hot_gnd ~ LEG_RET
    leg_b.bus_p ~ BUS_P
    leg_b.sw ~ SW_B

    # ---------------- resonant tank: SW_A -> CT -> coil -> C_res -> SW_B
    # The CT primary sits on the switch node (HF insulation basis open), not
    # the resonant node (up to ~640 V pk at 33-60 kHz): see ORACLE-ANSWER.md
    # Q4. Tank current still enters P1, so the CT sign is unchanged.
    t_ct = new CST3015_200E
    t_ct.P1 ~ SW_A
    t_ct.P2 ~ COIL_FEED
    t_ct.S1 ~ CT_S1
    t_ct.S2 ~ CT_S2
    j_coil = new PowerTerminalM4
    j_coil.p1 ~ COIL_FEED
    # 5 x 0.10 uF = 0.50 uF (stage 13, was 0.54 uF in 942C parts): ferrous-pan resonance ~31-33 kHz
    # with the assumed 70 uH coil, below the 35-60 kHz window (task 05 round 4).
    c_res1 = new ResB32654
    c_res1.p1 ~ RES_A
    c_res1.p2 ~ SW_B
    c_res2 = new ResB32654
    c_res2.p1 ~ RES_A
    c_res2.p2 ~ SW_B
    c_res3 = new ResB32654
    c_res3.p1 ~ RES_A
    c_res3.p2 ~ SW_B
    c_res4 = new ResB32654
    c_res4.p1 ~ RES_A
    c_res4.p2 ~ SW_B
    c_res5 = new ResB32654
    c_res5.p1 ~ RES_A
    c_res5.p2 ~ SW_B
    # Bleed: an OCP trip can leave C_res holding ~250 V with no discharge
    # path. 4 x 470 k = 1.88 M, tau ~0.94 s with 0.50 uF, ~26 mW in operation.
    r_crb1 = new R470k1206
    r_crb1.value = 470kohm
    r_crb1.p1 ~ RES_A
    r_crb1.p2 ~ CRBLEED_1
    r_crb2 = new R470k1206
    r_crb2.value = 470kohm
    r_crb2.p1 ~ CRBLEED_1
    r_crb2.p2 ~ CRBLEED_2
    r_crb3 = new R470k1206
    r_crb3.value = 470kohm
    r_crb3.p1 ~ CRBLEED_2
    r_crb3.p2 ~ CRBLEED_3
    r_crb4 = new R470k1206
    r_crb4.value = 470kohm
    r_crb4.p1 ~ CRBLEED_3
    r_crb4.p2 ~ SW_B

    # ---------------- supplies
    # Stage 38 (candidate 23, DECISIONS 47 item 1): PS1 (IRM-20-15, SELV 15 V for the controller) is deleted. The
    # controller logic runs from the chassis PS3 (MEAN WELL MPM-65-15ST) over the controller's J13, merged into its
    # logic rail there (c23-supply-topology/CONTROLLER-REQUEST.md); this board no longer has a mains-to-SELV supply.
    # Gate-driver supply through the off-board thermal-cutoff loop: an open
    # TCO removes all gate drive, the HOT 5 V rail and the OCP "OK" signal.
    j_tco = new TcoLoopHeader
    j_tco.p1 ~ L_FILT
    j_tco.p2 ~ TCO_L
    # Blower-supply mains tap (stage 16): F2 (3.15 A T) feeds J11, a fused branch to the chassis-mounted
    # PS3 (Mean Well IRM-60-15ST) whose 15 V runs the controller's blower buck, so blower start or stall
    # cannot brown out the controller logic (DECISIONS 15-16; since stage 38 PS3 also feeds that logic, merged on the
    # controller behind its own J13 isolation, so the blower transient stays off the logic rail).
    f_blw = new BranchFuseT3A15
    f_blw.p1 ~ L_FILT
    f_blw.p2 ~ BLW_L
    # Stage 28 (DECISIONS 30, F4): a 0.15 ohm limiter after F2 bounds the J11 fault current to 784 A
    r_blw = new BranchLimiter0R15
    r_blw.p1 ~ BLW_L
    r_blw.p2 ~ BLW_LR
    j_blw_ac = new MainsTapHeader
    j_blw_ac.p1 ~ BLW_LR
    j_blw_ac.p2 ~ N_FILT
    ps_gate = new HotSupply24
    ps_gate.ACL ~ TCO_L
    ps_gate.ACN ~ N_FILT
    ps_gate.VP ~ V24_RAW
    ps_gate.VN ~ N_LS
    c_v15 = new C10u1210
    c_v15.value = 10uF
    c_v15.p1 ~ V15_LS
    c_v15.p2 ~ N_LS
    u_ldo = new HotLdo
    u_ldo.IN ~ V15_LS
    u_ldo.EN ~ V15_LS
    u_ldo.GND ~ OCP_KELVIN_P
    u_ldo.OUT ~ HOT5
    c_ldo_in = new C100n0603
    c_ldo_in.value = 100nF
    c_ldo_in.p1 ~ V15_LS
    c_ldo_in.p2 ~ OCP_KELVIN_P
    c_ldo_out = new C10u1210
    c_ldo_out.value = 10uF
    c_ldo_out.p1 ~ HOT5
    c_ldo_out.p2 ~ OCP_KELVIN_P

    # ---------------- bus voltage sense: 1.88 M / 15.8 k = 1/120
    r_div1 = new R470k1206
    r_div1.value = 470kohm
    r_div1.p1 ~ BUS_P
    r_div1.p2 ~ VDIV_1
    r_div2 = new R470k1206
    r_div2.value = 470kohm
    r_div2.p1 ~ VDIV_1
    r_div2.p2 ~ VDIV_2
    r_div3 = new R470k1206
    r_div3.value = 470kohm
    r_div3.p1 ~ VDIV_2
    r_div3.p2 ~ VDIV_3
    r_div4 = new R470k1206
    r_div4.value = 470kohm
    r_div4.p1 ~ VDIV_3
    r_div4.p2 ~ VSENSE_IN
    r_div_bot = new R15k8Thin
    r_div_bot.value = 15.8kohm
    r_div_bot.p1 ~ VSENSE_IN
    r_div_bot.p2 ~ OCP_KELVIN_P
    c_div = new C1nC0G0603
    c_div.value = 1nF
    c_div.p1 ~ VSENSE_IN
    c_div.p2 ~ OCP_KELVIN_P
    u_vsense = new Amc1311
    u_vsense.VDD1 ~ HOT5
    u_vsense.GND1 ~ OCP_KELVIN_P
    u_vsense.VINP ~ VSENSE_IN
    u_vsense.SHTDN ~ OCP_KELVIN_P
    u_vsense.VDD2 ~ V3V3
    u_vsense.GND2 ~ SELV_GND
    u_vsense.VOUTP ~ VBUS_P
    u_vsense.VOUTN ~ VBUS_N
    c_vs1 = new C100n0603
    c_vs1.value = 100nF
    c_vs1.p1 ~ HOT5
    c_vs1.p2 ~ OCP_KELVIN_P
    c_vs2 = new C100n0603
    c_vs2.value = 100nF
    c_vs2.p1 ~ V3V3
    c_vs2.p2 ~ SELV_GND
    # AMC1311 SBAS786C (rev. Jun 2022) section 10: each supply is "decoupled with a low-ESR, 100-nF
    # capacitor ... parallel to a low-ESR, 1-uF capacitor" (closure review M1, stage 10)
    c_vs1_1u = new C1u0805
    c_vs1_1u.value = 1uF
    c_vs1_1u.p1 ~ HOT5
    c_vs1_1u.p2 ~ OCP_KELVIN_P
    c_vs2_1u = new C1u0805
    c_vs2_1u.value = 1uF
    c_vs2_1u.p1 ~ V3V3
    c_vs2_1u.p2 ~ SELV_GND

    # ---------------- DC-bus OCP (shoot-through), referenced to LEG_RET.
    # V(OCP_KELVIN_N) = -I*1 mohm. OCP_NODE = 1.25 V + 0.5 * V(KELVIN_N);
    # OCP_THRESH = 2.5 * 11.7/(12.6+11.7) = 1.2037 V -> trip at ~93 A nominal
    # (stage 15, 28 A hardware, DECISIONS 2026-10-10: corner band 68.58-118.74 A with 12.6k/11.7k,
    # 66.30 A low corner after the Kelvin shift; was 12.4k, 49.53-97.77 A)
    # (TLV3201 offset +/-5 mV max = +/-10 A; envelope peak <= 59.2 A at the 28 A ceiling). The lower
    # trip reduces risk; returned tank energy is not bounded: ORACLE-REVIEW.md.
    # Comparator output high = OK. NAND + default-HIGH isolation make
    # BUS_FAULT high on either trip or complete HOT-side power loss.
    r_ref_bias = new R5k6Bias
    r_ref_bias.value = 5.6kohm
    r_ref_bias.p1 ~ HOT5
    r_ref_bias.p2 ~ REF25
    u_ref = new Ref2V5
    u_ref.K ~ REF25
    u_ref.A ~ OCP_KELVIN_P
    r_ocp_ref = new R10kThin
    r_ocp_ref.value = 10kohm
    r_ocp_ref.p1 ~ REF25
    r_ocp_ref.p2 ~ OCP_NODE
    r_ocp_sense = new R10kThin
    r_ocp_sense.value = 10kohm
    r_ocp_sense.p1 ~ OCP_NODE
    r_ocp_sense.p2 ~ OCP_KELVIN_N
    c_ocp_node = new C100pC0G0603
    c_ocp_node.value = 100pF
    c_ocp_node.p1 ~ OCP_NODE
    c_ocp_node.p2 ~ OCP_KELVIN_P
    r_th_top = new R12k6Thin
    r_th_top.value = 12.6kohm
    r_th_top.p1 ~ REF25
    r_th_top.p2 ~ OCP_THRESH
    r_th_bot = new R11k7Thin
    r_th_bot.value = 11.7kohm
    r_th_bot.p1 ~ OCP_THRESH
    r_th_bot.p2 ~ OCP_KELVIN_P
    c_th = new C1nC0G0603
    c_th.value = 1nF
    c_th.p1 ~ OCP_THRESH
    c_th.p2 ~ OCP_KELVIN_P
    u_ocp = new Tlv3201
    u_ocp.VCC ~ HOT5
    u_ocp.GND ~ OCP_KELVIN_P
    u_ocp.INP ~ OCP_NODE
    u_ocp.INN ~ OCP_THRESH
    u_ocp.OUT ~ OCP_OK_HOT
    c_ocp_vcc = new C100n0603
    c_ocp_vcc.value = 100nF
    c_ocp_vcc.p1 ~ HOT5
    c_ocp_vcc.p2 ~ OCP_KELVIN_P
    # Bus OVP: VSENSE_IN = Vbus/120 vs 2.5 * 140/150 = 2.333 V -> ~280 V.
    # Output high = OK. Hardware restart inhibit through the controller latch.
    r_ovp_top = new R10kThin
    r_ovp_top.value = 10kohm
    r_ovp_top.p1 ~ REF25
    r_ovp_top.p2 ~ OVP_THRESH
    r_ovp_bot = new R140kThin
    r_ovp_bot.value = 140kohm
    r_ovp_bot.p1 ~ OVP_THRESH
    r_ovp_bot.p2 ~ OCP_KELVIN_P
    c_ovp_th = new C1nC0G0603
    c_ovp_th.value = 1nF
    c_ovp_th.p1 ~ OVP_THRESH
    c_ovp_th.p2 ~ OCP_KELVIN_P
    u_ovp = new Tlv3201
    u_ovp.VCC ~ HOT5
    u_ovp.GND ~ OCP_KELVIN_P
    u_ovp.INP ~ OVP_THRESH
    u_ovp.INN ~ VSENSE_IN
    u_ovp.OUT ~ OVP_OK_HOT
    c_ovp_vcc = new C100n0603
    c_ovp_vcc.value = 100nF
    c_ovp_vcc.p1 ~ HOT5
    c_ovp_vcc.p2 ~ OCP_KELVIN_P
    # BUS_FAULT_HOT = NOT(OCP_OK_HOT AND OVP_OK_HOT AND HOT5_OK_HOT).
    # Healthy = low; either trip = high. CA-IS3720HW (H suffix; ISO7710 before stage 31) defaults high
    # on input-side power loss while the SELV output supply remains valid.
    u_nand = new Nand3Lvc1g10
    u_nand.A ~ OCP_OK_HOT
    u_nand.B ~ OVP_OK_HOT
    u_nand.C ~ HOT5_OK_HOT
    u_nand.Y ~ BUS_FAULT_HOT
    u_nand.VCC ~ HOT5
    u_nand.GND ~ OCP_KELVIN_P
    c_nand_vcc = new C100n0603
    c_nand_vcc.value = 100nF
    c_nand_vcc.p1 ~ HOT5
    c_nand_vcc.p2 ~ OCP_KELVIN_P
    u_iso = new IsoReinfH
    u_iso.VCC1 ~ HOT5
    u_iso.GND1 ~ OCP_KELVIN_P
    u_iso.GND1B ~ OCP_KELVIN_P
    u_iso.IN ~ BUS_FAULT_HOT
    u_iso.VCC2 ~ V3V3
    u_iso.GND2 ~ SELV_GND
    u_iso.GND2B ~ SELV_GND
    u_iso.OUT ~ BUS_FAULT_ISO
    c_iso1 = new C100n0603
    c_iso1.value = 100nF
    c_iso1.p1 ~ HOT5
    c_iso1.p2 ~ OCP_KELVIN_P
    c_iso2 = new C100n0603
    c_iso2.value = 100nF
    c_iso2.p1 ~ V3V3
    c_iso2.p2 ~ SELV_GND

    # ---------------- SELV controller header (Micro-Fit 2x8)
    j_selv = new SelvHeader16
    # pin 1 (was V15_SELV from PS1) is not connected since stage 38; the J4 re-pin (g06-g08-g10 P5) is separate
    j_selv.p1 ~ J4_NC1
    j_selv.p2 ~ SELV_GND
    j_selv.p3 ~ V3V3
    j_selv.p4 ~ SELV_GND
    j_selv.p5 ~ PWM_HA
    j_selv.p6 ~ PWM_LA
    j_selv.p7 ~ PWM_HB
    j_selv.p8 ~ PWM_LB
    j_selv.p9 ~ PERMIT
    j_selv.p10 ~ BUS_FAULT
    j_selv.p11 ~ VBUS_P
    j_selv.p12 ~ VBUS_N
    j_selv.p13 ~ CT_ZC
    j_selv.p14 ~ CT_MON
    j_selv.p15 ~ SELV_GND
    j_selv.p16 ~ LINE_ZC

    # D5 functional earth: place beside the separate PCB PE branch terminal. This link is
    # not protective earthing. Reinforced isolation remains required with
    # PE open; SELV_GND is the historical name of the earthed ELV return.
    r_fe = new FunctionalEarthLink
    r_fe.value = 0ohm
    r_fe.p1 ~ PE
    r_fe.p2 ~ SELV_GND

    # Place the bidirectional TVS at the DC-link capacitor terminals. This
    # source join specifies protection topology, not the surge/energy rating
    # of the assembled commutation loop.
    # Stage 14: two 30KPA150CA in series; the string midpoint is the R3/R4 bleed midpoint, which
    # also equalises their leakage (ALT-D3 2.4).
    tvs_bus = new BusTvs30kpa150
    tvs_bus.p1 ~ BUS_P
    tvs_bus.p2 ~ BUSBLEED_MID
    tvs_bus_b = new BusTvs30kpa150
    tvs_bus_b.p1 ~ BUSBLEED_MID
    tvs_bus_b.p2 ~ HV_RET

    # Separate coil return stud; external coil connects j_coil to this stud.
    j_coil_return = new PowerTerminalM4
    j_coil_return.p1 ~ RES_A
    j_pe = new PeBranchTerminal
    j_pe.p1 ~ PE
    j_pe.p2 ~ PE

    # Two local capacitors per leg. HV_RET preserves shoot-through sensing;
    # LEG_RET would bypass the shunt. Keep the shunt power path short/wide.
    c_hf_a1 = new LocalBus100n
    c_hf_a1.p1 ~ BUS_P
    c_hf_a1.p2 ~ HV_RET
    c_hf_a2 = new LocalBus100n
    c_hf_a2.p1 ~ BUS_P
    c_hf_a2.p2 ~ HV_RET
    c_hf_b1 = new LocalBus100n
    c_hf_b1.p1 ~ BUS_P
    c_hf_b1.p2 ~ HV_RET
    c_hf_b2 = new LocalBus100n
    c_hf_b2.p1 ~ BUS_P
    c_hf_b2.p2 ~ HV_RET


    # ---------------- tank-CT detector (SELV), at T1
    # Kept last in the module so existing designators do not renumber.
    # T1's secondary is terminated here and never crosses the connector: an
    # open CT secondary spikes to hundreds of volts on SELV pins
    # (validation-results/06-controller-interface). Ported from
    # zapote/current-sense/circuit/current_sense_unit.ato: floating burden (3.0 ohm
    # with the 1:200 CT from stage 20; 1.5 ohm with the 1:100 part, same 0.015 V/A) around a bypassed 1.65 V midpoint (CT_S2), 1 k series input with
    # low-leakage BAS116H rail clamps, and a comparator per polarity. References 2.21k/10k
    # put the tank over-current trip at ~70 A (corner band 64.55-76.09 A, stage 15 28 A
    # hardware, DECISIONS 2026-10-10; was 3.32k, ~55 A). A third comparator gives the zero crossing; the
    # biased current waveform leaves through 1 k. The trip ORs with the
    # isolated bus fault onto the existing active-high BUS_FAULT line.
    r_ct_burden = new Burden3R0
    r_ct_burden.value = 3.0ohm
    r_ct_burden.p1 ~ CT_S1
    r_ct_burden.p2 ~ CT_S2
    c_ct_burden = new C100nC0G1206
    c_ct_burden.value = 100nF
    c_ct_burden.p1 ~ CT_S1
    c_ct_burden.p2 ~ CT_S2
    r_ct_bias_top = new R1kThin
    r_ct_bias_top.value = 1kohm
    r_ct_bias_top.p1 ~ V3V3
    r_ct_bias_top.p2 ~ CT_S2
    r_ct_bias_bot = new R1kThin
    r_ct_bias_bot.value = 1kohm
    r_ct_bias_bot.p1 ~ CT_S2
    r_ct_bias_bot.p2 ~ SELV_GND
    c_ct_bias = new C100nC0G1206
    c_ct_bias.value = 100nF
    c_ct_bias.p1 ~ CT_S2
    c_ct_bias.p2 ~ SELV_GND
    r_ct_series = new R1k1206
    r_ct_series.value = 1kohm
    r_ct_series.p1 ~ CT_S1
    r_ct_series.p2 ~ CT_SENSE_MON
    d_ct_hi = new ClampBas116h
    d_ct_hi.A ~ CT_SENSE_MON
    d_ct_hi.K ~ V3V3
    d_ct_lo = new ClampBas116h
    d_ct_lo.A ~ SELV_GND
    d_ct_lo.K ~ CT_SENSE_MON
    r_ct_hi_top = new R2k21Thin
    r_ct_hi_top.value = 2.21kohm
    r_ct_hi_top.p1 ~ V3V3
    r_ct_hi_top.p2 ~ CT_REF_HI
    r_ct_hi_bot = new R10kThin
    r_ct_hi_bot.value = 10kohm
    r_ct_hi_bot.p1 ~ CT_REF_HI
    r_ct_hi_bot.p2 ~ SELV_GND
    r_ct_lo_top = new R10kThin
    r_ct_lo_top.value = 10kohm
    r_ct_lo_top.p1 ~ V3V3
    r_ct_lo_top.p2 ~ CT_REF_LO
    r_ct_lo_bot = new R2k21Thin
    r_ct_lo_bot.value = 2.21kohm
    r_ct_lo_bot.p1 ~ CT_REF_LO
    r_ct_lo_bot.p2 ~ SELV_GND
    u_ct_pos = new Tlv3201
    u_ct_pos.INP ~ CT_SENSE_MON
    u_ct_pos.INN ~ CT_REF_HI
    u_ct_pos.OUT ~ CT_OC_POS
    u_ct_pos.VCC ~ V3V3
    u_ct_pos.GND ~ SELV_GND
    c_ct_pos = new C100n0603
    c_ct_pos.value = 100nF
    c_ct_pos.p1 ~ V3V3
    c_ct_pos.p2 ~ SELV_GND
    u_ct_neg = new Tlv3201
    u_ct_neg.INP ~ CT_REF_LO
    u_ct_neg.INN ~ CT_SENSE_MON
    u_ct_neg.OUT ~ CT_OC_NEG
    u_ct_neg.VCC ~ V3V3
    u_ct_neg.GND ~ SELV_GND
    c_ct_neg = new C100n0603
    c_ct_neg.value = 100nF
    c_ct_neg.p1 ~ V3V3
    c_ct_neg.p2 ~ SELV_GND
    u_ct_zc = new Tlv3201
    u_ct_zc.INP ~ CT_SENSE_MON
    u_ct_zc.INN ~ CT_S2
    u_ct_zc.OUT ~ CT_ZC
    u_ct_zc.VCC ~ V3V3
    u_ct_zc.GND ~ SELV_GND
    c_ct_zc = new C100n0603
    c_ct_zc.value = 100nF
    c_ct_zc.p1 ~ V3V3
    c_ct_zc.p2 ~ SELV_GND
    u_fault_or = new Or3Lvc1g332
    u_fault_or.A ~ BUS_FAULT_FLT
    # Stage 30 (DECISIONS 32/33): 1 k / 100 pF between U9 and U13.A. U9's CMTI upset (ns-wide) can no longer
    # reach the controller's asynchronous permit-latch CLR as a nuisance trip; it adds ~0.1 us to a ~1 us OCP chain.
    r_bf = new R1k0603
    r_bf.value = 1kohm
    r_bf.p1 ~ BUS_FAULT_ISO
    r_bf.p2 ~ BUS_FAULT_FLT
    c_bf = new C100pC0G0603
    c_bf.value = 100pF
    c_bf.p1 ~ BUS_FAULT_FLT
    c_bf.p2 ~ SELV_GND
    u_fault_or.B ~ CT_OC_POS
    u_fault_or.C ~ CT_OC_NEG
    u_fault_or.Y ~ BUS_FAULT
    u_fault_or.VCC ~ V3V3
    u_fault_or.GND ~ SELV_GND
    c_fault_or = new C100n0603
    c_fault_or.value = 100nF
    c_fault_or.p1 ~ V3V3
    c_fault_or.p2 ~ SELV_GND
    # Stage 19b (DECISIONS 19b): v3v3 <-> selv_gnd reference-transfer caps, one beside each layer change of
    # pwm_hb between the SELV row and J4 (its F.Cu runs are referenced to the In1 v3v3 pour, its B.Cu runs to the
    # In2 selv_gnd pour; the return current crosses between them here instead of 5-53 mm away).
    c_ref_xfer_1 = new C100n0603
    c_ref_xfer_1.value = 100nF
    c_ref_xfer_1.p1 ~ V3V3
    c_ref_xfer_1.p2 ~ SELV_GND
    c_ref_xfer_2 = new C100n0603
    c_ref_xfer_2.value = 100nF
    c_ref_xfer_2.p1 ~ V3V3
    c_ref_xfer_2.p2 ~ SELV_GND
    c_ref_xfer_3 = new C100n0603
    c_ref_xfer_3.value = 100nF
    c_ref_xfer_3.p1 ~ V3V3
    c_ref_xfer_3.p2 ~ SELV_GND
    c_ref_xfer_4 = new C100n0603
    c_ref_xfer_4.value = 100nF
    c_ref_xfer_4.p1 ~ V3V3
    c_ref_xfer_4.p2 ~ SELV_GND
    # Stage 40 (candidate 30a): pwm_hb's B.Cu -> F.Cu change at the old HS-B verdict pocket was served by that
    # isolator's SELV-side decoupler (2.0 mm); with the isolator gone a fifth transfer cap takes its place.
    c_ref_xfer_5 = new C100n0603
    c_ref_xfer_5.value = 100nF
    c_ref_xfer_5.p1 ~ V3V3
    c_ref_xfer_5.p2 ~ SELV_GND
    # Stage 44 (candidate 44, SELV-spine lane; OPEN-ITEMS S10): one transfer cap beside each SELV return-path open
    # change of the slow SELV lines (PERMIT, BUS_FAULT, BUS_FAULT_ISO, BIAS_GOOD), whose F.Cu runs ride the In1 v3v3
    # pour and B.Cu runs the In2 selv_gnd pour: PERMIT at its leg-B drop, its leg-A drop and J4; BUS_FAULT at U13;
    # BUS_FAULT_ISO at its B.Cu -> F.Cu change; BIAS_GOOD at its leg-A and leg-B drops.
    c_ref_xfer_6 = new C100n0603
    c_ref_xfer_6.value = 100nF
    c_ref_xfer_6.p1 ~ V3V3
    c_ref_xfer_6.p2 ~ SELV_GND
    c_ref_xfer_7 = new C100n0603
    c_ref_xfer_7.value = 100nF
    c_ref_xfer_7.p1 ~ V3V3
    c_ref_xfer_7.p2 ~ SELV_GND
    c_ref_xfer_8 = new C100n0603
    c_ref_xfer_8.value = 100nF
    c_ref_xfer_8.p1 ~ V3V3
    c_ref_xfer_8.p2 ~ SELV_GND
    c_ref_xfer_9 = new C100n0603
    c_ref_xfer_9.value = 100nF
    c_ref_xfer_9.p1 ~ V3V3
    c_ref_xfer_9.p2 ~ SELV_GND
    c_ref_xfer_10 = new C100n0603
    c_ref_xfer_10.value = 100nF
    c_ref_xfer_10.p1 ~ V3V3
    c_ref_xfer_10.p2 ~ SELV_GND
    c_ref_xfer_11 = new C100n0603
    c_ref_xfer_11.value = 100nF
    c_ref_xfer_11.p1 ~ V3V3
    c_ref_xfer_11.p2 ~ SELV_GND
    c_ref_xfer_12 = new C100n0603
    c_ref_xfer_12.value = 100nF
    c_ref_xfer_12.p1 ~ V3V3
    c_ref_xfer_12.p2 ~ SELV_GND
    r_ct_mon = new R1k0603
    r_ct_mon.value = 1kohm
    r_ct_mon.p1 ~ CT_SENSE_MON
    r_ct_mon.p2 ~ CT_MON

    # Append the new HOT5 circuit after all previously established devices.
    # This preserves their reference designators in the frozen netlist and
    # native18 integration baseline. The nets above may be joined later.
    # TPS3700 uses V15_LS independently of the HOT5 rail it measures.
    u_hot5_uv = new Hot5Supervisor
    u_hot5_uv.VDD ~ V15_LS
    u_hot5_uv.GND ~ OCP_KELVIN_P
    u_hot5_uv.INA ~ HOT5_UV_SENSE
    u_hot5_uv.INB ~ OCP_KELVIN_P
    u_hot5_uv.OUTA ~ HOT5_UV_RAW
    r_hot5_uv_top = new R105kThin
    r_hot5_uv_top.value = 105kohm
    r_hot5_uv_top.p1 ~ HOT5
    r_hot5_uv_top.p2 ~ HOT5_UV_SENSE
    r_hot5_uv_bot = new R10kThin
    r_hot5_uv_bot.value = 10kohm
    r_hot5_uv_bot.p1 ~ HOT5_UV_SENSE
    r_hot5_uv_bot.p2 ~ OCP_KELVIN_P
    r_hot5_uv_pull = new R10kThin
    r_hot5_uv_pull.value = 10kohm
    r_hot5_uv_pull.p1 ~ HOT5
    r_hot5_uv_pull.p2 ~ HOT5_UV_RAW
    c_hot5_uv = new C100n0603
    c_hot5_uv.value = 100nF
    c_hot5_uv.p1 ~ V15_LS
    c_hot5_uv.p2 ~ OCP_KELVIN_P
    u_hot5_schmitt = new Hot5SchmittBuffer
    u_hot5_schmitt.VCC ~ HOT5
    u_hot5_schmitt.GND ~ OCP_KELVIN_P
    u_hot5_schmitt.A ~ HOT5_UV_RAW
    u_hot5_schmitt.Y ~ HOT5_OK_HOT
    c_hot5_schmitt = new C100n0603
    c_hot5_schmitt.value = 100nF
    c_hot5_schmitt.p1 ~ HOT5
    c_hot5_schmitt.p2 ~ OCP_KELVIN_P

    # D-33 HOT bias; PS2 negative is N_LS, shunt midpoint is LEG_RET.
    bias_ls = new RegulatedSplit
    bias_ls.raw ~ V24_RAW
    bias_ls.p ~ V15_LS
    bias_ls.n ~ N_LS
    bias_ls.src ~ LEG_RET
    monitor_ls = new RailMonitor
    monitor_ls.src ~ LEG_RET
    monitor_ls.p ~ V15_LS
    monitor_ls.n ~ N_LS
    # Stage 14: the SN6507 / T2 / T3 push-pull is replaced by one isolated module per high side
    # (f6_bias.ato HighBias), each with its own enable divider.
    bias_ha = new HighBiasLink
    bias_ha.p ~ P_HA
    bias_ha.n ~ N_HA
    bias_ha.raw24 ~ V24_RAW
    bias_ha.nls ~ N_LS
    bias_ha.src ~ SW_A
    bias_ha.ls_v5 ~ monitor_ls.v5
    bias_ha.good_ls ~ MON_GOOD_HA
    # Stage 40 (candidate 30a): HS-B crosses to LS on its own ISO6721FB link, as HS-A does (M1b as drawn).
    bias_hb = new HighBiasLink
    bias_hb.p ~ P_HB
    bias_hb.n ~ N_HB
    bias_hb.raw24 ~ V24_RAW
    bias_hb.nls ~ N_LS
    bias_hb.src ~ SW_B
    bias_hb.ls_v5 ~ monitor_ls.v5
    bias_hb.good_ls ~ MON_GOOD_HB
    # Stage 30 (DECISIONS 33, candidate 24): the LS and HS-A verdicts meet in the LS domain and cross to SELV as a
    # heartbeat (f6_bias.ato Heartbeat); since stage 40 HS-B's joins the LS vote too (its ISO6721FB link, D20). U25 (OR3), its 100 nF and the 10 us RC (R126 / C143) are gone; U40 becomes a
    # non-inverting G17 on the pump's hold node, still the only driver of BIAS_GOOD.
    hb = new Heartbeat
    hb.ls_v5 ~ monitor_ls.v5
    hb.nls ~ N_LS
    hb.good ~ monitor_ls.good
    hb.ha ~ MON_GOOD_HA
    hb.hb ~ MON_GOOD_HB
    hb.gate ~ HSB_GOOD
    hb.v3v3 ~ V3V3
    hb.selv_gnd ~ SELV_GND
    u_bias_flt = new SchmittBuf17
    u_bias_flt.A ~ hb.hb_hold
    u_bias_flt.Y ~ BIAS_GOOD
    u_bias_flt.VCC ~ V3V3
    u_bias_flt.GND ~ SELV_GND
    c_bias_flt_vcc = new C100n0603
    c_bias_flt_vcc.value = 100nF
    c_bias_flt_vcc.p1 ~ V3V3
    c_bias_flt_vcc.p2 ~ SELV_GND
    line_zc = new LineZeroCross
    line_zc.line ~ L_FILT
    line_zc.neutral ~ N_FILT
    line_zc.selv_v ~ V3V3
    line_zc.selv_gnd ~ SELV_GND
    line_zc.out ~ LINE_ZC

    # Preserve native-20 designators; removed bootstrap references stay vacant.
    j_mains.designator = "J1"
    f1.designator = "F1"
    rv1.designator = "RV1"
    cx1.designator = "C1"
    cx2.designator = "C2"
    rb1a.designator = "R1"
    rb1b.designator = "R2"
    r_bus1.designator = "R3"
    r_bus2.designator = "R4"
    leg_a.r_gh.designator = "R10"
    leg_a.r_gl.designator = "R12"
    leg_b.r_gh.designator = "R18"
    leg_b.r_gl.designator = "R20"
    r_crb1.designator = "R22"
    r_crb2.designator = "R23"
    r_crb3.designator = "R24"
