component DisNand:
    """Stage 22 (DECISIONS 27): DIS = NAND(permit_gate, BIAS_GOOD), replacing the AO3400A inverter + 330 ohm pull-up and the
    LVC1G32 OR. Same SOT-23-5 pinout as the G32 it replaces (A1 B2 GND3 Y4 VCC5)."""
    designator_prefix = "U"
    mpn = "SN74LVC1G00DBVR"
    manufacturer = "Texas Instruments"
    footprint = "Package_TO_SOT_SMD:SOT-23-5"
    signal A ~ pin 1
    signal B ~ pin 2
    signal GND ~ pin 3
    signal Y ~ pin 4
    signal VCC ~ pin 5

component BiasGoodSchmitt:
    """Stage 22: inverting Schmitt (SN74LVC1G14DBVR) after the 10 us BIAS_BAD filter; output BIAS_GOOD feeds the DIS NANDs.
    DBV pins NC1, A2, GND3, Y4, VCC5, as the LVC1G17 it replaces."""
    designator_prefix = "U"
    mpn = "SN74LVC1G14DBVR"
    manufacturer = "Texas Instruments"
    footprint = "Package_TO_SOT_SMD:SOT-23-5"
    signal NC ~ pin 1
    signal A ~ pin 2
    signal GND ~ pin 3
    signal Y ~ pin 4
    signal VCC ~ pin 5

component LineOpto:
    designator_prefix = "U"
    mpn = "VOL628A-2X001T"   # stage 20: CTR bin -2 (63-125 %), stocked; same LSOP-4 / VDE option (DECISIONS 23)
    manufacturer = "Vishay"
    footprint = "temper:VOL628A_LSOP4_ReviewOnly"
    signal AC1 ~ pin 1
    signal AC2 ~ pin 2
    signal E ~ pin 3
    signal C ~ pin 4

component IsoBiasModule:
    """RECOM R24C2T25/R-R isolated gate-drive bias module (stage 14, DECISIONS 2026-10-09; ALT-BIAS option A1).
    21-27 V in, single 17 V output (FBVOUT- tied to FBVOUT+, COM open; R24C2T25/R Rev.1-2024 p.4),
    2 W, reinforced 5 kVAC / 1.4 kVDC working, Cio 3.5 pF max, CMTI 150 kV/us, 36-SSOP 12.83 x 7.5 mm.
    Pins (p.12): 1,2,5,8-18 PGND; 3 PG; 4 CTRL; 6 AVIN; 7 PVIN; 19-27,30,31,36 VOUT-; 28,29 VOUT+;
    32 COM; 33 FBVOUT-; 34 FBVOUT+; 35 FBCOM. Pin-compatible second source TI UCC14241QDWNRQ1."""
    designator_prefix = "U"
    mpn = "R24C2T25/R-R"
    manufacturer = "RECOM"
    footprint = "temper:RECOM_SSOP-36_7.5x12.83mm_P0.65mm_ReviewOnly"
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
