+    g_pb = 1.0 / (1.0 / (p["pin_k"] * TERM_PIN_A / (p["pin_l_mm"] * 1e-3)) + p["r_b_kw"])
+    pw = i_a ** 2 * p["r_pole_mohm"] * 1e-3
+    return (pw + g_pb * t_p0 + g_cord * t_inf + p["g_h"] * t_hous) / (g_pb + g_cord + p["g_h"])
