# Parts new to the integrated SELV controller. Ported blocks (interlock,
# thermal-sense, RTD) keep their own component definitions unchanged.
#
# Every part below was checked against its datasheet (pin numbers quoted in
# the docstring) and the JLC/LCSC catalogue on 2026-10-08. LCSC codes and the
# datasheet basis are tabulated in ../../bom/controller-parts.json; that table
# is what tools/verify_controller.py checks every resolved MPN against.

# ------------------------------------------------------------------ MCU

component Esp32S3Wroom1UN8:
    """Espressif ESP32-S3-WROOM-1U-N8 (8 MB quad flash, no PSRAM, U.FL antenna connector),
    LCSC C2980297. Enclosure R33: the antenna is an off-board 2450AT18A100 chip-antenna
    board on a 150 mm 1.13 mm coax, so there is no on-board antenna or keep-out.
    Pin numbers: ESP32-S3-WROOM-1 & -1U datasheet v1.8, Table 3-1 (the -1 and -1U share
    the 41-pin pinout, pin 41 = EPAD = GND). No octal PSRAM, so IO35/36/37 are free (note b)."""
    designator_prefix = "U"
    mpn = "ESP32-S3-WROOM-1U-N8"
    manufacturer = "Espressif Systems"
    footprint = "RF_Module:ESP32-S3-WROOM-1U"
    signal GND1 ~ pin 1
    signal V3V3 ~ pin 2
    signal EN ~ pin 3
    signal IO4 ~ pin 4
    signal IO5 ~ pin 5
    signal IO6 ~ pin 6
    signal IO7 ~ pin 7
    signal IO15 ~ pin 8
    signal IO16 ~ pin 9
    signal IO17 ~ pin 10
    signal IO18 ~ pin 11
    signal IO8 ~ pin 12
    signal IO19 ~ pin 13
    signal IO20 ~ pin 14
    signal IO3 ~ pin 15
    signal IO46 ~ pin 16
    signal IO9 ~ pin 17
    signal IO10 ~ pin 18
    signal IO11 ~ pin 19
    signal IO12 ~ pin 20
    signal IO13 ~ pin 21
    signal IO14 ~ pin 22
    signal IO21 ~ pin 23
    signal IO47 ~ pin 24
    signal IO48 ~ pin 25
    signal IO45 ~ pin 26
    signal IO0 ~ pin 27
    signal IO35 ~ pin 28
    signal IO36 ~ pin 29
    signal IO37 ~ pin 30
    signal IO38 ~ pin 31
    signal IO39 ~ pin 32
    signal IO40 ~ pin 33
    signal IO41 ~ pin 34
    signal IO42 ~ pin 35
    signal RXD0 ~ pin 36
    signal TXD0 ~ pin 37
    signal IO2 ~ pin 38
    signal IO1 ~ pin 39
    signal GND40 ~ pin 40
    signal EPAD ~ pin 41

