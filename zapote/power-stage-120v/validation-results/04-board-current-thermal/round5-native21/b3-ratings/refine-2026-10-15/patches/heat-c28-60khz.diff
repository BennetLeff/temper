+E_F = Q_DECK * SWING * F_WIN                                     # W of gate drive per FET
+
+
+def gate_split():
+    on = 0.95 + 8.2 + 2.7
+    vf = Q_DECK * 0.35 / (0.5 * Q_DECK * SWING)                 # diode forward-drop share of the turn-off energy
+    rbr = 1.0 + 0.1
+    rpar = 8.2 * rbr / (8.2 + rbr)
+    tot, res = 2.7 + rpar + 0.39, 1.0 - vf
