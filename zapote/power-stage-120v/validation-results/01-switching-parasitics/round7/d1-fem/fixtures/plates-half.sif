! Upper z-half of the 1 A plate fixture, mirrored at z=0.25 mm.
! K_z = 100 A/m across 10 mm width => full-loop I=1 A.
! Solve E_half, then L_full = 4 E_half / I^2; compare matched full mesh first.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "raw/fixtures/plates-half-box0p4-far12-m20-elmer"
  Results Directory "raw/fixtures/plates-half-box0p4-far12-m20-elmer"
End
Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Max Output Level = 5
End
Constants
  Permeability of Vacuum = 1.2566370614359173e-6
End
Body 1
  Target Bodies(1) = 1
  Name = "Air"
  Equation = 1
  Material = 1
End
Material 1
  Name = "Air"
  Relative Permeability = 1.0
  Relative Permittivity = 1.0
  Electric Conductivity = 0.0
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Edge Basis = Logical True
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End
Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Magnetic Field Strength = Logical True
  Calculate Elemental Fields = Logical True
  Separate Magnetic Energy = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1e-9
End
Boundary Condition 1
  Name = "Upper PEC plate, short, far field and magnetic symmetry plane"
  Target Boundaries(1) = 2
  AV {e} = Real 0.0
End
Boundary Condition 2
  Name = "1 A uniform current sheet at y=50 mm"
  Target Boundaries(1) = 3
  Magnetic Field Strength 1 = Real 0.0
  Magnetic Field Strength 2 = Real 0.0
  Magnetic Field Strength 3 = Real 100.0
End
