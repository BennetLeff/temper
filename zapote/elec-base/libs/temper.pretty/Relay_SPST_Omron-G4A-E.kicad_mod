	(pad "A1" thru_hole circle
		(at -3.175 0)
		(size 1.8 1.8)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
		(uuid "b8a2c020-0000-0000-0000-000000000001")
	)
	(pad "A2" thru_hole circle
