		(size 6.35 1.2)
		(layers "F.Fab")
		(uuid "b8a2c041-0000-0000-0000-000000000001")
	)
	;; Mounting/locating holes (NPTH, no net) -- 22mm x 12mm(6.25/5.75 asymmetric) pattern, datasheet-derived
	(pad "" np_thru_hole circle
		(at -11.0 5.75)
