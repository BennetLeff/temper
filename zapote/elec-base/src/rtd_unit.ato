# Standalone RTD unit build entry. The cooker Top entry remains separate.
# Circuit implementation stays in modules.ato; this file owns the carrier interface.
#
# The connector is a Samtec FTSH-105-01-F-D, 10 position, 2-row, 1.27 mm
# through-hole header.  The footprint is supplied beside this proposal under
# pcb/libs/Temper_RTD.pretty. Physical testing remains NOT RUN.

import RTDSensing from "modules.ato"
import ElectricPower from "generics/interfaces.ato"
import SPI from "generics/interfaces.ato"
import ElectricLogic from "generics/interfaces.ato"

component FTSH_105_01_F_D:
    """Samtec FTSH-105-01-F-D, 10-pin 2x5 1.27 mm THT boundary header.

    Pin numbers follow the manufacturer's pin-1 numbered view.  The mating host
    endpoint is deliberately outside this unit proposal.
    """
    designator_prefix = "J"
    footprint = "Temper_RTD:FTSH-105-01-F-D_2x5_P1.27mm"
    mpn = "FTSH-105-01-F-D"
    manufacturer = "Samtec"

    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10

module RTDUnit:
    """Standalone RTD sensing unit with an explicit 2x5 host boundary.

    `rtd_pan` preserves the existing RTDSensing instance identity.  `unit_io`
    is a passive boundary only; this source does not invent an MCU, buck, or
    host harness connection.
    """
    power = new ElectricPower
    power.voltage = 3.3V
    spi = new SPI
    cs = new ElectricLogic
    drdy = new ElectricLogic
    rtd_hw_fault = new ElectricLogic
    shared_ref_2v5 = new ElectricLogic

    rtd_pan = new RTDSensing
    rtd_pan.power.vcc ~ power.vcc
    rtd_pan.power.gnd ~ power.gnd
    rtd_pan.spi.sclk ~ spi.sclk
    rtd_pan.spi.mosi ~ spi.mosi
    rtd_pan.spi.miso ~ spi.miso
    rtd_pan.cs.line ~ cs.line
    rtd_pan.drdy.line ~ drdy.line
    rtd_pan.rtd_hw_fault.line ~ rtd_hw_fault.line
    rtd_pan.reference.VREF ~ shared_ref_2v5.line

    unit_io = new FTSH_105_01_F_D
    unit_io.p1 ~ power.vcc
    unit_io.p2 ~ power.gnd
    unit_io.p3 ~ power.gnd
    unit_io.p4 ~ spi.sclk
    unit_io.p5 ~ spi.mosi
    unit_io.p6 ~ spi.miso
    unit_io.p7 ~ cs.line
    unit_io.p8 ~ drdy.line
    unit_io.p9 ~ rtd_hw_fault.line
    unit_io.p10 ~ shared_ref_2v5.line

    # Stable unit boundary names; both return contacts share one ground net.
    power.vcc.override_net_name = "+3V3"
    power.gnd.override_net_name = "gnd"
    spi.sclk.override_net_name = "RTD_SCK"
    spi.mosi.override_net_name = "RTD_SDI"
    spi.miso.override_net_name = "RTD_SDO"
    cs.line.override_net_name = "RTD_CS_N"
    drdy.line.override_net_name = "RTD_DRDY"
    rtd_hw_fault.line.override_net_name = "RTD_HW_FAULT"
    shared_ref_2v5.line.override_net_name = "SHARED_REF_2V5"
    rtd_pan.fb_power.p2.override_net_name = "RTD_AVDD"
