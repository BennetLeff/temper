    designator_prefix = "U"
    mpn = "OPA2388IDR"
    manufacturer = "Texas Instruments"
    footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    signal OUTA ~ pin 1
    signal INA_N ~ pin 2
    signal INA_P ~ pin 3
    signal VN ~ pin 4
    signal INB_P ~ pin 5
    signal INB_N ~ pin 6
    signal OUTB ~ pin 7
    signal VP ~ pin 8

component Tlv9062:
