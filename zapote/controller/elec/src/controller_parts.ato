component Tps3703Window:
    """TI TPS3703A4330DSER: 3.3 V fixed window, +/-4 % UV/OV, +/-0.7 % threshold
    accuracy, CT open = 10 ms release delay, open-drain RESET (LCSC C2861205).
    SBVS249B Pin Functions (DSE): SENSE1 VDD2 CT3 RESET4 GND5 MR6."""
    designator_prefix = "U"
    mpn = "TPS3703A4330DSER"
    manufacturer = "Texas Instruments"
    footprint = "Package_SON:WSON-6_1.5x1.5mm_P0.5mm"
    signal SENSE ~ pin 1
    signal VDD ~ pin 2
    signal CT ~ pin 3
    signal RESET ~ pin 4
    signal GND ~ pin 5
    signal MR ~ pin 6

