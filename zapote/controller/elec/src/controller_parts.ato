    the MCU can observe protective nets but can never drive them.
    SCAS414AG pinout: 1OE1 1A1 2 2Y4 3 1A2 4 2Y3 5 1A3 6 2Y2 7 1A4 8 2Y1 9 GND10
    2A1 11 1Y4 12 2A2 13 1Y3 14 2A3 15 1Y2 16 2A4 17 1Y1 18 2OE19 VCC20."""
    designator_prefix = "U"
    mpn = "SN74LVC244APWR"
    manufacturer = "Texas Instruments"
    footprint = "Package_SO:TSSOP-20_4.4x6.5mm_P0.65mm"
    signal OE1_N ~ pin 1
    signal A1_1 ~ pin 2
    signal Y2_4 ~ pin 3
    signal A1_2 ~ pin 4
    signal Y2_3 ~ pin 5
    signal A1_3 ~ pin 6
    signal Y2_2 ~ pin 7
    signal A1_4 ~ pin 8
    signal Y2_1 ~ pin 9
    signal GND ~ pin 10
    signal A2_1 ~ pin 11
    signal Y1_4 ~ pin 12
    signal A2_2 ~ pin 13
    signal Y1_3 ~ pin 14
    signal A2_3 ~ pin 15
    signal Y1_2 ~ pin 16
    signal A2_4 ~ pin 17
    signal Y1_1 ~ pin 18
    signal OE2_N ~ pin 19
    signal VCC ~ pin 20

