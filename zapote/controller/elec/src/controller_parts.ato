# Parts new to the integrated SELV controller. Ported blocks (interlock,
# thermal-sense, RTD) keep their own component definitions unchanged.
#
# Every part below was checked against its datasheet (pin numbers quoted in
# the docstring) and the JLC/LCSC catalogue on 2026-10-08. LCSC codes and the
# datasheet basis are tabulated in ../../bom/controller-parts.json; that table
# is what tools/verify_controller.py checks every resolved MPN against.

# ------------------------------------------------------------------ MCU

component Esp32S3Wroom1N8:
    """Espressif ESP32-S3-WROOM-1-N8 (8 MB quad flash, no PSRAM), LCSC C2913198.
    Pin numbers: ESP32-S3-WROOM-1 & -1U datasheet v1.8, Table 3-1 (41 pins,
    pin 41 = EPAD = GND). No octal PSRAM, so IO35/36/37 are free (note b)."""
    designator_prefix = "U"
    mpn = "ESP32-S3-WROOM-1-N8"
    manufacturer = "Espressif Systems"
    footprint = "RF_Module:ESP32-S3-WROOM-1"
    signal GND1 ~ pin 1
    signal V3V3 ~ pin 2
    signal EN ~ pin 3
    signal IO4 ~ pin 4
    signal IO5 ~ pin 5
    signal IO6 ~ pin 6
    signal IO7 ~ pin 7
    signal IO15 ~ pin 8
    signal IO16 ~ pin 9
    signal IO17 ~ pin 10
    signal IO18 ~ pin 11
    signal IO8 ~ pin 12
    signal IO19 ~ pin 13
    signal IO20 ~ pin 14
    signal IO3 ~ pin 15
    signal IO46 ~ pin 16
    signal IO9 ~ pin 17
    signal IO10 ~ pin 18
    signal IO11 ~ pin 19
    signal IO12 ~ pin 20
    signal IO13 ~ pin 21
    signal IO14 ~ pin 22
    signal IO21 ~ pin 23
    signal IO47 ~ pin 24
    signal IO48 ~ pin 25
    signal IO45 ~ pin 26
    signal IO0 ~ pin 27
    signal IO35 ~ pin 28
    signal IO36 ~ pin 29
    signal IO37 ~ pin 30
    signal IO38 ~ pin 31
    signal IO39 ~ pin 32
    signal IO40 ~ pin 33
    signal IO41 ~ pin 34
    signal IO42 ~ pin 35
    signal RXD0 ~ pin 36
    signal TXD0 ~ pin 37
    signal IO2 ~ pin 38
    signal IO1 ~ pin 39
    signal GND40 ~ pin 40
    signal EPAD ~ pin 41

# ------------------------------------------------------------------ power

component Tps62933F:
    """TI TPS62933FDRLR, 3.8-30 V 3 A sync buck, forced-CCM, SOT-583 (LCSC C5219272).
    SLUSEA4D Fig 7-1: RT1 EN2 VIN3 GND4 SW5 BST6 SS7 FB8. VFB 788-812 mV at TJ 0-85 C."""
    designator_prefix = "U"
    mpn = "TPS62933FDRLR"
    manufacturer = "Texas Instruments"
    footprint = "Package_TO_SOT_SMD:SOT-583-8"
    signal RT ~ pin 1
    signal EN ~ pin 2
    signal VIN ~ pin 3
    signal GND ~ pin 4
    signal SW ~ pin 5
    signal BST ~ pin 6
    signal SS ~ pin 7
    signal FB ~ pin 8

component Tps62933:
    """TI TPS62933DRLR, PFM variant of the same die/pinout (LCSC C3200405), fan rail."""
    designator_prefix = "U"
    mpn = "TPS62933DRLR"
    manufacturer = "Texas Instruments"
    footprint = "Package_TO_SOT_SMD:SOT-583-8"
    signal RT ~ pin 1
    signal EN ~ pin 2
    signal VIN ~ pin 3
    signal GND ~ pin 4
    signal SW ~ pin 5
    signal BST ~ pin 6
    signal SS ~ pin 7
    signal FB ~ pin 8

