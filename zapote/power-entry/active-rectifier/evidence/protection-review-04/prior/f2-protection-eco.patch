+    # F2-open protection (PROPOSED, NOT APPLIED): independent diode-side OV
+    # detector + latch + dedicated inhibit + shunt clamp. Resistor values
+    # set the 500 V nominal OV trip at BOOST_DIODE_POSITIVE per the
+    # PROTECTION-SELECTION tolerance stack; exact values/parts are
+    # QR-DET/QR-DIV output. The existing q_inhibit/q_permit sequencing is
+    # unchanged; q_inhibit2 wire-ORs at pfc.VSENSE (either FET inhibits).
+    det_top.mpn = "TBD-QR-DIV-TOP"
+    det_top.value = 1Mohm
+    det_bot.mpn = "TBD-QR-DIV-BOT"
+    det_bot.value = 13kohm
+    boost_output ~ det_top.p1
+    det_top.p2 ~ det_cmp.INA_P
+    det_bot.p1 ~ det_cmp.INA_P
+    det_bot.p2 ~ control_gnd
+    # Comparator reference: 500 V nominal trip; reference derivation and
+    # bias-supervisor divider are QR-DET detail (placeholders here).
+    det_cmp.INA_N ~ det_bot.p1
+    aux_15v ~ det_cmp.VCC
+    control_gnd ~ det_cmp.GND
+    aux_15v ~ det_cmp.INB_P
+    control_gnd ~ det_cmp.INB_N
+    # Wired-OR fault combine: OV or bias fault sets the latch.
+    det_cmp.OUTA ~ det_latch.SET
+    det_cmp.OUTB ~ det_latch.SET
+    aux_15v ~ det_latch.VCC
+    control_gnd ~ det_latch.GND
+    control_gnd ~ det_latch.RESET
+    # Dedicated inhibit: latched fault drives q_inhibit2 ON, clamping
+    # pfc.VSENSE below OLP (standby). Asserted HIGH = inhibit.
+    r_inh2_gate.mpn = "RC1206FR-071KL"
+    r_inh2_gate.value = 1kohm
+    r_inh2_pd.mpn = "RC1206FR-07100KL"
+    r_inh2_pd.value = 100kohm
+    det_latch.Q ~ r_inh2_gate.p1
+    r_inh2_gate.p2 ~ q_inhibit2.G
+    r_inh2_pd.p1 ~ q_inhibit2.G
+    r_inh2_pd.p2 ~ control_gnd
+    q_inhibit2.D ~ pfc.VSENSE
+    q_inhibit2.S ~ control_gnd
+    # Shunt clamp across the diode-side node (QR-CLAMP part).
+    clamp.p1 ~ boost_output
+    clamp.p2 ~ control_gnd
