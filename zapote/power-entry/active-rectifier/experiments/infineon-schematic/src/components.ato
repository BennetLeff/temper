component IR11688S:
    """Infineon smart diode controller; pin map from the application reference."""
    footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    mpn = "IR11688S"
    manufacturer = "Infineon"
    datasheet = "https://www.infineon.com/dgdl/Infineon-IR11688S-DS-v01_00-EN.pdf"
    signal Gate1 ~ pin 1
    signal VCC ~ pin 2
    signal MOT ~ pin 3
    signal VD1 ~ pin 4
    signal VD2 ~ pin 5
    signal VS ~ pin 6
    signal GND ~ pin 7
    signal Gate2 ~ pin 8

component UCC21530BQDWKRQ1:
    """TI UCC21530BQDWKRQ1 DWK, active 8-V UVLO dual isolated gate driver.

    DWK has pads 1-11 and 14-16; pads 12/13 do not exist. The BQ 8-V UVLO
    grade accepts the 15-V auxiliary rail tolerance with margin.
    """
    footprint = "temper:SOIC16W_Isolated"
    mpn = "UCC21530BQDWKRQ1"
    manufacturer = "Texas Instruments"
    datasheet = "https://www.ti.com/lit/ds/symlink/ucc21530-q1.pdf"
    signal INA ~ pin 1
    signal INB ~ pin 2
    signal VCCI ~ pin 3
    signal GNDI ~ pin 4
    signal EN ~ pin 5
    signal DT ~ pin 6
    signal NC ~ pin 7
    signal VCCI2 ~ pin 8
    signal VSSB ~ pin 9
    signal OUTB ~ pin 10
    signal VDDB ~ pin 11
    signal VSSA ~ pin 14
    signal OUTA ~ pin 15
    signal VDDA ~ pin 16

component BSP300H6327XUSA1:
    """800-V sense-extension MOSFET used by the Infineon reference."""
    footprint = "temper:BSP300_PG-SOT223-4-21"
    mpn = "BSP300H6327XUSA1"
    manufacturer = "Infineon"
    datasheet = "https://www.infineon.com/dgdl/Infineon-BSP300-DS-v01_01-EN.pdf"
    signal G ~ pin 1
    signal D2 ~ pin 2
    signal S ~ pin 3
    signal D ~ pin 4

component IPW60R017C7:
    """600-V C7 MOSFET, TO-247-3; pin 1 gate, 2 drain, 3 source."""
    footprint = "Package_TO_SOT_THT:TO-247-3_Vertical"
    mpn = "IPW60R017C7"
    manufacturer = "Infineon"
    datasheet = "https://www.infineon.com/dgdl/Infineon-IPW60R017C7-DS-v02_02-EN.pdf"
    signal G ~ pin 1
    signal D ~ pin 2
    signal S ~ pin 3

component GBJ2510F:
    """Retained passive bridge, in parallel with active path for surge."""
    footprint = "temper:Diode_Bridge_GBJ2510"
    mpn = "GBJ2510-F"
    manufacturer = "Diodes Incorporated"
    signal PLUS ~ pin 1
    signal AC1 ~ pin 2
    signal AC2 ~ pin 3
    signal MINUS ~ pin 4

component IRM_10_15:
    """Mean Well 10-W encapsulated AC/DC, 85-305 Vac input, 15 V output."""
    footprint = "Converter_ACDC:Converter_ACDC_MeanWell_IRM-10-xx_THT"
    mpn = "IRM-10-15"
    manufacturer = "Mean Well"
    datasheet = "https://www.meanwell.com/Upload/PDF/IRM-10/IRM-10-SPEC.PDF"
    # IRM-10 standard footprint top-view mapping: 1=AC/N, 2=AC/L,
    # 3=-Vout, 4=+Vout. This is intentionally not the intuitive L/N order.
    signal ACN ~ pin 1
    signal ACL ~ pin 2
    signal VN ~ pin 3
    signal VP ~ pin 4

component Resistor:
    designator_prefix = "R"
    footprint = "Resistor_SMD:R_0603_1608Metric"
    value: ohm
    mpn: str
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor:
    designator_prefix = "C"
    footprint = "Capacitor_SMD:C_0603_1608Metric"
    value: farad
    mpn: str
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component BootstrapCeramic:
    designator_prefix = "C"
    footprint = "Capacitor_SMD:C_0805_2012Metric"
    mpn: str
    value: farad
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component BootstrapDiode:
    footprint = "Diode_SMD:D_SMA"
    mpn: str
    # KiCad D_SMA pad mapping is 1=K, 2=A.
    signal K ~ pin 1
    signal A ~ pin 2

component BootstrapBulk:
    designator_prefix = "C"
    # Selected EEU-FC1E101 (100 uF/25 V): radial dia 6.3 mm, P2.50 mm
    # (FC-A datasheet retained in sources/). L11.2 nominal vs H11.0
    # courtyard is a 0.2 mm height-clearance note for layout, not a fit risk.
    footprint = "Capacitor_THT:C_Radial_D6.3mm_H11.0mm_P2.50mm"
    mpn: str
    value: farad
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component BootstrapResistor:
    designator_prefix = "R"
    # Selected ERJ-P08J221V (220 ohm, 1206 anti-surge, 0.66 W). The prior
    # RH05047R0FE02 50-mm power-resistor placeholder is removed with the
    # 47-ohm position; pulse life remains bench item B-4 (no single-pulse
    # curve in the retained datasheet).
    footprint = "Resistor_SMD:R_1206_3216Metric"
    mpn: str
    value: ohm
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Interface:
    # Logical hierarchical port only. A generic 2.54 mm header is forbidden
    # here because AC_L/AC_N/PREBOOST carry the 15 A power path.
    footprint = "temper:HierarchicalPort"
    mpn = "HIERARCHICAL_PORTS_ONLY"
    signal AC_L ~ pin 1
    signal AC_N ~ pin 2
    signal PREBOOST_POS ~ pin 3
    signal HOT_GND ~ pin 4
    signal AUX_15V ~ pin 5
    signal GATE_CMD_A ~ pin 6
    signal GATE_CMD_B ~ pin 7
