         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MOSFET &amp;#8212; Power, N-Channel, SUPERFET&amp;#174; III, FRFET&amp;#174; 650 V, 65 A, 40 m&amp;#937;</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Description</rdf:li>
               <rdf:li>SUPERFET III MOSFET is ON Semiconductorâ€™s brandâˆ’new high</rdf:li>
               <rdf:li>voltage superâˆ’junction (SJ) MOSFET family that is utilizing charge</rdf:li>
               <rdf:li>balance technology for outstanding low onâˆ’resistance and lower gate</rdf:li>
               <rdf:li>charge performance. This advanced technology is tailored to minimize</rdf:li>
               <rdf:li>conduction loss</rdf:li>
               <rdf:li>provide superior switching performance</rdf:li>
               <rdf:li>and</rdf:li>
               <rdf:li>withstand extreme dv/dt rate.</rdf:li>
               <rdf:li>Consequently</rdf:li>
               <rdf:li>SUPERFET III MOSFET is very suitable for the</rdf:li>
               <rdf:li>various power system for miniaturization and higher efficiency.</rdf:li>
               <rdf:li>SUPERFET III FRFET MOSFETâ€™s optimized reverse recovery</rdf:li>
               <rdf:li>performance of body diode can remove additional component and</rdf:li>
               <rdf:li>improve system reliability.</rdf:li>
            </rdf:Bag>
         </dc:subject>
