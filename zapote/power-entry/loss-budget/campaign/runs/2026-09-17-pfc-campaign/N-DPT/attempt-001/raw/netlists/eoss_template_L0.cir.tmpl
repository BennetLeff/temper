* ============================================================
* Eoss measurement: quasi-static linear drain ramp 0->400 V with Vgs = 0
* DUT: __DUT__  (Infineon CoolMOS C7 vendor model, Level-0)
* Eoss(400 V) = integral over the ramp of v(d) * (-i(vds)) dt
* __NOTE__
* ============================================================
.param TEMP=__TEMP__
.temp __TEMP__
.include "../models/__MOSLIB__"

Vds d 0 PWL(0 0 __TRAMP__ 400)
Xdut d g 0 __DUT__
Vg  g 0 0

.options reltol=1e-5 abstol=1e-12 vntol=1e-7
.tran __TSTEP__ __TEND__ 0 __TMAX__

.control
run
let pv = v(d)*(-i(vds))
meas tran eoss   integ pv from=0        to=__TRAMP__
meas tran qoss   integ (-i(vds)) from=0 to=__TRAMP__
meas tran vfinal find v(d) at=__TRAMP__
.endc
.end
