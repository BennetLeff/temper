+ PARAMS:
+ fpar01 1.823
+ fpar02 1.262
+ fpar03 3.085
+ fpar04 3.336
GPOW 0 TJ VALUE = {IF(time > 0,LIMIT(ABS(V(Pow,0)),0,1e10),0)}
RGPOW TJ 0 1meg
RTHD0 TJ td1 6.461E-02
RTHD1 td1 td2 2.629E-01
RTHD2 td2 TCASE 2.530E-01
CTHD0 TJ 0 3.323E-04
CTHD1 td1 0 2.168E-03
CTHD2 td2 0 1.397E-02
.ENDS
*  ***************************************************************
.SUBCKT SCS_G5_650V_v1a a k Tj Pow
+ PARAMS:
+ fpar01 = {100}
+ fpar02 = {100}
+ fpar03 = {100}
+ fpar04 = {100}
X$sd a k1 Tj fpar37 fpar39 PARAMS: fpar05 = {fpar01} fpar07 = {fpar03}
X$pn a k1 Tj fpar38 fpar40 PARAMS: fpar06 = {fpar02} fpar07 = {fpar03}
Vcurr k1 k DC = 0
X$cap a k fpar41 fpar43 PARAMS: fpar08 = {fpar04} fpar07 = {fpar03}
G_Pow 0 Pow VALUE = {LIMIT(abs(V(fpar37,0) + V(fpar38,0) + V(fpar41,0)),0,100k) }
R_Pow 0 Pow 1
.ENDS
.SUBCKT fpar43 a k Pow PARAMS: fpar08 = {100} fpar07 = {100}
.PARAM fpar30 = {fpar08/100}
+ fpar31 = {7.629e-2}
+ fpar32 = {fpar31 / fpar07}
+ fpar33 = {1E12}
.PARAM fa_0 = {2.225}
+ fb_0 = {4.581}
+ fc_0 = {7.299}
+ fd_0 = {7.485}
+ pb = {1.553e-2}
+ pc = {1.028e-1}
+ pd = {5.821e-1}
.PARAM fa = {fa_0 * fpar30 * 1E-9}
+ fb = {fb_0 * fpar30 * 1E-9}
+ fc = {fc_0 * fpar30 * 1E-9}
+ fd = {fd_0 * fpar30 * 1E-9}
C_a a k1 {fa}
Rp_a a k1 {fpar33}
C_b a k_b {fb}
Rp_b a k_b {fpar33}
E_b k_b k1 VALUE {if(V(a,k1)<2, V(a,k1)-(exp(pb*V(a,k1))-1)/pb ,0)}
C_c a k_c {fc}
Rp_c a k_c {fpar33}
E_c k_c k1 VALUE {if(V(a,k1)<2, V(a,k1)-(exp(pc*V(a,k1))-1)/pc ,0)}
C_d a k_d {fd}
Rp_d a k_d {fpar33}
E_d k_d k1 VALUE {if(V(a,k1)<2, V(a,k1)-(exp(pd*V(a,k1))-1)/pd ,0)}
Rser k k1 {fpar32}
Vcurr k1 k DC=0
G_Pow 0 Pow VALUE = {LIMIT(abs(I(Vcurr)*(V(k,k1))),0,100k) }
R_Pow 0 Pow 1
.ENDS
.SUBCKT fpar42 a k pow PARAMS: fpar08 = {100} fpar07 = {100}
.PARAM fpar30 = {fpar08/100}
+ fpar34 = {18.949 * fpar30 * 1E-9}
+ fpar35 = {2.817}
+ fpar31 = {7.629e-2}
+ fpar32 = {fpar31 / fpar07}
+ fpar33 = {1E12}
+ fpar36 = {-280}
C_b k1 k_b {fpar34}
E_b a k_b VALUE {if(V(a,k1) < fpar36,
+ V(a,k1) + (2*(sqrt(fpar35*(fpar35 - fpar36)) - fpar35) + fpar35/sqrt(fpar35*(fpar35-fpar36)) * (fpar36-V(a,k1))) ,
+ if(V(a,k1)<=fpar35, V(a,k1) + (2*(sqrt(fpar35*(fpar35 - V(a,k1))) - fpar35)) ,
+ 0))}
R_p k1 k_b {fpar33}
R_s k2 k1 {fpar32}
VICap k2 k 0
G_Pow 0 pow VALUE = {LIMIT(abs(I(VICap)*(V(k2,k1))),0,100k) }
R_Pow 0 pow 1
.ENDS
.SUBCKT fpar40 a k Tj Pow PARAMS: fpar06 = {100} fpar07 = {100}
.PARAM fpar23 = {2.600e-37}
+ fpar24 = {1.270}
+ fpar25 = {2.700}
+ fpar16 = {8.617E-5}
+ fpar26 = {exp(-fpar25/(fpar16*300))}
+ fpar27 = {3.000e-2}
+ fpar32 = {fpar27 / fpar07}
+ fpar28 = {2.900}
+ fpar29 = {7.500e-3}
.FUNC RS(T) {fpar32 * (-0.2 + 1.2*(TK(T)/300))}
.FUNC TK(T) {T + 273}
.FUNC I0(T) {fpar23/fpar26*exp(-fpar25/(fpar16*TK(T)))}
.FUNC Vpn(V,T) {V-(fpar28-fpar29*T)}
.FUNC Ipn(I,V,T) {I0(T)*(exp((Vpn(V,T)-I*RS(T))/(fpar24*fpar16*TK(T)))-1)*fpar06}
GPN a k1 Value = {if (V(a,k)>0, Ipn(I(Vcurr),V(a,k),V(Tj,0)), 0)}
Rshunt a k 1E15
Vcurr k1 k DC=0
G_Pow 0 Pow VALUE = {LIMIT(abs(I(Vcurr)*(V(a,k))),0,100k) }
R_Pow 0 Pow 1
.ENDS
.SUBCKT fpar39 a k Tj Pow PARAMS: fpar05 = {100} fpar07 = {100}
.PARAM fpar09 = {0.170}
+ PhiB0 = {1.159}
+ fpar11 = {1.033}
+ fpar12 = {7.629e-2}
+ fpar13 = {2.317}
+ fpar14 = {-3.660}
+ fpar15 = {2.350}
+ fpar16 = {8.617E-5}
.PARAM Astern = {fpar09 * fpar05}
+ fpar32 = {fpar12 / fpar07}
.FUNC TK(T) {T + 273}
.FUNC PhiB(V) {if(V<0, PhiB0-sqrt(1.5E-8*abs(V)/4.5/1E-4), PhiB0)}
.FUNC I0F(V,T) {Astern * TK(T)*TK(T) * exp(-PhiB(V)/TK(T)/fpar16)}
.FUNC Rs(T) {fpar32 * (fpar13 + fpar14*(TK(T)/300) + fpar15*(TK(T)/300)^2)}
.FUNC ISDF(I,V,T) {I0F(V,T) * (exp((V-Rs(T)*I)/fpar11/TK(T)/fpar16)-1)}
.PARAM fpar17 = {-1.250e+1}
+ fpar18 = {6.300e-3}
+ fpar19 = {1.200e-4}
+ fpar20 = {-2.900e-2}
+ fpar21 = {1.240e-5}
+ fpar22 = {3.460e-7}
.FUNC I0S(T) {10^(fpar17 + fpar18*T + fpar19*T^2)*fpar05/100}
.FUNC V0S(T) {(fpar20 + fpar21*T + fpar22*T^2)}
.FUNC ISDS(V,T) {-I0S(T)*exp(V*V0S(T))}
GSD a k1 Value = {IF(V(a,k)>=0,ISDF(I(Vcurr),V(a,k),V(Tj,0)), ISDF(I(Vcurr),V(a,k),V(Tj,0))+ISDS(V(a,k),V(Tj,0)))}
Vcurr k1 k DC=0
G_Pow 0 Pow VALUE={LIMIT(abs(I(Vcurr)*(V(a,k))),0,100k) }
R_Pow 0 Pow 1
.ENDS
