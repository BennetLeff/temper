    signal request
    signal qualified
    signal watch
    signal load_ready
    signal arm_raw
    signal analog_good
    signal logic_good
    compare_bus = new ProtectionComparator
    compare_aux = new ProtectionComparator
    buffer = new ProtectionBuffer
    ldo = new ProtectionLdo
    por = new ProtectionPor
    reference = new ProtectionReference
    schmitt1 = new ProtectionSchmitt
    schmitt2 = new ProtectionSchmitt
