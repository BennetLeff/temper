    signal delta_buf
    signal vd_half
    signal vb_half
    signal vd_offset
    signal vb_offset
    signal fast_ok_n
    signal pre_ok
    signal ready
    signal aux_uv
    signal aux_ov
    signal pre_ref
    signal ready_ref
    signal por_n
    signal fault_n
    signal arm_filter
    signal arm_n
    signal arm_edge
    signal permit_n
    signal permit_clean
    signal pre_clean
    signal ready_n
    signal ready_clean
