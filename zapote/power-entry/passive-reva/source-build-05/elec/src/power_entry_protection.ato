# F2 supervisor construction candidate. See passive-reva/protection/IMPLEMENTATION.md.
# Pin maps transcribed from retained manufacturer PDFs. ALL ports HOT-referenced.
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("TRAITS")

component ProtectionComparator:
    mpn = "TLV1704PWR"
    footprint = "Package_SO:TSSOP-14_4.4x5mm_P0.65mm"
    signal OB ~ pin 1
    signal OA ~ pin 2
    signal VCC ~ pin 3
    signal NA ~ pin 4
    signal PA ~ pin 5
    signal NB ~ pin 6
    signal PB ~ pin 7
    signal NC ~ pin 8
    signal PC ~ pin 9
    signal ND ~ pin 10
    signal PD ~ pin 11
    signal GND ~ pin 12
    signal OD ~ pin 13
    signal OC ~ pin 14

component ProtectionBuffer:
    mpn = "OPA4197IPWR"
    footprint = "Package_SO:TSSOP-14_4.4x5mm_P0.65mm"
    signal OA ~ pin 1
    signal NA ~ pin 2
    signal PA ~ pin 3
    signal VCC ~ pin 4
    signal PB ~ pin 5
    signal NB ~ pin 6
    signal OB ~ pin 7
    signal OC ~ pin 8
    signal NC ~ pin 9
    signal PC ~ pin 10
    signal GND ~ pin 11
    signal PD ~ pin 12
    signal ND ~ pin 13
    signal OD ~ pin 14

component ProtectionLdo:
    mpn = "TPS7A1650DGNR"
    footprint = "temper:TPS7A16_DGN"
    signal OUT ~ pin 1
    signal DNC ~ pin 2
    signal PG ~ pin 3
    signal GND ~ pin 4
    signal EN ~ pin 5
    signal NC ~ pin 6
    signal DELAY ~ pin 7
    signal IN ~ pin 8
    signal EP ~ pin 9

component ProtectionPor:
    mpn = "TPS3808G50DBVR"
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    signal RESET_N ~ pin 1
    signal GND ~ pin 2
    signal MR_N ~ pin 3
    signal CT ~ pin 4
    signal SENSE ~ pin 5
    signal VCC ~ pin 6

component ProtectionReference:
    mpn = "LM4040A25IDBZR"
    footprint = "Package_TO_SOT_SMD:SOT-23"
    signal K ~ pin 1
    signal A ~ pin 2
    signal NC ~ pin 3

component ProtectionSchmitt:
    mpn = "SN74HCT14DR"
    footprint = "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"
    signal IA ~ pin 1
    signal OA ~ pin 2
    signal IB ~ pin 3
    signal OB ~ pin 4
    signal IC ~ pin 5
    signal OC ~ pin 6
    signal GND ~ pin 7
    signal OD ~ pin 8
    signal ID ~ pin 9
    signal OE ~ pin 10
    signal IE ~ pin 11
    signal OF ~ pin 12
    signal IF ~ pin 13
    signal VCC ~ pin 14

component ProtectionAnd:
    mpn = "SN74HCT08DR"
    footprint = "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"
    signal AA ~ pin 1
    signal BA ~ pin 2
    signal OA ~ pin 3
    signal AB ~ pin 4
    signal BB ~ pin 5
    signal OB ~ pin 6
    signal GND ~ pin 7
    signal OC ~ pin 8
    signal AC ~ pin 9
    signal BC ~ pin 10
    signal OD ~ pin 11
    signal AD ~ pin 12
    signal BD ~ pin 13
    signal VCC ~ pin 14

component ProtectionLatch:
    mpn = "SN74HCT74DR"
    footprint = "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"
    signal CLR1_N ~ pin 1
    signal D1 ~ pin 2
    signal CK1 ~ pin 3
    signal PRE1_N ~ pin 4
    signal Q1 ~ pin 5
    signal NQ1 ~ pin 6
    signal GND ~ pin 7
    signal NQ2 ~ pin 8
    signal Q2 ~ pin 9
    signal PRE2_N ~ pin 10
    signal CK2 ~ pin 11
    signal D2 ~ pin 12
    signal CLR2_N ~ pin 13
    signal VCC ~ pin 14

component ProtectionTimer:
    mpn = "LTC6994IS6-1#TRMPBF"
    footprint = "Package_TO_SOT_SMD:TSOT-23-6"
    signal IN ~ pin 1
    signal GND ~ pin 2
    signal SET ~ pin 3
    signal DIV ~ pin 4
    signal VCC ~ pin 5
    signal OUT ~ pin 6

component ProtectionR:
    mpn = "TNPW120610K0BEEA"
    footprint = "Resistor_SMD:R_1206_3216Metric"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component ProtectionC:
    mpn = "C0805C104K5RACTU"
    footprint = "Capacitor_SMD:C_0805_2012Metric"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component ProtectionHeader:
    mpn = "61300411121"
    footprint = "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"
    signal ARM ~ pin 1
    signal LOAD_READY ~ pin 2
    signal ARMED ~ pin 3
    signal GND ~ pin 4

component ProtectionGateDriver:
    mpn = "UCC27624DR"
    footprint = "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
    signal ENA ~ pin 1
    signal INA ~ pin 2
    signal GND ~ pin 3
    signal INB ~ pin 4
    signal OUTB ~ pin 5
    signal VDD ~ pin 6
    signal OUTA ~ pin 7
    signal ENB ~ pin 8

module PowerEntryProtection:
    signal vd
