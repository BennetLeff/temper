# Partial source/receiver join. The PFC/F2/driver and HOT watchdog producers
# remain unconnected and must be added before U4 can pass.
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("TRAITS")
from "receiver_isolation.ato" import ReceiverIsolation38
from "source_authority.ato" import SourceAuthority38
from "driver_stage.ato" import DriverStage38
from "hot_watchdog.ato" import HotWatchdog38
from "hot_rails.ato" import HotRails38
from "f2_detector.ato" import F2Detector38

module PowerEntryIntegrated38:
    receiver = new ReceiverIsolation38
    source = new SourceAuthority38
    driver = new DriverStage38
    hot_watchdog = new HotWatchdog38
    hot_rails = new HotRails38
    f2_detector = new F2Detector38

    source.SELV3V3 ~ receiver.SELV3V3
    source.SELV_GND ~ receiver.SELV_GND
    source.SOURCE_PERMIT_Q ~ receiver.SOURCE_PERMIT_Q
    source.SOURCE_HEALTH_Q ~ receiver.SOURCE_HEALTH_Q
    source.SOURCE_STOP_N ~ receiver.SOURCE_STOP_N
    source.SOURCE_HOT_PERMIT_FB ~ receiver.SOURCE_HOT_PERMIT_FB
    source.SOURCE_HOT_SESSION_FB ~ receiver.SOURCE_HOT_SESSION_FB
    driver.HOT_LOGIC5 ~ receiver.HOT_LOGIC5
    driver.HOT0 ~ receiver.HOT0
    driver.HOT_RUN_Q ~ receiver.HOT_RUN_Q
    driver.HOT_SESSION_Q ~ receiver.HOT_SESSION_Q
    driver.HOT_PERMIT ~ receiver.HOT_PERMIT
    driver.HOT_PREP_TRIP_OK ~ receiver.HOT_PREP_TRIP_OK
    driver.HOT_RECEIVER_ABORT_N ~ receiver.HOT_RECEIVER_ABORT_N
    driver.HOT_PREP_ABORT_OK ~ receiver.HOT_PREP_ABORT_OK
    driver.HOT_SOURCE_STOP_N ~ receiver.HOT_SOURCE_STOP_N
    hot_watchdog.HOT_LOGIC5 ~ receiver.HOT_LOGIC5
    hot_watchdog.HOT0 ~ receiver.HOT0
    hot_watchdog.HOT_WDI ~ receiver.HOT_WDI
    hot_watchdog.HOT_WATCHDOG_OK ~ receiver.HOT_WATCHDOG_OK
    hot_rails.HOT_LOGIC5 ~ receiver.HOT_LOGIC5
    hot_rails.HOT0 ~ receiver.HOT0
    hot_rails.HOT_RAILS_OK ~ receiver.HOT_RAILS_OK
    hot_rails.AUX_PROTECTED ~ driver.AUX_PROTECTED
    f2_detector.HOT_LOGIC5 ~ receiver.HOT_LOGIC5
    f2_detector.HOT0 ~ receiver.HOT0
    f2_detector.HOT_FAULT_N ~ receiver.HOT_FAULT_N
