+// The electrical deck retains its full `.save` inventory so ngspice still
+// delivers all diagnostics to the callback.  Successful grid exports only
+// need the original operating-point vectors; `time` is emitted implicitly by
+// wrdata and the 14 vectors below are the complete normalizer source set.
+const NORMAL_EXPORT: [&str; 14] = [
+    "v(acsrc)", "v(acn)", "i(Vac)", "v(load)", "v(vb)", "i(Lboost)",
+    "v(vd)", "v(sw)", "v(gate)", "v(q)", "v(en)", "v(fault)",
+    "v(vcomp)", "v(icomp)",
+];
+
+fn reduced_export_signals(deck: &str) -> Result<String, String> {
+    let saves: Vec<Vec<&str>> = deck
+        .lines()
+        .filter_map(|line| line.trim().strip_prefix(".save "))
+        .map(|line| line.split_whitespace().collect())
+        .collect();
+    if saves.len() != 1 {
+        return Err(format!("normal deck must contain exactly one .save line, found {}", saves.len()));
+    }
+    let columns = &saves[0];
+    if columns.first() != Some(&"time") {
+        return Err("normal .save line must begin with time".into());
+    }
+    for signal in NORMAL_EXPORT {
+        let count = columns.iter().filter(|column| **column == signal).count();
+        if count != 1 { return Err(format!("required normal export {signal} occurs {count} times")); }
+    }
+    for diagnostic in DIAG_NAMES {
+        let signal = std::str::from_utf8(diagnostic).map_err(|e| e.to_string())?;
+        let saved_name = format!("v({signal})");
+        let count = columns.iter().filter(|column| **column == saved_name).count();
+        if count != 1 { return Err(format!("required diagnostic {signal} occurs {count} times")); }
+    }
+    Ok(NORMAL_EXPORT.join(" "))
+}
+
+fn full_export_signals(deck: &str) -> Result<String, String> {
+    let saves: Vec<Vec<&str>> = deck
+        .lines()
+        .filter_map(|line| line.trim().strip_prefix(".save "))
+        .map(|line| line.split_whitespace().collect())
+        .collect();
+    if saves.len() != 1 {
+        return Err(format!("normal deck must contain exactly one .save line, found {}", saves.len()));
+    }
+    let columns = &saves[0];
+    if columns.first() != Some(&"time") {
+        return Err("normal .save line must begin with time".into());
+    }
+    let mut seen = std::collections::HashSet::new();
+    for signal in columns.iter().skip(1) {
+        if !seen.insert(*signal) { return Err(format!("duplicate saved signal {signal}")); }
+    }
+    Ok(columns[1..].join(" "))
+}
+
+fn select_export<'a>(all_saved_finite: bool, reduced: &'a str, full: &'a str) -> (&'a str, &'static str) {
+    if all_saved_finite { (reduced, "normal14_poststop") } else { (full, "full_saved_fallback_nonfinite") }
+}
