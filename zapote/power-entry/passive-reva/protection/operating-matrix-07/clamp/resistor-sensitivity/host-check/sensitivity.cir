set temp=-40
alter VSHUNT=-5
op
print v(isense) @dclamp[id]
set temp=25
op
print v(isense) @dclamp[id]
set temp=85
op
print v(isense) @dclamp[id]
set temp=125
op
print v(isense) @dclamp[id]
alterparam R_SENSE=22
