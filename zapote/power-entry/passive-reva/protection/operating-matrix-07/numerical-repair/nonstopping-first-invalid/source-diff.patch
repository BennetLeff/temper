+/// Keep the production watchdog threshold explicit and independently testable.
+/// This is intentionally based on wall-clock time since the last accepted
+/// simulation-time advance; a first-invalid snapshot does not reset it.
+fn stalled_since(last_advance: Instant, now: Instant) -> bool {
+    now.duration_since(last_advance) >= Duration::from_secs(120)
+}
