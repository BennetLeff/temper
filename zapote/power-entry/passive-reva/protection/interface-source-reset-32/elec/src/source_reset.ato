# Source-side fail-low health producer for interface-source-permit-30.
# GPIO/software contract and uncovered reset classes are in README.md.

component Watchdog:
    mpn = "TPS3431SDRBR"
    manufacturer = "Texas Instruments"
    datasheet = "https://www.ti.com/lit/ds/symlink/tps3431.pdf"
    footprint = "TBD_REVIEW_ONLY:TPS3431SDRBR_DRB0008A"
    signal VDD ~ pin 1
    signal CWD ~ pin 2
    signal EN ~ pin 3
    signal GND ~ pin 4
    signal SET1 ~ pin 5
    signal WDI ~ pin 6
    signal WDO ~ pin 7
    signal ENOUT ~ pin 8
    signal EP ~ pin 9

component WatchdogInputBuffer:
    mpn = "SN74LVC1G17DBVR"
    manufacturer = "Texas Instruments"
    datasheet = "https://www.ti.com/lit/ds/symlink/sn74lvc1g17.pdf"
    footprint = "Package_TO_SOT_SMD:SOT-23-5"
    signal NC ~ pin 1
    signal A ~ pin 2
    signal GND ~ pin 3
    signal Y ~ pin 4
    signal VCC ~ pin 5

component Resistor:
    footprint = "Resistor_SMD:R_0603_1608Metric"
    value: resistance
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor:
    footprint = "Capacitor_SMD:C_0603_1608Metric"
    value: capacitance
    signal p1 ~ pin 1
    signal p2 ~ pin 2

module SourceResetProducer:
    signal SELV3V3
    signal SELV_GND
    signal SOURCE_VALIDATED_HEARTBEAT
    signal SOURCE_RESET_GOOD
    signal SOURCE_WATCHDOG_GOOD
    signal wd_wdi
    signal wd_cwd
    signal wd_vdd

    watchdog = new Watchdog
    watchdog.VDD ~ SELV3V3
    watchdog.CWD ~ wd_cwd
    watchdog.EN ~ SELV3V3
    watchdog.GND ~ SELV_GND
    watchdog.SET1 ~ SELV3V3
    watchdog.WDI ~ wd_wdi
    watchdog.WDO ~ SOURCE_WATCHDOG_GOOD
    watchdog.ENOUT ~ SOURCE_WATCHDOG_GOOD
    watchdog.EP ~ SELV_GND

    # The ESP32 GPIO drives only the Schmitt input. The push-pull output
    # drives WDI with a 100 kohm default-low and is powered from watchdog VDD.
    wdi_buffer = new WatchdogInputBuffer
    wdi_buffer.A ~ SOURCE_VALIDATED_HEARTBEAT
    wdi_buffer.GND ~ SELV_GND
    wdi_buffer.Y ~ wd_wdi
    wdi_buffer.VCC ~ SELV3V3

    # A 1 nF C0G timing capacitor yields 132.4 ms typical; the watchdog
    # output deasserts on a later valid WDI edge, so permit latching is done
    # downstream by interface-source-permit-30.
    cwd_cap = new Capacitor
    cwd_cap.value = 1nF
    cwd_cap.p1 ~ wd_cwd
    cwd_cap.p2 ~ SELV_GND

    bypass = new Capacitor
    bypass.value = 100nF
    bypass.p1 ~ SELV3V3
    bypass.p2 ~ SELV_GND

    wdi_buffer_bypass = new Capacitor
    wdi_buffer_bypass.value = 100nF
    wdi_buffer_bypass.p1 ~ SELV3V3
    wdi_buffer_bypass.p2 ~ SELV_GND

    # WDO and ENOUT are open drain per TI and may share this pull-up node.
    watchdog_good_pullup = new Resistor
    watchdog_good_pullup.value = 10kohm
    watchdog_good_pullup.p1 ~ SELV3V3
    watchdog_good_pullup.p2 ~ SOURCE_WATCHDOG_GOOD

    # WDI is software generated only after a newly armed session has begun
    # and a complete valid peer frame has been accepted.
    heartbeat_pd = new Resistor
    heartbeat_pd.value = 100kohm
    heartbeat_pd.p1 ~ SOURCE_VALIDATED_HEARTBEAT
    heartbeat_pd.p2 ~ SELV_GND
    wdi_pd = new Resistor
    wdi_pd.value = 100kohm
    wdi_pd.p1 ~ wd_wdi
    wdi_pd.p2 ~ SELV_GND

    # GPIO21 candidate: no strap function and no listed power-up glitch.
    # Use a module/package pin actually routed to ESP32-S3 GPIO21 before PCB.
    reset_good_pd = new Resistor
    reset_good_pd.value = 10kohm
    reset_good_pd.p1 ~ SOURCE_RESET_GOOD
    reset_good_pd.p2 ~ SELV_GND
