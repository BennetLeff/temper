# Bounded A5 auxiliary supply candidate (standalone source module).
#
# The retained f2-shutdown-revb module consumes `aux` (HOT15) and `logic5`.
# `aux_raw` is the Mean Well IRM-10-15 output.  It is *not* connected directly
# to UCC27511ADBVR: TPS7A4701 is the overvoltage barrier.  The 5-V rail is a
# separate TPS54202 buck so loss of either regulated rail is visible to the
# existing rail supervisors.  ARM/PERMIT remain ports owned by the interlock;
# this module does not tie them healthy.

component TPS7A4701:
    mpn = "TPS7A4701RGW"
    datasheet = "https://www.ti.com/lit/ds/symlink/tps7a47.pdf"
    footprint = "Package_DFN_QFN:VQFN-20-1EP_5x5mm_P0.5mm_EP3.4x3.4mm"
    signal OUT ~ pin 1
    signal NC ~ pin 2
    signal FB ~ pin 3
    signal P64V2 ~ pin 4
    signal P64V1 ~ pin 5
    signal P32 ~ pin 6
    signal GND ~ pin 7
    signal P16 ~ pin 8
    signal P08 ~ pin 9
    signal P04 ~ pin 10
    signal P02 ~ pin 11
    signal P01 ~ pin 12
    signal EN ~ pin 13
    signal NR ~ pin 14
    signal IN ~ pin 15
    signal IN ~ pin 16
    signal NC ~ pin 17
    signal NC ~ pin 18
    signal NC ~ pin 19
    signal OUT ~ pin 20

component TPS54202:
    mpn = "TPS54202DDCR"
    datasheet = "https://www.ti.com/lit/ds/symlink/tps54202.pdf"
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    signal GND ~ pin 1
    signal SW ~ pin 2
    signal VIN ~ pin 3
    signal FB ~ pin 4
    signal EN ~ pin 5
    signal BOOT ~ pin 6

component TPS3700:
    mpn = "TPS3700DDCR"
    datasheet = "https://www.ti.com/lit/ds/symlink/tps3700.pdf"
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    signal OUTA ~ pin 1
    signal GND ~ pin 2
    signal INA_P ~ pin 3
    signal INB_N ~ pin 4
    signal VDD ~ pin 5
    signal OUTB ~ pin 6

component F2R:
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component F2C:
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component F2L:
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Hot15Logic5Supply:
    """IRM-10-15 source followed by a safe HOT15 LDO and real 5-V buck.

    The source's 14.625--20.25 V envelope is an integration assumption from
    the IRM-10-15 data sheet (15 V +/-2.5%, OVP range).  AUX15 is nominally
    15 V using TPS7A4701 ANY-OUT, with a conditional 14.25--15.75 V run
    envelope.  The low-line condition is I(AUX15) <=75 mA and a measured
    TPS7A4701 dropout <=0.30 V at that load; TI publishes 216 mV typical at
    0.5 A and 307 mV typical at 1 A, not a maximum at this output voltage.

    The TPS54202 input is AUX_RAW and its 8--28 V reference design covers the
    complete raw source envelope.  Its EN divider is bounded below the 5.5-V
    pin limit and has a pulldown, so an absent producer leaves logic5 off.
    """
    signal aux_raw
    signal aux15
    signal logic5
    signal gnd
    signal ldo_nr
    signal buck_en
    signal buck_sw
    signal buck_boot
    signal buck_fb
    signal buck_out
    signal aux15_ov_n
    signal aux15_ov_sense

    ldo = new TPS7A4701
    ldo.IN ~ aux_raw
    ldo.EN ~ aux_raw
    ldo.GND ~ gnd
    ldo.OUT ~ aux15
    ldo.FB ~ aux15
    # ANY-OUT 15 V table: 1.4 + 0.8 + 6.4 + 6.4 V.
    ldo.P08 ~ gnd
    ldo.P64V1 ~ gnd
    ldo.P64V2 ~ gnd
    ldo.NR ~ ldo_nr
    ldo_nr_c = new F2C
    ldo_nr_c.value = 1uF
    ldo_nr_c.p1 ~ ldo_nr
    ldo_nr_c.p2 ~ gnd

    ldo_cin = new F2C
    ldo_cin.value = 10uF
    ldo_cin.p1 ~ aux_raw
    ldo_cin.p2 ~ gnd
    ldo_cout = new F2C
    ldo_cout.value = 47uF
    ldo_cout.p1 ~ aux15
    ldo_cout.p2 ~ gnd

    # Independent overvoltage cut path.  TPS3700 is powered from logic5, not
    # AUX15, so a failed-high LDO cannot also remove its own monitor supply.
    # OUTB is open-drain active-low when INB_N > 0.4 V.  This divider is a
    # nominal 15.7 V trip and must be corner-checked before production.
    aux_ov = new TPS3700
    aux_ov.VDD ~ logic5
    aux_ov.GND ~ gnd
    aux_ov.INA_P ~ gnd
    aux_ov.OUTA ~ gnd
    aux_ov.INB_N ~ aux15_ov_sense
    aux_ov.OUTB ~ aux15_ov_n
    aux_ov_top = new F2R
    aux_ov_top.value = 3.83Mohm
    aux_ov_bottom = new F2R
    aux_ov_bottom.value = 100kohm
    aux_ov_top.p1 ~ aux15
    aux_ov_top.p2 ~ aux15_ov_sense
    aux_ov_bottom.p1 ~ aux15_ov_sense
    aux_ov_bottom.p2 ~ gnd
    aux_ov_pull = new F2R
    aux_ov_pull.value = 10kohm
    aux_ov_pull.p1 ~ logic5
    aux_ov_pull.p2 ~ aux15_ov_n
    buck = new TPS54202
    buck.VIN ~ aux_raw
    buck.GND ~ gnd
    buck.EN ~ buck_en
    buck.SW ~ buck_sw
    buck.BOOT ~ buck_boot
    buck.FB ~ buck_fb

    # 1 Mohm / 100 kohm EN divider: 1.33--1.84 V over 14.625--20.25 V.
    buck_en_top = new F2R
    buck_en_top.value = 1Mohm
    buck_en_bottom = new F2R
    buck_en_bottom.value = 100kohm
    buck_en_top.p1 ~ aux_raw
    buck_en_top.p2 ~ buck_en
    buck_en_bottom.p1 ~ buck_en
    buck_en_bottom.p2 ~ gnd
    buck_cin = new F2C
    buck_cin.value = 10uF
    buck_cin.p1 ~ aux_raw
    buck_cin.p2 ~ gnd
    buck_boot_c = new F2C
    buck_boot_c.value = 100nF
    buck_boot_c.p1 ~ buck_boot
    buck_boot_c.p2 ~ buck_sw
    buck_l = new F2L
    buck_l.value = 15uH
    buck_l.p1 ~ buck_sw
    buck_l.p2 ~ buck_out
    buck_cout = new F2C
    buck_cout.value = 22uF
    buck_cout.p1 ~ buck_out
    buck_cout.p2 ~ gnd
    buck_rtop = new F2R
    buck_rtop.value = 100kohm
    buck_rbottom = new F2R
    buck_rbottom.value = 13.3kohm
    buck_rtop.p1 ~ buck_out
    buck_rtop.p2 ~ buck_fb
    buck_rbottom.p1 ~ buck_fb
    buck_rbottom.p2 ~ gnd
    buck_out ~ logic5
