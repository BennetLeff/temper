/artifacts/

# Official KiCad footprint library, fetched on demand by
# tools/setup_kicad_env.py via a sparse git clone. This is itself a nested
# .git repo -- never commit it (see 11f859e5, "untrack 73 phantom gitlinks,
# close the submodule-foreach hole", for why a directory like this landing
# in the index as an uncommitted gitlink is a real, previously-hit failure
# mode, not a hypothetical one).
/pcb/libs/kicad-footprints/
/analysis_results/
/reports/
/snapshots/
/specctra_spec.md_files/

# Rust build artifacts
packages/*/target/
# Shared cargo target dir (.cargo/config.toml [build] target-dir). Replaces the
# per-crate target/ dirs above, which each worktree used to build from scratch.
target-shared/

# Pruned root files (2026-06-23 purge)
/*.pkl
minimal_overlap_config.yaml
routed_loop_FINAL.metrics.json
piantor_grid_*.png
run_clearance_sweep.sh

# Pipeline run artifacts (regenerated per run — do not track)
pipeline_execution.json

# Generated mesh + scratch routing output (2026-07-26)
# `/*.mesh` above only covers root-level files; these are directories.
# temp_routing_test/ held 7 stale routing logs that were tracked despite being
# throwaway output — listed here so it cannot return.
mfem_mesh/
temp_routing_test/

# External PCB corpora (2026-07-26)
# These are third-party repos cloned locally as benchmark/regression input.
# They were previously recorded as 73 gitlinks with no .gitmodules, which broke
# `git submodule foreach` in CI (exit 128) while delivering empty directories to
# every fresh clone. Repopulate locally with scripts/scan_external_corpus.py.
benchmarks/downloads_digital_iot/
power_pcb_dataset/sources/
