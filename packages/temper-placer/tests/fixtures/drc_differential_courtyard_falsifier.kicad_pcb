(kicad_pcb (version 20211014) (generator kiutils)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (44 "Edge.Cuts" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
  )

  (setup
    (pad_to_mask_clearance 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")

  (footprint "Diode_SMD:D_SMA" (layer "F.Cu")
    (tstamp 00000000-0000-0000-0000-000000000301)
    (at 100 100)
    (property "Reference" "D3")
    (property "Value" "D_SMA")
    (property "Footprint" "Diode_SMD:D_SMA")
    (path "/00000000-0000-0000-0000-000000000301")
    (fp_line (start -3.5 -1.75) (end 3.5 -1.75) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill no))
    (fp_line (start 3.5 -1.75) (end 3.5 1.75) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill no))
    (fp_line (start 3.5 1.75) (end -3.5 1.75) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill no))
    (fp_line (start -3.5 1.75) (end -3.5 -1.75) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill no))
    (pad "1" smd rect (at -1 0) (size 1.2 1.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND"))
    (pad "2" smd rect (at 1 0) (size 1.2 1.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "VCC"))
  )

  (footprint "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn" (layer "F.Cu")
    (tstamp 00000000-0000-0000-0000-000000000302)
    (at 110 100)
    (property "Reference" "C4")
    (property "Value" "CP_Radial_D35.0mm")
    (property "Footprint" "Capacitor_THT:CP_Radial_D35.0mm_P10.00mm_SnapIn")
    (path "/00000000-0000-0000-0000-000000000302")
    (fp_circle (center 5 0) (end 22.75 0) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill no))
    (pad "1" thru_hole circle (at -1.5 0) (size 2 2) (drill 1)
      (layers "*.Cu" "*.Mask") (net 2 "VCC"))
    (pad "2" thru_hole circle (at 1.5 0) (size 2 2) (drill 1)
      (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )

  (gr_rect (start 90 90) (end 140 110) (layer "Edge.Cuts") (width 0.1))

)
